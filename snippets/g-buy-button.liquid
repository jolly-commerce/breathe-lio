{% comment %}
  Snippet: Product Add to Cart Button
  Created by: Nazarii Prokopchuk

  Description:
  - This form handles adding a product to the cart.
  - The button text and attributes are dynamically generated based on product availability.

  Passed variables:
  - product: {Object} product to add to cart
  - button_class: {String} additional classes for button
  - add_text: {String} text for add to cart button
  - sold_out_text: {String} text for sold out button

  Used snippets:
  - g-button

  Render example:
  {% render 'g-buy-button', product: product, button_class: 'button_class', add_text: 'Add to cart', sold_out_text: 'Sold out' %}
{% endcomment %}
{%- assign data_attr_add_text = add_text -%}
{%- assign data_attr_sold_out_text = sold_out_text -%}
{% if attr_add_text != blank and attr_sold_out_text != blank %}
  {%- assign data_attr_add_text = attr_add_text -%}
  {%- assign data_attr_sold_out_text = attr_sold_out_text -%}
{% endif %}

{%- capture button_attributes -%}
  type="submit" data-button-text="{{ data_attr_add_text }}"
  data-sold-out-text="{{ data_attr_sold_out_text }}"
  {% if product.selected_or_first_available_variant.available == false %}
    disabled
  {% endif %}
{%- endcapture -%}

{%- capture button_text -%}
  {%- if product.selected_or_first_available_variant.available == false -%}
    {{- sold_out_text -}}
  {%- else -%}
    {{- add_text -}}
  {%- endif -%}
{%- endcapture -%}

{% assign button_class = button_class | default: 'jc-w-full disabled:jc-opacity-30' %}
{% assign purchase_form_id = 'purchase-form-' | append: product.id %}

{%- form 'product', product, is: 'atc-form', id: purchase_form_id -%}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
  {%- render 'g-button',
    text: button_text,
    button_attributes: button_attributes,
    button_class: button_class,
    icon: icon,
    icon_class: icon_class
  -%}
{%- endform -%}
