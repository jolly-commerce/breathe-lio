{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
MEGA MENU PANEL
----------------------------------------------------------------------------------------------------------------------

This component is used to show the different links in different panel for the menu drawer

********************************************
Supported variables
********************************************

* main_menu: the menu to show for the primary menu
* secondary_menu: the secondary menu (shown on mobile)
* block: use when mega menu is set to drawer
* is_mega_menu: set to true if mega menu is set to drawer
* layout

{%- endcomment -%}

<div class="panel-list__wrapper">
  <div class="panel">
    <div class="panel__wrapper" {% if mega_menu_block.settings.promo_content_layout == 'grid' or mega_menu_block.settings.promo_content_layout == 'collage' %}style="--panel-wrapper-justify-content: flex-start"{% endif %}>
      <div class="panel__scroller v-stack gap-4">
    <div class="top-sticky-bar">
        <div class="close_menu">
      <svg role="presentation" stroke-width="2" focusable="false" width="30" height="30" class="icon icon-close" viewBox="0 0 24 24">
        <path d="M17.658 6.343 6.344 17.657M17.658 17.657 6.344 6.343" stroke="#27334F"></path>
      </svg>
    </div>
    <a class="mobile-menu-logo" href="{{ shop.url }}">  <img src="{{ section.settings.logo | image_url: width: 400 }}" />
    </a>
    </div>
  <div class="mega-menu-left-links">
     {% for block in section.blocks %}
 {% case block.type %}
        {% when 'mega_menu' %}
        <p class="menu-name">{{ block.settings.menu-name-1 }}</p>
        {% when 'menu-link' %}
   <a class="mega-menu-link-new" href="{{ block.settings.url }}"><h2 class="h2">{{ block.settings.text }} <span>{{ block.settings.high-text }}</span></h2> <img src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/arrow-right.svg?v=1747749096" /> </a>
 
        {% when 'menu-link-2' %}
   <a class="mega-menu-link-new {{ block.id }}" href="{{ block.settings.url }}"><h2 class="h2">{{ block.settings.text }} <span>{{ block.settings.high-text }}</span></h2>  <img src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/arrow-right.svg?v=1747749096" /></a>
    {% endcase %}
{% endfor %}
</div>
        {% for block in section.blocks %}
 {% case block.type %}
        {% when 'mega_menu' %}
   <div class="mobile-menu-blocks">
      <div class="mega-menu-nav-single-box">
      <img src="{{ block.settings.image_1 | image_url: width: 1000 }}" />
     <h3 class="h3">{{- block.settings.image_heading_1 | escape -}}</h3>
            <p>{{- block.settings.image_sub_heading_1 | escape -}}</p>
           <a href="{{ block.settings.image_link_1 }}" class="gradient-button">{{ block.settings.image_url_text_1 }}</a>
    </div>
     <div class="mega-menu-nav-single-box">
      <img src="{{ block.settings.image_2 | image_url: width: 1000 }}" />
     <h3 class="h3">{{- block.settings.image_heading_2 | escape -}}</h3>
            <p>{{-block.settings.image_sub_heading_2 | escape -}}</p>
           <a href="{{ block.settings.image_link_2 }}" class="gradient-button">{{ block.settings.image_url_text_2 }}</a>
    </div>
   </div>
   {% endcase %}
{% endfor %}

 <div class="faq-accordion-item">
            <div class="faq-accordion-header" data-target="{{ section.id }}-fpanel{{ forloop.index }}">
              <div class="faq-acc-con">
                <span>{{ section.settings.mobile_menu_extra.title }}</span>
              </div>
              <button class="faq-toggle"></button>
            </div>
            <div class="faq-accordion-panel" id="{{ section.id }}-fpanel{{ forloop.index }}">
               {%- for link in section.settings.mobile_menu_extra.links -%}
                         
                            <a class="menu-link-extra"
                              href="{{ link.url }}"
                            >
                              {{ link.title | escape }}
                            </a>
                          
                        {%- endfor -%}
            </div>
          </div>
  
 <div class="mobile-navigation-bottom">
       {%- if section.settings.show_social_media -%}
          {%- capture social_media -%}{%- render 'social-media' -%}{%- endcapture -%}
        {%- endif -%}
          {{- social_media -}}
 {%- if show_country_selector and localization.available_countries.size > 1 -%}
          {%- assign country_selector = true -%}
        {%- endif -%}
   {%- if country_selector -%}
                  {%- render 'localization-selector', type: 'country', show_country_name: show_country_name -%}
                {%- endif -%}
          </div>
    </div>
     
 </div>
 </div>


</div>