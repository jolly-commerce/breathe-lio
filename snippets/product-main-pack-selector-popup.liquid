{% comment %}
  Pack Selector Popup - displays detailed product information in a modal
  Usage: {% render 'product-main-pack-selector-popup', step_2_products: products %}
{% endcomment %}
{% style %}
  body:has(.js-pack-selector-popup.active) {
    overflow: hidden;
  }
{% endstyle %}
<pack-selector-popup
  class="
    js-pack-selector-popup jc-pointer-events-none jc-opacity-0 jc-transition-all jc-duration-300 [&.active]:jc-pointer-events-auto
    [&.active]:jc-opacity-100 jc-fixed jc-inset-0 jc-z-50 jc-flex jc-items-center jc-justify-center jc-bg-black jc-bg-opacity-60
  "
>
  <div class="js-popup-overlay jc-absolute jc-inset-0"></div>

  <div class="jc-relative jc-w-80 jc-overflow-hidden">
    <!-- Close Button -->
    <button class="js-popup-close jc-absolute jc-top-3 jc-right-3 jc-z-10 jc-flex jc-items-center jc-justify-center">
      {% render 'g-render-icon', icon: 'fat-close', class: 'jc-w-6 jc-h-6' %}
    </button>

    <swiper-container
      id="productStep2Swiper"
      class="step2-swiper"
      slides-per-view="1"
      space-between="24"
      speed="500"
      loop="false"
      navigation="true"
      navigation-next-el=".step2-nav-button-next"
      navigation-prev-el=".step2-nav-button-prev"
    >
      {%- for product in step_2_products -%}
        <swiper-slide
          style="
            --bg-color: {{ product.metafields.jolly_meta.background_color | default: '#ffffff' }}30;
            --dot-color: {{ product.metafields.jolly_meta.background_color | default: '#004631' }}60;
            --dot-color-active: {{ product.metafields.jolly_meta.background_color | default: '#000000' }};
          "
          class="jc-bg-white jc-h-[inherit] jc-rounded-xl jc-border jc-border-britishRacingGreen"
          data-product-id="{{ product.first_available_variant.id }}"
        >
          <div class="jc-p-5 jc-flex jc-flex-col jc-bg-[var(--bg-color)] jc-gap-4 jc-h-full jc-rounded-xl">
            <!-- Product Image with Navigation -->
            <div class="jc-relative jc-w-full jc-h-fit">
              {% render 'g-render-image',
                class: 'jc-h-51 jc-w-51 jc-aspect-square jc-object-cover jc-mx-auto',
                img_src: product.featured_image.url,
                img: product.featured_image,
                size: '400 500',
                alt: product.featured_image.alt,
                width: '204',
                height: '204',
                loading: 'lazy'
              %}
            </div>

            <!-- Product Title -->
            <p class="jc-w-full jc-text-center jc-font-sigumL jc-leading-10 jc-text-5xl jc-font-normal jc-text-britishRacingGreen">
              {{ product.title }}
            </p>

            <!-- Rating Categories -->
            {%- assign categories_handel = product.metafields.jolly_meta.categories_handel
              | default: 'savoury,throat_hit,sweetness'
            -%}
            {%- assign categories = categories_handel | split: ',' -%}
            <div class="jc-flex jc-gap-4">
              {%- for category in categories -%}
                {%- assign rating = product.metafields.jolly_meta[category] | default: 3 -%}
                {%- assign category_title = 'bundle_pack.' | append: category | t -%}
                {%- if rating != blank and category_title != blank -%}
                  <div class="jc-flex-1 jc-flex jc-flex-col jc-items-center jc-gap-1">
                    <div class="jc-flex jc-gap-1.5 jc-items-center">
                      {%- for i in (1..3) -%}
                        <div
                          class="
                            jc-w-3 jc-h-3 jc-rounded-full
                            {% if i <= rating %}jc-bg-[var(--dot-color-active)]{% else %}jc-bg-[var(--dot-color)]{% endif %}
                          "
                        ></div>
                      {%- endfor -%}
                    </div>
                    <div class="jc-text-base jc-leading-5 jc-text-britishRacingGreen jc-font-normal jc-font-sigumL">
                      {{ category_title }}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <!-- Notes -->
            {%- if product.metafields.jolly_meta.notes != blank -%}
              <div class="jc-text-sm jc-leading-5 jc-text-darkGreen jc-font-normal jc-font-poppins jc-text-center">
                {{ product.metafields.jolly_meta.notes | metafield_tag }}
              </div>
            {%- endif -%}

            <!-- Description -->
            {%- if product.metafields.jolly_meta.custom_description != blank -%}
              <div class="jc-text-xs jc-leading-5 jc-text-darkGreen jc-font-normal jc-font-poppins jc-text-center">
                {{ product.metafields.jolly_meta.custom_description | metafield_tag }}
              </div>
            {%- endif -%}

            <!-- Add to Bundle Button -->
            <button
              class="
                js-add-to-bundle jc-mt-auto jc-w-full jc-text-center jc-py-2.5 jc-border jc-border-britishRacingGreen jc-rounded-mxs jc-uppercase
                jc-transition-all jc-text-xxs lg:jc-text-xs jc-leading-4 jc-font-semibold jc-text-britishRacingGreen
                [&:disabled]:jc-opacity-50 [&:disabled]:jc-pointer-events-none [&:disabled]:jc-cursor-not-allowed
                hover:jc-bg-munsell hover:jc-text-white jc-shadow-pack-selector-green
              "
            >
              {{ 'bundle_pack.button_add' | t }}
            </button>
          </div>
        </swiper-slide>
      {%- endfor -%}
      <div slot="container-end">
        <div
          part="button-prev"
          class="swiper-button-prev step2-nav-button-prev after:!jc-content-[''] !jc-top-1/4 !jc-left-5"
        >
          {% render 'g-render-icon', icon: 'fat-chevron-down', class: 'jc-w-full jc-h-full jc-rotate-90' %}
        </div>
        <div
          part="button-next"
          class="swiper-button-next step2-nav-button-next after:!jc-content-[''] !jc-top-1/4 !jc-right-5"
        >
          {% render 'g-render-icon', icon: 'fat-chevron-down', class: 'jc-w-full jc-h-full -jc-rotate-90' %}
        </div>
      </div>
    </swiper-container>
  </div>
</pack-selector-popup>
