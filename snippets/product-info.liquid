<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form  = document.querySelector(".product-info__block-item .product-info__buy-buttons .shopify-product-form");
    const boxes = Array.from(document.querySelectorAll(".plan-box"));
    if (!form || !boxes.length) return;

    // set up an Intl formatter using your shop settings
    const moneyFormatter = new Intl.NumberFormat(Shopify.locale, {
      style: "currency",
      currency: Shopify.currency.active
    });

    // format cents (Shopify AJAX gives price in cents) into a string
    function formatMoney(cents) {
      return moneyFormatter.format(cents / 100);
    }

    // recalc all plan prices on variant change
    function updatePrices(variantPrice) {
      boxes.forEach(box => {
        const pct = parseFloat(box.dataset.discountPercent) || 0;
        const discountedCents = Math.round(variantPrice * (1 - pct / 100));
        box.querySelector(".js-plan-price").textContent = formatMoney(discountedCents);
      });
    }

    // mark a plan active and inject the proper hidden field
    function setActive(box) {
      boxes.forEach(b => b.classList.remove("active"));
      box.classList.add("active");

      const existing = form.querySelector('input[name="selling_plan"]');
      if (existing) existing.remove();

      if (box.dataset.sellingPlanId) {
        const inp = document.createElement("input");
        inp.type  = "hidden";
        inp.name  = "selling_plan";
        inp.value = box.dataset.sellingPlanId;
        form.appendChild(inp);
      }
    }

    // wire up clicks + default
    boxes.forEach(b => b.addEventListener("click", () => setActive(b)));
    setActive(boxes[0]);

    // listen for Shopify's variant:change event (fired by your theme.js)
    document.addEventListener("variant:change", e => {
      updatePrices(e.detail.variant.price);
    });
  });
</script>





    

