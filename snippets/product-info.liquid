{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
PRODUCT INFO
----------------------------------------------------------------------------------------------------------------------

This snippet renders all the blocks of a given product. It uses the blocks of the section currently in use (there is
no need to manually pass the section as it is globally available)

********************************************
Supported variables
********************************************

* product: the product on which to render the information (if blank, it renders placeholder information)
* product_form_id: the ID of the product form
* context: the context of the product info. Can be "main_product", "featured_product" or "quick_buy"
{%- endcomment -%}

<safe-sticky class="product-info">
  {%- assign inside_block_group_context = false -%}
  {%- assign current_block_group_name = '' -%}

  {%- for block in section.blocks -%}
    {%- liquid
      assign previous_block_index = forloop.index0 | minus: 1
      assign next_block_index = forloop.index0 | plus: 1
      assign previous_block = section.blocks[previous_block_index]
      assign next_block = section.blocks[next_block_index]

      comment
      You can use your own condition to create smart grouping. When two or more blocks match the condition, they are
      automatically grouped by a div that will take the desired class. This can even work for more than 2 elements
      (for instance if you specify accordion follow by an accordion). The theme takes care of properly opening and
      closing the group for proper HTML. In order to make it work, you need to create one condition explaining when
      to enter into the group, and you need to indicate a block_group_class and block_group_name. Most of the time,
      the two will be identical. However, the block_group_name must be unique. This means that as long as the block_group_name
      stays the same, then another group will not be created as long as the conditions match.
      endcomment

      assign allow_block_group = true

      if block.type == 'offer' and next_block.type == 'offer'
        assign block_group_class = 'product-info__offer-list'
        assign block_group_name = 'product-info__offer-list'
      elsif block.type == 'collapsible_text' and next_block.type == 'collapsible_text'
        assign block_group_class = 'accordion-group'
        assign block_group_name = 'accordion-group'
      elsif block.type == 'collapsible_text' and next_block.type == 'description' and product.description != blank and next_block.settings.collapse_content
        assign block_group_class = 'accordion-group'
        assign block_group_name = 'accordion-group'
      elsif block.type == 'description' and product.description != blank and block.settings.collapse_content and next_block.type == 'collapsible_text'
        assign block_group_class = 'accordion-group'
        assign block_group_name = 'accordion-group'
      else
        assign allow_block_group = false
        assign block_group_class = ''
        assign current_block_group_name = ''
      endif

      if allow_block_group
        assign new_block_group_name = block_group_name

        if inside_block_group_context == true and new_block_group_name != current_block_group_name
          assign allow_block_group = false
        else
          assign current_block_group_name = new_block_group_name
        endif
      endif
    -%}

    {%- capture block_content -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {%- render block -%}
 {% when 'pack_selector' %}
{{ 'ws-pack-selector.css' | asset_url | stylesheet_tag: preload: true }}
<div class="ws-pack-selector" id="ws-pack-selector-{{ block.id }}">
  <!-- STEP 1: LIO Selector -->
  <div class="ws-lio-selector">
    <h4 class="ws-lio-selector__title">{{ block.settings.lio_selector_title }} :</h4>

    {% assign default_type = '' %}
    {% assign default_variant = nil %}
    {% for variant in product.variants %}
      {% if variant.metafields.custom.featured_icon_horizontal != blank %}
        {% assign type = variant.options[0] %}
        {% if default_type == '' %}
          {% assign default_type = type %}
          {% assign default_variant = variant %}
        {% endif %}
      {% endif %}
    {% endfor %}

    <div class="ws-lio-dropdown" data-selected-type="{{ default_type | handleize }}">
     <div class="ws-lio-dropdown__selected">
  <div class="ws-lio-selected-image">
    {% assign selected_variant = default_variant %}
    {% if selected_variant %}
      {{ selected_variant.metafields.custom.featured_icon_horizontal
         | image_url: width: 300
         | image_tag: alt: default_type }}
    {% endif %}
  </div>
  <span class="ws-lio-selected-label">Lio {{ default_type }}</span>
  
        <svg  class="ws-lio-dropdown__arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="8" viewBox="0 0 14 8" fill="none">
  <path d="M13.9998 0.940948C14.0043 0.757525 13.9443 0.577404 13.8281 0.425624C13.7118 0.273844 13.545 0.157947 13.351 0.0940481C13.157 0.0301489 12.9453 0.021422 12.7455 0.0690801C12.5456 0.116738 12.3676 0.218413 12.2359 0.35997L7.0161 5.76116L1.79814 0.35997C1.71695 0.262048 1.61388 0.180041 1.49528 0.119084C1.37668 0.0581269 1.24513 0.0195338 1.10893 0.00572058C0.972723 -0.00809259 0.8348 0.00317218 0.703736 0.0388093C0.572672 0.0744464 0.451282 0.133688 0.347243 0.212824C0.243203 0.291961 0.15881 0.389288 0.0991678 0.498709C0.039526 0.608131 0.00602719 0.72729 0.000741922 0.848725C-0.0045443 0.970159 0.0184345 1.09125 0.0683879 1.20442C0.118341 1.31759 0.194115 1.4204 0.290967 1.50641L6.25958 7.69028C6.35307 7.78739 6.46911 7.86537 6.59988 7.91884C6.73066 7.97231 6.873 8 7.01702 8C7.16104 8 7.30338 7.97231 7.43415 7.91884C7.56493 7.86537 7.68108 7.78739 7.77457 7.69028L13.7489 1.50641C13.9055 1.35019 13.9942 1.14983 13.9998 0.940948Z" fill="#005128"/>
</svg>
</div>

      <ul class="ws-lio-dropdown__list">
        {% for variant in product.variants %}
          {% if variant.metafields.custom.featured_icon_horizontal != blank %}
            {% assign type = variant.options[0] %}
            <li class="ws-lio-dropdown__item"
                data-variant-type="{{ type | handleize }}"
                data-variant-id="{{ variant.id }}">
              <div class="ws-lio-option__image">
                {{ variant.metafields.custom.featured_icon_horizontal
                   | image_url: width:300
                   | image_tag: alt:type }}
              </div>
              <span class="ws-lio-option__label">Lio {{ type }}</span>
            </li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>

  <!-- STEP 2: Pack Selector -->
  <div class="ws-pack-selector__packs">
    <h4 class="ws-pack-selector__title">{{ block.settings.pack_selector_title }} :</h4>
    {% assign lio_types = '' %}
    <ul class="ws-pack-options">
      {% for variant in product.variants %}
        {% assign type = variant.options[0] | handleize %}
        {% assign pack_title = variant.metafields.custom.pack_option_title | default: variant.title %}
         {% assign pack_desc = variant.metafields.custom.pack_option_description | newline_to_br %}
        {% if variant.featured_image != blank %}
          {% unless lio_types contains type %}
            {% assign lio_types = lio_types | append: type | append: ',' %}
          {% endunless %}
          <li class="ws-pack-option ws-pack-option--type-{{ type }}{% if forloop.first %} ws-pack-option--selected{% endif %}"
              data-variant-id="{{ variant.id }}"
            data-media-id="{{ variant.featured_media.id }}"
              data-variant-type="{{ type }}"
              style="{% if forloop.index > 3 %}display:none{% endif %}">
            <div class="ws-pack-option__image">
              {{ variant.featured_image
                 | image_url: width:500
                 | image_tag: alt:pack_title }}
            </div>
            <div class="ws-pack-option__details">
              <span class="ws-pack-option__title">{{ pack_title }}</span>
              <span class="ws-pack-option__desc">{{ pack_desc }}</span>
             
            </div>
          <div class="ws-pack-option__prices">
           <span class="ws-pack-option__price">{{ variant.price | money_without_trailing_zeros }}</span>
            {% if variant.compare_at_price != blank  %}
           <span class="ws-pack-option__com_price">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>
              {% endif %}
          </div>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>

  <!-- CTA BUTTON -->
  <div class="ws-cta">
  
     <button class="ws-cta__button">
  <span class="ws-cta__text">{{ block.settings.cta_text }}</span>
  <span class="ws-cta__price"></span>
  <span class="ws-cta__loader">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
  </span>
</button>

   
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const container = document.getElementById('ws-pack-selector-{{ block.id }}');
  const packOptions = container.querySelectorAll('.ws-pack-option');
  let selectedVariantId = '';

  function updateCTAButtonPrice() {
    const selectedOption = container.querySelector('.ws-pack-option--selected');
    if (selectedOption) {
      const price = selectedOption.querySelector('.ws-pack-option__price')?.innerText || '';
      ctaPrice.textContent = price;
    }
  }

  function syncGalleryToMedia(mediaId) {
    const thumbBtn = document.querySelector(`.product-gallery__thumbnail[data-media-id="${mediaId}"]`);
    if (thumbBtn) thumbBtn.click();
  }

  function updatePacksByType(type) {
    let firstVisible = null;
    packOptions.forEach(pack => {
      const packType = pack.dataset.variantType;
      if (packType === type) {
        pack.style.display = '';
        if (!firstVisible) {
          firstVisible = pack;
          pack.classList.add('ws-pack-option--selected');
          selectedVariantId = pack.dataset.variantId;
        } else {
          pack.classList.remove('ws-pack-option--selected');
        }
      } else {
        pack.style.display = 'none';
        pack.classList.remove('ws-pack-option--selected');
      }
    });

    updateCTAButtonPrice();

    // ─── NEW: Sync gallery to the first visible pack ───
    if (firstVisible) {
      const mediaId = firstVisible.dataset.mediaId;
      syncGalleryToMedia(mediaId);
    }
  }

  // Dropdown behavior
  const dropdown = container.querySelector('.ws-lio-dropdown');
  const selectedLabel = dropdown.querySelector('.ws-lio-selected-label');
  const selectedImageContainer = dropdown.querySelector('.ws-lio-selected-image');
  const dropdownList = dropdown.querySelector('.ws-lio-dropdown__list');
  const dropdownItems = dropdown.querySelectorAll('.ws-lio-dropdown__item');

  dropdown.querySelector('.ws-lio-dropdown__selected').addEventListener('click', () => {
    dropdown.classList.toggle('open');
  });

  dropdownItems.forEach(item => {
    item.addEventListener('click', () => {
      const type = item.dataset.variantType;
      const label = item.querySelector('.ws-lio-option__label').innerText;
      const imageHtml = item.querySelector('.ws-lio-option__image').innerHTML;

      selectedLabel.innerText = label;
      selectedImageContainer.innerHTML = imageHtml;

      dropdown.classList.remove('open');
      updatePacksByType(type);
    });
  });

  document.addEventListener('click', (e) => {
    if (!dropdown.contains(e.target)) {
      dropdown.classList.remove('open');
    }
  });

  // Update selected variant and price when pack is clicked
  packOptions.forEach(po => {
    po.addEventListener('click', () => {
      // 1. Visual selection + price
      packOptions.forEach(o => o.classList.remove('ws-pack-option--selected'));
      po.classList.add('ws-pack-option--selected');
      selectedVariantId = po.dataset.variantId;
      updateCTAButtonPrice();

      // 2. Sync gallery thumbnail
      const mediaId = po.dataset.mediaId;
      syncGalleryToMedia(mediaId);
    });
  });

  // CTA button setup
  const ctaButton = container.querySelector('.ws-cta__button');
  const ctaText = ctaButton.querySelector('.ws-cta__text');
  const ctaLoader = ctaButton.querySelector('.ws-cta__loader');
  const ctaPrice = ctaButton.querySelector('.ws-cta__price');

  updateCTAButtonPrice();

  // Ensure selectedVariantId is set on initial load
  const initiallySelected = container.querySelector('.ws-pack-option--selected');
  if (initiallySelected) {
    selectedVariantId = initiallySelected.dataset.variantId;
  }

  if (ctaButton) {
    ctaButton.addEventListener('click', () => {
      if (!selectedVariantId) return;

      ctaLoader.style.display = 'inline-flex';
      ctaText.style.display = 'none';
      ctaPrice.style.display = 'none';

      setTimeout(() => {
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: selectedVariantId, quantity: 1 }] })
        })
        .then(() => {
          const cartDrawer = document.querySelector('#cart-drawer');
          if (cartDrawer && typeof cartDrawer._onCartRefresh === 'function') {
            cartDrawer._onCartRefresh()
              .then(() => cartDrawer.show());
            setTimeout(() => {
              const countEl = document.querySelector('.count-bubble [aria-hidden="true"]');
              if (countEl) {
                const count = {{ cart.item_count }} + 1;
                countEl.innerText = count;
              }
            }, 2000);
          }
        })
        .catch(console.error)
        .finally(() => {
          ctaLoader.style.display = 'none';
          ctaText.style.display = 'inline-flex';
          ctaPrice.style.display = 'inline-flex';
        });
      }, 1000);
    });
  }
});
</script>




  
{%- when 'product-selector' -%}
  {% assign default_variant_option = '' %}
  {% assign default_variant = nil %}

  <div class="ecom-pack-selector" id="ecom-pack-selector-{{ block.id }}">
    <!-- Step 1: Lio Selector -->
    <div class="ecom-pack-selector__lio-selector">
      <h4 class="ecom-pack-selector__lio-selector-title">
        <span>{{ block.settings.lio_selector_title }}</span>
        <button class="ecom-pack-selector__lio-selector__title-info-button">
          {% render 'icon', icon: 'info', width: 14, height: 14 %}
        </button>
      </h4>
      <div class="ecom-pack-selector__lio-selector__options-wrapper">
        <ul class="ecom-pack-selector__lio-selector-options">
          {% for variant in product.variants %}
            {% if variant.metafields.custom.featured_icon != blank %}
              {% if default_variant_option == '' %}
                {% assign default_variant_option = variant.options[0] %}
                {% assign default_variant = variant %}
              {% endif %}
              <li
                class="ecom-pack-selector__lio-option{% if variant.options[0] == default_variant_option %} ecom-pack-selector__lio-option--selected{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-variant-type="{{ variant.options[0] | handleize }}"
              >
                <div class="ecom-pack-selector__lio-option-content">
                  <div class="ecom-pack-selector__lio-option-image-wrapper">
                    {{ variant.metafields.custom.featured_icon_horizontal | image_url: width: 300 | image_tag: alt: "Lio Icon", width: 300, height: 300, class: "ecom-pack-selector__lio-option-image" }}
                  </div>
                  <span class="ecom-pack-selector__lio-option-title">
                    {% case variant.options[0] %}
                      {% when block.settings.option_handle_1 %} {{ block.settings.lio_selector_option_1 }}
                      {% when block.settings.option_handle_2 %} {{ block.settings.lio_selector_option_2 }}
                      {% when block.settings.option_handle_3 %} {{ block.settings.lio_selector_option_3 }}
                      {% when block.settings.option_handle_4 %} {{ block.settings.lio_selector_option_4 }}
                      {% when block.settings.option_handle_5 %} {{ block.settings.lio_selector_option_5 }}
                      {% when block.settings.option_handle_6 %} {{ block.settings.lio_selector_option_6 }}
                      {% when block.settings.option_handle_7 %} {{ block.settings.lio_selector_option_7 }}
                      {% when block.settings.option_handle_8 %} {{ block.settings.lio_selector_option_8 }}
                    {% endcase %}
                  </span>
                </div>
                <div class="ecom-pack-selector__lio-option-price-and-toggle-btn">
                  <span class="ecom-pack-selector__lio-option-price-label">{{ block.settings.lio_selector_price_label }}</span>
                  <span class="ecom-pack-selector__lio-option-price">{{ variant.price | money }}</span>
                  {% render 'icon', icon: 'chevron-down-thin', width: 24, height: 24 %}
                </div>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- Step 2: Pack Selector -->
    <div class="ecom-pack-selector__pack-selector">
      <h4 class="ecom-pack-selector__pack-selector-title">{{ block.settings.pack_selector_title }}</h4>
      <div class="ecom-pack-selector__pack-selector-options">
        {% for variant in product.variants %}
          {% assign current_variant_option_0 = variant.options[0] %}
          {% if current_variant_option_0 == default_variant_option %}
            {% assign show_pack = 'true' %}
          {% else %}
            {% assign show_pack = '' %}
          {% endif %}

          <div
            class="ecom-pack-selector__pack-option{% if show_pack == 'true' %} ecom-pack-selector__pack-option--show{% endif %}{% if variant.id == default_variant.id %} ecom-pack-selector__pack-option--selected{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-variant-type="{{ variant.options[0] | handleize }}"
          >
            {% assign pack_option_title = variant.metafields.custom.pack_option_title | default: variant.title %}
            <div class="ecom-pack-selector__pack-option__text-content">
              <h6 class="ecom-pack-selector__pack-option__title">{{ pack_option_title }}</h6>
              {% if variant.metafields.custom.pack_option_description != blank %}
                <p class="ecom-pack-selector__pack-option__description">{{ variant.metafields.custom.pack_option_description | newline_to_br }}</p>
              {% endif %}
            </div>

            {% if variant.featured_image != blank %}
              {{ variant.featured_image | image_url: width: 500 | image_tag: alt: "Pack Option Image", width: 500, height: 500, class: "ecom-pack-selector__pack-option__image" }}
            {% endif %}

            <div class="ecom-pack-selector__pack-option__info-content">
              {% assign pack_option_badge = variant.metafields.custom.pack_option_badge | default: variant.metafields.custom.pack_option_badge_two %}
              {% if pack_option_badge != blank %}
                <div class="ecom-pack-selector__pack-option__badge{% if variant.metafields.custom.pack_option_badge_two != blank %} ecom-pack-selector__pack-option__badge--two{% endif %}">
                  {{ pack_option_badge }}
                </div>
              {% endif %}

              <div class="ecom-pack-selector__pack-option__prices">
                <span class="ecom-pack-selector__pack-option__compare-price">{{ variant.compare_at_price | money }}</span>
                <span class="ecom-pack-selector__pack-option__price">{{ variant.price | money }}</span>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- CTA Button -->
    {{ 'ecom-cta.css' | asset_url | stylesheet_tag: preload: true }}
    <div class="ecom-cta ecom-pack-selector__cta">
      {% if block.settings.link %}
        <a href="{{ block.settings.link }}" class="ecom-cta__box" role="button">{{ block.settings.pack_selector_cta_text }}</a>
      {% else %}
        <button class="ecom-cta__box" role="button">{{ block.settings.pack_selector_cta_text }}</button>
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const container = document.querySelector('#ecom-pack-selector-{{ block.id }}');
      if (!container) return;

      const lioOptions      = container.querySelectorAll('.ecom-pack-selector__lio-option');
      const packOptions     = container.querySelectorAll('.ecom-pack-selector__pack-option');
      const addToCartBtn    = container.querySelector('.ecom-pack-selector__cta .ecom-cta__box');
      const lioSelectorList = container.querySelector('.ecom-pack-selector__lio-selector-options');
      let selectedVariantId = '';

      // Initialize selectedVariantId to the default selected pack
      const defaultPack = container.querySelector('.ecom-pack-selector__pack-option--selected');
      if (defaultPack) {
        selectedVariantId = defaultPack.getAttribute('data-variant-id');
      }

      // Lio option click
      lioOptions.forEach(option => {
        option.addEventListener('click', function() {
          const variantType = this.getAttribute('data-variant-type');

          // Move the clicked <li> to the top of the list
          lioSelectorList.prepend(this);

          // Mark selected visually
          lioOptions.forEach(opt => opt.classList.remove('ecom-pack-selector__lio-option--selected'));
          this.classList.add('ecom-pack-selector__lio-option--selected');

          // Toggle dropdown open/close
          lioSelectorList.classList.toggle('ecom-pack-selector__lio-selector-options--open');
          const isOpen = lioSelectorList.classList.contains('ecom-pack-selector__lio-selector-options--open');

          // Show or hide all LIO options depending on dropdown state
          lioOptions.forEach(opt => {
            opt.style.display = isOpen ? 'flex' : '';
          });

          // Show/hide pack options by matching data-variant-type
          packOptions.forEach(packOpt => {
            const packType = packOpt.getAttribute('data-variant-type');
            packOpt.classList.remove('ecom-pack-selector__pack-option--show', 'ecom-pack-selector__pack-option--selected');
            if (packType === variantType) {
              packOpt.classList.add('ecom-pack-selector__pack-option--show');
            }
          });

          // Select the first shown pack option and update selectedVariantId
          const firstShown = container.querySelector('.ecom-pack-selector__pack-option--show');
          if (firstShown) {
            firstShown.classList.add('ecom-pack-selector__pack-option--selected');
            selectedVariantId = firstShown.getAttribute('data-variant-id');
          }
        });
      });

      // Pack option click
      packOptions.forEach(option => {
        option.addEventListener('click', function() {
          // Only deselect other pack options that are visible
          packOptions.forEach(opt => {
            if (opt.classList.contains('ecom-pack-selector__pack-option--show')) {
              opt.classList.remove('ecom-pack-selector__pack-option--selected');
            }
          });
          this.classList.add('ecom-pack-selector__pack-option--selected');
          selectedVariantId = this.getAttribute('data-variant-id');
        });
      });

      // Add to Cart
      if (addToCartBtn) {
        addToCartBtn.addEventListener('click', function() {
          if (!selectedVariantId) {
            console.error('No variant selected');
            return;
          }
          addToCartBtn.setAttribute('disabled', true);
          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ items: [{ id: selectedVariantId, quantity: 1 }] })
          })
          .then(res => res.json())
          .then(data => {
            // optional: redirect or show drawer
          })
          .catch(err => console.error('Error adding to cart:', err))
          .finally(() => {
            setTimeout(() => addToCartBtn.removeAttribute('disabled'), 2000);
          });
        });
      }
    });
  </script>



