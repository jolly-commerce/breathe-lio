{% comment %}
  Section: "product-main-sticky-atc"
  Created by: Yevhen Hryhorenko

  Snippets:
  - product-main-sticky-atc-gallery
  - product-main-sticky-atc-price
  - g-button
{% endcomment %}

{%- # Add to cart button class -%}
{%- assign add_to_cart_class = 'jc-min-w-fit jc-w-full disabled:jc-opacity-30 md:jc-w-auto' -%}

{%- # Add to cart button type -%}
{% case root.settings.add_to_cart_style %}
  {%- when 'style1' -%}
    {%- assign add_to_cart_type = 'black-button' -%}
    {%- assign add_to_cart_icon = '' -%}
  {%- when 'style2' -%}
    {%- assign add_to_cart_type = 'transparent-black' -%}
    {%- assign add_to_cart_icon = '' -%}
  {%- when 'style3' -%}
    {%- assign add_to_cart_type = 'transparent-black-with-arrow' -%}
    {%- assign add_to_cart_icon = 'arrow-right' -%}
{% endcase %}

{%- # Add to cart button text -%}
{%- capture add_to_cart_text -%}
  {% if product.selected_or_first_available_variant.available == false %}
    {{ 'products.product.sold_out' | t }}
  {%- else -%}
    {{ 'products.product.add_to_cart' | t }}
  {% endif %}
{%- endcapture -%}

{%- # Add to cart button disabled attribute -%}
{%- capture add_to_cart_attributes -%}
  form="{{ product_form_id }}" data-button-text="{{ 'products.product.add_to_cart' | t }}"
  data-sold-out-text="{{ 'products.product.sold_out' | t }}"
  {% if product.selected_or_first_available_variant.available == false %}
    disabled
{% endif %}
{%- endcapture -%}

<product-sticky-atc
  data-form-id="{{ product_form_id }}"
  class="jc-opacity-0 jc-invisible [&.active]:jc-opacity-100 [&.active]:jc-visible jc-bg-white jc-shadow-2xl jc-fixed jc-bottom-0 jc-left-0 jc-right-0 jc-z-[2] jc-transition-all jc-duration-300"
>
  <div class="jc-container jc-p-4 jc-flex jc-gap-4 jc-items-center jc-justify-between jc-flex-wrap">
    <div class="jc-flex jc-gap-2">
      {%- # Gallery -%}
      {% render 'product-main-sticky-atc-gallery' %}

      <div class="jc-self-center">
        <h2>
          {{ product.title }}
        </h2>
        <span data-sticky-checked-options class="jc-inline-block jc-mt-2">
          {{ product.selected_or_first_available_variant.title }}
        </span>
      </div>
    </div>

    <div class="jc-flex jc-gap-4 jc-w-full md:jc-w-auto">
      {%- # Price -%}
      {%- if root.settings.enable_price -%}
        <div class="jc-hidden md:jc-block">
          {%- render 'g-price-block',
            quantity_update: false,
            show_sale_badge: false,
            product_form_id: product_form_id,
            class: 'jc-gap-4 jc-text-3xl jc-leading-8'
          -%}
        </div>
      {%- endif -%}

      {%- # Atc button -%}
      {%- render 'g-button',
        text: add_to_cart_text,
        type: add_to_cart_type,
        button_attributes: add_to_cart_attributes,
        button_class: add_to_cart_class,
        display_price: root.settings.add_to_cart_display_price,
        icon: add_to_cart_icon,
        product_form_id: product_form_id
      -%}
    </div>
  </div>
</product-sticky-atc>
