{% comment %}
  Snippet: product-main-pack-selector

  Usage:
  {% render 'product-main-pack-selector', root: block %}
{% endcomment %}

<style>
  /* Step content visibility based on radio input state (inputs are inside each step) */
  pack-selector-component .pack-selector-step .step-content {
    display: none;
  }
  pack-selector-component .pack-selector-step input.step-toggle:checked ~ .step-content {
    display: block;
  }

  /* Arrow rotation based on radio input state */
  pack-selector-component .pack-selector-step input.step-toggle:checked + label .step-arrow {
    transform: rotate(180deg);
  }
  pack-selector-component .step-arrow {
    transform: rotate(0deg);
    transition: transform 0.3s ease;
  }

  pack-selector-component .js-product-option-card.selected {
    @apply jc-border-green-600 jc-bg-green-50;
  }

  pack-selector-component .js-product-option-card.selected .select-button {
    @apply jc-bg-green-600 jc-text-white jc-border-green-600;
  }
</style>

<pack-selector-component
  class="jc-block jc-w-full"
  data-max-flavors="{{ root.settings.max_flavors | default: 6 }}"
  data-min-flavors="{{ root.settings.min_flavors | default: 4 }}"
  data-text-summary-select-your-lio="{{ 'bundle_pack.summary_select_your_lio' | t }}"
  data-text-button-add-to-cart="{{ 'bundle_pack.button_add_to_cart' | t }}"
  data-text-button-adding-to-cart="{{ 'bundle_pack.button_adding_to_cart' | t }}"
>
  {%- # Step 1: Select Your Lio -%}
  {%- if root.settings.step_1_title != blank -%}
    <div class="pack-selector-step" data-step="1">
      <input type="radio" name="pack-step" id="step-1-toggle" class="jc-hidden step-toggle" checked>
      <label for="step-1-toggle" class="jc-flex jc-items-center jc-justify-between jc-cursor-pointer jc-mb-4">
        <div class="jc-flex jc-items-center jc-gap-2">
          <span class="jc-text-sm jc-font-bold jc-uppercase [&_strong]:jc-text-green-600">
            {{- root.settings.step_1_title -}}
          </span>
        </div>
        {% render 'g-render-icon', icon: 'chevron-down', class: 'jc-w-5 jc-h-5 jc-transition-transform step-arrow' %}
      </label>

      <div class="step-content" data-content="step-1">
        <div class="jc-grid jc-grid-cols-1 md:jc-grid-cols-3 jc-gap-4">
          {%- for product in root.settings.step_1_packs -%}
            <div
              class="
                js-product-option-card jc-border jc-border-gray-300 jc-rounded-lg jc-p-4 jc-cursor-pointer jc-transition-all hover:jc-border-green-600
                [&.selected]:jc-bg-green-600  [&.selected]:jc-border-green-600
              "
              data-product-id="{{ product.first_available_variant.id }}"
              data-step="1"
            >
              <div class="jc-aspect-square jc-relative jc-mb-3">
                {%- if product.featured_image -%}
                  {% render 'g-render-image',
                    class: 'jc-w-full jc-h-full jc-object-contain',
                    img_src: product.featured_image.url,
                    img: product.featured_image,
                    size: '220 300 400 500',
                    alt: product.title,
                    width: '100',
                    height: '100',
                    loading: 'lazy'
                  %}
                {%- endif -%}
                {%- if product.metafields.custom.badge_text -%}
                  <span class="jc-absolute jc-top-2 jc-right-2 jc-bg-orange-500 jc-text-white jc-text-xs jc-px-2 jc-py-1 jc-rounded">
                    {{ product.metafields.custom.badge_text }}
                  </span>
                {%- endif -%}
              </div>

              <h3 class="jc-text-sm jc-font-bold jc-mb-1 jc-uppercase">{{ product.title }}</h3>
              <p class="jc-text-xs jc-text-gray-600 jc-mb-3">
                {{ product.metafields.custom.subtitle | default: 'Premium wood' }}
              </p>

              <button
                class="jc-text-center jc-w-full jc-py-2 jc-border jc-border-black jc-rounded-full jc-text-sm jc-font-bold jc-uppercase jc-transition-all hover:jc-bg-black hover:jc-text-white select-button"
                data-action="select-pack"
              >
                {{ 'bundle_pack.button_select' | t }} | {{ product.price | money }}
              </button>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- # Step 2: Select Your Flavors -%}
  {%- if root.settings.step_2_title != blank -%}
    <div class="pack-selector-step jc-mt-6" data-step="2">
      <input type="radio" name="pack-step" id="step-2-toggle" class="jc-hidden step-toggle">
      <label for="step-2-toggle" class="jc-flex jc-items-center jc-justify-between jc-cursor-pointer jc-mb-4">
        <div class="jc-flex jc-items-center jc-gap-2">
          <span class="jc-text-sm jc-font-bold jc-uppercase [&_strong]:jc-text-green-600">
            {{- root.settings.step_2_title -}}
          </span>
        </div>
        {% render 'g-render-icon', icon: 'chevron-down', class: 'jc-w-5 jc-h-5 jc-transition-transform step-arrow' %}
      </label>

      <div class="step-content" data-content="step-2">
        <div class="jc-flex jc-items-center jc-justify-between jc-mb-3 jc-text-xs md:jc-text-sm">
          <div class="jc-flex jc-items-center jc-gap-2">
            <span class="jc-font-semibold jc-uppercase">{{ 'bundle_pack.selected_label' | t }}</span>
            <span
              ><span data-role="flavor-counter">0</span>/<span data-role="flavor-max">
                {{- root.settings.max_flavors | default: 6 -}}
              </span></span
            >
          </div>
        </div>

        <div class="jc-grid jc-grid-cols-2 lg:jc-grid-cols-3 jc-gap-4">
          {%- for product in root.settings.step_2_packs -%}
            <div
              class="
                js-product-option-card jc-border jc-border-gray-300 jc-rounded-lg jc-p-4 jc-transition-all hover:jc-border-green-600
                [&.selected]:jc-bg-green-600  [&.selected]:jc-border-green-600
              "
              data-product-id="{{ product.first_available_variant.id }}"
              data-step="2"
            >
              <div class="jc-aspect-square jc-relative jc-mb-3">
                {%- if product.featured_image -%}
                  {% render 'g-render-image',
                    class: 'jc-w-full jc-h-full jc-object-contain',
                    img_src: product.featured_image.url,
                    img: product.featured_image,
                    size: '220 300 400 500',
                    alt: product.title,
                    width: '100',
                    height: '100',
                    loading: 'lazy'
                  %}
                {%- endif -%}
              </div>
              <div class="js-trigger-popup">
                Trigger Popup
              </div>
              <h3 class="jc-text-xs jc-font-bold jc-text-center jc-uppercase jc-mb-2">{{ product.title }}</h3>

              <button
                class="js-select-button-step2 jc-text-center jc-w-full jc-py-2 jc-border jc-border-black jc-rounded-full jc-text-xs jc-font-bold jc-uppercase jc-transition-all hover:jc-bg-black hover:jc-text-white"
                data-action="select-step2"
              >
                {{ 'bundle_pack.button_select' | t }}
              </button>

              <div class="js-qty-control jc-hidden" data-product-id="{{ product.first_available_variant.id }}">
                <button
                  type="button"
                  class="js-btn-minus jc-btn jc-w-8 jc-h-8 jc-rounded-full jc-border jc-border-gray-300 jc-text-gray-700 jc-flex jc-items-center jc-justify-center"
                  aria-label="Decrease"
                >
                  -
                </button>
                <span class="js-qty-count jc-w-8 jc-text-center jc-font-semibold">0</span>
                <button
                  type="button"
                  class="js-btn-plus jc-btn jc-w-8 jc-h-8 jc-rounded-full jc-border jc-border-gray-300 jc-text-gray-700 jc-flex jc-items-center jc-justify-center"
                  aria-label="Increase"
                >
                  +
                </button>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- # Step 3: Select Accessories -%}
  {%- if root.settings.step_3_title != blank -%}
    <div class="pack-selector-step jc-mt-6" data-step="3">
      <input type="radio" name="pack-step" id="step-3-toggle" class="jc-hidden step-toggle">
      <label for="step-3-toggle" class="jc-flex jc-items-center jc-justify-between jc-cursor-pointer jc-mb-4">
        <div class="jc-flex jc-items-center jc-gap-2">
          <span class="jc-text-sm jc-font-bold jc-uppercase [&_strong]:jc-text-green-600">
            {{- root.settings.step_3_title -}}
          </span>
          <span class="jc-text-xs jc-text-gray-500">{{ 'bundle_pack.optional_label' | t }}</span>
        </div>
        {% render 'g-render-icon', icon: 'chevron-down', class: 'jc-w-5 jc-h-5 jc-transition-transform step-arrow' %}
      </label>

      <div class="step-content" data-content="step-3">
        <div class="jc-grid jc-grid-cols-1 md:jc-grid-cols-3 jc-gap-4">
          {%- for product in root.settings.step_3_packs -%}
            <div
              class="
                js-product-option-card jc-border jc-border-gray-300 jc-rounded-lg jc-p-4 jc-cursor-pointer jc-transition-all hover:jc-border-green-600
                [&.selected]:jc-bg-green-600  [&.selected]:jc-border-green-600
              "
              data-product-id="{{ product.first_available_variant.id }}"
              data-step="3"
            >
              <div class="jc-aspect-video jc-relative jc-mb-3">
                {%- if product.featured_image -%}
                  {% render 'g-render-image',
                    class: 'jc-w-full jc-h-full jc-object-cover jc-rounded',
                    img_src: product.featured_image.url,
                    img: product.featured_image,
                    size: '220 300 400 500',
                    alt: product.title,
                    width: '100',
                    height: '100',
                    loading: 'lazy'
                  %}
                {%- endif -%}
              </div>

              <h3 class="jc-text-sm jc-font-bold jc-mb-1">{{ product.title }}</h3>
              <p class="jc-text-xs jc-text-gray-600 jc-mb-3">{{ product.metafields.custom.description }}</p>

              <button
                class="jc-text-center jc-w-full jc-py-2 jc-border jc-border-black jc-rounded-full jc-text-sm jc-font-bold jc-uppercase jc-transition-all hover:jc-bg-black hover:jc-text-white select-button"
                data-action="select-accessory"
              >
                {{ 'bundle_pack.button_add' | t }} | {{ product.price | money }}
              </button>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- # Summary Button -%}
  <button
    class="
      jc-w-full jc-text-center jc-mt-8 jc-py-4 jc-bg-green-100 jc-text-green-800 jc-rounded-full jc-text-base jc-font-bold jc-uppercase
      jc-transition-all hover:jc-bg-green-200 disabled:jc-opacity-50 disabled:jc-cursor-not-allowed [&:not(:disabled)]:jc-bg-green-600
    "
    id="pack-selector-submit"
    disabled
  >
    {{ 'bundle_pack.summary_select_your_lio' | t }}
  </button>

</pack-selector-component>
