{{- 'ecom-tabs.css' | asset_url | stylesheet_tag: preload: true -}}

{% liquid 
   for block in section.blocks
    case block.type
        when 'included-tab'
            assign included_tabs = true
        when 'ingredient-tab'
            assign ingredient_tab = true
        when 'reviews-tab'
            assign reviews_tab = true
    endcase
   endfor
%}
<div class="ecom-tabs">
    <div class="ecom-tabs__header">
        {% if included_tabs %}
            <button type="button" class="ecom-tabs__button active" data-tab="included">Included</button>
        {% endif %}
        {% if ingredient_tab %}
            <button type="button" class="ecom-tabs__button" data-tab="ingredient">Ingredient</button>
        {% endif %}
        {% if reviews_tab %}
            <button type="button" class="ecom-tabs__button" data-tab="reviews">Reviews</button>
        {% endif %}
    </div>
  
    <div class="ecom-tabs__content">
        {% if included_tabs %}
            <!-- Included Tab -->
            <div class="ecom-tabs__tab active" id="included-tab">
                <div class="swiper included-swiper">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                            {% if block.type == 'included-tab' %}
                                <div class="swiper-slide {{ block.settings.class }}">
                                    <div class="product-item">
                                        <div class="product-item__image">
                                            <img src="{{ block.settings.image | image_url: width: 100 }}" alt="{{ block.settings.title }}" width="90" height="90">
                                            <div class="check-icon">
                                                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                    <g clip-path="url(#clip0_14041_491-{{forloop.index }})">
                                                    <mask id="mask0_14041_491-{{forloop.index }}" style="mask-type:luminance" maskUnits="userSpaceOnUse" x="0" y="0" width="22" height="22">
                                                    <path d="M11.0002 20.1668C12.2042 20.1683 13.3966 19.9319 14.5089 19.4711C15.6213 19.0104 16.6316 18.3343 17.4819 17.4819C18.3343 16.6316 19.0104 15.6213 19.4711 14.5089C19.9319 13.3966 20.1683 12.2042 20.1668 11.0002C20.1683 9.79617 19.9319 8.60374 19.4711 7.49139C19.0104 6.37905 18.3343 5.36871 17.4819 4.51842C16.6316 3.66599 15.6213 2.98998 14.5089 2.52921C13.3966 2.06845 12.2042 1.83202 11.0002 1.8335C9.79617 1.83202 8.60374 2.06845 7.49139 2.52921C6.37905 2.98998 5.36871 3.66599 4.51842 4.51842C3.66599 5.36871 2.98998 6.37905 2.52921 7.49139C2.06845 8.60374 1.83202 9.79617 1.8335 11.0002C1.83202 12.2042 2.06845 13.3966 2.52921 14.5089C2.98998 15.6213 3.66599 16.6316 4.51842 17.4819C5.36871 18.3343 6.37905 19.0104 7.49139 19.4711C8.60374 19.9319 9.79617 20.1683 11.0002 20.1668Z" fill="white" stroke="white" stroke-width="1.83333" stroke-linejoin="round"/>
                                                    <path d="M7.3335 10.9998L10.0835 13.7498L15.5835 8.24976" stroke="black" stroke-width="1.83333" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </mask>
                                                    <g mask="url(#mask0_14041_491-{{forloop.index }})">
                                                    <path d="M0 0H22V22H0V0Z" fill="#00B67C"/>
                                                    </g>
                                                    </g>
                                                    <defs>
                                                    <clipPath id="clip0_14041_491-{{forloop.index }}">
                                                    <rect width="22" height="22" fill="white"/>
                                                    </clipPath>
                                                    </defs>
                                                    </svg>
                                                    
                                            </div>
                                        </div>
                                        <h3>{{ block.settings.title }}</h3>
                                        <p>{{ block.settings.content }}</p>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                       
                    </div>
                    <div class="swiper-button-prev"><svg width="12" height="25" viewBox="0 0 12 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M1.84306 12.8476L7.50006 18.5046L8.91406 17.0906L3.96406 12.1406L8.91406 7.19061L7.50006 5.77661L1.84306 11.4336C1.65559 11.6211 1.55028 11.8754 1.55028 12.1406C1.55028 12.4058 1.65559 12.6601 1.84306 12.8476Z" fill="black"/>
                        </svg>
                        </div>
                    <div class="swiper-button-next"><svg width="12" height="25" viewBox="0 0 12 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M10.1569 12.8476L4.49994 18.5046L3.08594 17.0906L8.03594 12.1406L3.08594 7.19061L4.49994 5.77661L10.1569 11.4336C10.3444 11.6211 10.4497 11.8754 10.4497 12.1406C10.4497 12.4058 10.3444 12.6601 10.1569 12.8476Z" fill="black"/>
                        </svg>
                        </div>

                    <div class="swiper-scrollbar"></div>
                </div>
            </div>
        {% endif %}
        
        {% if ingredient_tab %}
            <!-- Ingredient Tab -->
            <div class="ecom-tabs__tab" id="ingredient-tab">
                <div class="ingredient-content">
                    {% for block in section.blocks %}
                        {% if block.type == 'ingredient-tab' %}
                            <div class="ingredient-icon">
                                <img src="{{ block.settings.image | image_url: width: 48 }}" alt="{{ block.settings.title }}" width="48" height="48">
                            </div>
                            <h3>{{ block.settings.title }}</h3>
                            <p>{{ block.settings.content }}</p>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        
        {% if reviews_tab %}
            <!-- Reviews Tab -->
            <div class="ecom-tabs__tab" id="reviews-tab">
                <div class="swiper reviews-swiper">
                    <div class="swiper-wrapper">
                        {% for block in section.blocks %}
                            {% if block.type == 'reviews-tab' %}
                                <div class="swiper-slide">
                                    <div class="review-item">
                                        <div class="rating">
                                            <svg height="25" width="134" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 96"><g fill="none"><g fill="#00b67a"><path d="M0 0h96v96H0zM104 0h96v96h-96zM208 0h96v96h-96zM312 0h96v96h-96zM416 0h96v96h-96z"/></g><path d="M48 64.7L62.6 61l6.1 18.8zm33.6-24.3H55.9L48 16.2l-7.9 24.2H14.4l20.8 15-7.9 24.2 20.8-15 12.8-9.2zM152 64.7l14.6-3.7 6.1 18.8zm33.6-24.3h-25.7L152 16.2l-7.9 24.2h-25.7l20.8 15-7.9 24.2 20.8-15 12.8-9.2zM256 64.7l14.6-3.7 6.1 18.8zm33.6-24.3h-25.7L256 16.2l-7.9 24.2h-25.7l20.8 15-7.9 24.2 20.8-15 12.8-9.2zM360 64.7l14.6-3.7 6.1 18.8zm33.6-24.3h-25.7L360 16.2l-7.9 24.2h-25.7l20.8 15-7.9 24.2 20.8-15 12.8-9.2zM464 64.7l14.6-3.7 6.1 18.8zm33.6-24.3h-25.7L464 16.2l-7.9 24.2h-25.7l20.8 15-7.9 24.2 20.8-15 12.8-9.2z" fill="#fff"/></g></svg>
                                        </div>
                                        <p class="review-text">"{{ block.settings.title }}"</p>
                                        <div class="reviewer">
                                            <p class="name"><strong>{{ block.settings.name }}</strong></p>
                                            <p class="age">Age: <strong>{{ block.settings.age }}</strong></p>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                       
                    </div>
                               
                    <div class="swiper-button-prev"><svg width="12" height="25" viewBox="0 0 12 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M1.84306 12.8476L7.50006 18.5046L8.91406 17.0906L3.96406 12.1406L8.91406 7.19061L7.50006 5.77661L1.84306 11.4336C1.65559 11.6211 1.55028 11.8754 1.55028 12.1406C1.55028 12.4058 1.65559 12.6601 1.84306 12.8476Z" fill="black"/>
                        </svg>
                        </div>
                    <div class="swiper-button-next"><svg width="12" height="25" viewBox="0 0 12 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M10.1569 12.8476L4.49994 18.5046L3.08594 17.0906L8.03594 12.1406L3.08594 7.19061L4.49994 5.77661L10.1569 11.4336C10.3444 11.6211 10.4497 11.8754 10.4497 12.1406C10.4497 12.4058 10.3444 12.6601 10.1569 12.8476Z" fill="black"/>
                        </svg>
                        </div>
                    <div class="swiper-scrollbar"></div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
  />
  
  <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Tab functionality
        const tabButtons = document.querySelectorAll('.ecom-tabs__button');
        const tabContents = document.querySelectorAll('.ecom-tabs__tab');

        tabButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                // Remove active class from all buttons and tabs
                tabButtons.forEach(btn => btn.classList.remove('active'));
                tabContents.forEach(tab => tab.classList.remove('active'));
                
                // Add active class to clicked button and corresponding tab
                button.classList.add('active');
                const tabId = button.getAttribute('data-tab') + '-tab';
                document.getElementById(tabId).classList.add('active');
                
                // Reinitialize swipers when tab becomes visible
                {% comment %} if (tabId === 'included-tab' || tabId === 'reviews-tab') {
                if (window.Swiper) {
                    setTimeout(() => {
                    swipers[tabId].update();
                    }, 10);
                }
                } {% endcomment %}
            });
        });
    
      
    let swiper_1 =  new Swiper('.included-swiper', {
        slidesPerView: 2,
        spaceBetween: 18,
        navigation: {
            nextEl: '.included-swiper .swiper-button-next',
            prevEl: '.included-swiper .swiper-button-prev',
        },
        scrollbar: {
            el: '.included-swiper .swiper-scrollbar',
        },
        breakpoints: {
            500: {
            slidesPerView: 3,
            },
        },
    });
      
    let swiper_2 = new Swiper('.reviews-swiper', {
        slidesPerView: 1.5,
        spaceBetween: 0,
        navigation: {
          nextEl: '.reviews-swiper .swiper-button-next',
          prevEl: '.reviews-swiper .swiper-button-prev',
        },
        breakpoints: {
          700: {
            slidesPerView: 2,
          },
        },
        scrollbar: {
          el: '.reviews-swiper .swiper-scrollbar',
        },
    });
    const targetNode = document.querySelector('.iFWeLOz14bGCGsDOM');
    if (targetNode) {
        const observer = new MutationObserver(function(mutations) {
            if (swiper_1) {
                swiper_1.update();
            }
        });
        
        observer.observe(targetNode, { 
            childList: true,
            subtree: true,
            attributes: true
        });
    }
});
</script>

