{% comment %}
  Snippet: Best Product Reviews
  Created by: Nazarii Prokopchuk

  Description:
  - This section displays a list of the best product reviews.
  - The reviews are retrieved from the product's metafields.

  Passed variables:
  - product: {Object} the product whose reviews are to be displayed

  Metafields:
  - jolly_meta.best_reviews: {Array} list of review items, each containing 'icon', 'title', and 'text'

  Metafield settings:
  - icon: {Image} icon image to display alongside the review
  - title: {Text} title of the review
  - text: {Richtext} content of the review

  Used snippets:
  - g-render-image

  Render example:
  {% render 'product-main-best-reviews', product: product %}
{% endcomment %}

{%- assign best_reviews = product.metafields.jolly_meta.best_reviews -%}

{% if best_reviews != blank %}
  <div class="jc-flex jc-flex-col jc-gap-8">
    {% for review in best_reviews.value %}
      <div class="jc-flex jc-flex-col jc-gap-2 jc-pl-4 jc-border-solid jc-border-black jc-border-0 jc-border-l-2">
        {% if review.icon != blank %}
          {% render 'g-render-image',
            class: 'jc-w-6 jc-h-6',
            img_src: review.icon.url,
            img: review.icon,
            alt: 'Image alt',
            width: '24',
            height: '24',
            loading: 'lazy'
          %}
        {% endif %}
        {% if review.title != blank %}
          <p class="jc-text-base jc-leading-6 jc-font-bold">{{ review.title }}</p>
        {% endif %}
        {% if review.text != blank %}
          <div data-richtext class="jc-text-base jc-leading-6">{{ review.text |  metafield_tag }}</div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endif %}
