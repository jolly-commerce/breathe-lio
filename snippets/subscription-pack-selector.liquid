<!-- Tabs: Subscribe vs One-time (no JS) -->
<style>
  /* Tab styling with :has() selector */
  .tab-container:has(#tab-subscribe:checked) .subscribe-label {
    background-color: #DAF7E9;
    border: 1px solid #004631;
    border-bottom: none;
  }
  .tab-container:has(#tab-onetime:checked) .onetime-label {
    background-color: #f4f4f4;
    border: 1px solid #004631;
    border-bottom: none;
  }
  .tab-container:has(#tab-onetime:checked) .jc-subscribe-benefits-description {
    background-color: #0000000D;
  }
  .tab-container:has(#tab-subscribe:checked) .subscribe-panel {
    display: block;
  }
  .tab-container:has(#tab-onetime:checked) .onetime-panel {
    display: block;
  }
  .tab-container:has(#tab-subscribe:checked) .onetime-panel {
    display: none;
  }
  .tab-container:has(#tab-onetime:checked) .subscribe-panel {
    display: none;
  }
</style>
{% if root.settings.subscribe_and_save_title != blank or root.settings.one_time_purchase_title != blank %}
  <fieldset class="tab-container">
    <!-- Radios -->
    <input id="tab-subscribe" type="radio" name="purchase_type" class="jc-sr-only" checked>
    <input id="tab-onetime" type="radio" name="purchase_type" class="jc-sr-only">

    <!-- Tab labels -->
    <div class="jc-flex jc-mt-6 -jc-mb-px">
      <!-- Subscribe -->
      {% if root.settings.subscribe_and_save_title != blank %}
        <label
          for="tab-subscribe"
          class="
            subscribe-label jc-relative jc-flex-1 jc-cursor-pointer jc-rounded-t-mxs
            jc-bg-transparent jc-text-britishRacingGreen jc-text-base jc-leading-5 jc-font-normal jc-font-sigumL jc-uppercase jc-text-center jc-py-3.5 jc-px-4 jc-z-10
          "
        >
          {{ root.settings.subscribe_and_save_title }}
          {% if root.settings.subscribe_and_save_subtitle != blank %}
            <div
              class="jc-absolute -jc-top-3 jc-inset-0"
            >
              <p class="jc-w-fit jc-mx-auto jc-bg-munsell jc-px-2 jc-py-1 jc-rounded-xxs jc-text-center jc-text-xxs jc-leading-3 jc-font-medium jc-font-poppins jc-text-white jc-uppercase">
                {{ root.settings.subscribe_and_save_subtitle }}
              </p>
            </div>
          {% endif %}
        </label>
      {% endif %}

      <!-- One-time -->
      {% if root.settings.one_time_purchase_title != blank %}
        <label
          for="tab-onetime"
          class="
            onetime-label jc-relative jc-flex-1 jc-cursor-pointer jc-rounded-t-mxs
            jc-bg-transparent jc-text-britishRacingGreen jc-text-base jc-leading-5 jc-font-normal jc-font-sigumL jc-uppercase jc-text-center jc-py-3.5 jc-px-4 jc-z-10
          "
        >
          {{ root.settings.one_time_purchase_title }}
        </label>
      {% endif %}
    </div>
    {%- capture benefits_features -%}
      <ul class="jc-grid jc-grid-cols-3 jc-gap-4 jc-px-4">
        {%- for i in (1..3) -%}
          {%- assign benefit_title = 'benefits_features_title_' | append: i -%}
          {%- assign benefit_image = 'benefits_features_image_' | append: i -%}
          {%- if root.settings[benefit_title] != blank -%}
            <li class="jc-flex jc-flex-col jc-items-center jc-gap-2">
              {% if root.settings[benefit_image] != blank %}
                {% render 'g-render-image',
                  class: 'jc-w-6 jc-h-6',
                  img_src: root.settings[benefit_image].url,
                  img: root.settings[benefit_image],
                  size: '40 60',
                  alt: '{{root.settings[benefit_title] }}',
                  width: '24',
                  height: '24',
                  loading: 'lazy'
                %}
              {% endif %}
              <div
                class="
                  [&_*]:!jc-leading-4 jc-font-normal jc-text-xs jc-font-poppins jc-text-britishRacingGreen jc-text-center
                  [&_strong]:jc-text-sm [&_strong]:jc-mb-1 [&_strong]:jc-block
                "
              >
                {{ root.settings[benefit_title] }}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {% if root.settings.subscribe_and_save_benefits_description != blank %}
        <div class="jc-subscribe-benefits-description jc-flex jc-items-center jc-justify-center jc-px-4 jc-py-3 jc-bg-munsell jc-bg-opacity-10 jc-gap-2 lg:jc-gap-4">
          <div class="jc-text-sm [&_*]:!jc-leading-5 jc-font-normal jc-font-poppins jc-text-britishRacingGreen">
            {{ root.settings.subscribe_and_save_benefits_description }}
          </div>
          {% if root.settings.subscribe_and_save_benefits_image != blank %}
            {% render 'g-render-image',
              class: 'jc-w-full jc-h-auto jc-max-w-25 lg:jc-max-w-32',
              img_src: root.settings.subscribe_and_save_benefits_image.url,
              img: root.settings.subscribe_and_save_benefits_image,
              size: '1000',
              alt: root.settings.subscribe_and_save_benefits_image.alt,
              loading: 'lazy'
            %}
          {% endif %}
        </div>
      {% endif %}
    {%- endcapture -%}
    <!-- Panels -->
    <div class="">
      <!-- SUBSCRIBE PANEL -->
      {% if root.settings.subscribe_and_save_title != blank %}
        <div
          class="
            subscribe-panel jc-pt-5 jc-hidden jc-space-y-4 jc-bg-azureishWhite jc-rounded-b-mxs jc-rounded-tr-mxs
            jc-border jc-border-britishRacingGreen
          "
        >
          {% if root.settings.subscribe_3_packs != blank or root.settings.subscribe_6_packs != blank %}
            <div class="jc-subscribe-packs-container">
              {% if root.settings.subscribe_3_packs != blank %}
                <div class="jc-subscribe-3-packs jc-text-sm [&_*]:!jc-leading-5 jc-font-normal jc-font-poppins jc-text-britishRacingGreen jc-text-center jc-hidden">
                  {{ root.settings.subscribe_3_packs }}
                </div>
              {% endif %}
              {% if root.settings.subscribe_6_packs != blank %}
                <div class="jc-subscribe-6-packs jc-text-sm [&_*]:!jc-leading-5 jc-font-normal jc-font-poppins jc-text-britishRacingGreen jc-text-center jc-hidden">
                  {{ root.settings.subscribe_6_packs }}
                </div>
              {% endif %}
            </div>
          {% endif %}
          {%- if root.settings.subscribe_and_save_description != blank -%}
            <div class="jc-text-3xl [&_*]:!jc-leading-8 jc-text-britishRacingGreen jc-font-normal jc-text-center jc-font-sigumL">
              {{ root.settings.subscribe_and_save_description }}
            </div>
          {%- endif -%}

          {% if benefits_features != blank %}
            {{ benefits_features }}
          {% endif %}
        </div>
      {% endif %}

      <!-- ONE-TIME PANEL -->
      {% if root.settings.one_time_purchase_title != blank %}
        <div
          class="
            onetime-panel jc-pt-5 jc-hidden jc-space-y-3 jc-bg-cultured jc-rounded-b-mxs jc-rounded-tl-mxs
            jc-border jc-border-britishRacingGreen [&_*]:jc-opacity-80
          "
        >
          {%- if root.settings.one_time_purchase_description != blank -%}
            <div class="jc-text-3xl [&_*]:!jc-leading-8 jc-text-britishRacingGreen jc-font-normal jc-text-center jc-font-sigumL">
              {{ root.settings.one_time_purchase_description }}
            </div>
          {%- endif -%}

          {% if benefits_features != blank %}
            {{ benefits_features }}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </fieldset>
{% endif %}
