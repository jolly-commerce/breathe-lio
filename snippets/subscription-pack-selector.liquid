<!-- Tabs: Subscribe vs One-time (no JS) -->
<style>
  /* Tab styling with :has() selector */
  .tab-container:has(#tab-subscribe:checked) .subscribe-label {
    background-color: #d1fae5;
    border: 1px solid #004631;
    border-bottom: none;
  }
  .tab-container:has(#tab-onetime:checked) .onetime-label {
    background-color: #f4f4f4;
    border: 1px solid #004631;
    border-bottom: none;
  }
  .tab-container:has(#tab-subscribe:checked) .subscribe-panel {
    display: block;
  }
  .tab-container:has(#tab-onetime:checked) .onetime-panel {
    display: block;
  }
  .tab-container:has(#tab-subscribe:checked) .onetime-panel {
    display: none;
  }
  .tab-container:has(#tab-onetime:checked) .subscribe-panel {
    display: none;
  }
</style>
{% if root.settings.subscribe_and_save_title != blank or root.settings.one_time_purchase_title != blank %}
  <fieldset class="tab-container">
    <!-- Radios -->
    <input id="tab-subscribe" type="radio" name="purchase_type" class="jc-sr-only" checked>
    <input id="tab-onetime" type="radio" name="purchase_type" class="jc-sr-only">

    <!-- Tab labels -->
    <div class="jc-flex jc-mt-6 -jc-mb-px">
      <!-- Subscribe -->
      {% if root.settings.subscribe_and_save_title != blank %}
        <label
          for="tab-subscribe"
          class="
            subscribe-label jc-relative jc-flex-1 jc-cursor-pointer jc-rounded-t-mxs
            jc-bg-transparent jc-text-britishRacingGreen jc-text-base jc-leading-xl jc-font-normal jc-font-sigumL jc-uppercase jc-text-center jc-py-3.5 jc-px-4
          "
        >
          {{ root.settings.subscribe_and_save_title }}
          {% if root.settings.subscribe_and_save_subtitle != blank %}
            <div
              class="
                jc-absolute -jc-top-3 jc-inset-0
                
              "
            >
              <p class="jc-w-fit jc-mx-auto jc-bg-munsell jc-px-2 jc-py-1 jc-rounded-xxs jc-text-center jc-text-xxs jc-leading-3 jc-font-normal jc-font-poppins jc-text-white jc-uppercase">
                {{ root.settings.subscribe_and_save_subtitle }}
              </p>
            </div>
          {% endif %}
        </label>
      {% endif %}

      <!-- One-time -->
      {% if root.settings.one_time_purchase_title != blank %}
        <label
          for="tab-onetime"
          class="
            onetime-label jc-relative jc-flex-1 jc-cursor-pointer jc-rounded-t-mxs
            jc-bg-transparent jc-text-britishRacingGreen jc-text-base jc-leading-xl jc-font-normal jc-font-sigumL jc-uppercase jc-text-center jc-py-3.5 jc-px-4
          "
        >
          {{ root.settings.one_time_purchase_title }}
        </label>
      {% endif %}
    </div>

    <!-- Panels -->
    <div class="">
      <!-- SUBSCRIBE PANEL -->
      {% if root.settings.subscribe_and_save_title != blank %}
        <div class="subscribe-panel jc-p-4 jc-pb-6 jc-hidden jc-space-y-3 jc-bg-green-100 jc-rounded-b-mxs jc-rounded-tr-mxs
          jc-border jc-border-britishRacingGreen">
          {%- if root.settings.subscribe_and_save_description != blank -%}
            <div class="jc-text-sm jc-leading-5 jc-text-britishRacingGreen jc-font-poppins jc-font-normal">
              {{ root.settings.subscribe_and_save_description }}
            </div>
          {%- endif -%}
          <div class="jc-flex jc-items-center jc-justify-between jc-w-full">
            {%- if root.settings.subscribe_and_save_benefits_title != blank -%}
              <p class="jc-font-semibold jc-font-poppins jc-text-sm jc-leading-5 jc-text-britishRacingGreen">
                {{ root.settings.subscribe_and_save_benefits_title }}
              </p>
            {%- endif -%}
            <div class="jc-flex jc-items-end jc-gap-2.5 jc-justify-end">
              <span class="jc-text-xs jc-leading-4 jc-line-through jc-font-medium jc-opacity-50">€30</span>
              <span class="jc-font-semibold jc-text-base jc-leading-5 jc-text-britishRacingGreen">€21</span>
            </div>
          </div>

          <ul class="jc-grid jc-grid-cols-1 md:jc-grid-cols-2 jc-gap-2.5">
            {%- for i in (1..4) -%}
              {%- assign benefit_title = 'benefits_features_title_' | append: i -%}
              {%- if root.settings[benefit_title] != blank -%}
                <li class="jc-flex jc-items-center jc-gap-2">
                  {% render 'g-render-icon', icon: 'fat-check', class: 'jc-w-5 jc-h-5' %}
                  <p class="jc-text-sm jc-leading-5 jc-font-medium jc-font-poppins jc-text-britishRacingGreen jc-opacity-80">
                    {{ root.settings[benefit_title] }}
                  </p>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {% endif %}

      <!-- ONE-TIME PANEL -->
      {% if root.settings.one_time_purchase_title != blank %}
        <div class="onetime-panel jc-p-4 jc-pb-6 jc-hidden jc-space-y-3 jc-bg-cultured jc-rounded-b-mxs jc-rounded-tl-mxs
          jc-border jc-border-britishRacingGreen">
          {%- if root.settings.one_time_purchase_description != blank -%}
            <div class="jc-text-sm jc-leading-5 jc-text-britishRacingGreen jc-font-poppins jc-font-normal">
              {{ root.settings.one_time_purchase_description }}
            </div>
          {%- endif -%}

          <div class="jc-flex jc-items-center jc-justify-between jc-w-full">
            {%- if root.settings.one_time_purchase_benefits_title != blank -%}
              <p class="jc-font-semibold jc-font-poppins jc-text-sm jc-leading-5 jc-text-britishRacingGreen">
                {{ root.settings.one_time_purchase_benefits_title }}
              </p>
            {%- endif -%}
            <div class="jc-flex jc-items-end jc-gap-2.5 jc-justify-end">
              <span class="jc-font-semibold jc-text-base jc-leading-5 jc-text-britishRacingGreen">€30</span>
            </div>
          </div>

          <ul class="jc-grid jc-grid-cols-1 md:jc-grid-cols-2 jc-gap-2.5">
            {%- for i in (1..4) -%}
              {%- assign benefit_title = 'benefits_features_title_' | append: i -%}
              {%- if root.settings[benefit_title] != blank -%}
                <li class="jc-flex jc-items-center jc-gap-2">
                  {% render 'g-render-icon', icon: 'fat-uncheck', class: 'jc-w-5 jc-h-5' %}
                  <p class="jc-line-through jc-text-sm jc-leading-5 jc-font-medium jc-font-poppins jc-text-britishRacingGreen jc-opacity-80">
                    {{ root.settings[benefit_title] }}
                  </p>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {% endif %}
    </div>
  </fieldset>
{% endif %}
