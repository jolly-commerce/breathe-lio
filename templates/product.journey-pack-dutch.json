        "text_HOx7Tq8lW8gC2Wtg": "<p>\"I was looking for a healthier way to quit smoking, and I found it\"</p>",
        "text_c7KGAD86cCEIxalJ": "<p><strong>Charlotte Revier</strong></p>",
        "text_Qg7bgvIozepEgl3N": "<p>Age: <strong>36</strong></p>",
