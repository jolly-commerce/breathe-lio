        "text_0Mvmys9qqZzxZDIr": "<h3>Samen Premium</h3>",
        "text_TVAuX71ity1gqv4U": "<p>1 Zilver + 1 Zwart Diffuser</p><p>120 Days (36 Cores)</p>",
