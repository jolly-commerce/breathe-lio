{% comment %}
  BreatheLio vs Füm — Comparison Landing Page
  Usage: Create a new page template in your Shopify theme and include this section,
         or paste into a custom Liquid section/template.
  
  Requires: 
  - Theme settings or section settings for logo images (see schema at bottom)
  - Google Fonts: DM Serif Display + Outfit (loaded via preconnect)
{% endcomment %}

{% style %}
:root {
  --lio-dark: #0a1a14;
  --lio-forest: #1a3a2a;
  --lio-green: #2d6a4f;
  --lio-mint: #52b788;
  --lio-light-mint: #b7e4c7;
  --lio-cream: #f0f5f1;
  --lio-white: #ffffff;
  --lio-gold: #c9a84c;
  --lio-warm: #faf8f5;
  --fum-yellow: #e8e07a;
  --fum-dark: #2d3328;
  --text-primary: #0a1a14;
  --text-secondary: #3d5a4a;
  --text-muted: #7a9988;
  --font-display: 'DM Serif Display', Georgia, serif;
  --font-body: 'Outfit', -apple-system, sans-serif;
  --radius: 16px;
  --radius-sm: 10px;
  --shadow-sm: 0 2px 8px rgba(10,26,20,0.06);
  --shadow-md: 0 8px 32px rgba(10,26,20,0.08);
  --shadow-lg: 0 16px 64px rgba(10,26,20,0.12);
  --shadow-glow: 0 0 40px rgba(82,183,136,0.15);
}

*, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; font-size:16px; }
body { font-family:var(--font-body); color:var(--text-primary); background:var(--lio-warm); line-height:1.7; overflow-x:hidden; -webkit-font-smoothing:antialiased; }

/* === ANIMATIONS === */
@keyframes fadeUp { from { opacity:0; transform:translateY(30px); } to { opacity:1; transform:translateY(0); } }
@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
@keyframes shimmer { 0% { background-position:-200% center; } 100% { background-position:200% center; } }
@keyframes pulse { 0%,100% { transform:scale(1); } 50% { transform:scale(1.05); } }
@keyframes float { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }
@keyframes breathe { 0%,100% { opacity:0.4; } 50% { opacity:0.8; } }

.fade-up { opacity:0; animation:fadeUp 0.8s ease forwards; }
.fade-up-d1 { animation-delay:0.1s; }
.fade-up-d2 { animation-delay:0.2s; }
.fade-up-d3 { animation-delay:0.3s; }
.fade-up-d4 { animation-delay:0.4s; }
.fade-up-d5 { animation-delay:0.5s; }

/* === LAYOUT === */
.comparison-container { max-width:1140px; margin:0 auto; padding:0 24px; }
.comparison-section { padding:100px 0; }

/* === NAV === */
.comparison-nav { position:fixed; top:0; left:0; right:0; z-index:100; background:rgba(250,248,245,0.85); backdrop-filter:blur(20px) saturate(180%); border-bottom:1px solid rgba(10,26,20,0.06); transition:all 0.3s; }
.comparison-nav-inner { display:flex; align-items:center; justify-content:space-between; padding:14px 24px; max-width:1140px; margin:0 auto; }
.comparison-nav-logo { height:36px; border-radius:6px; }
.comparison-nav-cta { display:inline-flex; align-items:center; gap:8px; padding:10px 24px; background:var(--lio-green); color:#fff; border-radius:50px; font-weight:600; font-size:0.88rem; text-decoration:none; transition:all 0.3s; letter-spacing:0.02em; }
.comparison-nav-cta:hover { background:var(--lio-forest); transform:translateY(-1px); box-shadow:var(--shadow-md); }

/* === HERO === */
.comparison-hero { position:relative; padding:160px 0 100px; background:linear-gradient(170deg, var(--lio-dark) 0%, var(--lio-forest) 50%, var(--lio-green) 100%); color:#fff; overflow:hidden; }
.comparison-hero::before { content:''; position:absolute; top:-50%; right:-20%; width:80%; height:200%; background:radial-gradient(ellipse, rgba(82,183,136,0.12) 0%, transparent 70%); pointer-events:none; animation:breathe 6s ease-in-out infinite; }
.comparison-hero::after { content:''; position:absolute; bottom:0; left:0; right:0; height:120px; background:linear-gradient(to bottom, transparent, var(--lio-warm)); pointer-events:none; }
.comparison-hero-badge { display:inline-flex; align-items:center; gap:8px; padding:8px 18px; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15); border-radius:50px; font-size:0.82rem; font-weight:500; letter-spacing:0.04em; text-transform:uppercase; margin-bottom:28px; backdrop-filter:blur(10px); }
.comparison-hero-badge-dot { width:6px; height:6px; background:#52b788; border-radius:50%; animation:pulse 2s infinite; }
.comparison-hero h1 { font-family:var(--font-display); font-size:clamp(2.6rem, 5.5vw, 4.2rem); line-height:1.12; font-weight:400; margin-bottom:24px; max-width:780px; }
.comparison-hero h1 em { font-style:italic; color:var(--lio-light-mint); }
.comparison-hero-sub { font-size:1.15rem; line-height:1.7; color:rgba(255,255,255,0.78); max-width:560px; margin-bottom:40px; font-weight:300; }
.comparison-hero-logos { display:flex; align-items:center; gap:20px; margin-bottom:44px; }
.comparison-hero-logo-box { width:70px; height:70px; border-radius:14px; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.comparison-hero-logo-box.lio { background:var(--lio-dark); border:2px solid rgba(82,183,136,0.4); }
.comparison-hero-logo-box.fum { background:var(--fum-yellow); border:2px solid rgba(255,255,255,0.15); }
.comparison-hero-logo-box img { height:38px; width:auto; }
.comparison-hero-vs { font-family:var(--font-display); font-size:1.4rem; color:var(--lio-mint); font-style:italic; }
.comparison-hero-ctas { display:flex; gap:16px; flex-wrap:wrap; }
.comparison-btn-primary { display:inline-flex; align-items:center; gap:10px; padding:16px 36px; background:var(--lio-mint); color:var(--lio-dark); font-weight:600; font-size:1rem; border-radius:50px; text-decoration:none; transition:all 0.35s cubic-bezier(0.4,0,0.2,1); letter-spacing:0.01em; border:none; cursor:pointer; }
.comparison-btn-primary:hover { background:#fff; transform:translateY(-2px); box-shadow:0 12px 40px rgba(82,183,136,0.3); }
.comparison-btn-secondary { display:inline-flex; align-items:center; gap:10px; padding:16px 36px; background:transparent; color:#fff; font-weight:500; font-size:1rem; border-radius:50px; text-decoration:none; transition:all 0.3s; border:1.5px solid rgba(255,255,255,0.25); cursor:pointer; }
.comparison-btn-secondary:hover { border-color:rgba(255,255,255,0.5); background:rgba(255,255,255,0.05); }
.comparison-hero-trust { display:flex; gap:32px; margin-top:48px; padding-top:32px; border-top:1px solid rgba(255,255,255,0.1); }
.comparison-hero-trust-item { display:flex; flex-direction:column; }
.comparison-hero-trust-num { font-family:var(--font-display); font-size:1.6rem; color:var(--lio-mint); }
.comparison-hero-trust-label { font-size:0.78rem; color:rgba(255,255,255,0.5); text-transform:uppercase; letter-spacing:0.06em; font-weight:500; }

/* === TLDR === */
.comparison-tldr { background:var(--lio-white); border-radius:var(--radius); padding:48px; box-shadow:var(--shadow-md); border:1px solid rgba(10,26,20,0.04); margin-top:-60px; position:relative; z-index:10; }
.comparison-tldr-label { font-size:0.75rem; font-weight:600; text-transform:uppercase; letter-spacing:0.1em; color:var(--lio-mint); margin-bottom:16px; }
.comparison-tldr-title { font-family:var(--font-display); font-size:1.8rem; margin-bottom:16px; color:var(--text-primary); }
.comparison-tldr-desc { color:var(--text-secondary); font-size:1.02rem; line-height:1.8; margin-bottom:32px; max-width:700px; }
.comparison-tldr-grid { display:grid; grid-template-columns:1fr 1fr; gap:32px; }
.comparison-tldr-col { padding:28px; border-radius:var(--radius-sm); }
.comparison-tldr-col.lio-col { background:linear-gradient(135deg, rgba(82,183,136,0.06), rgba(45,106,79,0.04)); border:1px solid rgba(82,183,136,0.15); }
.comparison-tldr-col.fum-col { background:rgba(232,224,122,0.08); border:1px solid rgba(232,224,122,0.2); }
.comparison-tldr-col-header { display:flex; align-items:center; gap:10px; margin-bottom:18px; font-weight:600; font-size:0.95rem; }
.comparison-tldr-col-logo { height:22px; border-radius:4px; }
.comparison-tldr-check { color:var(--lio-green); margin-right:8px; font-weight:700; }
.comparison-tldr-item { padding:6px 0; font-size:0.94rem; color:var(--text-secondary); line-height:1.6; }

/* === COMPARISON MATRIX === */
.comparison-matrix-section { background:var(--lio-cream); }
.comparison-section-label { font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:var(--lio-mint); margin-bottom:12px; text-align:center; }
.comparison-section-title { font-family:var(--font-display); font-size:clamp(1.8rem, 3.5vw, 2.6rem); text-align:center; margin-bottom:12px; color:var(--text-primary); }
.comparison-section-sub { text-align:center; color:var(--text-secondary); font-size:1.02rem; max-width:580px; margin:0 auto 52px; font-weight:300; }
.comparison-matrix-table { width:100%; border-collapse:separate; border-spacing:0; background:var(--lio-white); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow-md); border:1px solid rgba(10,26,20,0.04); }
.comparison-matrix-table thead th { padding:24px 20px; font-size:0.82rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; text-align:center; border-bottom:2px solid var(--lio-cream); }
.comparison-matrix-table thead th:first-child { text-align:left; width:36%; color:var(--text-muted); }
.comparison-matrix-table thead th.lio-head { color:var(--lio-green); background:linear-gradient(to bottom, rgba(82,183,136,0.06), transparent); }
.comparison-matrix-table thead th.fum-head { color:var(--fum-dark); }
.comparison-matrix-table thead th .th-logo { height:20px; margin-right:6px; vertical-align:middle; border-radius:3px; }
.comparison-matrix-table tbody tr { transition:background 0.2s; }
.comparison-matrix-table tbody tr:hover { background:rgba(82,183,136,0.02); }
.comparison-matrix-table tbody td { padding:18px 20px; border-bottom:1px solid var(--lio-cream); text-align:center; font-size:0.94rem; color:var(--text-secondary); }
.comparison-matrix-table tbody td:first-child { text-align:left; font-weight:500; color:var(--text-primary); font-size:0.92rem; }
.comparison-matrix-table tbody td.lio-cell { background:rgba(82,183,136,0.02); }
.comparison-check-yes { color:var(--lio-green); font-weight:700; font-size:1.1rem; }
.comparison-check-no { color:#d4645c; font-weight:700; font-size:1.1rem; }
.comparison-check-partial { color:var(--lio-gold); font-weight:600; font-size:0.85rem; }
.comparison-winner-row td { background:rgba(82,183,136,0.06) !important; }
.comparison-winner-row td:first-child { position:relative; }
.comparison-winner-badge { display:inline-block; padding:2px 8px; background:var(--lio-mint); color:#fff; font-size:0.65rem; font-weight:700; border-radius:4px; text-transform:uppercase; letter-spacing:0.06em; margin-left:8px; vertical-align:middle; }

/* === DEEP DIVE === */
.comparison-deep-dive-card { background:var(--lio-white); border-radius:var(--radius); padding:48px; margin-bottom:28px; box-shadow:var(--shadow-sm); border:1px solid rgba(10,26,20,0.04); transition:all 0.3s; }
.comparison-deep-dive-card:hover { box-shadow:var(--shadow-md); }
.comparison-dd-icon { font-size:1.6rem; margin-bottom:14px; }
.comparison-dd-title { font-family:var(--font-display); font-size:1.5rem; margin-bottom:20px; color:var(--text-primary); }
.comparison-dd-grid { display:grid; grid-template-columns:1fr 1fr; gap:32px; margin-bottom:24px; }
.comparison-dd-block { padding:20px; border-radius:var(--radius-sm); }
.comparison-dd-block.lio-block { background:linear-gradient(135deg, rgba(82,183,136,0.05), rgba(45,106,79,0.03)); border-left:3px solid var(--lio-mint); }
.comparison-dd-block.fum-block { background:rgba(232,224,122,0.06); border-left:3px solid var(--fum-yellow); }
.comparison-dd-block-label { font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:0.08em; color:var(--text-muted); margin-bottom:8px; }
.comparison-dd-block p { font-size:0.94rem; color:var(--text-secondary); line-height:1.7; }
.comparison-dd-verdict { padding:18px 24px; background:var(--lio-cream); border-radius:var(--radius-sm); font-size:0.92rem; color:var(--text-primary); }
.comparison-dd-verdict strong { color:var(--lio-green); }
.comparison-dd-quote { margin-top:24px; padding:24px; background:var(--lio-cream); border-radius:var(--radius-sm); border-left:3px solid var(--lio-mint); font-style:italic; color:var(--text-secondary); font-size:0.95rem; line-height:1.7; }
.comparison-dd-quote cite { display:block; margin-top:10px; font-style:normal; font-weight:600; font-size:0.82rem; color:var(--text-primary); }

/* === SWITCHING STORY === */
.comparison-switch-section { background:linear-gradient(170deg, var(--lio-dark), var(--lio-forest)); color:#fff; position:relative; overflow:hidden; }
.comparison-switch-section::before { content:''; position:absolute; top:0; right:0; width:50%; height:100%; background:radial-gradient(ellipse at top right, rgba(82,183,136,0.1), transparent 70%); }
.comparison-switch-card { max-width:740px; margin:0 auto; text-align:center; position:relative; z-index:2; }
.comparison-switch-label { font-size:0.72rem; font-weight:600; text-transform:uppercase; letter-spacing:0.12em; color:var(--lio-mint); margin-bottom:16px; }
.comparison-switch-title { font-family:var(--font-display); font-size:clamp(1.6rem, 3vw, 2.2rem); margin-bottom:28px; line-height:1.3; }
.comparison-switch-quote { font-size:1.15rem; line-height:1.8; color:rgba(255,255,255,0.8); font-style:italic; margin-bottom:28px; }
.comparison-switch-author { font-weight:600; font-size:0.92rem; color:var(--lio-mint); }
.comparison-switch-author span { display:block; font-weight:400; font-size:0.82rem; color:rgba(255,255,255,0.5); margin-top:4px; }
.comparison-switch-stats { display:grid; grid-template-columns:repeat(3, 1fr); gap:24px; margin-top:44px; padding-top:36px; border-top:1px solid rgba(255,255,255,0.1); }
.comparison-switch-stat-num { font-family:var(--font-display); font-size:2rem; color:var(--lio-mint); }
.comparison-switch-stat-label { font-size:0.78rem; color:rgba(255,255,255,0.5); text-transform:uppercase; letter-spacing:0.06em; margin-top:4px; }

/* === PRICING === */
.comparison-pricing-grid { display:grid; grid-template-columns:1fr 1fr; gap:28px; max-width:860px; margin:0 auto; }
.comparison-pricing-card { background:var(--lio-white); border-radius:var(--radius); padding:40px; box-shadow:var(--shadow-sm); border:1px solid rgba(10,26,20,0.04); position:relative; transition:all 0.3s; }
.comparison-pricing-card:hover { box-shadow:var(--shadow-md); }
.comparison-pricing-card.featured { border:2px solid var(--lio-mint); box-shadow:var(--shadow-glow); }
.comparison-pricing-card.featured::before { content:'BETTER VALUE'; position:absolute; top:-12px; left:50%; transform:translateX(-50%); padding:4px 18px; background:var(--lio-mint); color:#fff; font-size:0.68rem; font-weight:700; border-radius:50px; letter-spacing:0.08em; }
.comparison-pricing-logo { height:28px; margin-bottom:16px; border-radius:5px; }
.comparison-pricing-name { font-family:var(--font-display); font-size:1.3rem; margin-bottom:6px; }
.comparison-pricing-tagline { font-size:0.85rem; color:var(--text-muted); margin-bottom:24px; }
.comparison-pricing-price { font-family:var(--font-display); font-size:2.4rem; color:var(--text-primary); margin-bottom:4px; }
.comparison-pricing-price span { font-size:0.9rem; font-weight:400; color:var(--text-muted); font-family:var(--font-body); }
.comparison-pricing-note { font-size:0.8rem; color:var(--text-muted); margin-bottom:24px; }
.comparison-pricing-features { list-style:none; margin-bottom:28px; }
.comparison-pricing-features li { padding:8px 0; font-size:0.9rem; color:var(--text-secondary); display:flex; align-items:flex-start; gap:10px; }
.comparison-pricing-features li::before { content:'✓'; color:var(--lio-green); font-weight:700; flex-shrink:0; margin-top:1px; }
.comparison-pricing-card.competitor .comparison-pricing-features li::before { content:'~'; color:var(--text-muted); }

/* === FAQ === */
.comparison-faq-item { background:var(--lio-white); border-radius:var(--radius-sm); margin-bottom:12px; border:1px solid rgba(10,26,20,0.04); overflow:hidden; transition:all 0.3s; }
.comparison-faq-item:hover { border-color:rgba(82,183,136,0.2); }
.comparison-faq-q { padding:22px 28px; cursor:pointer; display:flex; justify-content:space-between; align-items:center; font-weight:500; font-size:0.96rem; color:var(--text-primary); user-select:none; }
.comparison-faq-q::after { content:'+'; font-size:1.4rem; color:var(--lio-mint); font-weight:300; transition:transform 0.3s; }
.comparison-faq-item.open .comparison-faq-q::after { content:'−'; }
.comparison-faq-a { max-height:0; overflow:hidden; transition:max-height 0.4s ease, padding 0.3s; }
.comparison-faq-item.open .comparison-faq-a { max-height:400px; }
.comparison-faq-a-inner { padding:0 28px 22px; font-size:0.92rem; color:var(--text-secondary); line-height:1.7; }

/* === FINAL CTA === */
.comparison-final-cta { background:linear-gradient(170deg, var(--lio-green), var(--lio-forest)); color:#fff; text-align:center; position:relative; overflow:hidden; }
.comparison-final-cta::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at center, rgba(183,228,199,0.08), transparent 60%); }
.comparison-final-cta .comparison-container { position:relative; z-index:2; }
.comparison-final-cta-title { font-family:var(--font-display); font-size:clamp(2rem, 4vw, 3rem); margin-bottom:18px; line-height:1.2; }
.comparison-final-cta-sub { font-size:1.08rem; color:rgba(255,255,255,0.75); max-width:520px; margin:0 auto 36px; font-weight:300; }
.comparison-final-cta .comparison-btn-primary { font-size:1.1rem; padding:18px 44px; }
.comparison-final-trust { display:flex; justify-content:center; gap:32px; margin-top:36px; font-size:0.82rem; color:rgba(255,255,255,0.5); }
.comparison-final-trust span { display:flex; align-items:center; gap:6px; }

/* === FOOTER === */
.comparison-footer { padding:40px 0; background:var(--lio-dark); color:rgba(255,255,255,0.4); text-align:center; font-size:0.8rem; }
.comparison-footer a { color:var(--lio-mint); text-decoration:none; }

/* === RESPONSIVE === */
@media (max-width:768px) {
  .comparison-section { padding:64px 0; }
  .comparison-hero { padding:120px 0 80px; }
  .comparison-tldr { padding:28px; margin-top:-40px; }
  .comparison-tldr-grid { grid-template-columns:1fr; }
  .comparison-dd-grid { grid-template-columns:1fr; }
  .comparison-pricing-grid { grid-template-columns:1fr; }
  .comparison-switch-stats { grid-template-columns:1fr; gap:16px; }
  .comparison-hero-trust { flex-direction:column; gap:16px; }
  .comparison-hero-logos { gap:14px; }
  .comparison-hero-ctas { flex-direction:column; }
  .comparison-hero-ctas a { text-align:center; justify-content:center; }
  .comparison-final-trust { flex-direction:column; align-items:center; gap:12px; }
  .comparison-matrix-wrapper { overflow-x:auto; -webkit-overflow-scrolling:touch; }
  .comparison-matrix-table { min-width:600px; }
  .comparison-nav-cta { padding:8px 18px; font-size:0.82rem; }
}
{% endstyle %}

{% comment %} ========== SETTINGS / VARIABLES ========== {% endcomment %}

{%- assign lio_url = section.settings.lio_url | default: 'https://breathelio.com/' -%}
{%- assign lio_logo = section.settings.lio_logo | default: blank -%}
{%- assign fum_logo = section.settings.fum_logo | default: blank -%}

{% comment %} ========== NAV ========== {% endcomment %}

<nav class="comparison-nav">
  <div class="comparison-nav-inner">
    {% if lio_logo != blank %}
      {{ lio_logo | image_url: width: 180 | image_tag: class: 'comparison-nav-logo', alt: 'BreatheLio' }}
    {% else %}
      <span style="font-family:var(--font-display);font-size:1.2rem;color:var(--lio-green);">BreatheLio</span>
    {% endif %}
    <a href="{{ lio_url }}" class="comparison-nav-cta">Try BreatheLio →</a>
  </div>
</nav>

{% comment %} ========== HERO ========== {% endcomment %}

<section class="comparison-hero">
  <div class="comparison-container">
    <div class="comparison-hero-badge fade-up">
      <span class="comparison-hero-badge-dot"></span> Honest Comparison · Updated {{ 'now' | date: '%Y' }}
    </div>

    <div class="comparison-hero-logos fade-up fade-up-d1">
      <div class="comparison-hero-logo-box lio">
        {% if lio_logo != blank %}
          {{ lio_logo | image_url: width: 120 | image_tag: alt: 'BreatheLio logo' }}
        {% else %}
          <span style="color:var(--lio-mint);font-family:var(--font-display);font-size:0.9rem;">BL</span>
        {% endif %}
      </div>
      <span class="comparison-hero-vs">vs</span>
      <div class="comparison-hero-logo-box fum">
        {% if fum_logo != blank %}
          {{ fum_logo | image_url: width: 120 | image_tag: alt: 'Füm logo' }}
        {% else %}
          <span style="color:var(--fum-dark);font-family:var(--font-display);font-size:0.9rem;">Füm</span>
        {% endif %}
      </div>
    </div>

    <h1 class="fade-up fade-up-d2">BreatheLio vs Füm:<br><em>A Cleaner Way to Breathe</em></h1>
    <p class="comparison-hero-sub fade-up fade-up-d3">You're looking for the best natural aromatherapy inhaler. We get it. Here's an honest, side-by-side look at how BreatheLio and Füm compare — so you can make the right choice for your wellness journey.</p>

    <div class="comparison-hero-ctas fade-up fade-up-d4">
      <a href="{{ lio_url }}" class="comparison-btn-primary">Shop BreatheLio Now ↗</a>
      <a href="#comparison" class="comparison-btn-secondary">See Full Comparison ↓</a>
    </div>

    <div class="comparison-hero-trust fade-up fade-up-d5">
      <div class="comparison-hero-trust-item">
        <span class="comparison-hero-trust-num">4.8★</span>
        <span class="comparison-hero-trust-label">Customer Rating</span>
