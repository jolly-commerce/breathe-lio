<body>

<div class="announcement">
  <strong>40% OFF FOREVER</strong> · Free Lio Plus device with every order
</div>

<div class="topbar">
  <div class="topbar-logo">Lio</div>
  <div class="topbar-right">
    <span class="topbar-secure">30 sec · 3 questions</span>
  </div>
</div>

<div class="progress">
  <div class="progress-row">
    <span>Step <strong id="stepNum">1</strong> of 3</span>
    <span><strong id="stepPct">33%</strong> complete</span>
  </div>
  <div class="progress-track">
    <div class="progress-fill" id="progressFill" style="width: 33%"></div>
  </div>
</div>

<main class="stage">

  <!-- STEP 1 — URGE FREQUENCY -->
  <section class="step is-active" data-step="1">
    <h2 class="step-h">How often do you smoke or vape?</h2>
    <p class="step-sub">Quick check — we'll match you to the right Lio plan in 30 seconds.</p>

    <div class="options" data-question="frequency">
      <button class="option" data-value="constant">
        <span class="option-emoji">🔥</span>
        <span class="option-body">
          <span class="option-label">All the time</span>
          <span class="option-hint">More than 10 times a day</span>
        </span>
        <span class="option-radio"></span>
      </button>
      <button class="option" data-value="often">
        <span class="option-emoji">⚡</span>
        <span class="option-body">
          <span class="option-label">Often</span>
          <span class="option-hint">5–10 times a day</span>
        </span>
        <span class="option-radio"></span>
      </button>
      <button class="option" data-value="sometimes">
        <span class="option-emoji">🌱</span>
        <span class="option-body">
          <span class="option-label">Sometimes</span>
          <span class="option-hint">A few times a day</span>
        </span>
        <span class="option-radio"></span>
      </button>
      <button class="option" data-value="rarely">
        <span class="option-emoji">🍃</span>
        <span class="option-body">
          <span class="option-label">Rarely</span>
          <span class="option-hint">Once a day or less</span>
        </span>
        <span class="option-radio"></span>
      </button>
    </div>

    <div class="cta-row">
      <button class="cta" id="next1" disabled>
        Continue
        <svg class="cta-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="16" height="16">
          <path d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </section>

  <!-- STEP 2 — TRIGGER TIMING -->
  <section class="step" data-step="2">
    <h2 class="step-h">When do you crave it most?</h2>
    <p class="step-sub">Pick the strongest moment — it tells us when you'll reach for Lio.</p>

    <div class="options" data-question="trigger">
