  <div class="sticky-cta-info">
    <div class="sticky-cta-price-row">
      <span class="sticky-cta-compare" id="stickyCompare">€49</span>
      <span class="sticky-cta-price" id="stickyPrice">€29</span>
      <span class="sticky-cta-meta" id="stickyCadence" style="font-size: 11px;">/month</span>
    </div>
    <div class="sticky-cta-meta" id="stickyMeta">40% off forever · free Lio+ device</div>
  </div>
  <button class="sticky-cta-btn" id="stickyCtaBtn">
    <span id="stickyCtaLabel">Get my free Lio+</span>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
