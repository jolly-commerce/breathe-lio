{% layout none %}
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0b2410">
<title>Lio — Find your fit</title>

<link rel="preconnect" href="https://use.typekit.net">
<link rel="stylesheet" href="https://use.typekit.net/xhz7hhk.css">

<style>
  :root {
    --forest:    #0b2410;
    --forest-2:  #14361b;
    --white:     #ffffff;
    --cream:     #fcfefb;
    --cream-2:   #f4f7f2;
    --cream-3:   #ebf0e6;
    --mint:      #94fca9;
    --mint-soft: #cdfee1;
    --warn:      #a86a1a;
    --warn-soft: rgba(255, 180, 80, 0.15);
    --honest:    #fff7c2;
    --f-04: rgba(11, 36, 16, 0.04);
    --f-06: rgba(11, 36, 16, 0.06);
    --f-08: rgba(11, 36, 16, 0.08);
    --f-10: rgba(11, 36, 16, 0.10);
    --f-14: rgba(11, 36, 16, 0.14);
    --f-22: rgba(11, 36, 16, 0.22);
    --f-40: rgba(11, 36, 16, 0.40);
    --f-55: rgba(11, 36, 16, 0.55);
    --f-72: rgba(11, 36, 16, 0.72);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  ::selection { background: var(--mint); color: var(--forest); }
  html, body { background: var(--cream); }
  body {
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-weight: 400;
    color: var(--forest);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    letter-spacing: -0.005em;
    min-height: 100vh;
    min-height: 100dvh;
  }
  img, svg { max-width: 100%; display: block; }
  button { font-family: inherit; cursor: pointer; }
  a { color: inherit; text-decoration: none; }
  .italic-word { font-style: italic; font-weight: 300; }

  .circle { position: relative; display: inline-block; padding: 0 0.02em; isolation: isolate; }
  .circle svg {
    position: absolute; left: 0; right: 0; bottom: -0.08em;
    width: 100%; height: 0.22em; z-index: -1; pointer-events: none; overflow: visible;
  }
  .circle svg path { fill: none; stroke: var(--mint); stroke-width: 10; stroke-linecap: round; }

  /* ANNOUNCEMENT */
  .announcement {
    background: var(--forest); color: var(--cream);
    text-align: center; padding: 11px 16px;
    font-size: 13px; letter-spacing: 0.01em; font-weight: 500;
    position: sticky; top: 0; z-index: 60;
  }
  .announcement strong { font-weight: 600; color: var(--mint); }

  /* TOP BAR */
  .topbar {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 20px;
    border-bottom: 1px solid var(--f-06);
    background: var(--cream);
    position: sticky; top: 38px; z-index: 50;
  }
  .topbar-logo { font-size: 22px; font-weight: 600; letter-spacing: -0.02em; }
  .topbar-right {
    display: flex; align-items: center; gap: 14px;
    font-size: 12px; color: var(--f-55); font-weight: 500;
  }
  .topbar-secure { display: inline-flex; align-items: center; gap: 5px; }
  .topbar-secure svg { width: 13px; height: 13px; }

  /* PROGRESS */
  .progress {
    background: var(--cream);
    padding: 14px 20px 18px;
    border-bottom: 1px solid var(--f-06);
    position: sticky; top: 92px; z-index: 40;
  }
  .progress-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 9px;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--f-55);
  }
  .progress-row strong { color: var(--forest); font-weight: 600; }
  .progress-track {
    height: 6px; background: var(--cream-3);
    border-radius: 99px; overflow: hidden; position: relative;
  }
  .progress-fill {
    height: 100%; background: var(--forest);
    border-radius: 99px;
    transition: width 0.5s var(--ease);
    width: 12%; position: relative;
  }
  .progress-fill::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(90deg, transparent, rgba(148, 252, 169, 0.4), transparent);
    animation: shimmer 2.5s infinite;
  }
  @keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

  /* STAGE */
  .stage {
    max-width: 580px;
    margin: 0 auto;
    padding: 28px 20px 120px;
    min-height: calc(100dvh - 200px);
    position: relative;
  }
  .step { display: none; animation: fade-up 0.45s var(--ease); }
  .step.is-active { display: block; }
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .step-eyebrow {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--forest);
    background: var(--mint-soft);
    padding: 6px 11px;
    border-radius: 99px;
    margin-bottom: 18px;
  }
  .step-eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--forest); }
  .step-h {
    font-size: clamp(28px, 6.5vw, 38px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
  }
  .step-sub {
    font-size: 16px;
    color: var(--f-72);
    margin-bottom: 28px;
    line-height: 1.5;
    max-width: 480px;
  }

  /* QUIZ OPTIONS */
  .options { display: flex; flex-direction: column; gap: 10px; }
  .option {
    display: flex; align-items: center;
    gap: 14px;
    padding: 18px 18px;
    background: var(--white);
    border: 1.5px solid var(--f-08);
    border-radius: 16px;
    text-align: left;
    width: 100%;
    transition: all 0.18s var(--ease);
    min-height: 64px;
    color: var(--forest);
    position: relative;
  }
  .option:hover {
    border-color: var(--f-22);
    transform: translateY(-1px);
    box-shadow: 0 8px 24px var(--f-06);
  }
  .option.is-selected {
    border-color: var(--forest);
    background: var(--forest);
    color: var(--cream);
  }
  .option-radio {
    flex-shrink: 0;
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 1.5px solid var(--f-22);
    display: grid; place-items: center;
    transition: all 0.2s var(--ease);
  }
  .option.is-selected .option-radio { border-color: var(--mint); background: var(--mint); }
  .option-radio::after {
    content: ''; width: 8px; height: 8px;
    border-radius: 50%; background: var(--forest);
    transform: scale(0);
    transition: transform 0.2s var(--ease-spring);
  }
  .option.is-selected .option-radio::after { transform: scale(1); }
  .option-body { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
  .option-label {
    font-size: 16px; font-weight: 500;
    letter-spacing: -0.01em; line-height: 1.3;
  }
  .option-hint {
    font-size: 13px; color: var(--f-55);
    font-weight: 400;
  }
  .option.is-selected .option-hint { color: rgba(252, 254, 251, 0.65); }
  .option-emoji {
    flex-shrink: 0;
    width: 36px; height: 36px;
    background: var(--cream-2);
    border-radius: 10px;
    display: grid; place-items: center;
    font-size: 18px;
  }
  .option.is-selected .option-emoji { background: var(--forest-2); }
  .option:hover .option-emoji {
    transform: scale(1.08) rotate(-3deg);
    transition: transform 0.2s var(--ease-spring);
  }

  /* CTA */
  .cta-row { margin-top: 28px; display: flex; flex-direction: column; gap: 14px; }
  .cta {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 8px;
    padding: 18px 28px;
    background: var(--forest);
    color: var(--cream);
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    transition: all 0.18s var(--ease);
    width: 100%;
    min-height: 56px;
  }
  .cta:hover:not(:disabled) {
    background: var(--forest-2);
    transform: translateY(-1px);
    box-shadow: 0 10px 28px rgba(11, 36, 16, 0.2);
  }
  .cta:disabled { opacity: 0.4; cursor: not-allowed; }
  .cta-arrow { transition: transform 0.18s var(--ease); }
  .cta:hover:not(:disabled) .cta-arrow { transform: translateX(3px); }
  .cta-back {
    background: transparent; color: var(--f-72);
    border: none; font-size: 14px; font-weight: 500;
    padding: 10px; align-self: center;
    text-decoration: underline;
    text-decoration-color: var(--f-22);
    text-underline-offset: 4px;
  }
  .cta-back:hover { color: var(--forest); text-decoration-color: var(--forest); }

  /* TRUST STRIP */
  .trust-strip {
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--f-06);
    display: flex; align-items: center; justify-content: center;
    gap: 18px; flex-wrap: wrap;
    font-size: 12px;
    color: var(--f-55); font-weight: 500;
  }
  .trust-strip-item { display: inline-flex; align-items: center; gap: 6px; }
  .trust-strip-item svg { width: 14px; height: 14px; flex-shrink: 0; }

  /* HONESTY NOTE */
  .honesty-note {
    margin-top: 22px;
    padding: 14px 16px;
    background: var(--honest);
    border-radius: 12px;
    font-size: 13px;
    color: var(--forest);
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .honesty-note svg { flex-shrink: 0; width: 16px; height: 16px; margin-top: 2px; }
  .honesty-note strong { font-weight: 700; }

  /* QUALIFIER WARNING */
  .qualifier-banner {
    margin-top: 16px;
    padding: 14px 16px;
    background: var(--warn-soft);
    border-radius: 12px;
    font-size: 13px;
    color: var(--forest);
    line-height: 1.5;
    display: none;
    align-items: flex-start;
    gap: 10px;
  }
  .qualifier-banner.is-shown { display: flex; }
  .qualifier-banner svg { flex-shrink: 0; width: 16px; height: 16px; margin-top: 2px; color: var(--warn); }

  /* LOADING */
  .processing { text-align: center; padding: 40px 0 20px; }
  .processing-spinner {
    width: 64px; height: 64px;
    margin: 0 auto 24px;
    border: 3px solid var(--cream-3);
    border-top-color: var(--forest);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .processing-status {
    display: flex; flex-direction: column;
    gap: 10px; max-width: 360px; margin: 0 auto;
  }
  .processing-row {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px;
    background: var(--white);
    border: 1px solid var(--f-08);
    border-radius: 10px;
    font-size: 14px;
    color: var(--f-55);
    opacity: 0.3;
    transition: opacity 0.4s var(--ease), color 0.4s var(--ease);
    text-align: left;
  }
  .processing-row.is-done { opacity: 1; color: var(--forest); }
  .processing-row.is-done .processing-check { background: var(--mint); }
  .processing-row.is-done .processing-check svg { opacity: 1; transform: scale(1); }
  .processing-check {
    flex-shrink: 0;
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--cream-3);
    display: grid; place-items: center;
    transition: background 0.4s var(--ease);
  }
  .processing-check svg {
    width: 12px; height: 12px;
    color: var(--forest);
    opacity: 0;
    transform: scale(0.6);
    transition: all 0.3s var(--ease-spring);
  }

  /* RESULT / OFFER */
  .result-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--forest);
    background: var(--mint-soft);
    padding: 6px 12px;
    border-radius: 99px;
    margin-bottom: 16px;
  }
  .result-h {
    font-size: clamp(30px, 7vw, 42px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.028em;
    margin-bottom: 14px;
  }
  .result-sub {
    font-size: 15.5px;
    color: var(--f-72);
    line-height: 1.55;
    margin-bottom: 20px;
    max-width: 520px;
  }
  .result-proof-row {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 9px 14px;
    background: var(--white);
    border: 1px solid var(--f-08);
    border-radius: 99px;
    margin-bottom: 24px;
    font-size: 13px;
    color: var(--forest);
    line-height: 1;
  }
  .result-proof-stars { display: inline-flex; gap: 1px; color: #f4a020; }
  .result-proof-stars svg { width: 14px; height: 14px; }
  .result-proof-text strong { font-weight: 700; }
  .result-proof-text small { color: var(--f-55); font-size: 11px; }

  /* PROOF STRIP */
  .proof-strip {
    margin-bottom: 22px;
    padding: 16px 18px;
    background: var(--cream-2);
    border-left: 3px solid var(--mint);
    border-radius: 0 12px 12px 0;
  }
  .proof-strip-quote { font-size: 14px; color: var(--forest); line-height: 1.55; }
  .proof-strip-attr {
    margin-top: 8px; font-size: 11.5px; color: var(--f-55);
    font-weight: 500; display: flex; align-items: center; gap: 8px;
  }
  .proof-strip-stars { display: inline-flex; gap: 1px; color: #f4a020; }
  .proof-strip-stars svg { width: 11px; height: 11px; }
  .proof-strip-verified { display: inline-flex; align-items: center; gap: 4px; color: var(--f-55); }
  .proof-strip-verified svg { width: 11px; height: 11px; }

  /* PLAN CARD */
  .plan-block {
    margin-top: 8px;
    background: var(--white);
    border: 1.5px solid var(--f-08);
    border-radius: 18px;
    padding: 18px 18px;
    margin-bottom: 14px;
  }
  .plan-block-title {
    font-size: 12.5px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--f-55); margin-bottom: 14px;
  }
  .plan-cards { display: flex; flex-direction: column; gap: 10px; }
  .plan-card {
    background: var(--white);
    border: 1.5px solid var(--f-08);
    border-radius: 14px;
    overflow: hidden;
    transition: all 0.18s var(--ease);
    cursor: pointer;
  }
  .plan-card:hover { border-color: var(--f-22); }
  .plan-card.is-selected {
    border-color: var(--forest);
    background: var(--cream);
    box-shadow: 0 2px 12px rgba(11, 36, 16, 0.06);
  }
  .plan-card-eyebrow {
    display: block; width: 100%;
    padding: 7px 12px;
    background: var(--forest);
    color: var(--honest);
    text-align: center;
    font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.08em; line-height: 1.2;
    text-transform: uppercase;
  }
  .plan-card-body { padding: 14px 14px 12px; }
  .plan-card-row { display: flex; align-items: flex-start; gap: 12px; }
  .plan-card-radio {
    flex-shrink: 0; width: 18px; height: 18px;
    border: 1.5px solid var(--f-22);
    border-radius: 50%; background: var(--white);
    margin-top: 3px; position: relative;
    transition: border-color 0.18s var(--ease);
  }
  .plan-card.is-selected .plan-card-radio { border-color: var(--forest); }
  .plan-card.is-selected .plan-card-radio::after {
    content: ''; position: absolute; inset: 3px;
    border-radius: 50%; background: var(--forest);
  }
  .plan-card-info { flex: 1; min-width: 0; }
  .plan-card-title { font-size: 15.5px; font-weight: 700; color: var(--forest); line-height: 1.25; letter-spacing: -0.005em; }
  .plan-card-cadence { font-size: 12.5px; color: var(--f-55); margin-top: 4px; line-height: 1.35; }
  .plan-card-price-wrap { text-align: right; flex-shrink: 0; }
  .plan-card-price-row { display: flex; align-items: baseline; justify-content: flex-end; gap: 6px; }
  .plan-card-price { font-size: 18px; font-weight: 700; color: var(--forest); line-height: 1; letter-spacing: -0.01em; }
  .plan-card-compare-at { font-size: 12.5px; color: var(--f-55); text-decoration: line-through; font-weight: 600; }
  .plan-card-perday { font-size: 11px; color: var(--f-55); margin-top: 4px; }
  .plan-card.is-selected .plan-card-perday { color: var(--forest); font-weight: 600; }

  .plan-card-included {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--f-08);
    display: none;
  }
  .plan-card.is-selected .plan-card-included.show-when-selected { display: block; }

  .plan-card-free-device {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px; margin-bottom: 12px;
    background: var(--mint-soft);
    border-radius: 12px;
    border: 1px solid var(--mint);
  }
  .plan-card-free-device-icon {
    flex-shrink: 0; width: 36px; height: 36px;
    border-radius: 10px; background: var(--mint);
    display: grid; place-items: center; color: var(--forest);
  }
  .plan-card-free-device-icon svg { width: 20px; height: 20px; }
  .plan-card-free-device-body { flex: 1; min-width: 0; }
  .plan-card-free-device-title { font-size: 14px; font-weight: 700; color: var(--forest); letter-spacing: -0.01em; line-height: 1.25; }
  .plan-card-free-device-sub { font-size: 11.5px; color: var(--f-72); line-height: 1.35; margin-top: 2px; }
  .plan-card-free-device-flag {
    flex-shrink: 0;
    background: var(--forest); color: var(--honest);
    padding: 4px 8px; border-radius: 6px;
    font-size: 9.5px; font-weight: 800;
    letter-spacing: 0.06em; text-transform: uppercase; line-height: 1;
  }
  .plan-card-included-label { font-size: 10.5px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--f-55); margin-bottom: 12px; }
  .plan-card-included-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 9px; }
  .plan-card-included-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 13.5px; line-height: 1.4; color: var(--forest); }
  .plan-card-included-check { flex-shrink: 0; width: 18px; height: 18px; border-radius: 50%; background: var(--mint); display: grid; place-items: center; margin-top: 1px; }
  .plan-card-included-check svg { width: 11px; height: 11px; color: var(--forest); }
  .plan-card-included-body { flex: 1; }
  .plan-card-included-title { font-weight: 600; letter-spacing: -0.005em; }
  .plan-card-included-sub { font-size: 12px; color: var(--f-55); margin-top: 1px; line-height: 1.4; }

  .plan-card[data-plan="onetime"] { background: var(--cream-2); }
  .plan-card[data-plan="onetime"].is-selected { background: var(--white); }
  .plan-card-onetime-note { font-size: 11.5px; color: var(--f-55); margin-top: 8px; margin-left: 30px; line-height: 1.4; }

  /* CHECKOUT CTA */
  .checkout-cta {
    width: 100%;
    background: var(--forest); color: var(--cream);
    border: none; border-radius: 14px;
    padding: 18px 24px;
    font-family: inherit; font-size: 16px; font-weight: 600; letter-spacing: -0.01em;
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    transition: all 0.18s var(--ease); cursor: pointer;
    margin-top: 14px;
  }
  .checkout-cta:hover { background: var(--forest-2); transform: translateY(-1px); box-shadow: 0 10px 28px rgba(11, 36, 16, 0.2); }
  .checkout-cta-main { font-size: 16px; font-weight: 600; }
  .checkout-cta-price { font-size: 12.5px; font-weight: 400; opacity: 0.75; }

  /* Trust bar */
  .im8-trust-bar { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 16px 0 22px; }
  .im8-trust-bar__item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 12px 6px; background: var(--white); border: 1px solid var(--f-08); border-radius: 12px; }
  .im8-trust-bar__icon { width: 40px; height: 40px; border-radius: 11px; background: var(--cream); border: 1px solid var(--f-08); display: flex; align-items: center; justify-content: center; color: var(--forest); flex-shrink: 0; }
  .im8-trust-bar__icon svg { width: 20px; height: 20px; }
  .im8-trust-bar__title { font-size: 12.5px; font-weight: 700; color: var(--forest); line-height: 1.2; }
  .im8-trust-bar__sub { font-size: 10.5px; color: var(--f-55); line-height: 1.25; }
  @media (max-width: 380px) {
    .im8-trust-bar { gap: 5px; }
    .im8-trust-bar__item { padding: 10px 4px; gap: 6px; }
    .im8-trust-bar__icon { width: 34px; height: 34px; }
    .im8-trust-bar__icon svg { width: 17px; height: 17px; }
    .im8-trust-bar__title { font-size: 11.5px; }
    .im8-trust-bar__sub { font-size: 9.5px; }
  }

  /* PRODUCT VIEWER */
  .product-viewer { margin: 0 -20px 22px; background: linear-gradient(180deg, var(--cream-3) 0%, var(--cream-2) 100%); border-radius: 0; padding: 0 0 18px; overflow: hidden; border-top: 1px solid var(--f-08); border-bottom: 1px solid var(--f-08); }
