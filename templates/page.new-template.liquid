<script>
(function() {
  'use strict';

  const state = {
    step: 1,
    answers: { frequency: null, trigger: null, expectation: null },
    plan: 'subscription',
    color: 'olive'
  };

  const stepEls = document.querySelectorAll('.step');
  const stepNumEl = document.getElementById('stepNum');
  const stepPctEl = document.getElementById('stepPct');
  const progressFill = document.getElementById('progressFill');
  const TOTAL_STEPS = 3;

  function showStep(n) {
    stepEls.forEach(s => s.classList.remove('is-active'));
    const target = document.querySelector(`[data-step="${n}"]`);
    if (target) target.classList.add('is-active');
    state.step = n;

    const progressEl = document.querySelector('.progress');
    if (n <= TOTAL_STEPS) {
      progressEl.style.display = '';
      const pct = Math.round((n / TOTAL_STEPS) * 100);
      stepNumEl.textContent = n;
      stepPctEl.textContent = pct + '%';
      progressFill.style.width = pct + '%';
    } else {
      progressEl.style.display = 'none';
    }

    const stickyBar = document.querySelector('.sticky-cta');
    if (stickyBar) {
      stickyBar.classList.toggle('is-visible', n === 5);
      document.body.classList.toggle('has-sticky-bar', n === 5);
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  document.querySelectorAll('[data-question]').forEach(group => {
    const question = group.dataset.question;
    group.addEventListener('click', e => {
      const opt = e.target.closest('.option');
      if (!opt) return;
      group.querySelectorAll('.option').forEach(o => o.classList.remove('is-selected'));
      opt.classList.add('is-selected');
      state.answers[question] = opt.dataset.value;

      const stepNum = parseInt(opt.closest('.step').dataset.step, 10);
      const nextBtn = document.getElementById('next' + stepNum);
      if (nextBtn) nextBtn.disabled = false;

      let shouldAutoAdvance = true;
      if (question === 'expectation') {
        const warn = document.getElementById('fullReplaceWarning');
        if (opt.dataset.value === 'full_replacement') {
          warn.classList.add('is-shown');
          shouldAutoAdvance = false;
        } else {
          warn.classList.remove('is-shown');
        }
      }

      if (shouldAutoAdvance) {
        setTimeout(() => {
          if (stepNum < 3) {
            showStep(stepNum + 1);
          } else if (stepNum === 3) {
            showStep(4);
            runProcessing();
          }
        }, 320);
      }
    });
  });

  document.getElementById('next1').addEventListener('click', () => showStep(2));
  document.getElementById('next2').addEventListener('click', () => showStep(3));
  document.getElementById('next3').addEventListener('click', () => { showStep(4); runProcessing(); });

  document.querySelectorAll('[data-back]').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = parseInt(btn.dataset.back, 10);
      showStep(target);
    });
  });

  function runProcessing() {
    const rows = document.querySelectorAll('.processing-row');
    rows.forEach(r => r.classList.remove('is-done'));
    let i = 0;
    const tick = () => {
      if (i < rows.length) {
        rows[i].classList.add('is-done');
        i++;
        setTimeout(tick, 700);
      } else {
        setTimeout(() => { routeToResult(); }, 600);
      }
    };
    setTimeout(tick, 400);
  }

  function routeToResult() {
    personalizeResult();
    showStep(5);
  }

  function personalizeResult() {
    const a = state.answers;
    const headline = document.getElementById('resultHeadline');
    const sub = document.getElementById('resultSub');
    const eyebrow = document.getElementById('resultEyebrow');

    if (a.expectation === 'calm_breath') {
      eyebrow.textContent = 'Built for your stress moments';
      headline.innerHTML = 'A slower breath, when you need one.';
      sub.innerHTML = 'Lio turns the hand-to-mouth moment into a deliberate, calming pause. No smoke, no nicotine — just the reset.';
    } else if (a.expectation === 'cut_down') {
      eyebrow.textContent = 'Built for cutting down';
      headline.innerHTML = 'Cut down without going cold.';
      sub.innerHTML = 'Every time you reach for Lio instead, that\'s one fewer cigarette. Most users halve their intake within 2–3 weeks.';
    } else if (a.expectation === 'replace_ritual') {
      eyebrow.textContent = 'Built for breaking the habit';
      headline.innerHTML = 'Break the hand-to-mouth habit.';
      sub.innerHTML = '80% of the habit is the hand, the breath, the pause. Lio handles that part — so the chemistry can fade on its own.';
    } else {
      eyebrow.textContent = 'Built for your swap';
      headline.innerHTML = 'Your ritual tool for the swap.';
      sub.innerHTML = 'Lio handles the hand, the breath, the pause. Pair it with whatever you\'re using for the nicotine side.';
    }
  }

  function updateCtaCopy() {
    const ctaLabel = document.getElementById('ctaLabel');
    const ctaPrice = document.getElementById('ctaPrice');
    const stickyLabel = document.getElementById('stickyCtaLabel');
    const stickyPrice = document.getElementById('stickyPrice');
    const stickyCompare = document.getElementById('stickyCompare');
    const stickyCadence = document.getElementById('stickyCadence');
    const stickyMeta = document.getElementById('stickyMeta');

    if (state.plan === 'subscription') {
      ctaLabel.textContent = 'Get my free Lio+';
      ctaPrice.textContent = '€29/month · 40% off forever · cancel anytime';
      if (stickyLabel) stickyLabel.textContent = 'Get my free Lio+';
      if (stickyPrice) stickyPrice.textContent = '€29';
      if (stickyCompare) { stickyCompare.textContent = '€49'; stickyCompare.style.display = ''; }
      if (stickyCadence) stickyCadence.textContent = '/month';
      if (stickyMeta) stickyMeta.textContent = '40% off forever · free Lio+ device';
    } else {
      ctaLabel.textContent = 'Send me my Lio';
      ctaPrice.textContent = '€49 one-time · no subscription, no extras';
      if (stickyLabel) stickyLabel.textContent = 'Send me my Lio';
      if (stickyPrice) stickyPrice.textContent = '€49';
      if (stickyCompare) stickyCompare.style.display = 'none';
      if (stickyCadence) stickyCadence.textContent = 'one-time';
      if (stickyMeta) stickyMeta.textContent = 'No subscription, no extras';
    }
  }

  document.querySelectorAll('.plan-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('is-selected'));
      card.classList.add('is-selected');
      state.plan = card.dataset.plan;
      updateCtaCopy();
    });
  });

  function activateSlide(slideIdx) {
    document.querySelectorAll('.product-viewer-img').forEach(img => {
      img.classList.toggle('is-active', img.dataset.slide === String(slideIdx));
    });
    document.querySelectorAll('.product-viewer-thumb').forEach(t => {
      t.classList.toggle('is-active', t.dataset.thumb === String(slideIdx));
    });
  }

  document.querySelectorAll('.product-viewer-thumb').forEach(thumb => {
    thumb.addEventListener('click', () => activateSlide(thumb.dataset.thumb));
  });

  document.querySelectorAll('.color-swatch').forEach(swatch => {
    swatch.addEventListener('click', () => {
      const color = swatch.dataset.color;
      const newImgSrc = swatch.dataset.colorImg;
      state.color = color;

      document.querySelectorAll('.color-swatch').forEach(s => {
        const isSelected = s.dataset.color === color;
        s.classList.toggle('is-selected', isSelected);
        s.setAttribute('aria-checked', isSelected ? 'true' : 'false');
      });

      const mainImg = document.getElementById('productImgMain');
      const mainThumbImg = document.getElementById('productThumbMain');
      if (mainImg && newImgSrc) mainImg.src = newImgSrc;
      if (mainThumbImg && newImgSrc) mainThumbImg.src = newImgSrc;

      activateSlide(0);

      const colorNameEl = document.getElementById('colorName');
      if (colorNameEl) colorNameEl.textContent = color.charAt(0).toUpperCase() + color.slice(1);
    });
  });

  function handleCheckout() {
    console.log('Checkout', { plan: state.plan, color: state.color, answers: state.answers });
    alert('✓ Checkout (' + state.plan + ' · ' + state.color + ')\n\nIn production, this routes to Shopify with the selected variant + answer attributes attached as line item properties.');
  }
  document.getElementById('checkoutBtn').addEventListener('click', handleCheckout);
  const stickyBtn = document.getElementById('stickyCtaBtn');
  if (stickyBtn) stickyBtn.addEventListener('click', handleCheckout);

  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const wasOpen = item.classList.contains('is-open');
      document.querySelectorAll('.faq-item.is-open').forEach(i => i.classList.remove('is-open'));
      if (!wasOpen) item.classList.add('is-open');
    });
  });

})();
</script>

