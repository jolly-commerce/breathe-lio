      "type": "ecom-faq",
      "blocks": {
        "question_wgkmgX": {
          "type": "question",
          "settings": {
            "title": "What are the ingredients?",
            "content": "<p>Lio® Flavour Cores are made with 100% natural ingredients. They don’t have nicotine, smoke, vapor, or chemicals. They offer a clean, tasty air that helps you break bad habits safely.</p>"
          }
        },
        "question_LAbnnq": {
          "type": "question",
          "settings": {
            "title": "What does flavored air taste like?",
            "content": "<p>If you’re used to vapor, Lio feels lighter at first. Think of it like a herbal tea instead of soda: less harsh, more natural, and better for you.</p>"
          }
        },
        "question_eiDnJV": {
          "type": "question",
          "settings": {
            "title": "What are cores made of?",
            "content": "<p>Each Core uses medical-grade polyester. The fiber is filled with natural plant oils from farms we work with around the world.</p>"
          }
        },
        "question_CYDXWF": {
          "type": "question",
          "settings": {
            "title": "How long do the Lio Cores last?",
            "content": "<p>Each Core lasts 2–4 days, depending on how much you use it. If you use it a lot, you might need to change it more often.</p>"
          }
        },
        "question_mzqPjk": {
          "type": "question",
          "settings": {
            "title": "How often can I use Lio?",
            "content": "<p>You can use Lio as much as you want. If you feel any discomfort, stop using and talk to your doctor.</p>"
          }
        },
        "question_CMify8": {
          "type": "question",
          "settings": {
            "title": "Is Lio safe to use?",
            "content": "<p><strong>Yes, </strong>absolutely<strong>!</strong> Lio is made with natural ingredients and has no nicotine, smoke, or harmful chemicals.</p>"
          }
        },
        "question_44hFeD": {
          "type": "question",
          "settings": {
            "title": "Shipping & Refunds",
            "content": "<p><strong>Worldwide shipping - For Free<br/></strong>We ship worldwide from the Netherlands with free shipping on all orders. Delivery takes 2-3 days within Europe, 4-8 days outside Europe, and next-day delivery in the Middle East (from Dubai).<br/><br/><strong>The Money Back Guarantee</strong><br/>If you’ve used Lio™, commit to a 30 days to experience its benefits. After completing the 30-day journey, you have 7 days to request a refund if you’re not satisfied. This ensures you have enough time to fully explore its impact before making a decision.</p>"
          }
        },
        "question_htK8yE": {
          "type": "question",
          "settings": {
            "title": "How does Lio work?",
            "content": "<p>Lio helps you keep the hand-to-mouth habit but with clean, tasty air instead. It keeps you relaxed and makes quitting smoking or vaping easier.</p>"
          }
        },
        "question_zE9BfB": {
          "type": "question",
          "settings": {
            "title": "Can I use Lio anywhere?",
            "content": "<p>Yes. You can use Lio anywhere because there's no smoke or vapor</p>"
          }
        }
