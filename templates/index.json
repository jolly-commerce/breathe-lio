      "settings": {
        "text_FtgUZGCiW6P9UIyb": "<h3>No vapor. No smell. No restrictions.</h3>",
        "text_hKUF97nnDGZrSrGo": "<h3>Use it anywhere. </h3>",
        "text_NpTZ41smky1abxJe": "<h3>The urge doesn't care where you are. <em><strong>Neither does Lio.</strong></em></h3>",
