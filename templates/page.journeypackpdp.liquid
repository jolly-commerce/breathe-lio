<script>
  (function(){
    var s='<svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#0b2410"/></svg>';
    var sm='<svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" fill="#94fca9"/></svg>';
    document.querySelectorAll('[data-stars]').forEach(function(el){el.innerHTML=s.repeat(5);});
    document.querySelectorAll('[data-stars-mini]').forEach(function(el){el.innerHTML=sm.repeat(5);el.style.transform='scale(.78)';el.style.transformOrigin='left center';});
  })();

  (function(){
    var clock=document.getElementById('clock');
    var end=localStorage.getItem('lioOfferEnd');
    var now=Date.now();
    if(!end||+end<now){end=now+24*60*60*1000;localStorage.setItem('lioOfferEnd',end);}
    function tick(){
      var d=Math.max(0,+end-Date.now());
      var h=Math.floor(d/3.6e6),m=Math.floor(d%3.6e6/6e4),sec=Math.floor(d%6e4/1e3);
      clock.textContent=[h,m,sec].map(function(x){return String(x).padStart(2,'0');}).join(':');
      if(d<=0){end=Date.now()+24*60*60*1000;localStorage.setItem('lioOfferEnd',end);}
    }
    tick();setInterval(tick,1000);
  })();

  (function(){var t=document.getElementById('logoTrack');t.innerHTML+=t.innerHTML;})();

  /* ---- per-buybox logic: each .buybox is fully self-contained ---- */
  (function(){
    var lbl={'90':'90-Day Supply Pack','30':'30-Day Supply Pack'};
    var sp=document.getElementById('stickyPrice');

    function syncSticky(plan){
      sp.innerHTML='<s>'+plan.dataset.was+'</s> <em>'+plan.dataset.price+'</em> Â· '+lbl[plan.dataset.plan];
    }

    document.querySelectorAll('.buybox').forEach(function(box){
      var thumbs=box.querySelectorAll('.bb-thumb');
      var ico=box.querySelector('.js-stageIco');
      var lab=box.querySelector('.js-stageLabel');
      var woods=box.querySelectorAll('.wood-chip');
      var plans=box.querySelectorAll('.plan');
      var atcText=box.querySelector('.js-atcText');

      thumbs.forEach(function(t){
        t.addEventListener('click',function(){
          thumbs.forEach(function(x){x.classList.remove('active');});
          t.classList.add('active');
          ico.textContent=t.dataset.ico;
          lab.textContent=t.dataset.label;
        });
      });

      woods.forEach(function(w){
        w.addEventListener('click',function(){
          woods.forEach(function(x){x.classList.remove('sel');});
          w.classList.add('sel');
        });
      });

      plans.forEach(function(p){
        p.addEventListener('click',function(){
          plans.forEach(function(x){x.classList.remove('sel');});
          p.classList.add('sel');
          atcText.textContent=p.dataset.cta+' Â· '+p.dataset.price;
          var g=box.querySelector('.js-guar');
          if(g&&p.dataset.guar){g.textContent=p.dataset.guar;}
          syncSticky(p);
        });
      });
    });
  })();

  (function(){
    document.querySelectorAll('.faq-q').forEach(function(q){q.addEventListener('click',function(){
      var it=q.parentElement,op=it.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(function(i){i.classList.remove('open');});
      if(!op)it.classList.add('open');
    });});
  })();

  /* mobile menu */
  (function(){
    var burger=document.getElementById('navBurger');
    var menu=document.getElementById('mobileMenu');
    var closeBtn=document.getElementById('mmClose');
    if(!burger||!menu)return;
    function open(){menu.classList.add('open');menu.setAttribute('aria-hidden','false');burger.setAttribute('aria-expanded','true');document.body.style.overflow='hidden';}
    function close(){menu.classList.remove('open');menu.setAttribute('aria-hidden','true');burger.setAttribute('aria-expanded','false');document.body.style.overflow='';}
    burger.addEventListener('click',open);
    closeBtn.addEventListener('click',close);
    menu.addEventListener('click',function(e){if(e.target===menu)close();});
    menu.querySelectorAll('.mm-links a, .mm-cta').forEach(function(a){
      a.addEventListener('click',close);
    });
  })();

  /* sticky hides while EITHER buy box is in view */
  (function(){
    var st=document.getElementById('sticky');
    var boxes=[document.getElementById('buy'),document.getElementById('buy2')];
    function chk(){
      var anyVisible=boxes.some(function(b){
        var r=b.getBoundingClientRect();
        return r.bottom>120 && r.top<innerHeight-80;
      });
      var nearFooter=(innerHeight+scrollY)>(document.body.offsetHeight-540);
      if(!anyVisible&&!nearFooter)st.classList.add('show');else st.classList.remove('show');
    }
    addEventListener('scroll',chk,{passive:true});addEventListener('resize',chk);chk();
  })();

  (function(){
    var io=new IntersectionObserver(function(e){e.forEach(function(x){
      if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}
    });},{threshold:.1});
    document.querySelectorAll('.reveal').forEach(function(el){io.observe(el);});
  })();
</script>
