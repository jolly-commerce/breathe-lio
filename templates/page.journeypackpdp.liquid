  .wrap{padding:0 22px;}
  section.hero,.problem,.uvt,.reasons,.how,.reviews,.founder,.guar,.faq,.myth,.sci,.tline,.final,.buy2{padding-top:46px;padding-bottom:46px;}
  .logostrip-item{padding:13px 22px;font-size:13px;gap:10px;}
  h2.big{font-size:clamp(26px,7vw,40px);}
  .sub{font-size:15px;}
}

/* phone */
@media (max-width:600px){
  .wrap{padding:0 18px;}
  h1.hero-h1{font-size:clamp(34px,10.5vw,46px);}
  .hero-grid{gap:24px;}
  .hero-rating{flex-wrap:wrap;}
  .hero-benefits li{font-size:14px;}

  /* buy box */
  .bb-body{padding:18px 16px 20px;}
