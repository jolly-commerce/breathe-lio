  display:flex;align-items:center;justify-content:center;font-size:26px;
}
.grab-card .gc-t{font-size:14px;font-weight:900;color:var(--forest);letter-spacing:-.02em;line-height:1.25;}
@media (max-width:780px){
  .grab-row{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:420px){
  .grab-row{grid-template-columns:1fr 1fr;gap:10px;}
  .grab-card{padding:20px 10px;}
}

