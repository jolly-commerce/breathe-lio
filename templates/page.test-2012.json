    "ecom_science_backed_N3zFP9": {
      "type": "ecom-science-backed",
      "blocks": {
        "tab_dipTpG": {
          "type": "tab",
          "settings": {
            "tab": "Cordell & Buckle",
            "label": "Aromatherapy & Craving Reduction Study by Cordell & Buckle",
            "date": "2013",
            "description": "A university-based study tested the effects of black pepper and angelica root essential oils on cravings. Both helped reduce the urge to engage in unhealthy habits, with black pepper providing the most craving relief and angelica offering the longest delay before the next urge. Conclusion: Aromatherapy may help reduce cravings and support withdrawal relief.\n\nConclusion: Aromatherapy may help reduce cravings and support withdrawal relief.",
            "background_image": "shopify://shop_images/Rectangle_6872.png"
          }
        },
        "tab_Jfbqzc": {
          "type": "tab",
          "settings": {
            "tab": "Przulj, McRobbie & Hajek",
            "label": "Sensorimotor Replacement & Habit ChangeReview by Przulj, McRobbie & Hajek",
            "date": "2012",
            "description": "This research reviewed how physical sensations—like inhaling, holding, and exhaling—can reinforce habits. The study found that replicating these sensations with non-nicotine tools (like natural inhalers) could help users transition away from addictive routines.\n\nConclusion: Addressing both chemical and sensory triggers can increase quitting success.",
            "background_image": "shopify://shop_images/Rectangle_6872.png"
          }
        },
        "tab_PAVAiX": {
          "type": "tab",
          "settings": {
            "tab": "Rose & Behm",
            "label": "Black Pepper Vapor & Craving ReliefStudy by Rose & Behm",
            "date": "1993",
            "description": "Participants who inhaled black pepper vapor after overnight abstinence reported significantly lower cravings and anxiety, along with stronger physical sensations in the chest—key in soothing withdrawal.\n\nConclusion: Natural inhalation tools using black pepper may ease symptoms and reduce the urge.",
            "background_image": "shopify://shop_images/Rectangle_6872.png"
          }
        }
      },
      "block_order": [
