{% comment %} ══════════════════════════════════ CSS ══════════════════════════════════ {% endcomment %}
<style>
  /* ── Reset & Variables ── */
  .lio-quiz *, .lio-quiz *::before, .lio-quiz *::after { box-sizing: border-box; margin: 0; padding: 0; }

  .lio-quiz {
    --green: #2d5a27;
    --green-lt: #3a7432;
    --green-pale: #e8f0e6;
    --green-mist: #f2f7f1;
    --black: #0a0a0a;
    --white: #ffffff;
    --cream: #f5f1eb;
    --sand: #e0d8cd;
    --text: #1a1a1a;
    --text-mid: #444444;
    --text-lt: #6a6a6a;
    --border: rgba(0,0,0,0.08);
    --shadow: 0 2px 40px rgba(0,0,0,0.06);
    --shadow-lg: 0 8px 60px rgba(0,0,0,0.1);
    --radius: 16px;
    --radius-sm: 10px;
    --font-display: 'Playfair Display', Georgia, serif;
    --font-body: 'DM Sans', system-ui, sans-serif;
    --ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);

    font-family: var(--font-body);
    color: var(--text);
    background: var(--white);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* ── Announcement Bar ── */
  .lio-quiz__announce {
    width: 100%;
    padding: 9px 16px;
    text-align: center;
    font-size: 0.69rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--white);
    background: var(--green);
    font-weight: 500;
  }

  /* ── Header ── */
  .lio-quiz__header {
    width: 100%;
    padding: 14px 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .lio-quiz__header img { height: 34px; width: auto; }

  /* ── Progress Bar ── */
  .lio-quiz__progress { width: 100%; max-width: 560px; padding: 0 24px; margin-top: 22px; }
  .lio-quiz__progress-track { width: 100%; height: 3px; background: var(--green-pale); border-radius: 100px; overflow: hidden; }
  .lio-quiz__progress-fill { height: 100%; background: var(--green); border-radius: 100px; transition: width 0.6s var(--ease); }
  .lio-quiz__progress-label { text-align: center; font-size: 0.7rem; color: var(--text-lt); margin-top: 7px; letter-spacing: 0.07em; text-transform: uppercase; font-weight: 500; }

  /* ── Content Container ── */
  .lio-quiz__content { width: 100%; max-width: 640px; padding: 0 24px; flex: 1; display: flex; flex-direction: column; align-items: center; }

  /* ── Screen States ── */
  .lio-quiz__screen { width: 100%; opacity: 0; transform: translateY(14px); transition: opacity 0.45s ease, transform 0.45s ease; display: none; flex-direction: column; align-items: center; }
  .lio-quiz__screen.is-active { display: flex; opacity: 1; transform: translateY(0); }
  .lio-quiz__screen.is-exiting { opacity: 0; transform: translateY(-10px); }

  /* ── Landing ── */
  .lio-quiz__landing { text-align: center; padding-top: 44px; padding-bottom: 40px; }
  .lio-quiz__badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 16px; background: var(--green-pale); border-radius: 100px; font-size: 0.71rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--green); margin-bottom: 22px; }
  .lio-quiz__landing h1 { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 2.7rem); font-weight: 600; line-height: 1.15; color: var(--black); margin-bottom: 14px; }
  .lio-quiz__landing h1 em { font-style: italic; color: var(--green); }
  .lio-quiz__subtitle { font-size: 1.02rem; color: var(--text-lt); line-height: 1.6; max-width: 440px; margin: 0 auto 28px; }

  /* ── Hero Image ── */
  .lio-quiz__hero {
    width: 100%;
    max-width: 520px;
    margin: 0 auto 28px;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .lio-quiz__hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ── Feature Pills ── */
  .lio-quiz__features { display: flex; justify-content: center; gap: 28px; margin-bottom: 32px; flex-wrap: wrap; }
  .lio-quiz__feature { display: flex; align-items: center; gap: 7px; font-size: 0.8rem; color: var(--text-lt); font-weight: 500; }
  .lio-quiz__feature svg { width: 16px; height: 16px; color: var(--green); flex-shrink: 0; }

  /* ── CTA Button ── */
  .lio-quiz__cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    padding: 16px 48px; background: var(--green); color: var(--white); border: none;
    border-radius: 100px; font-family: var(--font-body); font-size: 0.9rem;
    font-weight: 600; letter-spacing: 0.04em; cursor: pointer;
    transition: all 0.35s var(--ease); text-transform: uppercase;
  }
  .lio-quiz__cta:hover { background: var(--green-lt); transform: translateY(-1px); box-shadow: var(--shadow-lg); }
  .lio-quiz__cta svg { width: 16px; height: 16px; transition: transform 0.3s ease; }
  .lio-quiz__cta:hover svg { transform: translateX(3px); }

  /* ── Trust Line ── */
  .lio-quiz__trust { margin-top: 24px; display: flex; align-items: center; justify-content: center; gap: 14px; font-size: 0.76rem; color: var(--text-lt); }
  .lio-quiz__trust-stars { color: #e8a000; letter-spacing: 1px; }
  .lio-quiz__trust-sep { width: 1px; height: 13px; background: var(--sand); }

  /* ── Quote Block ── */
  .lio-quiz__quote { margin-top: 32px; padding: 22px; background: var(--green-mist); border-radius: var(--radius-sm); max-width: 460px; margin-left: auto; margin-right: auto; border-left: 3px solid var(--green); }
  .lio-quiz__quote-text { font-family: var(--font-display); font-style: italic; font-size: 0.95rem; line-height: 1.6; color: var(--text); margin-bottom: 10px; }
  .lio-quiz__quote-author { font-size: 0.76rem; color: var(--text-lt); font-weight: 500; }

  /* ── Question Screens ── */
  .lio-quiz__question { padding-top: 36px; }
  .lio-quiz__q-number { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--green); font-weight: 600; margin-bottom: 10px; text-align: center; }
  .lio-quiz__q-text { font-family: var(--font-display); font-size: clamp(1.4rem, 4vw, 1.85rem); font-weight: 600; text-align: center; line-height: 1.3; color: var(--black); margin-bottom: 6px; }
  .lio-quiz__q-help { text-align: center; font-size: 0.83rem; color: var(--text-lt); margin-bottom: 28px; }

  /* ── Answer Options ── */
  .lio-quiz__options { width: 100%; display: flex; flex-direction: column; gap: 10px; margin-bottom: 28px; }
  .lio-quiz__option {
    width: 100%; padding: 16px 18px; background: var(--white);
    border: 1.5px solid #e2e2e2; border-radius: var(--radius-sm);
    cursor: pointer; transition: all 0.35s var(--ease);
    display: flex; align-items: center; gap: 14px; text-align: left;
  }
  .lio-quiz__option:hover { border-color: var(--green); background: var(--green-mist); transform: translateX(3px); }
  .lio-quiz__option.is-selected { border-color: var(--green); background: var(--green-mist); box-shadow: 0 0 0 1px var(--green); }
  .lio-quiz__option-icon { width: 40px; height: 40px; border-radius: 50%; background: var(--green-pale); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; transition: all 0.3s ease; }
  .lio-quiz__option.is-selected .lio-quiz__option-icon { background: var(--green); }
  .lio-quiz__option-body { flex: 1; }
  .lio-quiz__option-label { font-weight: 600; font-size: 0.9rem; color: var(--text); margin-bottom: 1px; }
  .lio-quiz__option-desc { font-size: 0.76rem; color: var(--text-lt); line-height: 1.4; }
  .lio-quiz__option-check { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid #d0d0d0; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; }
  .lio-quiz__option.is-selected .lio-quiz__option-check { border-color: var(--green); background: var(--green); }
  .lio-quiz__option.is-selected .lio-quiz__option-check::after { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--white); }

  /* ── Affirmation ── */
  .lio-quiz__affirm { text-align: center; font-size: 0.76rem; color: var(--green); font-weight: 500; margin-top: -12px; margin-bottom: 16px; opacity: 0; transform: translateY(4px); transition: all 0.4s ease; }
  .lio-quiz__affirm.is-visible { opacity: 1; transform: translateY(0); }

  /* ── Loading ── */
  .lio-quiz__loading-title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--black); margin-bottom: 6px; }
  .lio-quiz__loading-sub { font-size: 0.83rem; color: var(--text-lt); margin-bottom: 28px; }
  .lio-quiz__dots { display: flex; gap: 6px; justify-content: center; padding: 56px 0; }
  .lio-quiz__dots span { width: 8px; height: 8px; border-radius: 50%; background: #d0d0d0; animation: lioQuizDotBounce 1.2s ease infinite; }
  .lio-quiz__dots span:nth-child(2) { animation-delay: 0.15s; }
  .lio-quiz__dots span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes lioQuizDotBounce {
    0%, 80%, 100% { transform: scale(0.6); background: #d0d0d0; }
    40% { transform: scale(1); background: var(--green); }
  }

  /* ── Result Screen ── */
  .lio-quiz__result { padding-top: 28px; text-align: center; padding-bottom: 56px; }
  @keyframes lioQuizReveal {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .lio-quiz__reveal { animation: lioQuizReveal 0.65s ease both; }
  .lio-quiz__result-badge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 16px; background: var(--green); color: var(--white); border-radius: 100px; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 18px; }
  .lio-quiz__result-title { font-family: var(--font-display); font-size: clamp(1.7rem, 5vw, 2.3rem); font-weight: 600; line-height: 1.2; color: var(--black); margin-bottom: 10px; }
  .lio-quiz__result-sub { font-size: 0.95rem; color: var(--text-lt); line-height: 1.6; max-width: 460px; margin: 0 auto 24px; }

  /* ── Product Card ── */
  .lio-quiz__product { background: var(--white); border: 1.5px solid #e0e0e0; border-radius: var(--radius); overflow: hidden; max-width: 480px; margin: 0 auto 22px; text-align: left; box-shadow: var(--shadow); animation: lioQuizReveal 0.65s ease 0.2s both; }
  .lio-quiz__product-image { width: 100%; height: 260px; background: var(--green-mist); overflow: hidden; position: relative; display: flex; align-items: center; justify-content: center; }
  .lio-quiz__product-image img { width: 100%; height: 100%; object-fit: cover; }
  .lio-quiz__product-badge { position: absolute; top: 12px; left: 12px; background: var(--green); color: var(--white); padding: 4px 12px; border-radius: 100px; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .lio-quiz__product-body { padding: 22px; }
  .lio-quiz__product-name { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; color: var(--black); margin-bottom: 3px; }
  .lio-quiz__product-price { font-size: 0.88rem; color: var(--text-lt); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
  .lio-quiz__product-price .sale { font-weight: 700; color: var(--green); }
  .lio-quiz__product-price .orig { text-decoration: line-through; font-size: 0.8rem; }

  /* ── Flavour Tags ── */
  .lio-quiz__flavours { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 14px; }
  .lio-quiz__flavour { padding: 3px 10px; border-radius: 100px; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; }
  .lio-quiz__flavour--mint { background: #d4edda; color: #155724; }
  .lio-quiz__flavour--cinnamon { background: #f5d6c0; color: #8b3a00; }
  .lio-quiz__flavour--turkey { background: #d6e9f5; color: #0c4b7a; }
  .lio-quiz__flavour--mango { background: #fff3cd; color: #856404; }
  .lio-quiz__flavour--orange { background: #ffe4cc; color: #9a4600; }
  .lio-quiz__flavour--berry { background: #e8d4f0; color: #5b2070; }

  .lio-quiz__product-desc { font-size: 0.83rem; color: var(--text-lt); line-height: 1.6; margin-bottom: 16px; }
  .lio-quiz__product-highlights { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }
  .lio-quiz__product-highlights span { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; background: var(--green-pale); border-radius: 100px; font-size: 0.7rem; font-weight: 500; color: var(--green); }

  .lio-quiz__product-cta {
    width: 100%; padding: 15px; background: var(--green); color: var(--white); border: none;
    border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.9rem;
    font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer;
    transition: all 0.35s var(--ease); display: flex; align-items: center; justify-content: center;
    gap: 8px; text-decoration: none;
  }
  .lio-quiz__product-cta:hover { background: var(--green-lt); transform: translateY(-1px); }

  /* ── Why Section ── */
  .lio-quiz__why { max-width: 480px; margin: 0 auto 22px; text-align: left; animation: lioQuizReveal 0.65s ease 0.4s both; }
  .lio-quiz__why h4 { font-family: var(--font-display); font-size: 1.05rem; font-weight: 600; margin-bottom: 12px; color: var(--black); }
  .lio-quiz__why ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .lio-quiz__why li { display: flex; align-items: flex-start; gap: 9px; font-size: 0.83rem; color: var(--text-mid); line-height: 1.5; }
  .lio-quiz__why li svg { width: 16px; height: 16px; color: var(--green); flex-shrink: 0; margin-top: 2px; }

  /* ── Trust Bar ── */
  .lio-quiz__trust-bar { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; padding: 18px 0; animation: lioQuizReveal 0.65s ease 0.6s both; }
  .lio-quiz__trust-item { display: flex; align-items: center; gap: 5px; font-size: 0.73rem; color: var(--text-lt); font-weight: 500; }
  .lio-quiz__trust-item svg { width: 15px; height: 15px; color: var(--green); }

  /* ── Review ── */
  .lio-quiz__review { max-width: 480px; margin: 14px auto 0; padding: 18px; background: var(--green-mist); border-radius: var(--radius-sm); text-align: left; animation: lioQuizReveal 0.65s ease 0.8s both; border-left: 3px solid var(--green); }
  .lio-quiz__review-stars { color: #e8a000; font-size: 0.82rem; margin-bottom: 6px; letter-spacing: 1px; }
  .lio-quiz__review-text { font-size: 0.83rem; color: var(--text); line-height: 1.6; font-style: italic; margin-bottom: 6px; }
  .lio-quiz__review-author { font-size: 0.73rem; color: var(--text-lt); font-weight: 600; }

  /* ── Disclaimer ── */
  .lio-quiz__disclaimer { max-width: 480px; margin: 22px auto 0; font-size: 0.66rem; color: #999; text-align: center; line-height: 1.5; animation: lioQuizReveal 0.65s ease 1s both; }

  /* ── Option pulse animation ── */
  @keyframes lioQuizPulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.012); }
    100% { transform: scale(1); }
  }
  .lio-quiz__option.is-pulsing { animation: lioQuizPulse 0.3s ease; }

  /* ── Responsive ── */
  @media (max-width: 520px) {
    .lio-quiz__features { flex-direction: column; align-items: center; gap: 10px; }
    .lio-quiz__trust-bar { flex-direction: column; align-items: center; gap: 10px; }
    .lio-quiz__product-image { height: 200px; }
    .lio-quiz__content { padding: 0 16px; }
  }
</style>


{% comment %} ══════════════════════════════════ HTML ══════════════════════════════════ {% endcomment %}
<div class="lio-quiz" id="lioQuiz">

  {%- comment %} ── Announcement Bar ── {% endcomment -%}
  <div class="lio-quiz__announce">
    Free Shipping from €20 &nbsp;·&nbsp; 30-Day Money-Back Guarantee &nbsp;·&nbsp; Produced in the Netherlands
  </div>

  {%- comment %} ── Header with Logo ── {% endcomment -%}
  <header class="lio-quiz__header">
    <a href="{{ routes.root_url }}">
      <img src="{{ logo_url }}" alt="Lio®" loading="eager" />
    </a>
  </header>

  {%- comment %} ── Progress Bar (hidden until quiz starts) ── {% endcomment -%}
  <div class="lio-quiz__progress" id="lioProgress" style="display:none">
    <div class="lio-quiz__progress-track">
      <div class="lio-quiz__progress-fill" id="lioProgressFill" style="width:0%"></div>
    </div>
    <div class="lio-quiz__progress-label" id="lioProgressLabel">Question 1 of 4</div>
  </div>

  {%- comment %} ── Main Content Area ── {% endcomment -%}
  <div class="lio-quiz__content">

    {%- comment %} ═══════ LANDING SCREEN ═══════ {% endcomment -%}
    <div class="lio-quiz__screen is-active" id="lioScreen-landing">
      <div class="lio-quiz__landing">

        <div class="lio-quiz__badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          100,000+ People Made the Switch
        </div>

        <h1>Which Lio® Is<br><em>Perfect for You?</em></h1>
        <p class="lio-quiz__subtitle">Answer 4 quick questions and we'll match you with the exact Lio device &amp; flavour cores designed for your lifestyle.</p>

        {%- comment %} ── Hero Image ── {% endcomment -%}
        <div class="lio-quiz__hero">
          <img
            src="{{ hero_img_url }}"
            alt="Lio® Classic vs Pro — The original flavored air device"
            loading="eager"
            width="1280"
            height="1280"
          />
        </div>

        <div class="lio-quiz__features">
          <div class="lio-quiz__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>Takes 30 seconds</div>
          <div class="lio-quiz__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>Personalized result</div>
          <div class="lio-quiz__feature"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>0% nicotine</div>
        </div>

