    answers['q' + q] = v;

    /* Visual selection */
    var siblings = el.parentElement.querySelectorAll('.lio-quiz__option');
    for (var i = 0; i < siblings.length; i++) {
      siblings[i].classList.remove('is-selected', 'is-pulsing');
    }
    el.classList.add('is-selected', 'is-pulsing');

    /* Show affirmation */
    var affirm = document.getElementById('lioAffirm' + q);
    if (affirm) setTimeout(function() { affirm.classList.add('is-visible'); }, 180);

    /* Auto-advance */
    setTimeout(function() {
      if (q < 4) {
        updateProgress(q + 1);
        showScreen('q' + (q + 1));
        window.scrollTo({ top: 0, behavior: 'smooth' });
