    "instant_6_ta2_uu_zb_jng9_i_bn7_zG7qRF": {
      "type": "instant-6TA2UUZbJNG9IBn7",
      "name": "Our Risk Reversal Section",
      "settings": {
        "text_RqeYeB830WbfWaJt": "<p>You can try lio</p>",
        "text_rMvlqLcboGKkprue": "<p>30 DAYS </p><p>RISK FREE</p>",
        "text_ZaClVx3vMwIHsUiP": "<p>Try Lio for a month. If it&apos;s not helping,</p><p>return it for a full refund, no questions asked.</p>",
        "url_gbrE9ibdXe9fIZpB": "shopify://products/lio®-journey-pack-1",
