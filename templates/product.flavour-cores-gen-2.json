        "text_oQmHRffhRGF09uvV": "<p>4.5</p>",
        "text_P7aYoqMjbNUUxLVa": "<h3>Lio® FLAVOUR CORES</h3>",
        "text_T7298DcybYtEFxbd": "<p>92% Succesrate</p>",
        "text_KN8DckJx9aatHkgU": "<p>No Nicotine</p>",
        "text_slL2nqcC8bOBrAkq": "<p>100% Natural</p>",
        "text_ctUNxadd2eVI3fGh": "<p><strong>\"The Simplest Way to Break Bad Habits\"</strong></p>",
        "text_qeGDzyfEvwvH8buY": "<p>Nicotine-free, natural flavoured air designed to help you break free effortlessly and build better habits.</p>",
        "text_M7vBUYsZmdTrhmWp": "<p>Cores Version:</p>",
        "text_SonQaobnzWlfMhw4": "<p>Classic</p>",
        "text_SwU1C7Ue8SHeJzrG": "<p>Gen 2</p>",
        "text_VoBAZ7kJMsTYahSG": "<h3>Original</h3>",
        "text_7qygQUgDUX2qFXb1": "<p>You save </p>",
        "text_YTEyPNdEkeA3zBZV": "<p>Most Popular</p>",
