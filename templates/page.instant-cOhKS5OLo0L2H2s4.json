        "url_JTQiLx0d6ldiHp3A": "#shopify-block-AbEdORFVxNzdmMnQ2S__loox_reviews_loox_agg_section_FxbYj8",
        "text_NlMttJvre1Gyr4np": "<p>SEE MORE REVIEWS</p>",
