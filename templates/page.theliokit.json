        "r3":  { "type": "review", "settings": { "quote": "The site, the product, the promises — <mark>all real.</mark> I use mine every single day now.", "name": "Pedro C.", "avatar_letter": "", "avatar_from": "#9ab8d1", "avatar_to": "#5a7896", "stars": 5, "verified": true } },
        "r4":  { "type": "review", "settings": { "quote": "The resistance, the flavor, the ritual — <mark>perfectly satisfying.</mark> I'm genuinely happy with myself.", "name": "Michelle K.", "avatar_letter": "", "avatar_from": "#94fca9", "avatar_to": "#4fb36a", "stars": 5, "verified": true } },
        "r5":  { "type": "review", "settings": { "quote": "Mint, Cinnamon, Cold Turkey — my three favourites. <mark>Very good and satisfying.</mark>", "name": "Thomas B.", "avatar_letter": "", "avatar_from": "#d4a5b8", "avatar_to": "#8a5d7a", "stars": 5, "verified": true } },
        "r6":  { "type": "review", "settings": { "quote": "First week was weird. Now I don't know how I got through meetings without it. <mark>It's just there, quiet, in my pocket.</mark>", "name": "Anna K.", "avatar_letter": "", "avatar_from": "#b9c9a6", "avatar_to": "#6e8a52", "stars": 5, "verified": true } },
        "r7":  { "type": "review", "settings": { "quote": "Flew Amsterdam to Dubai with it in hand the whole way. <mark>No one blinked. No one stopped me.</mark>", "name": "Sofia M.", "avatar_letter": "", "avatar_from": "#eac488", "avatar_to": "#b07a2e", "stars": 5, "verified": true } },
        "r8":  { "type": "review", "settings": { "quote": "Cinnamon is unreal. My partner keeps stealing it. <mark>We ordered a second one.</mark>", "name": "David L.", "avatar_letter": "", "avatar_from": "#d4a05a", "avatar_to": "#7a4b1b", "stars": 5, "verified": true } },
