        "faq_vape": {
          "type": "faq_question",
          "settings": {
            "q": "Is this a vape?",
            "a": "<p>No. A wooden aromatherapy diffuser. No battery, no coil, no liquid, no heating element. You breathe ordinary air through a wooden mouthpiece — the plant-oil core at the end gives it flavor and a cool menthol sensation. Nothing is heated, nothing is combusted.</p>"
          }
        },
        "faq_feel": {
          "type": "faq_question",
          "settings": {
            "q": "Will it feel like what I'm used to?",
            "a": "<p>Partly. The menthol cores give a real <strong>cool throat hit</strong> on the inhale — the physical sensation is there. What's not there is the nicotine kick. Think of it as the feeling without the substance.</p>"
          }
        },
        "faq_lasts": {
          "type": "faq_question",
          "settings": {
            "q": "How long does one core last?",
            "a": "<p>Around <strong>7–10 days for a light user, 3–5 days if you use it heavily.</strong> The flavor is strongest the first day and gradually fades — when you can barely smell it before inhaling, swap it. The wooden body stays with you; only the core changes.</p>"
          }
        },
        "faq_inside": {
          "type": "faq_question",
          "settings": {
            "q": "What's actually in the cores?",
            "a": "<p>Medical-grade polyester fiber infused with <strong>food-safe plant essential oils</strong> — peppermint, cinnamon, mango, orange, depending on the variant. No synthetic aromas, no solvents, no propylene glycol. Third-party tested, every batch.</p>"
          }
        },
        "faq_refund": {
          "type": "faq_question",
          "settings": {
            "q": "What if it doesn't work for me?",
            "a": "<p>Try it for <strong>90 days</strong>. Use it the way it's meant to be used — every time you'd reach for your old habit. If the ritual doesn't land, <strong>full refund, used or not.</strong> No 'must be sealed' fine print, no restocking fee.</p>"
          }
        },
        "faq_ship": {
          "type": "faq_question",
          "settings": {
            "q": "How fast does it arrive?",
            "a": "<p>Shipped from the Netherlands. <strong>2–3 working days across Europe, 4–8 days outside.</strong> Free worldwide, no minimum. Tracking link by email the moment it leaves the warehouse.</p>"
          }
        },
