        "r10": { "type": "review", "settings": { "quote": "The weight in the hand is the thing. Heavier than you'd think. <mark>Feels like a real object, not a gadget.</mark>", "name": "Clara B.", "avatar_letter": "", "avatar_from": "#c8a1b1", "avatar_to": "#76445d", "stars": 5, "verified": true } },
