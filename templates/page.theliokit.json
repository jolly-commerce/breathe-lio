        "r1":  { "type": "review", "settings": { "quote": "Two years in and Lio is still the first thing I reach for. It just became <mark>part of how I live now.</mark>", "name": "Natascha H.", "avatar_letter": "", "avatar_from": "#c4a57b", "avatar_to": "#8b6a47", "stars": 5, "verified": true } },
