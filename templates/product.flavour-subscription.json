    "ecom_faq_9JNHQA": {
      "type": "ecom-faq",
      "blocks": {
        "question_Xa8UUH": {
          "type": "question",
          "settings": {
            "title": "What are the ingredients?",
            "content": "<p>Lio® Flavour Cores are crafted with 100% natural ingredients, offering a nicotine-free solution to help break harmful habits. Delivering clean, flavoured air without smoke, vapor, or chemicals, ensuring a safe, effective, and satisfying alternative for relieving cravings.</p>"
          }
        },
        "question_ipPnxK": {
          "type": "question",
          "settings": {
            "title": "What does flavored air taste like?",
            "content": "<p>If you’re used to vapor, Lio might feel lighter at first—but it’s designed for a healthier future. Think of Lio as herbal tea compared to the sticky soda of vapor: less intense, more natural, and far better for you.</p>"
          }
        },
        "question_BE4wCE": {
          "type": "question",
          "settings": {
            "title": "What are cores made of?",
            "content": "<p>Each Core fiber is medical grade polyester, infused in the fiber is our unique plant blend of pure essential oils from amazing farms we've partnered with around the world.</p>"
          }
        },
        "question_fKTip9": {
          "type": "question",
          "settings": {
            "title": "How long do the Lio Cores last?",
            "content": "<p>Each Lio Core lasts 2-4 days, depending on your usage. Heavy users may need to replace the cores more frequently, but they are designed to provide lasting flavor and a satisfying experience.</p>"
          }
        },
        "question_UMTRXM": {
          "type": "question",
          "settings": {
            "title": "How often can I use Lio?",
            "content": "<p>Use Lio as often as you like. If you experience any discomfort, please discontinue use and consult your physician.</p>"
          }
        },
        "question_9PTRMQ": {
          "type": "question",
          "settings": {
            "title": "Is Lio safe to use?",
            "content": "<p>Lio is made with 100% natural ingredients and is completely free from nicotine, smoke, and harmful chemicals, making it a safe and healthier alternative for people trying to quit smoking or vaping.</p>"
          }
        },
        "question_KBPhnx": {
          "type": "question",
          "settings": {
            "title": "Shipping & Refunds",
            "content": "<p><strong>Worldwide shipping - For Free<br/></strong>We ship worldwide from the Netherlands with free shipping on all orders. Delivery takes 2-3 days within Europe, 4-8 days outside Europe, and next-day delivery in the Middle East (from Dubai).<br/><br/><strong>The Money Back Guarantee</strong><br/>If you’ve used Lio™, commit to a 30 days to experience its benefits. After completing the 30-day journey, you have 7 days to request a refund if you’re not satisfied. This ensures you have enough time to fully explore its impact before making a decision.</p>"
          }
        },
        "question_LG34Gj": {
          "type": "question",
          "settings": {
            "title": "How does Lio work?",
            "content": "<p>Lio works by replacing the hand-to-mouth fixation with naturally infused air, offering calming, refreshing flavors without nicotine, smoke, or chemicals. This action helps reduce the psychological need for smoking or vaping while keeping you engaged with familiar habits.</p>"
          }
        },
        "question_KznXfV": {
          "type": "question",
          "settings": {
            "title": "Question",
            "content": "<p>Share some content to your customers about your products.</p>"
          }
        },
        "question_kmmrPa": {
          "type": "question",
          "settings": {
            "title": "Can I use Lio anywhere?",
            "content": "<p>Yes! Lio produces no smoke, vapor, or harmful chemicals, so it can be used in most places where smoking or vaping are not allowed. Its discreet and clean design makes it a convenient, portable option to carry and use anywhere, whether you’re at home, work, or on the go.</p>"
          }
        },
