        "text_Xs4K2SWY4FB3Xtbs": "<p>Great Taste</p>",
        "text_sj2CyJBEWv5KaxfI": "<p>Replaced Hand to Mouth Habit</p>",
        "text_HH3qL5pntSAZOalp": "<p>No Nicotine Intake</p>",
