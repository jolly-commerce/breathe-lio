        "text_BPPRXQMqXbTYvO98": "<p>Verified </p>",
        "text_J2hHECZ9LEP42Idx": "<p>— Omar Khalid</p>",
        "text_QJPn5Nr3hf9EkK14": "<p>\"It's insane—this stuff really helps. I'm really, really satisfied with it.\"</p><p></p><p></p>",
