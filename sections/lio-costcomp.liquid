<!-- ================== COST COMPARISON ================== -->
{%- if section.settings.compact -%}
<style>
  /* Compact mode keeps the headline at full size — only tightens spacing
     and shrinks meta/foot text. Bars become a horizontal mobile slider. */
  .costcomp.cc-compact { padding: 28px 16px !important; }
  .costcomp.cc-compact .costcomp-inner { max-width: 760px; }
  .costcomp.cc-compact .costcomp-head { margin-bottom: 20px; }
  .costcomp.cc-compact .costcomp-sub { font-size: 14px; max-width: 540px; margin: 0 auto; }
  .costcomp.cc-compact .section-eyebrow { margin-bottom: 8px !important; font-size: 11px; }
  .costcomp.cc-compact .costcomp-bars { gap: 10px !important; margin: 18px 0; }
  .costcomp.cc-compact .costcomp-savings { padding: 14px 16px !important; gap: 10px; }
  .costcomp.cc-compact .costcomp-foot { font-size: 11px; line-height: 1.5; opacity: 0.7; margin-top: 14px; }

  /* Mobile slider for bars */
  @media (max-width: 768px) {
    .costcomp.cc-compact .costcomp-bars {
      display: flex !important;
      flex-direction: row !important;
      grid-template-columns: none !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 12px !important;
      padding: 4px 16px 18px;
      margin-left: -16px;
      margin-right: -16px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .costcomp.cc-compact .costcomp-bars::-webkit-scrollbar { display: none; }
    .costcomp.cc-compact .costcomp-bar {
      flex: 0 0 78%;
      scroll-snap-align: center;
      max-width: 78%;
    }
    .costcomp.cc-compact .costcomp-savings { flex-direction: column; align-items: flex-start; text-align: left; }
    .costcomp.cc-compact .costcomp-savings-right { font-size: 28px !important; }
  }
</style>
{%- endif -%}

<section class="costcomp{% if section.settings.compact %} cc-compact{% endif %}" id="cost">
  <div class="costcomp-inner">
    {%- if template.suffix == 'theliokit' -%}
    <div class="ccx-tk">
      <div class="ccx-tk-head">
        <span class="ccx-tk-eyebrow">Your monthly habit</span>
        <h2 class="ccx-tk-h2">
          The habit isn't <em>free.</em><br>
          Lio just costs less.
        </h2>
      </div>

      <div class="ccx-tk-grid">
        <div class="ccx-tk-card ccx-tk-card--bad">
          <div class="ccx-tk-card-head">
            <span class="ccx-tk-card-tag">Your old daily habit</span>
            <span class="ccx-tk-card-mono">recurring · disposable</span>
          </div>
          <div class="ccx-tk-card-price">
            <span class="ccx-tk-card-num">€345</span>
            <span class="ccx-tk-card-unit">per month</span>
          </div>
          <ul class="ccx-tk-card-list">
            <li>~€11.50 every day</li>
            <li>Disposable, never owned</li>
            <li>Cost continues forever</li>
          </ul>
        </div>

        <div class="ccx-tk-card ccx-tk-card--good">
          <span class="ccx-tk-card-flag">Lio · first month</span>
          <div class="ccx-tk-card-head">
            <span class="ccx-tk-card-tag">The 60-Day Kit</span>
            <span class="ccx-tk-card-mono">device + 60 days included</span>
          </div>
          <div class="ccx-tk-card-price">
            <span class="ccx-tk-card-num">€69</span>
            <span class="ccx-tk-card-unit">first month</span>
          </div>
          <ul class="ccx-tk-card-list">
            <li>From €0.79/day after</li>
            <li>Device stays yours forever</li>
            <li>Refills from €17/month · pause anytime</li>
          </ul>
        </div>
      </div>

      <div class="ccx-tk-savings">
        <div class="ccx-tk-savings-num">
          <span>≈ €306</span>
          <small>saved / month</small>
        </div>
        <div class="ccx-tk-savings-num">
          <span>≈ €3,670</span>
          <small>saved / year</small>
        </div>
        <div class="ccx-tk-savings-num">
          <span>~3 weeks</span>
          <small>to break even</small>
        </div>
      </div>

      <p class="ccx-tk-foot">
        Based on common monthly spend in 2026 across European markets. Lio comparison uses the €69 60-Day Kit (device + 60 days of cores). Ongoing refills from €17/month.
      </p>
    </div>

    <style>
      .costcomp .ccx-tk {
        --tk-forest: #0b2410;
        --tk-cream: #fcfefb;
        --tk-paper: #f8faf6;
        --tk-mint: #94fca9;
        --tk-mint-soft: #cdfee1;
        --tk-line-08: rgba(11,36,16,0.08);
        --tk-line-12: rgba(11,36,16,0.12);
        --tk-text-72: rgba(11,36,16,0.72);
        --tk-text-55: rgba(11,36,16,0.55);
        --tk-mono: "iA Writer Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
        max-width: 980px; margin: 0 auto;
        color: var(--tk-forest);
      }
      .ccx-tk-head { text-align: center; margin-bottom: 28px; }
      .ccx-tk-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--tk-mono);
        font-size: 11px; letter-spacing: 0.22em;
        text-transform: uppercase; color: var(--tk-text-55);
        font-weight: 700; margin-bottom: 12px;
      }
      .ccx-tk-eyebrow::before {
        content: ""; width: 6px; height: 6px; border-radius: 50%;
        background: var(--tk-mint);
      }
      .ccx-tk-h2 {
        margin: 0;
        font-size: clamp(26px, 4.4vw, 40px);
        line-height: 1.05; letter-spacing: -0.03em;
        font-weight: 800; color: var(--tk-forest);
      }
      .ccx-tk-h2 em { font-style: italic; font-weight: 300; color: var(--tk-text-55); }

      /* ─── Side-by-side cards ─── */
      .ccx-tk-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-bottom: 24px;
        align-items: stretch;
      }
      .ccx-tk-card {
        position: relative;
        border-radius: 16px;
        padding: 24px 22px;
        display: flex; flex-direction: column;
      }
      .ccx-tk-card--bad {
        background: var(--tk-paper);
        border: 1px solid var(--tk-line-08);
        color: var(--tk-text-72);
      }
      .ccx-tk-card--good {
        background: var(--tk-forest);
        color: var(--tk-cream);
        border: 1px solid var(--tk-forest);
      }
      .ccx-tk-card-flag {
        position: absolute; top: -11px; left: 22px;
        background: var(--tk-mint); color: var(--tk-forest);
        font-family: var(--tk-mono);
        font-size: 9.5px; letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 700;
        padding: 5px 11px;
        border-radius: 999px;
      }
      .ccx-tk-card-head {
        display: flex; flex-direction: column; gap: 4px;
        margin-bottom: 16px;
      }
      .ccx-tk-card-tag {
        font-size: 14px; font-weight: 700;
        letter-spacing: -0.01em;
      }
      .ccx-tk-card--bad .ccx-tk-card-tag { color: var(--tk-forest); }
      .ccx-tk-card-mono {
        font-family: var(--tk-mono);
        font-size: 10px; letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.7;
      }

      .ccx-tk-card-price {
        display: flex; align-items: baseline; gap: 8px;
        padding: 12px 0 16px;
        margin-bottom: 16px;
        border-bottom: 1px dashed currentColor;
        opacity: 1;
      }
      .ccx-tk-card--bad .ccx-tk-card-price { border-bottom-color: var(--tk-line-12); }
      .ccx-tk-card--good .ccx-tk-card-price { border-bottom-color: rgba(252,254,251,0.18); }
      .ccx-tk-card-num {
        font-size: clamp(36px, 5.6vw, 50px);
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1;
      }
      .ccx-tk-card--bad .ccx-tk-card-num { color: var(--tk-forest); }
      .ccx-tk-card--bad .ccx-tk-card-num::before {
        content: "";
        position: absolute;
      }
      .ccx-tk-card--good .ccx-tk-card-num { color: var(--tk-mint); }
      .ccx-tk-card-unit {
        font-size: 13px;
        opacity: 0.7;
      }

      .ccx-tk-card-list {
        list-style: none; padding: 0; margin: auto 0 0;
        display: flex; flex-direction: column; gap: 6px;
        font-size: 13px; line-height: 1.5;
      }
      .ccx-tk-card-list li {
        display: flex; align-items: flex-start; gap: 8px;
      }
      .ccx-tk-card-list li::before {
        content: "·";
        flex-shrink: 0;
        font-weight: 700;
        font-size: 16px;
        line-height: 1.2;
      }
      .ccx-tk-card--bad .ccx-tk-card-list li::before { color: var(--tk-text-55); }
      .ccx-tk-card--good .ccx-tk-card-list li::before { color: var(--tk-mint); }

      /* ─── Savings strip ─── */
      .ccx-tk-savings {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0;
        background: var(--tk-mint-soft);
        border-radius: 14px;
        padding: 18px 8px;
        margin-bottom: 18px;
      }
      .ccx-tk-savings-num {
        text-align: center;
        padding: 4px 12px;
        border-right: 1px solid rgba(11,36,16,0.10);
      }
      .ccx-tk-savings-num:last-child { border-right: 0; }
      .ccx-tk-savings-num span {
        display: block;
        font-size: clamp(18px, 3vw, 26px);
        font-weight: 800;
        color: var(--tk-forest);
        letter-spacing: -0.02em;
        line-height: 1.05;
      }
      .ccx-tk-savings-num small {
        display: block;
        font-family: var(--tk-mono);
        font-size: 9.5px; letter-spacing: 0.16em;
        text-transform: uppercase;
        color: rgba(11,36,16,0.65);
        margin-top: 6px;
      }

      .ccx-tk-foot {
        margin: 0;
        font-size: 11.5px;
        line-height: 1.5;
        color: var(--tk-text-55);
        text-align: center;
        max-width: 720px;
        margin-left: auto; margin-right: auto;
      }

      @media (max-width: 720px) {
        .ccx-tk-grid { grid-template-columns: 1fr; gap: 12px; }
        .ccx-tk-card { padding: 22px 18px; }
        .ccx-tk-card-flag { left: 18px; }
        .ccx-tk-savings { grid-template-columns: 1fr; gap: 0; padding: 8px 18px; }
        .ccx-tk-savings-num {
          border-right: 0;
          border-bottom: 1px solid rgba(11,36,16,0.10);
          padding: 12px 0;
        }
        .ccx-tk-savings-num:last-child { border-bottom: 0; }
        .ccx-tk-savings-num span { font-size: 22px; }
      }
    </style>
    {%- else -%}
    <div class="costcomp-head">
      <div class="section-eyebrow" style="margin-bottom: 28px;">What you'd spend this month</div>
      <h2 class="costcomp-h2">
        The habit isn't <span class="italic-word">free.</span><br>
        Lio just costs less.
      </h2>
      <p class="costcomp-sub">
        A month of Lio — <strong>the device included</strong> — is a fraction of what the old habit costs. Same ritual, fewer zeros.
      </p>
    </div>

    <div class="costcomp-bars">
      <div class="costcomp-bar cigs" style="--bar-width: 100%;">
        <div class="costcomp-bar-label">
          <strong>A pack a day</strong>
          <span>20 cigarettes · NL avg. €11.50/pack</span>
        </div>
        <div class="costcomp-bar-track">
          <div class="costcomp-bar-fill">
            <span class="costcomp-bar-note">monthly burn</span>
          </div>
        </div>
        <div class="costcomp-bar-price">
          €345
          <small>per month</small>
        </div>
      </div>

      <div class="costcomp-bar vapes" style="--bar-width: 26%;">
        <div class="costcomp-bar-label">
          <strong>Disposables / pods</strong>
          <span>3-5 devices/pods per month</span>
        </div>
        <div class="costcomp-bar-track">
          <div class="costcomp-bar-fill">
            <span class="costcomp-bar-note">monthly burn</span>
          </div>
        </div>
        <div class="costcomp-bar-price">
          €90
          <small>per month</small>
        </div>
      </div>

      <div class="costcomp-bar lio" style="--bar-width: 11%;">
        <div class="costcomp-bar-label">
          <strong>Lio · first month</strong>
          <span>Device free + 30 days of cores</span>
        </div>
        <div class="costcomp-bar-track">
          <div class="costcomp-bar-fill">
            <span class="costcomp-bar-note">you pay</span>
          </div>
        </div>
        <div class="costcomp-bar-price">
          €39
          <small>first month · less ongoing</small>
        </div>
      </div>
    </div>

    <div class="costcomp-savings">
      <div class="costcomp-savings-left">
        <strong>What switching buys back</strong>
        <span>Around <strong style="color: var(--mint);">€3,670 per year</strong> kept in your pocket vs. a pack-a-day habit. The device stays yours forever.</span>
      </div>
      <div class="costcomp-savings-right">
        ~€306<small>saved / month</small>
      </div>
    </div>

    <p class="costcomp-foot">
      Prices based on early-2026 retail averages: Netherlands €11.50–12.00/pack, UK ~£13–17, Germany ~€8.50, France ~€12.50. Vape estimates use mid-range disposable/pod pricing. Lio comparison uses the €39 Journey Pack (device + 30 days of cores). Ongoing core refills from €17/month.
    </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lio · Cost comparison",
  "tag": "section",
  "class": "section-lio-costcomp",
  "settings": [
    { "type": "checkbox", "id": "compact", "label": "Compact mode", "default": false }
  ],
  "presets": [{ "name": "Lio · Cost comparison" }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
