<style>
  .auto-icon-text {
    --duration1: 100s;
    --gap1: 25px;
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 0px;
    width: 100%;
    margin: auto;
  }
  .auto-icon-text-group {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 0;
    width: max-content;
    animation: scrollNew var(--duration1) linear infinite;
  }
  @keyframes scrollNew {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(calc(-100%));
    }
  }
  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    width: 190px;
    height: 100%;
    border-radius: 10px;
  }
  .width-wrapper-i {
    border-bottom: 1px solid #a4a0a0;
  }
  .right-auto-container {
    display: flex;
    gap: 10px;
    flex-direction: column;
    gap: 10px;
  }
  .box-text-i img.box-reviewer-image {
    height: 70px;
    width: 70px;
    border-radius: 50%;
    border: 2px solid var(--lio-dark-green);
  }
  .box-text-i p {
    color: #302f2f;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.1px;
  }

  .right-auto-container img {
    width: 75px;
  }
  @media screen and (max-width: 600px) {
    .box-text-i {
      width: 360px;
      padding: 20px 15px;
    }
    .box-text-i p {
      font-size: 14px;
    }
    .auto-icon-text {
      --duration1: 50s;
    }
  }
</style>
<div class="width-wrapper-i">
  <div class="auto-icon-text {{ section.settings.custom-class }}">
    {% for i in (1..4) %}
      <div class="auto-icon-text-group">
        {% for block in section.blocks %}
          <div class="logo-container" style="padding: 14px 28px;">
            <img src="{{ block.settings.logo | image_url: width: 400 }}" width="100%" height="100%" />
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "infinite logo section",
  "settings": [
    {
      "type": "text",
      "id": "custom-class",
      "label": "custom class"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "infinite logo section"
    }
  ]
}
{% endschema %}
