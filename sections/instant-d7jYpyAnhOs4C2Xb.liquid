    {
      "type": "richtext",
      "id": "text_FKqyOJevnexwRkx8",
      "label": "Text",
      "default": "<h3>Our best results come from the heaviest users. One customer smoked 60 cigarettes daily for 40 years and succeeded with Lio. If it works for extreme cases like these, it works for you. The heavier your habit, the more dramatic your relief.</h3>"
    },
