<!-- ================== MID-PAGE CTA (catches hot-intent after flavors) ================== -->
<section class="midcta" aria-label="Ready to start">
  <div class="midcta-inner">
    <div class="midcta-content">
      <div class="midcta-eyebrow">Ready when you are</div>
      <h2 class="midcta-h">
        Pick a flavor. <span class="italic-word">Start today.</span>
      </h2>
      <p class="midcta-sub">
        Device free, 30 days of cores, guide included. Under €0.90 per day for the first month.
      </p>
    </div>
    <div class="midcta-right">
      <a href="#offer" class="btn-primary">
        Start — €39
        <span class="arrow" aria-hidden="true"><svg><use href="#arrow"/></svg></span>
      </a>
      <div class="midcta-price">
        <strong>€0.88/day</strong> · Ships in 24h · 30-day refund
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lio · Mid-page CTA",
  "tag": "section",
  "class": "section-lio-midcta",
  "settings": [],
  "presets": [{ "name": "Lio · Mid-page CTA" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
