{{ 'ecom-featured-images.css' | asset_url | stylesheet_tag: preload: true }}

<style>
  .ecom-featured-images {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 0 !important;
    padding-right: 0 !important;

    @media (min-width: 1150px) {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
</style>

<div class="ecom-featured-images">
  <div class="ecom-featured-images__container container">
    {% for block in section.blocks %}
      <div class="ecom-featured-images__item ecom-featured-images__item--{{ block.type }}">
        {% if block.type == 'image' %}
          <img loading="lazy" 
            src="{{ block.settings.image | image_url: width: 500 }}" 
            width="100%" 
            height="100%" 
            alt="{{ block.settings.image.alt | default: '' }}"
          >
        {% elsif block.type == 'text' %}
          {% if block.settings.background_image != blank %}
            <style>.ecom-featured-images__item--text {background-image: url('{{ block.settings.background_image | image_url: width: 500 }}');}</style>
          {% endif %}

          {% render "ecom-trustpilot-label", type: 'small', trustpilot_avatars: block.settings.trustpilot_avatars %}
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "Ecom Featured Images",
    "settings": [
      {
        "type": "header",
        "content": "Paddings",
        "info": "Paddings for section"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Padding Top Desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Padding Bottom Desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 40
      }
    ],
    "blocks": [
      {
        "type": "image",
        "name": "Image",
        "settings": [
          {
            "type": "image_picker", 
            "id": "image",
            "label": "Image"
          }
        ]
      },
      {
        "type": "text", 
        "name": "Text",
        "settings": [
          {
            "type": "image_picker",
            "id": "background_image",
            "label": "Background Image"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "50.000+"
          },
          {
            "type": "text",
            "id": "text",
            "label": "Text",
            "default": "Happy customers"
          },
          { 
            "type": "image_picker",
            "id": "trustpilot_avatars",
            "label": "Trustpilot Avatars"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Ecom Featured Images"
      }
    ]
  }
{% endschema %}