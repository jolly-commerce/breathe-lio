{%- comment -%} ── Shipping countdown ── {%- endcomment -%}
<script>
(function() {
  var MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  var CUTOFF_HOUR   = {{ section.settings.cutoff_hour   | default: 15 }};
  var CUTOFF_MINUTE = {{ section.settings.cutoff_minute | default: 0 }};

  function pad(n) { return String(n).padStart(2,'0'); }
  function sameDay(a,b) {
    return a.getFullYear()===b.getFullYear() && a.getMonth()===b.getMonth() && a.getDate()===b.getDate();
  }
  function fmtCountdown(ms) {
    var s   = Math.floor(ms/1000);
    var h   = Math.floor(s/3600); s -= h*3600;
    var m   = Math.floor(s/60);   s -= m*60;
    var parts = [];
    if (h) parts.push(h+'h');
    if (m) parts.push(m+'m');
    parts.push(pad(s)+'s');
    return parts.join(' ');
  }

  function tick() {
    var now     = new Date();
    var cutoff  = new Date(now.getFullYear(), now.getMonth(), now.getDate(), CUTOFF_HOUR, CUTOFF_MINUTE, 0, 0);
    var isPast  = now >= cutoff;
    var shipDay = new Date(now);
    if (isPast) shipDay.setDate(shipDay.getDate()+1);

    var today    = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var isToday  = sameDay(shipDay, today);
    var dateStr  = (isToday ? 'Ships today, ' : 'Ships tomorrow, ') + MONTHS[shipDay.getMonth()] + ' ' + shipDay.getDate();

    var nextCutoff = new Date(cutoff);
    if (isPast) nextCutoff.setDate(nextCutoff.getDate()+1);
    var diff = Math.max(0, nextCutoff - now);

    document.querySelectorAll('.shipping-date-text').forEach(function(el){ el.textContent = dateStr; });
    document.querySelectorAll('.shipping-countdown-text').forEach(function(el){ el.textContent = fmtCountdown(diff); });
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

{%- comment -%} ── Toggle ── {%- endcomment -%}
<script>
(function() {
  var track   = document.querySelector('.lio-pricing__toggle-track');
  var opts    = document.querySelectorAll('.lio-pricing__toggle-option');
  var cards   = document.querySelectorAll('.lio-card');
  var isLeft  = true;

  function updateCardPrices(card, variant) {
    var prefix     = variant === 'solo' ? 'solo' : 'together';
    var price      = card.dataset[prefix + 'Price'] || '';
    var oldPrice   = card.dataset[prefix + 'OldPrice'] || '';
    var saveAmount = card.dataset[prefix + 'SaveAmount'] || '';
    var image      = card.dataset[prefix + 'Image'] || '';

    var mainEl  = card.querySelector('.pricing-card-price');
    var oldEl   = card.querySelector('.pricing-card-old-price');
    var saveEl  = card.querySelector('.pricing-card-save-amount');
    var saveSpan = saveEl ? saveEl.querySelector('span') : null;
    var imgEl   = card.querySelector('.lio-card__image-img');

    if (mainEl  && price)      mainEl.textContent = price;
    if (oldEl)  { if (oldPrice) { oldEl.textContent = oldPrice; oldEl.style.display='inline'; } else { oldEl.style.display='none'; } }
    if (saveEl) { if (saveAmount && saveSpan) { saveSpan.textContent = '🔥 Save '+saveAmount; saveEl.style.display='flex'; } else { saveEl.style.display='none'; } }
    if (imgEl   && image) imgEl.src = image;
  }

  function setToggle(leftActive) {
    isLeft = leftActive;
    var targetVariant = leftActive ? 'solo' : 'together';

    if (track) {
      track.setAttribute('aria-checked', leftActive ? 'false' : 'true');
    }
    opts.forEach(function(btn, i) {
      var active = leftActive ? i===0 : i===1;
      btn.classList.toggle('lio-pricing__toggle-option--active', active);
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    cards.forEach(function(card) { updateCardPrices(card, targetVariant); });

    var forms = document.querySelectorAll('.pricing-card-add-to-cart-form');
    if (!forms.length) return;
    var handle = document.querySelector('.lio-pricing') && document.querySelector('.lio-pricing').dataset.sectionProductHandle;
    if (!handle && forms[0]) handle = forms[0].dataset.productHandle;
    if (!handle) return;

    fetch('/products/'+handle+'.js')
      .then(function(r){ return r.json(); })
      .then(function(product) {
        var packOpt = leftActive ? 'Start Solo' : 'Start Together';
        forms.forEach(function(form) {
          var input      = form.querySelector('.variant-id-input');
          if (!input) return;
          var lioV = form.dataset.lioVersion || 'decoy';
          var lioOpt = '';
          if      (lioV === 'hero')  lioOpt = 'Lio 90-Day Starter Kit (1 month free + free Lio)';
          else if (lioV === 'decoy') lioOpt = 'Lio 30-Day Starter Kit (free Lio)';

          var matched = product.variants.find(function(v) {
            if (!v.available) return false;
            var hasPack = v.option1===packOpt || v.option2===packOpt || v.option3===packOpt;
            if (!hasPack) return false;
            if (lioOpt) return v.option1===lioOpt || v.option2===lioOpt || v.option3===lioOpt;
            return true;
          }) || product.variants.find(function(v) {
            return v.available && (v.option1===packOpt || v.option2===packOpt || v.option3===packOpt);
          });

          if (matched) {
            input.value = matched.id;
            form.dataset.variantId  = matched.id;
            form.dataset.packVariant = targetVariant;
            var parentCard = form.closest('.lio-card');
            if (parentCard) updateCardPrices(parentCard, targetVariant);
          }
        });
      })
      .catch(function(){});
  }

  /* Init prices */
  cards.forEach(function(card){ updateCardPrices(card,'solo'); });

  /* Wire toggle track */
  if (track) {
    track.addEventListener('click', function() { setToggle(!isLeft); });
    track.addEventListener('keydown', function(e) {
      if (e.key===' '||e.key==='Enter') { e.preventDefault(); setToggle(!isLeft); }
    });
  }

  /* Wire option buttons */
  opts.forEach(function(btn) {
    btn.addEventListener('click', function() {
      setToggle(btn.dataset.target === 'solo');
    });
  });

  setToggle(true);
})();
</script>

{%- comment -%} ── Add to cart ── {%- endcomment -%}
<script>
(function() {
  document.querySelectorAll('.pricing-card-add-to-cart-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var btn      = form.querySelector('.pricing-card-add-to-cart');
      var btnText  = btn.querySelector('.button-text');
      var origText = btnText.textContent;
      var input    = form.querySelector('input[name="id"]');
      var vid      = (input ? input.value : '') || form.dataset.variantId;

      if (!vid || vid==='0' || vid==='') {
        alert('Please wait a moment and try again.');
        return;
      }

      btn.disabled = true;
      btnText.textContent = 'Adding…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: vid, quantity: 1 })
      })
      .then(function(r) {
        if (!r.ok) return r.json().then(function(d){ throw new Error(d.description||d.message||'Error'); });
        return r.json();
      })
      .then(function() {
        window.location.href = '/checkout';
      })
      .catch(function(err) {
        alert(err.message || 'Could not add to cart. Please try again.');
        btn.disabled = false;
        btnText.textContent = origText;
      });
    });
  });
})();
</script>

{%- comment -%} ── Tooltips (mobile tap support) ── {%- endcomment -%}
<script>
(function() {
  var isMobile = window.innerWidth <= 768;
  if (!isMobile) return;

  document.querySelectorAll('.lio-tooltip__trigger').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var bubble  = btn.closest('.lio-tooltip').querySelector('.lio-tooltip__bubble');
      var isOpen  = bubble.classList.contains('lio-tooltip__bubble--visible');

      document.querySelectorAll('.lio-tooltip__bubble--visible').forEach(function(b){ b.classList.remove('lio-tooltip__bubble--visible'); });
      if (!isOpen) bubble.classList.add('lio-tooltip__bubble--visible');
    });
  });

  document.addEventListener('click', function() {
    document.querySelectorAll('.lio-tooltip__bubble--visible').forEach(function(b){ b.classList.remove('lio-tooltip__bubble--visible'); });
  });
})();
</script>

