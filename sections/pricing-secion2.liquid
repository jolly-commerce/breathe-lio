.lio-card__shipping-sub {
  font-family: var(--lio-font-body);
  font-size: 12px;
  color: rgba(10,50,19,.6);
}
.lio-card--hero .lio-card__shipping-sub { color: rgba(250,254,252,.6); }
.lio-card__shipping-countdown { color: var(--lio-green); font-weight: 600; }

/* ── Tooltip ── */
.lio-tooltip {
  position: relative;
  display: inline-flex;
  align-items: center;
}
.lio-tooltip__trigger {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  display: flex;
  color: rgba(10,50,19,.45);
  transition: color .2s;
}
.lio-tooltip__trigger:hover { color: var(--lio-green); }
.lio-card--hero .lio-tooltip__trigger { color: rgba(250,254,252,.45); }
.lio-tooltip__trigger svg { width: 16px; height: 16px; fill: currentColor; }
.lio-tooltip__bubble {
  position: absolute;
  bottom: calc(100% + 10px);
  left: 50%;
  transform: translateX(-50%) translateY(6px);
  width: 260px;
  background: #fff;
  border: 1px solid var(--lio-border-strong);
  border-radius: var(--lio-radius-sm);
  padding: 12px 14px;
  font-family: var(--lio-font-body);
  font-size: 13px;
  line-height: 1.5;
  color: var(--lio-forest);
  box-shadow: var(--lio-shadow-lg);
  opacity: 0;
  visibility: hidden;
  transition: opacity .2s, transform .2s, visibility .2s;
  pointer-events: none;
  z-index: 100;
}
.lio-tooltip__bubble--visible,
.lio-tooltip:hover .lio-tooltip__bubble,
.lio-tooltip:focus-within .lio-tooltip__bubble {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
  pointer-events: auto;
}
.lio-tooltip__arrow {
  position: absolute;
  bottom: -5px;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 10px; height: 10px;
  background: #fff;
  border-right: 1px solid var(--lio-border-strong);
  border-bottom: 1px solid var(--lio-border-strong);
}

/* ── Shared animations ── */
@keyframes lioFadeDown {
  from { opacity:0; transform: translateY(-16px); }
  to   { opacity:1; transform: translateY(0); }
}

/* ── Responsive ── */
@media (max-width: 1024px) {
  .lio-pricing { padding: 64px 24px; }
  .lio-pricing__cards { gap: 20px; }
  .lio-card { flex-basis: 320px; }
}
@media (max-width: 768px) {
  .lio-pricing { padding: 48px 16px; }
  .lio-pricing__cards {
    flex-direction: column;
    align-items: center;
  }
  .lio-card {
    flex: 1 1 100%;
    max-width: 380px;
    width: 100%;
  }
  .lio-pricing__toggle-wrap { gap: 10px; padding: 10px 14px; }
  .lio-pricing__toggle-option { font-size: 13px; }
  .lio-card__main-price { font-size: 28px; }
  .lio-card__cta .button-text { font-size: 13px; }
  .lio-tooltip__bubble {
    left: auto;
    right: 0;
    transform: none;
    bottom: calc(100% + 8px);
    width: calc(100vw - 80px);
    max-width: 280px;
  }
  .lio-tooltip__bubble--visible { transform: none; }
  .lio-tooltip__arrow { left: auto; right: 8px; }
}

/* ── Reduce motion ── */
@media (prefers-reduced-motion: reduce) {
  .lio-pricing__orb,
  .lio-card__glow,
  .lio-card__bonus svg,
  .lio-card__image-shimmer,
  .lio-pricing__banner-pulse { animation: none; }
  .lio-card,
  .lio-pricing__banner,
  .lio-pricing__heading,
  .lio-pricing__subheading,
  .lio-pricing__toggle-wrap { animation: none; }
}
</style>

