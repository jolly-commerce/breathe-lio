  flex-shrink: 0;
}
.lio-card__guarantee-icon--shield { fill: var(--lio-green); }
.lio-card__guarantee-icon--x { fill: #D0D5DD; }

/* ── Divider ── */
.lio-card__divider {
  width: 100%;
  height: 1px;
  background: rgba(10,50,19,.1);
  border-radius: var(--lio-radius-pill);
}
.lio-card--hero .lio-card__divider { background: rgba(255,255,255,.12); }

/* ── Shipping ── */
.lio-card__shipping {
  display: flex;
  align-items: center;
  gap: 10px;
}
.lio-card__shipping-icon {
  width: 20px; height: 20px;
  fill: var(--lio-green);
  flex-shrink: 0;
}
.lio-card__shipping-text {
  display: flex;
  flex-direction: column;
}
.lio-card__shipping-date {
