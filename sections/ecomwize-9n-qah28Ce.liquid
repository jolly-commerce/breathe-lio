          {%- assign price_sp_price = current_variant.price -%}
          {%- assign price_sp_compare = current_variant.compare_at_price -%}
          {%- assign price_has_selling_plan = false -%}
          
          {%- if selected_product.selling_plan_groups.size > 0 -%}
            {%- for allocation in current_variant.selling_plan_allocations -%}
              {%- if forloop.first -%}
                {%- assign price_sp_price = allocation.price -%}
                {%- assign price_sp_compare = allocation.compare_at_price | default: current_variant.price -%}
                {%- assign price_has_selling_plan = true -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
          
          {%- comment -%} Calculate savings {%- endcomment -%}
          {%- assign price_savings_amount = 0 -%}
          {%- assign price_savings_percent = 0 -%}
          {%- if price_sp_compare > price_sp_price -%}
            {%- assign price_savings_amount = price_sp_compare | minus: price_sp_price -%}
            {%- assign price_savings_percent = price_savings_amount | times: 100 | divided_by: price_sp_compare -%}
          {%- endif -%}
          
