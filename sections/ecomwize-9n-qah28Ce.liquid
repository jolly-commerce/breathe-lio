          function initUGCSwiper() {
            var container = document.querySelector('#ecomwize-product01-9n-qah28Ce .product01-ugc-swiper-9n-qah28Ce');
            
            // If container not found yet, retry
            if (!container) {
              if (retryCount < maxRetries) {
                retryCount++;
                setTimeout(initUGCSwiper, retryDelay);
              }
              return;
            }
            
            // If Swiper not loaded yet, retry
            if (typeof Swiper === 'undefined') {
              if (retryCount < maxRetries) {
                retryCount++;
                setTimeout(initUGCSwiper, retryDelay);
              }
              return;
            }
            
            // Already initialized
            if (container.swiper) return;
            
            var navContainer = container.closest('.product01-ugc-carousel');
            var dotsContainer = navContainer ? navContainer.querySelector('.product01-ugc-dots') : null;
            var prevBtn = navContainer ? navContainer.querySelector('.product01-ugc-prev') : null;
            var nextBtn = navContainer ? navContainer.querySelector('.product01-ugc-next') : null;
            
            var swiper = new Swiper(container, {
              slidesPerView: 'auto',
              spaceBetween: 12,
              navigation: {
                prevEl: prevBtn,
                nextEl: nextBtn,
              },
              on: {
                init: function() {
                  updateDots(this);
                  updateNavButtons(this);
                },
                slideChange: function() {
                  updateDots(this);
                  updateNavButtons(this);
                },
                resize: function() {
                  updateDots(this);
                }
              }
            });
            
            function updateDots(swiper) {
              if (!dotsContainer) return;
              var snapCount = swiper.snapGrid ? swiper.snapGrid.length : 1;
              var currentIndex = swiper.snapIndex || 0;
              
              dotsContainer.innerHTML = '';
              for (var i = 0; i < snapCount; i++) {
                var dot = document.createElement('button');
                dot.className = 'product01-ugc-dot' + (i === currentIndex ? ' active' : '');
                dot.setAttribute('type', 'button');
                dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
                (function(index) {
                  dot.addEventListener('click', function() {
                    swiper.slideTo(index);
                  });
                })(i);
                dotsContainer.appendChild(dot);
              }
            }
            
            function updateNavButtons(swiper) {
              if (prevBtn) {
                prevBtn.disabled = swiper.isBeginning;
              }
              if (nextBtn) {
                nextBtn.disabled = swiper.isEnd;
              }
            }
          }
          
          // Start initialization
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initUGCSwiper);
          } else {
            initUGCSwiper();
          }
          
          // Also listen for Shopify section events (theme editor)
          document.addEventListener('shopify:section:load', function(e) {
            if (e.target && e.target.querySelector('.product01-ugc-swiper-9n-qah28Ce')) {
              retryCount = 0;
              setTimeout(initUGCSwiper, 50);
            }
          });
        })();
        </script>
        </div>
        {%- endif -%}
          
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </form>
      </div>
    </div>
    {% endif %}
  </div>


  <!-- Sticky Add to Cart Bar -->
  {% if selected_product != blank %}
  <div class="product01-sticky-bar-9n-qah28Ce" id="product01-sticky-bar-9n-qah28Ce">
    <div class="product01-sticky-inner">
      {% if selected_product.featured_image %}
      <div class="product01-sticky-desktop product01-sticky-thumb">
        <img src="{{ selected_product.featured_image | img_url: '120x120' }}" alt="{{ selected_product.title }}">
      </div>
      {% endif %}
      <div class="product01-sticky-desktop product01-sticky-info">
        <p class="product01-sticky-title">{{ selected_product.title }}</p>
        <p class="product01-sticky-price" data-sticky-price>{%- assign sticky_price = current_variant.price -%}{%- if selected_product.selling_plan_groups.size > 0 -%}{%- for allocation in current_variant.selling_plan_allocations -%}{%- if forloop.first -%}{%- assign sticky_price = allocation.price -%}{%- endif -%}{%- endfor -%}{%- endif -%}{{ sticky_price | money }}</p>
      </div>
      <button 
          type="submit" 
          class="product01-add-to-cart"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            <span class="product01-add-to-cart-text">{{ section.settings.add_to_cart_text | default: 'Add to Cart' }}</span><span class="product01-add-to-cart-divider"></span>{%- assign atc_price = current_variant.price -%}{%- if selected_product.selling_plan_groups.size > 0 -%}{%- for allocation in current_variant.selling_plan_allocations -%}{%- if forloop.first -%}{%- assign atc_price = allocation.price -%}{%- endif -%}{%- endfor -%}{%- endif -%}<span class="product01-add-to-cart-price money" data-atc-price>{{ atc_price | money | strip_html | remove: '&lt;span class=money&gt;' | remove: '&lt;span class=&quot;money&quot;&gt;' | remove: '&lt;/span&gt;' | strip }}</span>
          {% else %}
            <span class="product01-add-to-cart-text">{{ section.settings.sold_out_text | default: 'Sold Out' }}</span>
          {% endif %}
        </button>
    </div>
  </div>
  {% endif %}

</div>

<!-- Variant Data -->
{% if selected_product != blank %}
<script type="application/json" id="product01-variants-9n-qah28Ce">{{ selected_product.variants | json }}</script>
<script type="application/json" id="product01-options-9n-qah28Ce">{{ selected_product.options_with_values | json }}</script>
{% endif %}

<script>
(function() {
  const section = document.getElementById('ecomwize-product01-9n-qah28Ce');
  if (!section) return;
  
  const variantsData = document.getElementById('product01-variants-9n-qah28Ce');
  const variantIdInput = document.getElementById('product01-variant-id-9n-qah28Ce');
  const variantBtns = section.querySelectorAll('[data-option-name][data-option-value]');
  const addToCartBtn = section.querySelector('.product01-container .product01-add-to-cart');

  const priceRowEl = section.querySelector('[data-save-mode]');
  const priceEl = section.querySelector('[data-price-current]') || section.querySelector('.product01-container .product01-price');
  const comparePriceEl = section.querySelector('[data-price-compare]') || section.querySelector('.product01-compare-price');
  const saveBadgeEl = section.querySelector('[data-price-save-badge]') || section.querySelector('.product01-save-badge');
  const saveBadgeValueEl = section.querySelector('[data-price-save-value]');
  const saveBadgeTextEl = section.querySelector('[data-price-save-text]');
  
  const saveDisplayMode = priceRowEl?.dataset?.saveMode || 'percent';

  // Single source of truth: sync sticky bar from main section elements
  function syncStickyBar() {
    var sb = document.getElementById('product01-sticky-bar-9n-qah28Ce');
    if (!sb) return;
    var titlePrice = sb.querySelector('[data-sticky-price]');
    if (titlePrice && priceEl) titlePrice.innerHTML = priceEl.innerHTML;
    var atcPrice = sb.querySelector('.product01-add-to-cart-price');
    var mainAtcPrice = addToCartBtn ? addToCartBtn.querySelector('[data-atc-price]') || addToCartBtn.querySelector('.product01-add-to-cart-price') : null;
    if (atcPrice && mainAtcPrice) atcPrice.innerHTML = mainAtcPrice.innerHTML;
    var stickyBtn = sb.querySelector('.product01-add-to-cart');
    if (stickyBtn && addToCartBtn) {
      var wasDisabled = stickyBtn.disabled;
      stickyBtn.disabled = addToCartBtn.disabled;
      if (addToCartBtn.disabled || wasDisabled !== addToCartBtn.disabled) {
        stickyBtn.innerHTML = addToCartBtn.innerHTML;
      }
    }
  }

  var _currencyRate = 0;
  var _currencyPrefix = '';
  var _currencySuffix = '';
  var _currencyUseComma = false;
  var _currencyDetected = false;

  function _detectCurrency() {
    if (_currencyDetected) return;
    _currencyDetected = true;

    var el = priceEl;
    if (!el) return;
    var rawCents = parseInt(el.dataset.priceRaw || '0', 10);
    if (rawCents <= 0) return;

    var text = (el.textContent || el.innerText || '').trim();
    if (!text) return;

    var numMatch = text.match(/[\d][\d.,]*/);
    if (!numMatch) return;
    var numStr = numMatch[0];

    var lastComma = numStr.lastIndexOf(',');
    var lastDot = numStr.lastIndexOf('.');
    var parsed;

    if (lastComma > lastDot && (numStr.length - lastComma <= 3)) {
      parsed = parseFloat(numStr.replace(/\./g, '').replace(',', '.'));
      _currencyUseComma = true;
    } else {
      parsed = parseFloat(numStr.replace(/,/g, ''));
      _currencyUseComma = false;
    }

    if (!parsed || parsed <= 0 || isNaN(parsed)) return;

    var baseAmount = rawCents / 100;
    _currencyRate = parsed / baseAmount;

    if (_currencyRate < 0.001 || _currencyRate > 10000) {
      _currencyRate = 0;
      return;
    }

    var idx = text.indexOf(numStr);
    _currencyPrefix = text.substring(0, idx);
    _currencySuffix = text.substring(idx + numStr.length);

    section.querySelectorAll('.money').forEach(function(el) {
      el.classList.remove('money');
    });
  }

  function formatMoney(cents) {
    if (!_currencyDetected) _detectCurrency();

    if (_currencyRate > 0 && _currencyRate !== 1) {
      var converted = (cents / 100) * _currencyRate;
      var formatted;
      if (_currencyUseComma) {
        formatted = converted.toFixed(2).replace('.', ',');
      } else {
        formatted = converted.toFixed(2);
      }
      return _currencyPrefix + formatted + _currencySuffix;
    }

    var raw;
    if (typeof Shopify !== 'undefined' && Shopify.formatMoney) {
      raw = Shopify.formatMoney(cents);
    } else {
      var moneyFormat = section.dataset.moneyFormat || '';
      if (!moneyFormat) return (cents / 100).toFixed(2);
      var amount = (cents / 100).toFixed(2);
      var amountNoDecimals = Math.round(cents / 100).toString();
      var amountWithComma = amount.replace('.', ',');
      var amountNoDecimalsWithComma = amountNoDecimals.replace(/(d)(?=(d{3})+$)/g, '$1.');
      var b = String.fromCharCode(123, 123);
      var e = String.fromCharCode(125, 125);
      raw = moneyFormat;
      raw = raw.replace(b + 'amount_no_decimals_with_comma_separator' + e, amountNoDecimalsWithComma);
      raw = raw.replace(b + ' amount_no_decimals_with_comma_separator ' + e, amountNoDecimalsWithComma);
      raw = raw.replace(b + 'amount_with_comma_separator' + e, amountWithComma);
      raw = raw.replace(b + ' amount_with_comma_separator ' + e, amountWithComma);
      raw = raw.replace(b + 'amount_no_decimals' + e, amountNoDecimals);
      raw = raw.replace(b + ' amount_no_decimals ' + e, amountNoDecimals);
      raw = raw.replace(b + 'amount' + e, amount);
      raw = raw.replace(b + ' amount ' + e, amount);
    }
    if (raw) {
      var tmp = document.createElement('div');
      tmp.innerHTML = raw;
      var text = tmp.textContent || tmp.innerText || raw;
      if (text.indexOf('&lt;') !== -1) {
        tmp.innerHTML = text;
        text = tmp.textContent || tmp.innerText || text;
      }
      return text;
    }
    return (cents / 100).toFixed(2);
  }

  function formatSavings(priceRaw, compareRaw) {
    if (!compareRaw || compareRaw <= priceRaw) return '';
    const savingsAmount = compareRaw - priceRaw;
    const savingsPercent = Math.round((savingsAmount / compareRaw) * 100);

    if (saveDisplayMode === 'amount') {
      return formatMoney(savingsAmount);
    } else {
      return savingsPercent + '%';
    }
  }

  function updateSaveValue(el, priceRaw, compareRaw) {
    if (!el) return;
    el.innerHTML = formatSavings(priceRaw, compareRaw);
    if (saveDisplayMode === 'amount') {
      el.classList.add('money');
    } else {
      el.classList.remove('money');
    }
  }

  function triggerCurrencyConvert() {
    document.dispatchEvent(new CustomEvent('shopify:section:rerender'));
  }

  let variants = [];
  let selectedOptions = {};
  
  if (variantsData) {
    try { variants = JSON.parse(variantsData.textContent); } catch (e) {}
  }
  
  if (variants.length > 0) {
    const firstVariant = variants.find(v => v.available) || variants[0];
    if (firstVariant?.options) {
      const optionsData = document.getElementById('product01-options-9n-qah28Ce');
      if (optionsData) {
        try {
          const options = JSON.parse(optionsData.textContent);
          options.forEach((opt, i) => { selectedOptions[opt.name] = firstVariant.options[i]; });
        } catch (e) {}
      }
    }
  }
  
  function findVariant() {
    return variants.find(variant => {
      const optionsData = document.getElementById('product01-options-9n-qah28Ce');
      if (!optionsData) return false;
      try {
        const options = JSON.parse(optionsData.textContent);
        return options.every((opt, i) => selectedOptions[opt.name] === variant.options[i]);
      } catch (e) { return false; }
    });
  }
  
  function updateUI(variant) {
    if (!variant) return;
    var hasSellingPlans = !!section.querySelector('[data-selling-plans]');

    if (variantIdInput) variantIdInput.value = variant.id;

    if (!hasSellingPlans) {
      if (priceEl) {
        priceEl.innerHTML = formatMoney(variant.price);
        priceEl.dataset.priceRaw = variant.price;
      }
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        if (comparePriceEl) {
          comparePriceEl.innerHTML = formatMoney(variant.compare_at_price);
          comparePriceEl.dataset.compareRaw = variant.compare_at_price;
          comparePriceEl.style.display = '';
        }
        if (saveBadgeEl) {
          saveBadgeEl.style.display = '';
          if (saveBadgeValueEl) {
            updateSaveValue(saveBadgeValueEl, variant.price, variant.compare_at_price);
          } else {
            saveBadgeEl.innerHTML = 'Save ' + formatSavings(variant.price, variant.compare_at_price);
          }
        }
      } else {
        if (comparePriceEl) comparePriceEl.style.display = 'none';
        if (saveBadgeEl) saveBadgeEl.style.display = 'none';
      }
    }

    if (addToCartBtn) {
      var textEl = addToCartBtn.querySelector('.product01-add-to-cart-text');
      var priceInBtn = addToCartBtn.querySelector('[data-atc-price]') || addToCartBtn.querySelector('.product01-add-to-cart-price');

      if (variant.available) {
        addToCartBtn.disabled = false;
        if (textEl) textEl.textContent = '{{ section.settings.add_to_cart_text | default: "Add to Cart" }}';
        if (priceInBtn && !hasSellingPlans) priceInBtn.innerHTML = formatMoney(variant.price);
        var iconEl = addToCartBtn.querySelector('.product01-add-to-cart-icon');
        var dividerEls = addToCartBtn.querySelectorAll('.product01-add-to-cart-divider');
        if (iconEl) iconEl.style.display = '';
        if (priceInBtn) priceInBtn.style.display = '';
        dividerEls.forEach(function(d) { d.style.display = ''; });
      } else {
        addToCartBtn.disabled = true;
        if (textEl) {
          textEl.textContent = '{{ section.settings.sold_out_text | default: "Sold Out" }}';
          var iconEl = addToCartBtn.querySelector('.product01-add-to-cart-icon');
          var dividerEls = addToCartBtn.querySelectorAll('.product01-add-to-cart-divider');
          if (iconEl) iconEl.style.display = 'none';
          if (priceInBtn) priceInBtn.style.display = 'none';
          dividerEls.forEach(function(d) { d.style.display = 'none'; });
        }
      }
    }

    if (history.replaceState) {
      var url = new URL(window.location);
      url.searchParams.set('variant', variant.id);
      history.replaceState({}, '', url);
    }

    document.dispatchEvent(new CustomEvent('variant:changed', { detail: { variant } }));
    if (!hasSellingPlans) triggerCurrencyConvert();
    syncStickyBar();
  }
  
  variantBtns.forEach(btn => {
    btn.addEventListener('click', function() {
      const optionName = this.dataset.optionName;
      const optionValue = this.dataset.optionValue;
      
      section.querySelectorAll('[data-option-name="' + optionName + '"]').forEach(container => {
        container.querySelectorAll('[data-option-value]').forEach(b => {
          if (b.dataset.optionValue === optionValue) {
            b.classList.add('selected');
          } else {
            b.classList.remove('selected');
          }
        });
        const labelValue = container.querySelector('[data-selected-value="' + optionName + '"]');
        if (labelValue) labelValue.textContent = optionValue;
      });
      
      selectedOptions[optionName] = optionValue;
      
      const variant = findVariant();
      if (variant) {
        updateUI(variant);
        
        if (section.updateSellingPlansForVariant) {
          section.updateSellingPlansForVariant(variant.id);
        }
        
        if (variant.featured_image?.src) {
          const gallery = document.querySelector('[data-ecomwize-product-gallery][data-section-id="9n-qah28Ce"]');
          if (gallery?.mainSwiper) {
            const slides = gallery.querySelectorAll('[data-main-swiper] .swiper-slide img');
            const variantImageName = variant.featured_image.src.split('?')[0].split('/').pop();
            
            slides.forEach((img, index) => {
              const slideImageName = img.src.split('?')[0].split('/').pop();
              if (slideImageName === variantImageName || img.src.includes(variantImageName)) {
                gallery.mainSwiper.slideTo(index, 300);
              }
            });
          }
        }
      }
    });
  });
  
  const sellingPlansContainer = section.querySelector('[data-selling-plans]');
  if (sellingPlansContainer) {
    const subscribeBox = sellingPlansContainer.querySelector('[data-sp-option="subscribe"]');
    const onetimeBox = sellingPlansContainer.querySelector('[data-sp-option="one-time"]');
    const spInput = sellingPlansContainer.querySelector('[data-sp-input]');
    const frequencySelect = sellingPlansContainer.querySelector('[data-sp-frequency]');
    const subscribePriceEl = sellingPlansContainer.querySelector('[data-sp-subscribe-price]');
    const subscribeCompareEl = sellingPlansContainer.querySelector('[data-sp-subscribe-compare]');
    const onetimePriceEl = sellingPlansContainer.querySelector('[data-sp-onetime-price]');
    const onetimeCompareEl = sellingPlansContainer.querySelector('[data-sp-onetime-compare]');
    const addToCartPriceEl = section.querySelector('[data-atc-price]');
    
    const priceCurrentEl = section.querySelector('[data-price-current]');
    const priceCompareEl = section.querySelector('[data-price-compare]');
    const priceSaveBadgeEl = section.querySelector('[data-price-save-badge]');
    const priceSaveValueEl = section.querySelector('[data-price-save-value]');
    
    let allAllocationsData = {};
    let currentVariantId = sellingPlansContainer.dataset.currentVariantId;
    const allAllocationsScript = sellingPlansContainer.querySelector('.product01-sp-all-allocations-data');
    if (allAllocationsScript) {
      try {
        allAllocationsData = JSON.parse(allAllocationsScript.textContent || '{}');
      } catch (e) {}
    }
    
    function getAllocationsForVariant(variantId) {
      return allAllocationsData[String(variantId)] || [];
    }
    
    function updateSellingPlanPrice(planId) {
      const allocationsData = getAllocationsForVariant(currentVariantId);
      if (!allocationsData.length) return;

      const allocation = allocationsData.find(a => String(a.planId) === String(planId));
      if (allocation) {
        if (subscribePriceEl) subscribePriceEl.innerHTML = formatMoney(allocation.priceRaw);
        if (subscribeCompareEl) {
          subscribeCompareEl.innerHTML = formatMoney(allocation.onetimePriceRaw);
          subscribeCompareEl.style.display = allocation.onetimePriceRaw > allocation.priceRaw ? '' : 'none';
        }
        if (onetimePriceEl) onetimePriceEl.innerHTML = formatMoney(allocation.onetimePriceRaw);
        if (onetimeCompareEl) {
          var hasOTC = allocation.onetimeComparePriceRaw && allocation.onetimeComparePriceRaw > allocation.onetimePriceRaw;
          onetimeCompareEl.innerHTML = hasOTC ? formatMoney(allocation.onetimeComparePriceRaw) : '';
          onetimeCompareEl.style.display = hasOTC ? '' : 'none';
        }

        if (subscribeBox?.classList.contains('selected')) {
          if (addToCartPriceEl) addToCartPriceEl.innerHTML = formatMoney(allocation.priceRaw);
          if (priceCurrentEl) {
            priceCurrentEl.innerHTML = formatMoney(allocation.priceRaw);
            priceCurrentEl.dataset.priceRaw = allocation.priceRaw;
          }
          if (priceCompareEl) {
            priceCompareEl.innerHTML = formatMoney(allocation.onetimePriceRaw);
            priceCompareEl.dataset.compareRaw = allocation.onetimePriceRaw;
            priceCompareEl.style.display = allocation.onetimePriceRaw > allocation.priceRaw ? '' : 'none';
          }
          if (priceSaveValueEl && allocation.onetimePriceRaw > allocation.priceRaw) {
            updateSaveValue(priceSaveValueEl, allocation.priceRaw, allocation.onetimePriceRaw);
          }
          if (priceSaveBadgeEl) {
            priceSaveBadgeEl.style.display = allocation.onetimePriceRaw > allocation.priceRaw ? '' : 'none';
          }
        } else {
          if (addToCartPriceEl) addToCartPriceEl.innerHTML = formatMoney(allocation.onetimePriceRaw);
          if (priceCurrentEl) {
            priceCurrentEl.innerHTML = formatMoney(allocation.onetimePriceRaw);
            priceCurrentEl.dataset.priceRaw = allocation.onetimePriceRaw;
          }
          if (priceCompareEl) {
            var hasOTC2 = allocation.onetimeComparePriceRaw && allocation.onetimeComparePriceRaw > allocation.onetimePriceRaw;
            if (hasOTC2) {
              priceCompareEl.innerHTML = formatMoney(allocation.onetimeComparePriceRaw);
              priceCompareEl.dataset.compareRaw = allocation.onetimeComparePriceRaw;
            }
            priceCompareEl.style.display = hasOTC2 ? '' : 'none';
          }
          if (priceSaveBadgeEl) {
            var hasOTC3 = allocation.onetimeComparePriceRaw && allocation.onetimeComparePriceRaw > allocation.onetimePriceRaw;
            priceSaveBadgeEl.style.display = hasOTC3 ? '' : 'none';
          }
        }

        triggerCurrencyConvert();
        syncStickyBar();
      }
    }

    function updateSellingPlansForVariant(variantId) {
      currentVariantId = variantId;
      sellingPlansContainer.dataset.currentVariantId = variantId;

      const allocationsData = getAllocationsForVariant(variantId);
      if (!allocationsData.length) return;

      const allocation = allocationsData[0];
      const selectedPlanId = frequencySelect?.value || allocation?.planId;

      if (selectedPlanId) {
        updateSellingPlanPrice(selectedPlanId);
      }
    }
    
    section.updateSellingPlansForVariant = updateSellingPlansForVariant;
    
    function updateSellingPlanUI(isSubscribe) {
      var allocationsData = getAllocationsForVariant(currentVariantId);
      var selectedPlanId = frequencySelect ? frequencySelect.value : (subscribeBox ? subscribeBox.dataset.spPlanId : null);
      var allocation = allocationsData.find(function(a) { return String(a.planId) === String(selectedPlanId); }) || allocationsData[0];

      if (subscribeBox && onetimeBox) {
        if (isSubscribe) {
          subscribeBox.classList.add('selected');
          subscribeBox.querySelector('.product01-sp-radio')?.classList.add('selected');
          onetimeBox.classList.remove('selected');
          onetimeBox.querySelector('.product01-sp-radio')?.classList.remove('selected');
          if (spInput && frequencySelect) {
            spInput.value = frequencySelect.value;
          } else if (spInput && subscribeBox.dataset.spPlanId) {
            spInput.value = subscribeBox.dataset.spPlanId;
          }
          if (addToCartPriceEl && subscribePriceEl) addToCartPriceEl.innerHTML = subscribePriceEl.innerHTML;
          if (priceCurrentEl && subscribePriceEl) {
            priceCurrentEl.innerHTML = subscribePriceEl.innerHTML;
            if (allocation) priceCurrentEl.dataset.priceRaw = allocation.priceRaw;
          }
          if (priceCompareEl && allocation) {
            if (subscribeCompareEl && allocation.onetimePriceRaw > allocation.priceRaw) {
              priceCompareEl.innerHTML = subscribeCompareEl.innerHTML;
              priceCompareEl.dataset.compareRaw = allocation.onetimePriceRaw;
              priceCompareEl.style.display = '';
            } else {
              priceCompareEl.style.display = 'none';
            }
          }
          if (priceSaveBadgeEl && allocation) {
            priceSaveBadgeEl.style.display = allocation.onetimePriceRaw > allocation.priceRaw ? '' : 'none';
          }
          if (priceSaveValueEl && allocation && allocation.onetimePriceRaw > allocation.priceRaw) {
            updateSaveValue(priceSaveValueEl, allocation.priceRaw, allocation.onetimePriceRaw);
          }
        } else {
          subscribeBox.classList.remove('selected');
          subscribeBox.querySelector('.product01-sp-radio')?.classList.remove('selected');
          onetimeBox.classList.add('selected');
          onetimeBox.querySelector('.product01-sp-radio')?.classList.add('selected');
          if (spInput) spInput.value = '';
          if (addToCartPriceEl && onetimePriceEl) addToCartPriceEl.innerHTML = onetimePriceEl.innerHTML;
          if (priceCurrentEl && onetimePriceEl) {
            priceCurrentEl.innerHTML = onetimePriceEl.innerHTML;
            if (allocation) priceCurrentEl.dataset.priceRaw = allocation.onetimePriceRaw;
          }
          if (priceCompareEl && allocation) {
            var hasCompare = allocation.onetimeComparePriceRaw && allocation.onetimeComparePriceRaw > allocation.onetimePriceRaw;
            if (hasCompare && onetimeCompareEl) {
              priceCompareEl.innerHTML = onetimeCompareEl.innerHTML;
              priceCompareEl.dataset.compareRaw = allocation.onetimeComparePriceRaw;
              priceCompareEl.style.display = '';
            } else {
              priceCompareEl.style.display = 'none';
            }
          }
          if (priceSaveBadgeEl && allocation) {
            var hasCompare = allocation.onetimeComparePriceRaw && allocation.onetimeComparePriceRaw > allocation.onetimePriceRaw;
            priceSaveBadgeEl.style.display = hasCompare ? '' : 'none';
          }
          if (priceSaveValueEl && allocation) {
            var hasCompare = allocation.onetimeComparePriceRaw && allocation.onetimeComparePriceRaw > allocation.onetimePriceRaw;
            if (hasCompare) {
              updateSaveValue(priceSaveValueEl, allocation.onetimePriceRaw, allocation.onetimeComparePriceRaw);
            }
          }
        }
      }
      syncStickyBar();
    }

    if (subscribeBox) {
      subscribeBox.addEventListener('click', () => updateSellingPlanUI(true));
    }
    
    if (onetimeBox) {
      onetimeBox.addEventListener('click', () => updateSellingPlanUI(false));
    }
    
    if (frequencySelect) {
      frequencySelect.addEventListener('change', (e) => {
        if (spInput) spInput.value = e.target.value;
        updateSellingPlanPrice(e.target.value);
      });
      frequencySelect.addEventListener('click', (e) => e.stopPropagation());
    }
    
  }
  
  const form = document.getElementById('product01-form-9n-qah28Ce');
  if (form) {
    let originalButtonContent = '';
    
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(form);
      const variantId = formData.get('id');
      const sellingPlan = formData.get('selling_plan');
      if (!variantId) return;
      
      const spinnerSVG = '<svg class="product01-add-to-cart-spinner" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>';
      
      if (addToCartBtn) {
        originalButtonContent = addToCartBtn.innerHTML;
        addToCartBtn.disabled = true;
        addToCartBtn.innerHTML = spinnerSVG + '<span class="product01-add-to-cart-text">Adding...</span>';
      }
      
      const cartData = { id: variantId, quantity: 1 };
      if (sellingPlan) cartData.selling_plan = sellingPlan;
      
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cartData)
      })
      .then(response => response.json())
      .then(data => {
        
          // Restore button
          if (addToCartBtn) {
            addToCartBtn.disabled = false;
            addToCartBtn.innerHTML = originalButtonContent;
          }
          // Upcart app cart
          if (window.upcartRefreshCart) {
            window.upcartRefreshCart();
          }
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        if (addToCartBtn) {
          addToCartBtn.disabled = false;
          addToCartBtn.innerHTML = originalButtonContent;
        }
      });
    });
  }

  // Sticky Add to Cart Bar
  const stickyBar = document.getElementById('product01-sticky-bar-9n-qah28Ce');

  const mainAtcButton = section ? section.querySelector('.product01-container .product01-add-to-cart') : null;
  if (stickyBar && mainAtcButton) {
    // Show/hide sticky bar based on ATC button scroll position
    function checkStickyVisibility() {
      var rect = mainAtcButton.getBoundingClientRect();
      if (rect.bottom < 0) {
        stickyBar.classList.add('product01-sticky-visible');
      } else {
        stickyBar.classList.remove('product01-sticky-visible');
      }
    }
    window.addEventListener('scroll', checkStickyVisibility, { passive: true });
    checkStickyVisibility();

    // Sticky ATC button triggers main form submit
    const stickyAtcBtn = stickyBar.querySelector('.product01-add-to-cart');
    if (stickyAtcBtn) {
      stickyAtcBtn.addEventListener('click', function(e) {
        e.preventDefault();
        const variantId = variantIdInput ? variantIdInput.value : null;
        if (!variantId) return;

        const sellingPlanInput = document.querySelector('#product01-form-9n-qah28Ce [name="selling_plan"]');
        const cartData = { id: variantId, quantity: 1 };
        if (sellingPlanInput && sellingPlanInput.value) cartData.selling_plan = sellingPlanInput.value;

        const spinnerSVG = '<svg class="product01-add-to-cart-spinner" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256"><path d="M232,128a104,104,0,0,1-208,0c0-41,23.81-78.36,60.66-95.27a8,8,0,0,1,6.68,14.54C60.15,61.59,40,93.27,40,128a88,88,0,0,0,176,0c0-34.73-20.15-66.41-51.34-80.73a8,8,0,0,1,6.68-14.54C208.19,49.64,232,87,232,128Z"></path></svg>';
        const originalContent = stickyAtcBtn.innerHTML;
        stickyAtcBtn.disabled = true;
        stickyAtcBtn.innerHTML = spinnerSVG + '<span class="product01-add-to-cart-text">Adding...</span>';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(cartData)
        })
        .then(response => response.json())
        .then(data => {
          stickyAtcBtn.disabled = false;
          stickyAtcBtn.innerHTML = originalContent;
          
          // Upcart app cart
          if (window.upcartRefreshCart) {
            window.upcartRefreshCart();
          }
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          stickyAtcBtn.disabled = false;
          stickyAtcBtn.innerHTML = originalContent;
        });
      });
    }

  }

})();
</script>

