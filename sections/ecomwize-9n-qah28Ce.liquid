            {%- assign variant_savings_percent = variant_savings_amount | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="product01-compare-price money" data-price-compare data-compare-raw="{{ current_variant.compare_at_price }}">{{ current_variant.compare_at_price | money | strip_html | remove: '&lt;span class=money&gt;' | remove: '&lt;span class=&quot;money&quot;&gt;' | remove: '&lt;/span&gt;' | strip }}</span>
            <span class="product01-save-badge" data-price-save-badge>
              <span data-price-save-text>{{ price_badge_text }}</span>
              <span {%- if price_display_mode == 'amount' -%}class="money"{%- endif -%} data-price-save-value>{%- if price_display_mode == 'amount' -%}{{ variant_savings_amount | money | strip_html | remove: '&lt;span class=money&gt;' | remove: '&lt;span class=&quot;money&quot;&gt;' | remove: '&lt;/span&gt;' | strip }}{%- else -%}{{ variant_savings_percent }}%{%- endif -%}</span>
            </span>
          {%- endif -%}
        </div>
        </div>
