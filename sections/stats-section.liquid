<style>
  .stats-section{
    width : 100%;
    margin-bottom : 10px;
  }
  .stats-top{
    border-top : 1px solid #BEBBBB;
     border-bottom : 1px solid #BEBBBB;
    padding : 30px 0px;
    display  : flex;
     width : 100%;
  }
  .stats-top-left {
    width: 50%;
    display: flex;
    flex-direction: column;
    gap: 15px;
    align-items: flex-start;
}
  .stats-top-left h2.h3{
    font-size : 35px;
  }
   .stats-top-left h2.h3 span{
    color : var(--lio-light-green);
   }
   .stats-section a.gradient-button span{
     font-weight : 400;
   }
  span.stat-pre-text{
    font-weight : 600;
    color : #434343;
    font-size : 13px;
  }
 span.stat-pre-text-2 {
    font-weight: 500;
    color: #434343;
    font-size: 14px;
    padding-left: 53px;
}
 .stats-full-width {
    display: flex;
    width: 100%;
    gap: 20px;
    margin-top: 30px;
}
 .single-stat {
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: center;
}
 .single-stat h4 {
    font-size: 75px;
    font-family: sigum;
    line-height: 1;
   color : #302F2F;
   letter-spacing : -1.4px;
}
  .single-stat p{
    text-align : center;
    text-wrap : balance;
    color : #434343;
    font-weight : 500;
    font-size : 14px;
  }
  .second-st.single-stat h4 {
    color : #00B67A;
  } 
  .stat-disclaimer{
    color : #434343;
    font-size : 13px;
    margin-top : 10px;
    font-weight : 500;
  }
  .stats-section .gradient-button{
    width : 100%;
    max-width : 240px;
    padding : 8px 0px;
    text-align : center;
  }
   @media screen and (max-width: 990px){
     .stats-top {
    padding: 30px 0px;
    display: flex;
    width: 100%;
    flex-direction: column;
}
     .stats-top-left {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: center;
}
   .stats-full-width {
    display: flex;
    width: 100%;
    gap: 20px;
    margin-top: 30px;
    flex-direction: column;
    margin-bottom: 25px;
}
     .stats-top-left h2.h3 {
    font-size: 35px;
    text-align: center;
    max-width: 300px;
}
     span.stat-pre-text-2 {
    font-weight: 500;
    color: #434343;
    font-size: 14px;
    padding-left: 0px;
}
     .single-stat {
    display: flex;
    flex-direction: row;
    gap: 5px;
    align-items: flex-start;
}
   .single-stat p {
    text-align: left;
    font-size: 14px;
    padding-top: 10px;
    max-width: 200px;
}
     .single-stat h4 {
    font-size: 65px;
    font-family: sigum;
    line-height: 1;
    letter-spacing: -1.4px;
    min-width: 140px;
}
     .single-stat.second-st h4{
       min-width: 190px;
     }
     .stats-top-right {
    display: flex;
    flex-direction: column;
    align-items: center;
}
     .stat-disclaimer {
    text-align: center;
    text-wrap: balance;
}
   }
</style>

<div class="width-wrapper stats-outer">
  <div class="stats-section">
    <div class="stats-top">
      <div class="stats-top-left">
        <span class="stat-pre-text">{{ section.settings.sub }}</span>
         <h2 class="h3">{{ section.settings.heading }}  <span>{{ section.settings.highlighted-heading }}</span></h2>
           {% if section.settings['button-text'] != blank %}
              {% assign journey_pack = all_products['new-lio®-journey-pack'] %}
   
            <a class="gradient-button hidden sm:block" href="{{ section.settings.button-url }}">{{ section.settings['button-text'] }} <span>{{ journey_pack.price | money_without_trailing_zeros }}</span></a>
          {% endif %}
            <span class="stat-pre-text-2  sm:hidden">{{ section.settings.sub-2 }}</span>
      </div>
      <div class="stats-top-right">
         <span class="stat-pre-text-2 hidden sm:block">{{ section.settings.sub-2 }}</span>
      <div class="stats-full-width">
  <div class="single-stat">
    <h4>{{ section.settings.stat-1 }}%</h4>
    <p>{{ section.settings.stat-1-text }}</p>
  </div>
  <div class="single-stat second-st">
    <h4>{{ section.settings.stat-2 }}%</h4>
    <p>{{ section.settings.stat-2-text }}</p>
  </div>
  <div class="single-stat">
    <h4>{{ section.settings.stat-3 }}%</h4>
    <p>{{ section.settings.stat-3-text }}</p>
  </div>
</div>
 {% if section.settings['button-text'] != blank %}
  
            <a class="gradient-button sm:hidden" href="{{ section.settings.button-url }}">{{ section.settings['button-text'] }} <span>{{ journey_pack.price | money_without_trailing_zeros }}</span></a>
          {% endif %}
         
 
 


      </div>
    </div>
    <p class="stat-disclaimer">{{ section.settings.disclaimer }}</p>
  </div>
</div>
<script>
  // Helper to animate number
  function animateValue(element, end, duration = 2000) {
    let start = 0;
    let startTime = null;

    const step = (timestamp) => {
      if (!startTime) startTime = timestamp;
      const progress = timestamp - startTime;
      const val = Math.min(Math.floor((progress / duration) * end), end);
      element.textContent = val + '%';
      if (val < end) {
        requestAnimationFrame(step);
      }
    };

    requestAnimationFrame(step);
  }

  // Intersection Observer to trigger when section is visible
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('.stats-section');
    const statElements = section.querySelectorAll('.single-stat h4');
    let hasAnimated = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !hasAnimated) {
          statElements.forEach((el) => {
            const endValue = parseInt(el.textContent.replace('%', ''), 10);
            animateValue(el, endValue);
          });
          hasAnimated = true;
        }
      });
    }, { threshold: 0.5 });

    observer.observe(section);
  });
</script>


