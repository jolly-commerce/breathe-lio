<style>

    .new-home-banner{
      overflow : hidden;
       width : 100%;

    }
    .new-home-banner-wrapper{
      width : 100%;


    }
    .new-home-slide {
      width: 100%;
      min-width : 100%;
      background-size: cover !important;
      background-position: center center !important;
      background-repeat: no-repeat !important;
      overflow : hidden;
       height: 100%;
  }
   .new-home-slide-inner {
      width: 100%;
     max-width : 1400px;
      padding: 0px 30px;
      min-height: min(75vh, 900px);
      margin: auto;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 20px;
      position: relative;
  }
   .new-home-banner .swiper-wrapper {
      height: 100%;
  }
   .new-home-banner .swiper-slide{
       height: 100%;
      color : var(--lio-white);
    }
   .new-home-slide-inner h2.h1 {
       color: var(--lio-white);
      z-index: 1;
      font-size: 80px;
      max-width: 700px;
      line-height: 0.9;
      letter-spacing: -1.2px;
      text-wrap: balance;
  }
    .new-home-slide-inner h2.h1 span {
      color:#bfedde;


     }
   .new-home-slide-inner p{
        font-size : 18px;
       color: var(--lio-white);
          max-width : 100%;
         text-wrap : balance;
         line-height : 1.25;
     max-width : 500px;

   }
   .new-home-left {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 17px;
      width: 100%;

    }

     .new-home-slide-inner .truspilot-block {
      gap: 12px;
      display: flex;
      align-items: center;
      margin-bottom: 10px;
  }
    .new-home-slide-inner  .truspilot-block p {
      font-size: 14px;
      margin-bottom: -5px;
  }
     .new-home-slide-inner .trustpilot-rating{
        width : 80px;
      }


  .swiper-pagination-banner.swiper-pagination-bullets {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-top: 10px;
      gap: 10px;
  }
  span.swiper-pagination-bullet {
      transition: all 0.3s ease;
      background: transparent;
      width: fit-content;
      height: fit-content;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      color: black !Important;
      opacity: 1 !important;
      font-size : 17px;
  }

   span.swiper-pagination-bullet:after {
      content: "";
      display: inline-block;
      height: 2px;
      background: black;
      width: 0px;
      margin: auto 0px;
     transition : all 1s ease;
  }
   .swiper-pagination-banner.swiper-pagination-bullets .swiper-pagination-bullet-active::after {
     width: 60px;
     border-radius : 3px;
  }
    .free-shipping-text{
      display : flex;
      gap : 8px;
      letter-spacing : 0px;
      font-size : 15px;
    }
    .free-shipping-text p{
      font-size : 17px ;
      font-weight : 600;

    }
    .new-home-slide-inner .gradient-button {
      position: relative;
      z-index: 10;
      pointer-events: auto;

    }

  @media (max-width: 768px) {

    .new-home-slide-inner .gradient-button {
      background: var(--lio-button);
      position: relative;
  z-index: 10;
  pointer-events: auto;
      color: var(--lio-white);

  }

   .swiper-button-next-home-banner,
    .swiper-button-prev-home-banner{
      display : none !Important;
    }

   .new-home-slide-inner  .truspilot-block p{
        font-size: 13px;
      }

    .new-home-slide {
      background-position: center center;
      background-size: cover;
    }
  .new-home-slide-inner {
      padding: 30px 10px 20px 10px;
      min-height: max(71vh,595px) ;
      justify-content: flex-start;
      gap: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
  }
    .new-home-right img{
      width : 90% !important;
      height : 90% !important;
    }
    .new-home-left {
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width : 100%;
  }
     .new-home-right {
      width : 100%;
  }

  .new-home-slide-inner h2.h1 {
      font-size: 40px;
      letter-spacing: -0.2px;
      margin-bottom: 10px;
      max-width: 330px;
      text-align: center;
      text-wrap: auto;
    font-family: var(--heading-font-family);
  }
  .new-home-slide-inner p {
      font-size: 14px;
      line-height: 1.3;
      margin-bottom: 10px;
      text-align: center;
  }
  .new-home-slide-inner .gradient-button {
      background: var(--lio-button);
    color: var(--lio-white);
    padding: 11px 60px;
    font-size:16px;
  }

   }
  }
</style>

{% for block in section.blocks %}
  <style>
       {% if block.settings.image-1 != blank %}
          .{{ block.id }} .new-home-slide {
            background-image: url('{{ block.settings.image-1 | img_url: 'master' }}');
          }
       .{{ block.id }} .new-home-slide .gradient-button:hover{
      background : var(--lio-yellow);
      color : var(--lio-yellow);
      box-shadow:
        -0px 0px 0px 0px var(--lio-yellow),
      -0px 0px 0px 0px var(--lio-yellow);
      -webkit-box-shadow:
        -0px 0px 0px 0px var(--lio-yellow),
        -0px 0px 0px 0px var(--lio-yellow);
      -moz-box-shadow:
          -0px 0px 0px 0px var(--lio-yellow),
        -0px 0px 0px 0px var(--lio-yellow);
        margin : 0px 0px 8px 0px;
    }
        {% endif %}

    @keyframes breathing {
      0%, 100% {
        transform: scale(1);
        color: var(--lio-white);
      }
      50% {
        transform: scale(1.02);
        color: #9fe3ce;
      }
    }

    .new-home-slide-inner h2.h1 span {
      display: inline-block;
      animation: breathing 4s infinite ease-in-out;
      transform-origin: left center;
    }
      @media (max-width: 768px) {
      .new-home-slide-inner h2.h1 span {
        transform-origin: center;
      }
    }


      @keyframes ctaFlow {
      0%, 100% {
        transform: scale(1);
        box-shadow: -3px 4px 0px 0px var(--lio-dark-green), -4px 5px 0px 0px var(--lio-yellow);
      }
      50% {
        transform: scale(1.05);
        box-shadow: -6px 8px 0px 0px var(--lio-dark-green), -8px 10px 0px 0px var(--lio-yellow);
      }
    }

    .new-home-slide-inner .gradient-button {
      animation: ctaFlow 4s infinite ease-in-out;
    }



      @media (max-width: 768px) {
        {% if block.settings.image-2 != blank %}
          .{{ block.id }} .new-home-slide {
            background-image: url('{{ block.settings.image-2 | img_url: 'master' }}');
          }
        .{{ block.id }} .new-home-slide .gradient-button:hover{
      background : var(--lio-yellow);
      color : var(--lio-yellow);
      box-shadow:
        -0px 0px 0px 0px var(--lio-yellow),
      -0px 0px 0px 0px var(--lio-yellow);
      -webkit-box-shadow:
        -0px 0px 0px 0px var(--lio-yellow),
        -0px 0px 0px 0px var(--lio-yellow);
      -moz-box-shadow:
          -0px 0px 0px 0px var(--lio-yellow),
        -0px 0px 0px 0px var(--lio-yellow);
        margin : 0px 0px 8px 0px;
    }
        {% endif %}
      }


      .new-home-slide-inner .gradient-button {
      background: var(--lio-button);
      color: var(--lio-white);
    }
  </style>
{% endfor %}
<div class="new-home-banner jc-bg-red">
  <div class="new-home-banner-wrapper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide {{ block.id }}">
          <div
            class="new-home-slide"
          >
            <div class="new-home-slide-inner ">
              <div class="new-home-left">
                <div class="truspilot-block">
                  <img
                    class="trustpilot-rating"
                    src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/green-stars.svg"
                  >
                  <p>
                    {{ block.settings['trust-text'] }}
                  </p>
                </div>
                <h2 class="h1">
                  {{ block.settings.heading }}
                  <span>{{ block.settings['highlighted-heading'] }}</span>
                </h2>

                {% if block.settings['sub-text'] != blank %}
                  <p>
                    {{ block.settings['sub-text'] }}
                  </p>
                {% endif %}
                {% if block.settings['button-text'] != blank %}
                  <a class="gradient-button " href="{{ block.settings.button-url }}">
                    {{- block.settings['button-text'] -}}
                  </a>
                  <div class="free-shipping-text">
                    {% if block.settings.image_icon != blank %}
                      <img src="{{ block.settings.image_icon | image_url: width: 200 }}">
                    {% endif %}
                    <p>{{ block.settings['free-text'] }}</p>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
    <!--
      <div class="swiper-pagination-banner"></div>
      <div class="swiper-button-next-home-banner"></div>
      <div class="swiper-button-prev-home-banner"></div>
    -->
  </div>
</div>

{% schema %}
{
  "name": "new-homepage-banner",
  "settings": [],
  "blocks": [
    {
      "type": "Slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image-1",
          "label": "desktop image"
        },
        {
          "type": "image_picker",
          "id": "image-2",
          "label": "mobile image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text"
        },
        {
          "type": "text",
          "id": "highlighted-heading",
          "label": "highlighted-heading"
        },
        {
          "type": "text",
          "id": "sub-text",
          "label": "sub text"
        },
        {
          "type": "text",
          "id": "trust-text",
          "label": "trust text"
        },
        {
          "type": "url",
          "id": "button-url",
          "label": "Button URL"
        },
        {
          "type": "text",
          "id": "button-text",
          "label": "Button Text"
        },
        {
          "type": "text",
          "id": "free-text",
          "label": "Free shipping Text",
          "default": "Free shipping available above €50"
        },
        {
          "type": "image_picker",
          "id": "image_icon",
          "label": "icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "new-homepage-banner"
    }
  ]
}
{% endschema %}
