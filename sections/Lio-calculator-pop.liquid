 <style>
    .calc-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.6);
      justify-content: center;
      align-items: center;
      z-index: 1000;
    }
    .calc-calculator {
      background: #F9F5E9;
      border-radius: 30px;
      padding: 40px 50px;
      max-width: 600px;
      width : 96%;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      text-align: center;
      position: relative;
      border : 1px solid #005128;
    }
 .calc-calculator  h2.h2{
  font-size : 45px;

}
    .calc-close {
      position: absolute;
      top: 20px;
      right: 20px;
      cursor: pointer;
      font-size: 17px;
      width : 17px;
    }
   .calc-close img{
     width : 100%;
   }
   .calc-tabs {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    padding-top: 15px;
}
    .calc-tabs button {
       width: 120px;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 10px;
    font-size: 18px;
    letter-spacing: -1px;
    font-weight: 600;
    box-shadow: -3px 4px 0 0 var(--lio-dark-green);
    -webkit-box-shadow: -3px 4px 0px 0px var(--lio-dark-green);
    -moz-box-shadow: -3px 4px 0px 0px var(--lio-dark-green);
    margin: 0 0 8px 4px;
    transition: all .4s ease;
    background-color: transparent;
    color: var(--lio-dark-green);
      border : 1px solid var(--lio-dark-green);
      padding : 5px;
    }
  
    .calc-tabs .calc-active {
      background-color: var(--lio-yellow);
     
    }
   .calc-slider {
  -webkit-appearance: none;
  width: 100%;
  height: 6px;
  border-radius: 3px;
  background: linear-gradient(to right, #00B67A 75%, lightgrey 75%);
  outline: none;
}

/* Chrome & Safari */
.calc-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  height: 20px;
  width: 20px;
  border-radius: 50%;
  background: #00B67A;
  cursor: pointer;
  margin-top: -3px; /* Centers the thumb on 6px track */
  box-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
}

/* Firefox */
.calc-slider::-moz-range-thumb {
  height: 20px;
  width: 20px;
  border-radius: 50%;
  background: #00B67A;
  cursor: pointer;
  border: none;
  box-shadow: 0 0 2px rgba(0, 0, 0, 0.2);
}

.calc-slider::-moz-range-track {
  background: linear-gradient(to right, #00B67A 75%, lightgrey 75%);
  height: 6px;
  border-radius: 3px;
}

/* Edge (legacy IE) */
.calc-slider::-ms-thumb {
  height: 16px;
  width: 16px;
  border-radius: 50%;
  background: #00B67A;
  cursor: pointer;
  border: none;
}

.calc-slider::-ms-fill-lower {
  background: #00B67A;
}

.calc-slider::-ms-fill-upper {
  background: lightgrey;
}
.calc-container {
  width: 100%;
  margin-top: 12px;
}

.slider-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 0px;
  font-size: 18px;
  font-weight : 600;
  color: #C2D1BF;
}


    .calc-grid {
      display: flex;
      justify-content: space-between;
      margin: 20px 0;
    }
    
    .calc-savings {
    color: var(--lio-light-green);
    margin: 30px 0 15px 0;
    text-transform: uppercase;
    font-family: 'Sigum';
    font-size: 30px;
    letter-spacing: -0.8px;
}
    .calc-btn {
      max-width: 400px;
      width : 95%;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 15px;
    font-size: 20px;
    letter-spacing: -0.5px;
    font-weight: 600;
    box-shadow: -3px 4px 0 0 var(--lio-dark-green);
    -webkit-box-shadow: -3px 4px 0px 0px var(--lio-dark-green);
    -moz-box-shadow: -3px 4px 0px 0px var(--lio-dark-green);
   margin : auto;
    transition: all .4s ease;
    background-color: var(--lio-yellow);
    color: var(--lio-dark-green);
      padding : 10px;
    }
   p.per-week-container{
     margin-top : 20px;
     text-align : center;
     font-weight : 600;
     font-size : 18px;
   }
  .current-spend-label, .lio-spend-label {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -0.5px;
       max-width : 180px;
}
   .current-spend-label{
     text-align : left;
  
   }
   .lio-spend-label{
      text-align : right;
   }
  .calc-column-1 {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap : 15px;
    border-right : 1px solid #00512830;
}
   .calc-column-2 {
    width: 50%;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
       gap : 15px;
}
   .change-rate span{
     font-weight : 400;
     font-family :'Sigum';
     font-size : 26px;
     padding-right : 8px;
     letter-spacing: -0.5px;
   }
   p.change-rate {
    font-size: 14px;
    font-weight: 600;
    color: #005128;
    letter-spacing: -0.3px;
}
    @media only screen and (max-width: 999px){
      .calc-calculator {
    padding: 60px 20px 30px 20px;
   
}
      .calc-calculator  h2.h2 {
    font-size: 32px;
}
      .current-spend-label, .lio-spend-label {
    font-size: 18px;
    max-width: 130px;
}
 .change-rate span {
    font-weight: 400;
    font-family: 'Sigum';
    font-size: 22px;
    padding-right: 0px;
    letter-spacing: -0.5px;
    display: block;
    line-height: 1;
}
   .calc-column-1   p.change-rate {
   
    text-align: left;
}
      .calc-column-2 p.change-rate {
   
    text-align: right;
}
      .calc-savings {
    color: var(--lio-light-green);
    margin: 30px auto 15px auto;
    text-transform: uppercase;
    font-family: 'Sigum';
    font-size: 25px;
    letter-spacing: -0.8px;
    line-height: 1;
    max-width: 280px;
    text-wrap: balance;
}
    }
  </style>

<div class="calc-overlay" id="calcOverlay">
    <div class="calc-calculator">
      <span class="calc-close" id="calcClose"><img loading="lazy" src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/crosswa.svg?v=1749814944" /></span>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="calc-tabs">
        <button id="calcCigaretteBtn">smoke</button>
        <button id="calcVapeBtn" class="calc-active">vape</button>
      </div>
   <p class="per-week-container">
  <span id="perWeekLabel">{{ section.settings.per_week_label_2 }}</span>
  <span id="calcCountDisplay">30</span>
</p>
     <div class="calc-container">
  <input type="range" min="0" max="40" value="30" class="calc-slider" id="calcCountSlider">
  <div class="slider-labels">
    <span>0</span>
    <span>40</span>
  </div>
</div>

      <div class="calc-grid">
        <div class="calc-column-1">
         <p class="current-spend-label">
  {{ section.settings.current_spend_label }}
</p>
         <p class="change-rate">
  <span id="calcCurrentMonth">€0.00</span> 
  {{ section.settings.per_month_label }}
</p>

<p class="change-rate">
  <span id="calcCurrentYear">€0.00</span> 
  {{ section.settings.per_year_label }}
</p>
        </div>
        <div class="calc-column-2">
         <p class="lio-spend-label">
  {{ section.settings.lio_spend_label }}
</p>

<p class="change-rate">
  <span id="calcLioMonth">€0.00</span> 
  {{ section.settings.per_month_label }}
</p>

<p class="change-rate">
  <span id="calcLioYear">€0.00</span> 
  {{ section.settings.per_year_label }}
</p>
         
        </div>
      </div>
      <p class="calc-savings">
  {{ section.settings.you_save_label }} 
  <span id="calcSavingsText">€0.00</span> 
  {{ section.settings.per_year_label }}
</p>
      <a href="#" class="calc-btn">Make the switch & save</a>
    </div>
  </div>

 <script>
  const slider = document.getElementById("calcCountSlider");

  function updateSliderBackground(slider) {
    const min = slider.min;
    const max = slider.max;
    const val = slider.value;
    const percentage = ((val - min) / (max - min)) * 100;
    slider.style.background = `linear-gradient(to right, #00B67A ${percentage}%, lightgrey ${percentage}%)`;
  }

  updateSliderBackground(slider);
  slider.addEventListener("input", () => updateSliderBackground(slider));

  const calcOverlay = document.getElementById('calcOverlay');
  const calcClose = document.getElementById('calcClose');
  const calcCountSlider = document.getElementById('calcCountSlider');
  const calcCountDisplay = document.getElementById('calcCountDisplay');
  const calcCurrentMonth = document.getElementById('calcCurrentMonth');
  const calcCurrentYear = document.getElementById('calcCurrentYear');
  const calcLioMonth = document.getElementById('calcLioMonth');
  const calcLioYear = document.getElementById('calcLioYear');
  const calcSavingsText = document.getElementById('calcSavingsText');
  const calcCigaretteBtn = document.getElementById('calcCigaretteBtn');
  const calcVapeBtn = document.getElementById('calcVapeBtn');
  const perWeekLabel = document.getElementById('perWeekLabel');

  const calcPrices = {
    vape: 0.6,
    cigarette: 1,
    lio: 0.2
  };

  const perWeekText = {
    vape: `{{ section.settings.per_week_label_2 }}`,
    cigarette: `{{ section.settings.per_week_label }}`
  };

  let calcType = 'vape';

  function calcUpdateValues() {
    const calcCount = parseInt(calcCountSlider.value);
    calcCountDisplay.textContent = calcCount;

    const calcCurrentPrice = calcType === 'vape' ? calcPrices.vape : calcPrices.cigarette;
    const calcCurrentMonthly = calcCount * calcCurrentPrice * 4;
    const calcCurrentYearly = calcCount * calcCurrentPrice * 52;
    const calcLioMonthly = calcCount * calcPrices.lio * 4;
    const calcLioYearly = calcCount * calcPrices.lio * 52;
    const calcSavings = calcCurrentYearly - calcLioYearly;

    calcCurrentMonth.textContent = `€${calcCurrentMonthly.toFixed(2)}`;
    calcCurrentYear.textContent = `€${calcCurrentYearly.toFixed(2)}`;
    calcLioMonth.textContent = `€${calcLioMonthly.toFixed(2)}`;
    calcLioYear.textContent = `€${calcLioYearly.toFixed(2)}`;
    calcSavingsText.textContent = ` €${calcSavings.toFixed(2)} `;
  }

  // Open calculator popup
  document.querySelectorAll('a[href="#open-calc"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      calcOverlay.style.display = 'flex';
    });
  });

  // Close handlers
  calcClose.addEventListener('click', () => {
    calcOverlay.style.display = 'none';
  });

  calcOverlay.addEventListener('click', (e) => {
    if (e.target === calcOverlay) {
      calcOverlay.style.display = 'none';
    }
  });

  // Button tab switch
  calcCigaretteBtn.addEventListener('click', () => {
    calcType = 'cigarette';
    calcCigaretteBtn.classList.add('calc-active');
    calcVapeBtn.classList.remove('calc-active');
    perWeekLabel.textContent = perWeekText.cigarette;
    calcUpdateValues();
  });

  calcVapeBtn.addEventListener('click', () => {
    calcType = 'vape';
    calcVapeBtn.classList.add('calc-active');
    calcCigaretteBtn.classList.remove('calc-active');
    perWeekLabel.textContent = perWeekText.vape;
    calcUpdateValues();
  });

  calcCountSlider.addEventListener('input', calcUpdateValues);

  // Init
  calcUpdateValues();
</script>

