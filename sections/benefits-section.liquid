 <style>
            .benfits-section{
              display : flex;
              flex-direction : column;
              gap : 10px;
              margin-top : 25px;
            }  
            .benfits-section h2 {
                font-size: 55px;
                text-align: center;
                width: fit-content;
                margin: auto;
              position : relative;
            }
              .benfits-section h2::after {
                content: "";
                position: absolute;
                right: -40px;
                bottom: -10px;
                width: 90px;
                height: 20px;
                background: url("https://cdn.shopify.com/s/files/1/0659/6676/8379/files/Squiggle_Mini_9f.svg?v=1747824794");
                background-size: contain;
                background-repeat: no-repeat;
            }
              .benfits-section h2 span{
                color : var(--lio-light-green);
              }
             .benfits-section p.ben-para{
                text-align : center;
                 max-width : 480px;
               margin : auto;
               
              }
             
            .cl-toggle-switch {
             position: relative;
            }
            
         
.cl-switch {
             position: relative;
             display: inline-block;
   width: 50px;
  height: 30px;
   touch-action: manipulation;       
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
            }
            /* Input */
            .cl-switch > input {
             appearance: none;
             -moz-appearance: none;
             -webkit-appearance: none;
             z-index: -1;
             position: absolute;
             right: 6px;
             top: -8px;
             display: block;
             margin: 0;
             border-radius: 50%;
             width: 50px;
             height: 30px;
             background-color: #00B67A50;
             outline: none;
             opacity: 0;
             transform: scale(1);
             pointer-events: none;
             transition: opacity 0.3s 0.1s, transform 0.2s 0.1s;
            }

  

   .cl-switch > span {
  display: block;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
            /* Track */
            .cl-switch > span::before {
             content: "";
             float: right;
             display: inline-block;
             margin: 5px 0 5px 10px;
             border-radius: 7px;
             width: 50px;
             height: 14px;
             background-color: #00B67A50;
             vertical-align: top;
             transition: background-color 0.2s, opacity 0.2s;
            }
            /* Thumb */
            .cl-switch > span::after {
             content: "";
             position: absolute;
             top: 2px;
             right: 30px;
             border-radius: 50%;
             width: 20px;
             height: 20px;
             background-color: #00B67A;
             box-shadow: 0 3px 1px -2px rgba(0, 0, 0, 0.2), 0 2px 2px 0 rgba(0, 0, 0, 0.14), 0 1px 5px 0 rgba(0, 0, 0, 0.12);
             transition: background-color 0.2s, transform 0.2s;
            }
            /* Checked */
            .cl-switch > input:checked {
             right: 0px;
             background-color: #00B67A50;
            }
            
            .cl-switch > input:checked + span::before {
             background-color: #00B67A50;
            }
            
            .cl-switch > input:checked + span::after {
             background-color: #00B67A;
             transform: translateX(30px);
            }
            /* Hover, Focus */
            .cl-switch:hover > input {
             opacity: 0.04;
            }
            
            .cl-switch > input:focus {
             opacity: 0.12;
            }
            
            .cl-switch:hover > input:focus {
             opacity: 0.16;
            }
            /* Active */
            .cl-switch > input:active {
  opacity: 1;   
  transform: none;
  transition: none;
}
            
            .cl-switch > input:active + span::before {
             background-color: #00B67A;
            }
            
            .cl-switch > input:checked:active + span::before {
             background-color: #00B67A;
            }
            /* Disabled */
            .cl-switch > input:disabled {
             opacity: 0;
            }
            
            .cl-switch > input:disabled + span::before {
             background-color: #00B67A;
            }
            
            .cl-switch > input:checked:disabled + span::before {
             background-color: #00B67A;
            }
            
            .cl-switch > input:checked:disabled + span::after {
             background-color: #00B67A;
            }
            
            
             
