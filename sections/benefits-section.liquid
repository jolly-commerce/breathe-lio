<script>
document.addEventListener('DOMContentLoaded', () => {
  const checkbox   = document.getElementById('myCheckbox');

  // desktop containers
  const one        = document.getElementById('one-select');
  const second     = document.getElementById('second-select');
  // mobile containers
  const mobone     = document.getElementById('mob-one-select');
  const mobsecond  = document.getElementById('mob-second-select');

  function initSvgAnimations(container) {
    if (!container) return;
    container.querySelectorAll('.draw-svg').forEach((svg) => {
      const maskPath = svg.querySelector('mask path');
      if (!maskPath) return;

      // 1) generate a fresh, unique mask ID
      const uniq = `mask-path-${Math.random().toString(36).substr(2, 9)}`;

      // 2) rename the mask itself
      const maskEl = maskPath.closest('mask');
      maskEl.setAttribute('id', uniq);

      // 3) repoint the <g> to use the new mask
      const gEl = svg.querySelector('g[mask]');
      gEl.setAttribute('mask', `url(#${uniq})`);

      // 4) repoint the <mpath> so animateMotion follows the correct mask
      const mpath = svg.querySelector('mpath');
      if (mpath) {
        mpath.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', `#${uniq}`);
      }

      // reset & animate the dash‐offset on the mask path
      const len = maskPath.getTotalLength();
      maskPath.style.transition       = 'none';
      maskPath.style.strokeDasharray  = len;
      maskPath.style.strokeDashoffset = len;
      maskPath.getBoundingClientRect(); // force reflow

      requestAnimationFrame(() => {
        maskPath.style.transition       = 'stroke-dashoffset 1.5s ease-out';
        maskPath.style.strokeDashoffset = 0;
      });

      // kick off the moving dot
      const motion = svg.querySelector('animateMotion');
      if (motion) motion.beginElement();
    });
  }

  function observeSvgOnScroll(container) {
    if (!container) return;
    container.querySelectorAll('.draw-svg').forEach((svg) => {
      const maskPath = svg.querySelector('mask path');
      if (!maskPath) return;

      // generate a fresh mask ID
      const uniq = `mask-path-${Math.random().toString(36).substr(2, 9)}`;
      const maskEl = maskPath.closest('mask');
      maskEl.setAttribute('id', uniq);

      // repoint the <g> to this mask
      const gEl = svg.querySelector('g[mask]');
      gEl.setAttribute('mask', `url(#${uniq})`);

      // repoint the <mpath> too
      const mpath = svg.querySelector('mpath');
      if (mpath) {
        mpath.setAttributeNS('http://www.w3.org/1999/xlink', 'xlink:href', `#${uniq}`);
      }

      // prepare for animation
      const motion = svg.querySelector('animateMotion');
      const len    = maskPath.getTotalLength();
      maskPath.style.strokeDasharray  = len;
      maskPath.style.strokeDashoffset = len;

      // observe when in view
      const io = new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
          maskPath.getBoundingClientRect();
          maskPath.style.transition       = 'stroke-dashoffset 1.5s ease-out';
          maskPath.style.strokeDashoffset = 0;
          if (motion) motion.beginElement();
          obs.unobserve(svg);
        }
      }, { threshold: 0.1 });

      io.observe(svg);
    });
  }

  // run scroll-based observers on all four containers
  [ one, second, mobone, mobsecond ].forEach(el => {
    observeSvgOnScroll(el);
  });

  // toggle handler: show/hide and animate both desktop + mobile
  checkbox.addEventListener('change', () => {
    if (checkbox.checked) {
      one.classList.add('main-hidden');
      mobone.classList.add('main-hidden');
      second.classList.remove('main-hidden');
      mobsecond.classList.remove('main-hidden');
      initSvgAnimations(second);
      initSvgAnimations(mobsecond);
    } else {
      second.classList.add('main-hidden');
      mobsecond.classList.add('main-hidden');
      one.classList.remove('main-hidden');
      mobone.classList.remove('main-hidden');
      initSvgAnimations(one);
      initSvgAnimations(mobone);
    }
  });
});
</script>


