<!-- ================== VIDEO TESTIMONIAL WALL ================== -->
<section class="videowall" id="videos">
  <div class="videowall-inner">
    <div class="videowall-head">
      <div>
        <div class="section-eyebrow">Real hands · Real people</div>
        <h2 class="section-h2">
          See it <span class="italic-word">in the hand</span> before you hold one.
        </h2>
      </div>
      <div class="videowall-head-right">
        <div class="videowall-head-count">
          <strong>150,000+</strong>
          <span>Customers filmed with Lio</span>
        </div>
        <div class="videowall-head-play">
          <svg><use href="#play-solid"/></svg>
        </div>
      </div>
    </div>

    <div class="mobile-swipe-hint">Swipe</div>
    <div class="videowall-grid">
      <div class="video-tile v1" data-video data-name="Peter, 44" data-quote="Eight months in, it's still the first thing I reach for.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:42</div>
        <div class="video-tile-flag" aria-label="Netherlands">🇳🇱</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Peter · 44</div>
          <div class="video-tile-quote">"Eight months in — still the first thing I reach for."</div>
        </div>
      </div>

      <div class="video-tile v2" data-video data-name="Anna, 60" data-quote="One week in and I'm not craving at all.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:31</div>
        <div class="video-tile-flag" aria-label="Netherlands">🇳🇱</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Anna · 60</div>
          <div class="video-tile-quote">"One week in and I'm not craving at all."</div>
        </div>
      </div>

      <div class="video-tile v3" data-video data-name="James, 38" data-quote="I can use it anywhere, nothing comes out.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:54</div>
        <div class="video-tile-flag" aria-label="United Kingdom">🇬🇧</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">James · 38</div>
          <div class="video-tile-quote">"I can use it anywhere. Nothing comes out."</div>
        </div>
      </div>

      <div class="video-tile v4" data-video data-name="Pedro, 51" data-quote="The site, the product, the promises — all real.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:28</div>
        <div class="video-tile-flag" aria-label="Portugal">🇵🇹</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Pedro · 51</div>
          <div class="video-tile-quote">"The product, the promises — all real."</div>
        </div>
      </div>

      <div class="video-tile v5" data-video data-name="Michelle, 34" data-quote="Perfectly satisfying — the resistance, the flavor.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:37</div>
        <div class="video-tile-flag" aria-label="Belgium">🇧🇪</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Michelle · 34</div>
          <div class="video-tile-quote">"Perfectly satisfying. I'm genuinely happy."</div>
        </div>
      </div>

      <div class="video-tile v6" data-video data-name="Antonio, 62" data-quote="This little gadget saved me for the last 20 days.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:45</div>
        <div class="video-tile-flag" aria-label="Italy">🇮🇹</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Antonio · 62</div>
          <div class="video-tile-quote">"This little gadget saved me for 20 days."</div>
        </div>
      </div>

      <div class="video-tile v7" data-video data-name="Thomas, 29" data-quote="Mint, Cinnamon, Cold Turkey — my three favourites.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:52</div>
        <div class="video-tile-flag" aria-label="Germany">🇩🇪</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Thomas · 29</div>
          <div class="video-tile-quote">"Three flavors, one ritual. Very satisfying."</div>
        </div>
      </div>

      <div class="video-tile v8" data-video data-name="Michael, 22" data-quote="Day 14 — it's the only thing that's ever helped.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:24</div>
        <div class="video-tile-flag" aria-label="United Kingdom">🇬🇧</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Michael · 22</div>
          <div class="video-tile-quote">"Day 14 — it's the only thing that's helped."</div>
        </div>
      </div>

      <div class="video-tile v9" data-video data-name="Natascha, 41" data-quote="Two years in and it's part of how I live now.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:48</div>
        <div class="video-tile-flag" aria-label="Netherlands">🇳🇱</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Natascha · 41</div>
          <div class="video-tile-quote">"Two years in — part of how I live now."</div>
        </div>
      </div>

      <div class="video-tile v10" data-video data-name="Kamar, 43" data-quote="People ask what it is, they try it, they order one.">
        <div class="video-tile-bg"></div>
        <div class="video-tile-duration">0:33</div>
        <div class="video-tile-flag" aria-label="France">🇫🇷</div>
        <div class="video-tile-play"><svg><use href="#play-solid"/></svg></div>
        <div class="video-tile-meta">
          <div class="video-tile-name">Kamar · 43</div>
          <div class="video-tile-quote">"People try it and they order one too."</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
