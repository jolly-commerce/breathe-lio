<!-- ================== SECTION 3: HOW IT WORKS ================== -->
<section class="how" id="how">
  <div class="how-inner">
    <div class="how-head">
      <div>
        <div class="section-eyebrow">The mechanism</div>
        <h2 class="section-h2">
          Three steps.<br>
          <span class="italic-word">That's the</span> whole thing.
        </h2>
      </div>
      <div class="how-head-right">
        <p>
          Most habit tools fight the chemistry. Lio works on the <strong>behavior</strong> — the hand reaching for something, the breath drawn in, the tiny pause that resets you.
        </p>
      </div>
    </div>

    <div class="how-steps">
      <div class="how-step">
        <span class="how-step-num">01</span>
        <div class="how-step-visual">
          <svg><use href="#step-insert"/></svg>
        </div>
        <h3 class="how-step-title">Insert <span class="italic-word">a core.</span></h3>
        <p class="how-step-body">
          Unwrap a plant-oil core, fray the tip, slide it into the walnut body. One core lasts roughly ten days.
        </p>
        <div class="how-step-spec">
          <span>No tools · <strong>~30 seconds</strong></span>
        </div>
      </div>

      <div class="how-step">
        <span class="how-step-num">02</span>
        <div class="how-step-visual">
          <svg><use href="#step-inhale"/></svg>
        </div>
        <h3 class="how-step-title">Inhale <span class="italic-word">like normal.</span></h3>
        <p class="how-step-body">
          Draw air through the mouthpiece. It passes over the core, picks up the natural flavor, and leaves only on your breath.
        </p>
        <div class="how-step-spec">
          <span>Airflow-only · <strong>nothing heats up</strong></span>
        </div>
      </div>

      <div class="how-step">
        <span class="how-step-num">03</span>
        <div class="how-step-visual">
          <svg><use href="#step-reset"/></svg>
        </div>
        <h3 class="how-step-title">Reset <span class="italic-word">the urge.</span></h3>
        <p class="how-step-body">
          You got the ritual. You got the pause. You got the breath. The loop closes — without the substance it was built around.
        </p>
        <div class="how-step-spec">
          <span>Use anywhere · <strong>no restrictions</strong></span>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lio · How it works",
  "tag": "section",
  "class": "section-lio-how",
  "settings": [],
  "presets": [{ "name": "Lio · How it works" }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
