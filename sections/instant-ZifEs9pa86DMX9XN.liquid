      "default": "<p>SICHERHEIT UND WISSENSCHAFT</p>"
    },
    {
      "type": "richtext",
      "id": "text_0UrZtvFXvnkOpcEg",
      "label": "Text",
      "default": "<h3>Vertrauenswürdig, Vollkommen Sicher!</h3>"
    },
    {
