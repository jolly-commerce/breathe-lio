<script>
  (function() {
    var root = document.getElementById('lio-science-v2');
    if (!root) return;

    /* Scroll-triggered reveal */
    if (!('IntersectionObserver' in window)) {
      root.querySelectorAll('.lsv2-reveal, .lsv2-reveal-stagger').forEach(function(el){ el.classList.add('is-in'); });
    } else {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry){
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      root.querySelectorAll('.lsv2-reveal, .lsv2-reveal-stagger').forEach(function(el){ io.observe(el); });
    }

    /* Reference pills — scroll + flash highlight */
    root.querySelectorAll('.lsv2-ref[data-ref]').forEach(function(pill){
      pill.addEventListener('click', function(e){
        e.preventDefault();
        var n = pill.getAttribute('data-ref');
        var target = document.getElementById('lsv2-ref-' + n);
        if (!target) return;
        var offset = 100;
        var y = target.getBoundingClientRect().top + window.pageYOffset - offset;
        window.scrollTo({ top: y, behavior: 'smooth' });
        target.classList.remove('is-flash');
        void target.offsetWidth;
        target.classList.add('is-flash');
      });
    });

    /* Hero year counter */
    (function() {
      var fromEl = document.getElementById('lsv2-year-from');
      var toEl = document.getElementById('lsv2-year-to');
      if (!fromEl || !toEl) return;
      var animate = function(el, start, end, duration) {
        var t0 = performance.now();
        var step = function(now) {
          var p = Math.min(1, (now - t0) / duration);
          var eased = 1 - Math.pow(1 - p, 3);
          el.textContent = Math.round(start + (end - start) * eased);
          if (p < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };
      setTimeout(function(){ animate(fromEl, 1990, 1994, 700); }, 700);
      setTimeout(function(){ animate(toEl, 2020, 2024, 700); }, 950);
    })();

    /* Anatomy interactivity */
    (function() {
      var rows = root.querySelectorAll('.lsv2-anatomy-row');
      var rings = root.querySelectorAll('.lsv2-anatomy-core-ring');
      if (!rows.length || !rings.length) return;

      var setActive = function(idx) {
        rings.forEach(function(r, i){ r.classList.toggle('is-active', i === idx); });
        rows.forEach(function(r, i){ r.classList.toggle('is-hover', i === idx); });
      };

      rows.forEach(function(row, i){
        row.addEventListener('mouseenter', function(){ setActive(i); });
        row.addEventListener('mouseleave', function(){ setActive(-1); });
        row.addEventListener('focusin', function(){ setActive(i); });
      });

      if (window.matchMedia('(max-width: 900px)').matches && 'IntersectionObserver' in window) {
        var section = document.getElementById('lsv2-anatomy');
        if (!section) return;
        var timer = null;
        var idx = 0;
        var cycle = function() {
          setActive(idx);
          idx = (idx + 1) % 3;
        };
        var aio = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry){
            if (entry.isIntersecting) {
              cycle();
              timer = setInterval(cycle, 2200);
            } else if (timer) {
              clearInterval(timer);
              timer = null;
              setActive(-1);
            }
          });
        }, { threshold: 0.4 });
        aio.observe(section);
      }
    })();

    /* Ingredients swiper dot indicator */
    (function() {
      var track = document.getElementById('lsv2-ing-track');
      var dotsWrap = document.getElementById('lsv2-ing-dots');
      if (!track || !dotsWrap) return;
      var dots = dotsWrap.querySelectorAll('.lsv2-ingredients-dot');
      if (!dots.length) return;

      var updateDots = function() {
        var slideWidth = track.scrollWidth / 3;
        var idx = Math.round(track.scrollLeft / slideWidth);
        dots.forEach(function(d, i){ d.classList.toggle('is-active', i === idx); });
      };

      track.addEventListener('scroll', updateDots, { passive: true });
      window.addEventListener('resize', updateDots);
      requestAnimationFrame(updateDots);
    })();
  })();
</script>

