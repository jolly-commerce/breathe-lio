  }
  .lsv2 .lsv2-anatomy-row p em { color: var(--lsv2-mint); font-style: italic; }

  /* 5. INGREDIENTS */
  .lsv2 .lsv2-ingredients {
    padding: 96px 0 80px;
  }
  .lsv2 .lsv2-ingredients-head {
    padding: 0 20px;
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }
  .lsv2 .lsv2-ingredients-head .lsv2-h-section {
    margin: 18px auto;
    max-width: 14ch;
  }
  .lsv2 .lsv2-ingredients-head .lsv2-lede { max-width: 540px; margin: 0 auto; }

  .lsv2 .lsv2-ingredients-track-wrap {
    position: relative;
  }
  .lsv2 .lsv2-ingredients-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 20px 24px;
