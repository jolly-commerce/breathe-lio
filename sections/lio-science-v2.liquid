    padding: 100px 20px;
    position: relative;
    overflow: hidden;
  }
  .lsv2 .lsv2-honesty::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 12%, rgba(148, 252, 169, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 80% 88%, rgba(148, 252, 169, 0.04) 0%, transparent 50%);
    pointer-events: none;
  }
  .lsv2 .lsv2-honesty-inner {
    max-width: 980px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .lsv2 .lsv2-honesty-head {
    text-align: center;
