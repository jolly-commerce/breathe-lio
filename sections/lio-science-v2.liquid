  /* 6. COMPARE */
  .lsv2 .lsv2-compare {
    padding: 96px 20px 100px;
    background: var(--lsv2-cream-2);
    border-top: 1px solid var(--lsv2-f-08);
    border-bottom: 1px solid var(--lsv2-f-08);
  }
  .lsv2 .lsv2-compare-head {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .lsv2 .lsv2-compare-head .lsv2-h-section {
    margin: 18px auto;
    max-width: 16ch;
  }
  .lsv2 .lsv2-compare-head .lsv2-lede { max-width: 540px; margin: 0 auto; }

  .lsv2 .lsv2-compare-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    max-width: 980px;
    margin: 0 auto;
  }
  @media (min-width: 700px) {
    .lsv2 .lsv2-compare-grid { grid-template-columns: 1fr 1fr; gap: 16px; }
  }

  .lsv2 .lsv2-compare-col {
    background: var(--lsv2-white);
    border: 1px solid var(--lsv2-f-10);
    border-radius: 20px;
    padding: 28px 24px 24px;
    position: relative;
    overflow: hidden;
  }
  .lsv2 .lsv2-compare-col-head {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--lsv2-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lsv2-f-55);
    margin-bottom: 12px;
  }
  .lsv2 .lsv2-compare-col-head .marker {
    width: 8px; height: 8px;
    border-radius: 50%;
  }
  .lsv2 .lsv2-compare-col.is-vape .marker { background: var(--lsv2-warn); }
  .lsv2 .lsv2-compare-col.is-lio .marker { background: var(--lsv2-mint); }
  .lsv2 .lsv2-compare-col h3 {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin-bottom: 24px;
    color: var(--lsv2-forest);
  }

  .lsv2 .lsv2-compare-diagram {
    position: relative;
    height: 180px;
    background: var(--lsv2-paper);
    border-radius: 12px;
    margin-bottom: 24px;
    overflow: hidden;
    border: 1px solid var(--lsv2-f-06);
  }
  .lsv2 .lsv2-compare-diagram-label {
    position: absolute;
    bottom: 10px; left: 14px;
    font-family: var(--lsv2-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lsv2-f-40);
  }

  .lsv2 .lsv2-vape-device {
    position: absolute;
    top: 50%; left: 12%;
    width: 56px; height: 18px;
    background: linear-gradient(180deg, #555, #333);
    border-radius: 4px;
    transform: translateY(-50%);
  }
  .lsv2 .lsv2-vape-coil {
    position: absolute;
    top: 50%; left: 16%;
    width: 12px; height: 12px;
    background: radial-gradient(circle, #ff6b6b, #b3382a);
    border-radius: 50%;
    transform: translateY(-50%);
    box-shadow: 0 0 16px rgba(255, 107, 107, 0.7);
    animation: lsv2VapeCoilPulse 1.4s ease-in-out infinite;
  }
  @keyframes lsv2VapeCoilPulse {
    0%, 100% { box-shadow: 0 0 12px rgba(255, 107, 107, 0.6); transform: translateY(-50%) scale(1); }
    50% { box-shadow: 0 0 22px rgba(255, 107, 107, 0.9); transform: translateY(-50%) scale(1.1); }
  }
  .lsv2 .lsv2-vape-particle {
    position: absolute;
    width: 8px; height: 8px;
    background: rgba(180, 100, 100, 0.5);
    border-radius: 50%;
    filter: blur(2px);
    animation: lsv2VapeRise 2.4s ease-in infinite;
  }
  .lsv2 .lsv2-vape-particle:nth-child(3) { top: 50%; left: 25%; animation-delay: 0s; }
  .lsv2 .lsv2-vape-particle:nth-child(4) { top: 50%; left: 35%; animation-delay: 0.4s; width: 12px; height: 12px; }
  .lsv2 .lsv2-vape-particle:nth-child(5) { top: 50%; left: 45%; animation-delay: 0.8s; width: 10px; height: 10px; }
  .lsv2 .lsv2-vape-particle:nth-child(6) { top: 50%; left: 60%; animation-delay: 1.2s; width: 14px; height: 14px; opacity: 0.4; }
  .lsv2 .lsv2-vape-particle:nth-child(7) { top: 50%; left: 75%; animation-delay: 1.6s; width: 16px; height: 16px; opacity: 0.3; }
  @keyframes lsv2VapeRise {
    0% { transform: translate(0, 0) scale(0.5); opacity: 0.7; }
    50% { transform: translate(40px, -40px) scale(1.4); opacity: 0.45; }
    100% { transform: translate(80px, -80px) scale(2); opacity: 0; }
  }

  .lsv2 .lsv2-lio-device {
    position: absolute;
    top: 50%; left: 14%;
    width: 14px; height: 64px;
    background: linear-gradient(180deg, #8b6f47, #5a4429);
    border-radius: 5px 5px 8px 8px;
    transform: translateY(-50%);
    box-shadow: inset 0 -4px 8px rgba(0,0,0,0.3);
  }
  .lsv2 .lsv2-lio-device::before {
    content: "";
    position: absolute;
    top: 8%; left: 50%;
    transform: translateX(-50%);
    width: 5px; height: 3px;
    background: rgba(0,0,0,0.4);
    border-radius: 2px;
  }
  .lsv2 .lsv2-lio-airflow {
    position: absolute;
    top: 50%;
    left: 24%;
    width: 8px;
    height: 1.5px;
    background: var(--lsv2-mint);
    border-radius: 1px;
    opacity: 0.8;
    animation: lsv2LioFlow 2.4s linear infinite;
  }
  .lsv2 .lsv2-lio-airflow:nth-of-type(2) { top: calc(50% - 8px); animation-delay: 0.4s; }
  .lsv2 .lsv2-lio-airflow:nth-of-type(3) { top: calc(50% + 8px); animation-delay: 0.8s; }
  .lsv2 .lsv2-lio-airflow:nth-of-type(4) { top: 50%; animation-delay: 1.2s; }
  .lsv2 .lsv2-lio-airflow:nth-of-type(5) { top: calc(50% - 4px); animation-delay: 1.6s; }
  @keyframes lsv2LioFlow {
    0% { transform: translateX(0) scaleX(0.5); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 0.6; }
    100% { transform: translateX(140px) scaleX(2); opacity: 0; }
  }
  .lsv2 .lsv2-lio-aroma {
    position: absolute;
    width: 5px; height: 5px;
    background: var(--lsv2-mint);
    border-radius: 50%;
    opacity: 0;
    animation: lsv2LioAroma 3s ease-in-out infinite;
  }
  .lsv2 .lsv2-lio-aroma:nth-of-type(6) { top: 30%; right: 18%; animation-delay: 0.5s; }
  .lsv2 .lsv2-lio-aroma:nth-of-type(7) { top: 55%; right: 12%; animation-delay: 1.2s; }
  .lsv2 .lsv2-lio-aroma:nth-of-type(8) { top: 70%; right: 22%; animation-delay: 1.8s; }
  @keyframes lsv2LioAroma {
    0% { transform: scale(0); opacity: 0; }
    30% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(0.8) translate(20px, -20px); opacity: 0; }
  }

  .lsv2 .lsv2-compare-flow {
    list-style: none;
    margin: 0 0 24px;
    padding: 0 0 24px;
    border-bottom: 1px solid var(--lsv2-f-08);
  }
  .lsv2 .lsv2-compare-flow li {
    padding: 8px 0;
    font-size: 13px;
    color: var(--lsv2-f-72);
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lsv2 .lsv2-compare-flow li .step {
    width: 22px; height: 22px;
    border-radius: 50%;
    background: var(--lsv2-cream-2);
    color: var(--lsv2-forest);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--lsv2-mono);
    font-size: 10px;
    font-weight: 700;
    flex-shrink: 0;
    border: 1px solid var(--lsv2-f-10);
  }
  .lsv2 .lsv2-compare-col.is-vape .lsv2-compare-flow li .step {
    color: var(--lsv2-warn);
    border-color: rgba(255, 138, 138, 0.4);
    background: rgba(255, 138, 138, 0.06);
  }
  .lsv2 .lsv2-compare-col.is-lio .lsv2-compare-flow li .step {
    color: var(--lsv2-forest);
    background: var(--lsv2-mint-soft);
    border-color: var(--lsv2-mint);
  }
  .lsv2 .lsv2-compare-output {
    font-size: 13px;
    color: var(--lsv2-f-55);
    line-height: 1.55;
  }
  .lsv2 .lsv2-compare-output strong { color: var(--lsv2-forest); font-weight: 600; }

  .lsv2 .lsv2-compare-disclaimer {
    margin: 32px auto 0;
    max-width: 720px;
    padding: 18px 20px;
    background: var(--lsv2-white);
    border: 1px solid var(--lsv2-f-08);
    border-radius: 10px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--lsv2-f-72);
  }
  .lsv2 .lsv2-compare-disclaimer strong { color: var(--lsv2-forest); font-weight: 600; }

  /* 7. TNO */
  .lsv2 .lsv2-tno {
    padding: 100px 20px;
    position: relative;
  }
  .lsv2 .lsv2-tno-inner {
    max-width: 760px;
    margin: 0 auto;
  }
  .lsv2 .lsv2-tno-head {
    text-align: center;
