{%- comment -%}
  Lio · Science v2 — full evidence dossier as a standalone scroll narrative.
  Renders inside the default theme header/footer chrome.
  All classes prefixed `lsv2-` and CSS scoped to .lsv2 to avoid collisions.
{%- endcomment -%}

<section class="lsv2" id="lio-science-v2">

<link rel="preconnect" href="https://use.typekit.net">
<link rel="stylesheet" href="https://use.typekit.net/xhz7hhk.css">

<style>
  .lsv2 {
    --lsv2-forest:    #0b2410;
    --lsv2-forest-2:  #0e2d14;
    --lsv2-white:     #ffffff;
    --lsv2-cream:     #fcfefb;
    --lsv2-cream-2:   #f4f7f2;
    --lsv2-paper:     #f8faf6;
    --lsv2-mint:      #94fca9;
    --lsv2-mint-soft: #cdfee1;
    --lsv2-warn:      #ff8a8a;

    --lsv2-f-04: rgba(11, 36, 16, 0.04);
    --lsv2-f-06: rgba(11, 36, 16, 0.06);
    --lsv2-f-08: rgba(11, 36, 16, 0.08);
    --lsv2-f-10: rgba(11, 36, 16, 0.10);
    --lsv2-f-14: rgba(11, 36, 16, 0.14);
    --lsv2-f-22: rgba(11, 36, 16, 0.22);
    --lsv2-f-40: rgba(11, 36, 16, 0.40);
    --lsv2-f-55: rgba(11, 36, 16, 0.55);
    --lsv2-f-72: rgba(11, 36, 16, 0.72);
    --lsv2-m-35: rgba(148, 252, 169, 0.35);

    --lsv2-c-04: rgba(252, 254, 251, 0.04);
    --lsv2-c-08: rgba(252, 254, 251, 0.08);
    --lsv2-c-12: rgba(252, 254, 251, 0.12);
    --lsv2-c-40: rgba(252, 254, 251, 0.4);
    --lsv2-c-55: rgba(252, 254, 251, 0.55);
    --lsv2-c-72: rgba(252, 254, 251, 0.72);
    --lsv2-c-90: rgba(252, 254, 251, 0.9);

    --lsv2-ease:   cubic-bezier(0.22, 1, 0.36, 1);
    --lsv2-bounce: cubic-bezier(0.34, 1.56, 0.64, 1);
    --lsv2-mono:   ui-monospace, "SF Mono", Menlo, Consolas, monospace;

    background: var(--lsv2-cream);
    color: var(--lsv2-forest);
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-weight: 400;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.005em;
    font-feature-settings: "ss01", "kern";
    display: block;
  }
  .lsv2 *, .lsv2 *::before, .lsv2 *::after { box-sizing: border-box; }
  .lsv2 ::selection { background: var(--lsv2-mint); color: var(--lsv2-forest); }
  .lsv2 img, .lsv2 svg { max-width: 100%; display: block; }
  .lsv2 a { color: inherit; text-decoration: none; }
  .lsv2 button { font-family: inherit; }

  .lsv2 .lsv2-italic { font-style: italic; font-weight: 300; }
  .lsv2 .lsv2-mono { font-family: var(--lsv2-mono); }

  /* Scroll reveal */
  .lsv2 .lsv2-reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.9s var(--lsv2-ease), transform 0.9s var(--lsv2-ease);
  }
  .lsv2 .lsv2-reveal.is-in {
    opacity: 1;
    transform: translateY(0);
  }
  .lsv2 .lsv2-reveal-stagger > * {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.8s var(--lsv2-ease), transform 0.8s var(--lsv2-ease);
  }
  .lsv2 .lsv2-reveal-stagger.is-in > *:nth-child(1) { transition-delay: 0.05s; opacity: 1; transform: translateY(0); }
  .lsv2 .lsv2-reveal-stagger.is-in > *:nth-child(2) { transition-delay: 0.15s; opacity: 1; transform: translateY(0); }
  .lsv2 .lsv2-reveal-stagger.is-in > *:nth-child(3) { transition-delay: 0.25s; opacity: 1; transform: translateY(0); }
  .lsv2 .lsv2-reveal-stagger.is-in > *:nth-child(4) { transition-delay: 0.35s; opacity: 1; transform: translateY(0); }
  .lsv2 .lsv2-reveal-stagger.is-in > *:nth-child(5) { transition-delay: 0.45s; opacity: 1; transform: translateY(0); }
  .lsv2 .lsv2-reveal-stagger.is-in > *:nth-child(6) { transition-delay: 0.55s; opacity: 1; transform: translateY(0); }

  /* Primitives */
  .lsv2 .lsv2-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--lsv2-white);
    border: 1px solid var(--lsv2-f-10);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--lsv2-f-72);
  }
  .lsv2 .lsv2-eyebrow::before {
    content: "";
    width: 5px; height: 5px;
    background: var(--lsv2-mint);
    border-radius: 50%;
  }
  .lsv2 .lsv2-eyebrow.dark {
    background: var(--lsv2-c-04);
    border-color: var(--lsv2-c-12);
    color: var(--lsv2-c-72);
  }
  .lsv2 .lsv2-h-display {
    font-weight: 900;
    font-size: clamp(40px, 11vw, 96px);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .lsv2 .lsv2-h-section {
    font-weight: 900;
    font-size: clamp(34px, 8vw, 64px);
    line-height: 0.96;
    letter-spacing: -0.04em;
  }
  .lsv2 .lsv2-h-card {
    font-weight: 800;
    font-size: clamp(22px, 5.4vw, 28px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .lsv2 .lsv2-lede {
    font-size: clamp(16px, 4vw, 19px);
    line-height: 1.55;
    color: var(--lsv2-f-72);
  }
  .lsv2 .lsv2-lede strong { color: var(--lsv2-forest); font-weight: 600; }

  /* 1. HERO */
  .lsv2 .lsv2-hero {
    min-height: 92vh;
    padding: 40px 20px 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    overflow: hidden;
    text-align: center;
  }
  .lsv2 .lsv2-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 80% 18%, rgba(148, 252, 169, 0.18) 0%, transparent 45%),
      radial-gradient(circle at 12% 90%, rgba(148, 252, 169, 0.08) 0%, transparent 42%);
    pointer-events: none;
  }
  .lsv2 .lsv2-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 0 0, transparent 99%, rgba(11,36,16,0.012) 100%);
    background-size: 3px 3px;
    pointer-events: none;
    mix-blend-mode: multiply;
  }

  .lsv2 .lsv2-hero-laurels {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    color: var(--lsv2-forest);
    margin-bottom: 28px;
    position: relative;
    z-index: 2;
    opacity: 0;
    animation: lsv2HeroFadeIn 1s var(--lsv2-ease) 0.1s forwards;
  }
  .lsv2 .lsv2-hero-laurels svg { width: 24px; height: 50px; }
  .lsv2 .lsv2-hero-laurels .label {
    font-family: var(--lsv2-mono);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--lsv2-f-55);
    font-weight: 500;
  }

  .lsv2 .lsv2-hero-h1 {
    font-weight: 900;
    font-size: clamp(48px, 13vw, 130px);
    line-height: 0.88;
    letter-spacing: -0.06em;
    margin: 0 auto 28px;
    max-width: 13ch;
    position: relative;
    z-index: 2;
    opacity: 0;
    animation: lsv2HeroFadeIn 1.1s var(--lsv2-ease) 0.25s forwards;
  }

  .lsv2 .lsv2-hero-sub {
    font-size: clamp(16px, 4.2vw, 19px);
    line-height: 1.55;
    color: var(--lsv2-f-72);
    max-width: 540px;
    margin: 0 auto 56px;
    padding: 0 8px;
    position: relative;
    z-index: 2;
    opacity: 0;
    animation: lsv2HeroFadeIn 1.1s var(--lsv2-ease) 0.45s forwards;
  }
  .lsv2 .lsv2-hero-sub strong { color: var(--lsv2-forest); font-weight: 600; }

  .lsv2 .lsv2-hero-counter {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 32px;
    background: var(--lsv2-white);
    border: 1px solid var(--lsv2-f-10);
    border-radius: 18px;
    box-shadow: 0 12px 40px rgba(11,36,16,0.08);
    position: relative;
    z-index: 2;
    opacity: 0;
    animation: lsv2HeroFadeIn 1.1s var(--lsv2-ease) 0.65s forwards;
  }
  .lsv2 .lsv2-hero-counter-key {
    font-family: var(--lsv2-mono);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--lsv2-f-55);
  }
  .lsv2 .lsv2-hero-counter-val {
    font-size: clamp(40px, 10vw, 60px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--lsv2-forest);
    font-feature-settings: "tnum", "ss01";
  }
  .lsv2 .lsv2-hero-counter-val .arrow {
    color: var(--lsv2-mint);
    margin: 0 0.18em;
    font-weight: 600;
    font-style: italic;
  }
  .lsv2 .lsv2-hero-counter-foot {
    font-size: 12px;
    color: var(--lsv2-f-55);
    margin-top: 4px;
  }

  .lsv2 .lsv2-hero-scroll-cue {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--lsv2-mono);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--lsv2-f-40);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    z-index: 2;
    opacity: 0;
    animation: lsv2HeroFadeIn 1s var(--lsv2-ease) 0.9s forwards;
  }
  .lsv2 .lsv2-hero-scroll-cue::after {
    content: "";
    width: 1px;
    height: 24px;
    background: linear-gradient(to bottom, var(--lsv2-f-40), transparent);
    animation: lsv2ScrollLine 2s ease-in-out infinite;
  }

  @keyframes lsv2HeroFadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes lsv2ScrollLine {
    0% { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
    50.01% { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
  }

  /* 2. STAT TICKER */
  .lsv2 .lsv2-ticker {
    background: var(--lsv2-forest);
    color: var(--lsv2-cream);
    padding: 28px 0;
    overflow: hidden;
    position: relative;
    border-top: 1px solid var(--lsv2-c-12);
    border-bottom: 1px solid var(--lsv2-c-12);
  }
  .lsv2 .lsv2-ticker-grid {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }
  .lsv2 .lsv2-ticker-cell {
    text-align: center;
    padding: 8px 16px;
    border-right: 1px solid var(--lsv2-c-12);
    position: relative;
  }
  .lsv2 .lsv2-ticker-cell:last-child { border-right: none; }
  .lsv2 .lsv2-ticker-num {
    font-size: clamp(24px, 5vw, 36px);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--lsv2-mint);
    line-height: 1;
    margin-bottom: 6px;
    font-feature-settings: "tnum";
  }
  .lsv2 .lsv2-ticker-label {
    font-size: 11px;
    color: var(--lsv2-c-55);
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  @media (max-width: 700px) {
    .lsv2 .lsv2-ticker-grid { grid-template-columns: repeat(2, 1fr); }
    .lsv2 .lsv2-ticker-cell { padding: 14px 12px; border-bottom: 1px solid var(--lsv2-c-12); }
    .lsv2 .lsv2-ticker-cell:nth-child(2n) { border-right: none; }
    .lsv2 .lsv2-ticker-cell:nth-last-child(-n+2) { border-bottom: none; }
  }

  /* 3. PREMISE */
  .lsv2 .lsv2-premise {
    padding: 96px 20px 80px;
    position: relative;
  }
  .lsv2 .lsv2-premise-head {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .lsv2 .lsv2-premise-head .lsv2-h-section {
    margin: 18px auto 18px;
    max-width: 18ch;
  }
  .lsv2 .lsv2-premise-thesis {
    margin-top: 28px;
    padding: 22px 24px;
    background: var(--lsv2-white);
    border: 1px solid var(--lsv2-f-10);
    border-left: 3px solid var(--lsv2-mint);
    border-radius: 4px;
    text-align: left;
    max-width: 580px;
    margin-left: auto;
    margin-right: auto;
  }
  .lsv2 .lsv2-premise-thesis p {
    font-size: 16px;
    line-height: 1.55;
    color: var(--lsv2-forest);
    font-style: italic;
  }
  .lsv2 .lsv2-premise-thesis cite {
    display: block;
    margin-top: 10px;
    font-family: var(--lsv2-mono);
    font-size: 11px;
    color: var(--lsv2-f-55);
    font-style: normal;
    letter-spacing: 0.04em;
  }

  .lsv2 .lsv2-premise-points {
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .lsv2 .lsv2-premise-point {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 20px;
    padding: 36px 0;
    border-bottom: 1px solid var(--lsv2-f-08);
    align-items: start;
  }
  .lsv2 .lsv2-premise-point:last-child { border-bottom: none; }
  .lsv2 .lsv2-premise-point-num {
    font-family: var(--lsv2-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--lsv2-f-55);
    padding-top: 8px;
  }
  .lsv2 .lsv2-premise-point-num strong {
    display: block;
    font-size: 28px;
    color: var(--lsv2-forest);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 4px;
    line-height: 1;
  }
  .lsv2 .lsv2-premise-point h3 {
    font-size: clamp(20px, 5vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
    color: var(--lsv2-forest);
    line-height: 1.15;
  }
  .lsv2 .lsv2-premise-point p {
    font-size: clamp(15px, 3.8vw, 16px);
    line-height: 1.6;
    color: var(--lsv2-f-72);
  }
  .lsv2 .lsv2-premise-point p em { font-style: italic; color: var(--lsv2-forest); }

  /* Citation pill */
  .lsv2 .lsv2-ref {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 18px;
    padding: 0 6px;
    margin: 0 1px;
    background: var(--lsv2-mint-soft);
    color: var(--lsv2-forest);
    font-family: var(--lsv2-mono);
    font-size: 10px;
    font-weight: 700;
    border-radius: 4px;
    vertical-align: 2px;
    letter-spacing: 0.02em;
    transition: background 0.2s var(--lsv2-ease), transform 0.2s var(--lsv2-ease);
    cursor: pointer;
    border: none;
  }
  .lsv2 .lsv2-ref:hover, .lsv2 .lsv2-ref:active { background: var(--lsv2-mint); transform: translateY(-1px); }
  @media (max-width: 600px) {
    .lsv2 .lsv2-premise-point { grid-template-columns: 1fr; gap: 8px; padding: 28px 0; }
    .lsv2 .lsv2-premise-point-num { padding-top: 0; display: flex; align-items: center; gap: 12px; }
    .lsv2 .lsv2-premise-point-num strong { display: inline; font-size: 18px; }
  }

  /* 4. ANATOMY */
  .lsv2 .lsv2-anatomy {
    background: var(--lsv2-forest);
    color: var(--lsv2-cream);
    padding: 100px 20px;
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--lsv2-c-12);
    border-bottom: 1px solid var(--lsv2-c-12);
  }
  .lsv2 .lsv2-anatomy::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 88% 18%, rgba(148, 252, 169, 0.10) 0%, transparent 42%),
      radial-gradient(circle at 8% 92%, rgba(148, 252, 169, 0.05) 0%, transparent 38%);
    pointer-events: none;
  }
  .lsv2 .lsv2-anatomy-inner {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    text-align: center;
  }
  .lsv2 .lsv2-anatomy-inner .lsv2-h-section {
    color: var(--lsv2-cream);
    margin: 18px auto 18px;
    max-width: 16ch;
  }
  .lsv2 .lsv2-anatomy-inner .lsv2-lede {
    color: var(--lsv2-c-72);
    max-width: 560px;
    margin: 0 auto 56px;
  }
  .lsv2 .lsv2-anatomy-inner .lsv2-lede strong { color: var(--lsv2-cream); }

  .lsv2 .lsv2-anatomy-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 901px) {
    .lsv2 .lsv2-anatomy-grid {
      grid-template-columns: 1.1fr 1fr;
      gap: 64px;
      text-align: left;
    }
  }

  .lsv2 .lsv2-anatomy-core {
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    aspect-ratio: 1;
  }
  .lsv2 .lsv2-anatomy-core-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--lsv2-c-12);
    transition: opacity 0.6s var(--lsv2-ease), transform 0.6s var(--lsv2-ease), border-color 0.6s var(--lsv2-ease);
  }
  .lsv2 .lsv2-anatomy-core-ring.outer {
    inset: 0;
    background: radial-gradient(circle at 30% 30%, rgba(148, 252, 169, 0.04), transparent 70%);
  }
  .lsv2 .lsv2-anatomy-core-ring.middle {
    inset: 14%;
    background: radial-gradient(circle at 30% 30%, rgba(148, 252, 169, 0.08), transparent 70%);
  }
  .lsv2 .lsv2-anatomy-core-ring.inner {
    inset: 32%;
    background: radial-gradient(circle, var(--lsv2-mint) 0%, var(--lsv2-mint-soft) 100%);
    border: none;
    box-shadow: 0 0 60px rgba(148, 252, 169, 0.4), inset 0 0 24px rgba(11, 36, 16, 0.1);
  }
  .lsv2 .lsv2-anatomy-core-ring.is-active {
    border-color: var(--lsv2-mint);
  }
  .lsv2 .lsv2-anatomy-core-label {
    position: absolute;
    font-family: var(--lsv2-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lsv2-c-55);
    pointer-events: none;
  }
  .lsv2 .lsv2-anatomy-core-label.l1 { top: 4%; left: 0; }
  .lsv2 .lsv2-anatomy-core-label.l1::before {
    content: "01 ·";
    color: var(--lsv2-mint);
    margin-right: 6px;
  }
  .lsv2 .lsv2-anatomy-core-label.l2 { top: 50%; right: -4%; transform: translateY(-50%); }
  .lsv2 .lsv2-anatomy-core-label.l2::before {
    content: "02 ·";
    color: var(--lsv2-mint);
    margin-right: 6px;
  }
  .lsv2 .lsv2-anatomy-core-label.l3 { bottom: 4%; left: 0; right: 0; text-align: center; }
  .lsv2 .lsv2-anatomy-core-label.l3::before {
    content: "03 ·";
    color: var(--lsv2-mint);
    margin-right: 6px;
  }

  .lsv2 .lsv2-anatomy-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lsv2 .lsv2-anatomy-row {
    padding: 22px 0;
    border-bottom: 1px solid var(--lsv2-c-12);
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 18px;
    align-items: start;
    cursor: default;
    transition: background 0.3s var(--lsv2-ease);
    margin: 0 -16px;
    padding-left: 16px;
    padding-right: 16px;
    border-radius: 8px;
  }
  .lsv2 .lsv2-anatomy-row:last-child { border-bottom: none; }
  .lsv2 .lsv2-anatomy-row:hover, .lsv2 .lsv2-anatomy-row.is-hover {
    background: var(--lsv2-c-04);
  }
  .lsv2 .lsv2-anatomy-row-num {
    font-family: var(--lsv2-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--lsv2-c-55);
    padding-top: 4px;
  }
  .lsv2 .lsv2-anatomy-row h4 {
    font-size: 18px;
    font-weight: 700;
    color: var(--lsv2-cream);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .lsv2 .lsv2-anatomy-row p {
