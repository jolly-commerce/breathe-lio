  }
  .lsv2 .lsv2-tno-head .lsv2-h-section {
    margin: 18px auto;
    max-width: 14ch;
  }
  .lsv2 .lsv2-tno-head .lsv2-lede { max-width: 580px; margin: 0 auto; }

