    padding: 0;
    margin: 0;
  }
  .lsv2 .lsv2-honesty-item {
    padding: 36px 0;
    border-bottom: 1px solid var(--lsv2-c-12);
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 20px;
    align-items: start;
  }
  .lsv2 .lsv2-honesty-item:last-child { border-bottom: none; }
  .lsv2 .lsv2-honesty-item::before {
    counter-increment: lsv2honesty;
    content: counter(lsv2honesty, decimal-leading-zero);
    font-family: var(--lsv2-mono);
    font-size: 13px;
    color: var(--lsv2-c-40);
    letter-spacing: 0.04em;
    padding-top: 4px;
  }
  .lsv2 .lsv2-honesty-item h3 {
    font-size: clamp(20px, 5vw, 26px);
    font-weight: 800;
    letter-spacing: -0.025em;
    margin-bottom: 12px;
    color: var(--lsv2-cream);
    line-height: 1.15;
  }
