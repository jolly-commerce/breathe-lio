  .lsv2 .lsv2-ing-card:hover::after { opacity: 0.4; }
  .lsv2 .lsv2-ing-card > * { position: relative; z-index: 1; }

  .lsv2 .lsv2-ing-card-num {
    font-family: var(--lsv2-mono);
