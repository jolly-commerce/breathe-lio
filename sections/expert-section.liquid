<style>


  @media screen and (max-width: 990px){
    .image-wrapper-full,
    .image-expert-box,
    .button-wrapper-img,
    
    .image-expert-box img,
    .text-expert-box img.hiding-image-desktop {
      display: none !important;
    }
  }



  .expert-section h2 {
                font-size: 55px;
                text-align: center;
                width: fit-content;
  
                margin: auto;
              position : relative;
        margin-top : 50px;

    margin-bottom : 15px;
            }
              .expert-section h2::after {
                content: "";
                position: absolute;
                right: -40px;
                bottom: -10px;
                width: 90px;
                height: 20px;
                background: url("https://cdn.shopify.com/s/files/1/0659/6676/8379/files/Squiggle_Mini_9f.svg?v=1747824794");
                background-size: contain;
                background-repeat: no-repeat;
            }
     .expert-section h2.h2 span{
                color : var(--lio-light-green);  


       
              }
  .expert-section p.ben-para{
                text-align : center;
                 max-width : 580px;
               margin : auto;
    font-size : 14px;
    font-weight : 500;
               
              }
a.button-expert-review {
    display: flex;
    gap: 10px;
    font-weight: 600;
    align-items: center;
    justify-content: center;
    letter-spacing: -0.2px;
    margin: auto;
    border-bottom: 1px solid #00512880;
    margin-top: 20px;
    width: fit-content;
    margin-bottom: 30px;
}
 .full-width-expert-section {
    position: relative;
    width: 100%;
    overflow: hidden;
}
  .image-wrapper-full{
    overflow : hidden;
     min-height : 410px;
  }
 
  .image-expert-box{
    width : 100%;
    height : 250px;
    transition : 0.5s all ease;
  }
 .image-expert-box img {
      object-fit: contain;
    width: 100%;
    height: 100%;
    border-radius: 20px;
}
 .swiper-slide-active .image-expert-box{
   height : 410px;
 }
  .top-rev-exp{
    display : flex;
    gap : 10px;
    align-items : center;
  }
  .top-rev-exp p{
    font-weight : 700 !important;
    letter-spacing : -0.3px !important;
    font-size : 16px !important;
  }
  .text-expert-box-top {
    background: #ffffff;
    padding: 30px 20px;
    border-radius: 20px;
    margin-bottom: 10px;
    border: 1px solid #00512840;
}
  .text-expert-box-bottom{
    background : #ffffff;
    padding : 15px;
    border-radius : 10px;
    border : 1px solid #00512840;
    box-shadow: -3px 4px 0 0 var(--lio-dark-green);
    -webkit-box-shadow: -3px 4px 0px 0px var(--lio-dark-green);
    -moz-box-shadow: -3px 4px 0px 0px var(--lio-dark-green);
  }


  
  .text-expert-box-bottom p{
    font-size : 14px;
  }
  .text-wrapper-full {
    overflow: hidden;
    max-width: 550px;
    
    margin-left : 250px;
    margin-top : -80px;
    padding : 10px;
    position : relative;
    padding-bottom : 30px;
    
}
  .text-wrapper-full .experts-scrollbar{
     position: absolute;
    bottom: 5px;
    width: 95%;
    left: 50%;
    transform: translateX(-50%);
    height: 2px;
    background: #B6C6BE;
  }
 .text-wrapper-full .experts-scrollbar .swiper-scrollbar-drag {
    background: linear-gradient(270deg, #EDED5E 0.01%, #004E55 57.58%, #004E55 115.15%);
}
.text-wrapper-full  p.designation-rev{
 font-weight : 400;
padding : 10px 0px 20px;
  }
  .text-wrapper-full p{
    font-size : 13px;
    font-weight : 500;
  }

  .button-wrapper-img div {
    display: flex;
    width: 80px;
    height: 49px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 1000px;
    background: #19613B;
    cursor: pointer;
}
  .button-wrapper-img {
    position: absolute;
    right: 0px;
    top: 50%;
    display: flex;
    gap: 10px;
    z-index : 1;
}
 @media screen and (max-width: 990px){
   .text-wrapper-full {
    overflow: hidden;
    max-width: 100%;
    margin-left: 0px;
    padding:0px 5px;
    position: relative;
    padding-bottom: 30px;
    margin-top: 0px;
     
     
}
   .expert-section h2::after {
    content: "";
    position: absolute;
    right: 0px;
}
   .expert-section h2 {
    font-size: 35px;
    margin-bottom: 15px;
    max-width: 320px;
}
   .swiper-slide-active .image-expert-box {
    height: 120px;
}
   .image-expert-box {
    height: 120px;
}
   .image-wrapper-full {
    overflow: hidden;
    min-height: 120px;
     transform : translateY(410px);
     
}
   .button-wrapper-img {
    position: absolute;
    right: 0px;
    top: 20%;
    display: flex;
     width : 100%;
      padding:0px 5px;
     justify-content : space-between;
    gap: 10px;
    z-index : 1;
}
 .text-expert-box  img.hiding-image-desktop {
    height: 390px;
    object-fit: cover;
    border-radius: 15px;
    margin-bottom: 160px;
    width: 100%;
}
   .button-wrapper-img div {
    width: 60px;
    height: 35px;
}
   .width-wrapper.expert-section {
    
    padding: 20px 10px;
}
 }



  
</style>

<div class="width-wrapper expert-section ">
  <h2 class="h2">{{ section.settings.heading }} <span>{{ section.settings.highlighted-heading }}</span></h2>
            <p class="ben-para">{{ section.settings.sub-text }}</p>
  <a href="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/arrf.svg?v=1747933867">  </a>
   {% if section.settings['button-text'] != blank %}
            <a class="button-expert-review" href="{{ section.settings.button-url }}">{{ section.settings['button-text'] }} <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/arrf.svg?v=1747933867" /> </a>
          {% endif %}

  <div class="full-width-expert-section">
    
    <div class="image-wrapper-full">
      <div class="swiper-wrapper">
       {% for block in section.blocks %}
        {% case block.type %}
          {% when 'review' %}
          <div class="swiper-slide">
            <div class="image-expert-box">
              <img loading="lazy" src="{{ block.settings.image | image_url: width: 1000 }}" />
            </div>
          </div>
           {% endcase %}
      {% endfor %}
      </div>
    </div>
    <div class="text-wrapper-full">
       <div class="swiper-wrapper">
       {% for block in section.blocks %}
        {% case block.type %}
          {% when 'review' %}
          <div class="swiper-slide">
            <div class="text-expert-box">
             <img loading="lazy" class="sm:hidden hiding-image-desktop" src="{{ block.settings.image | image_url: width: 1000 }}" />
             <div class="text-expert-box-top">
               <div class="top-rev-exp">
                 <img loading="lazy" src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/ticko.svg?v=1747821467" />
                 <p>{{ block.settings.name }}</p>
               </div>
               <p class="designation-rev">{{ block.settings.designation }}</p>
               {{ block.settings.review }}
             </div>
               <div class="text-expert-box-bottom">
                 {{ block.settings.conclusion }}
               </div>
            </div>
          </div>
           {% endcase %}
      {% endfor %}
      </div>
      <div class="experts-scrollbar"></div>
    </div>
    <div class="button-wrapper-img">
      <div class="prev-image-1">
    {{ 'arrow-left.svg' | inline_asset_content }}
  </div>
          <div class="next-image-1">
         {{ 'arrow-right.svg' | inline_asset_content }}
  </div>
      </div>
  </div>
  
</div>

{% schema %}
  {
    "name": "expert-section",
    "settings": [
       {
          "type": "text",
          "id": "heading",
          "label": "Heading Text",
         "default" : "Why Lio® is Safe &"
        },
        {
          "type": "text",
          "id": "highlighted-heading",
          "label": "highlighted-heading",
            "default" : "Effective"
        },
       {
          "type": "text",
          "id": "sub-text",
          "label": "sub text"
        },
      {
          "type": "text",
          "id": "left-sub-text",
          "label": "left sub text",
          "default" : "more likely to stay nicotine-free"
        },
       {
          "type": "url",
          "id": "button-url",
          "label": "Button URL"
        },
       {
          "type": "text",
          "id": "button-text",
          "label": "button-text"
        },
    ],
     "blocks": [
     {
    "type": "review",
    "name": "review",
    "settings":
    [
      {
        "type": "image_picker",
        "id": "image",
        "label": "image"
      },
      {
    "type": "text",
    "id": "name",
    "label": "name"
      },
       {
    "type": "text",
    "id": "date",
    "label": "date"
      },
      {
    "type": "richtext",
    "id": "review",
    "label": "review"
      },
       {
    "type": "text",
    "id": "designation",
    "label": "designation"
      },
       {
    "type": "richtext",
    "id": "conclusion",
    "label": "conclusion"
      },
    ]
  }
  ],
    "presets": [{
      "name": "expert-section"
    }]
  }
{% endschema %}