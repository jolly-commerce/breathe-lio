<cart-drawer {% if request.design_mode %}handle-section-events{% endif %} class="cart-drawer drawer drawer--lg" id="cart-drawer">
  {%- if cart.item_count == 0 -%}
    <button is="close-button" aria-label="{{ 'general.accessibility.close' | t | escape }}">
      {%- render 'icon' with 'close' -%}
    </button>

    <div class="empty-state align-self-center">
      <div class="empty-state__icon-wrapper">
        {%- render 'icon' with 'cart', width: 32, height: 32, stroke_width: 1 -%}
        <span class="count-bubble count-bubble--lg">0</span>
      </div>

      <div class="prose">
        <p class="h5">{{ 'cart.general.empty' | t }}</p>

        {%- assign button_content = 'cart.general.continue_shopping' | t -%}
        {%- render 'button', href: settings.cart_empty_button_link, size: 'xl', content: button_content -%}
      </div>
    </div>
  {%- else -%}
    <div class="cart-drawer__inner">
      <div class="cart-drawer__top">
        <div class="h-stack items-center justify-between">
          <div class="h-stack grow gap-2 sm:gap-2.5">
            <p class="h5">{{- 'cart.general.title' | t -}} <span> ({{ cart.item_count }})</span> </p>
            {% comment %}
            <cart-count class="count-bubble count-bubble--md">{{ cart.item_count }}</cart-count>
    {% endcomment %}
          </div>

          <button type="button" is="close-button" class="drawer__close-icon">
            <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
            {%- render 'icon' with 'drawer-cross-custom' -%}
          </button>
        </div>

        {%- if settings.cart_show_free_shipping_threshold -%}
          {%- render 'free-shipping-bar' -%}
        {%- endif -%}
      </div>

      <div class="v-stack gap-6 sm:gap-8">
        <div class="cart-drawer__line-items">
          {%- for line_item in cart.items -%}
            {%- render 'line-item', line_item: line_item, show_desktop_quantity: true -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.products.count > 0 -%}
          <div class="cart-drawer__recommendations">
            <div class="v-stack gap-2.5 sm:gap-4">
              {%- capture carousel_id -%}cart-drawer-recommendations{%- endcapture -%}

              {%- liquid
                assign horizontal_products_blends = true
                assign product_card_background = section.settings.product_card_background | default: product.settings.product_card_background

                if product_card_background != 'rgba(0,0,0,0)' and product_card_background != blank and product_card_background != settings.dialog_background
                  assign horizontal_products_blends = false
                endif

                assign rendered_recommendations = 0

                capture recommendations
                  for recommended_product in section.settings.products
                    assign item_count_in_cart = cart | line_items_for: recommended_product

                    if item_count_in_cart.size == 0
                      render 'cart-product-card', product: recommended_product, show_add_to_cart: true, background: section.settings.product_card_background, text_color: section.settings.product_card_text_color
                      assign rendered_recommendations = rendered_recommendations | plus: 1
                    endif
                  endfor
                endcapture
              -%}

              {%- if rendered_recommendations > 0 -%}
                <div class="h-stack justify-between gap-4">
                  {%- if section.settings.recommendations_title != blank -%}
                    <p class="recom-title-main">{{ section.settings.recommendations_title | escape }}</p>
                  {%- endif -%}
 {%- if rendered_recommendations > 1 -%}
                 <div class="navigation-links">
   <img class="left-navigation" src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/left-cirlce-got.svg?v=1750158089" width="24" height="24" />
    <img class="right-navigation" src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/right-cirlce-got.svg?v=1750158089" width="24" height="24" />
   </div>
   {% endif %}
                </div>
              {%- endif -%}

              {%- if recommendations != blank -%}
                  <div id="recommendation-slider" class="custom-cart-recom">
  {{ recommendations }}
</div>

              {%- endif -%}


            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="v-stack gap-4 sm:gap-4" slot="footer">
      <div class="v-stack gap-1">
        {% for discount_application in cart.cart_level_discount_applications %}
          <div class="h-stack gap-4 justify-between">
            <div class="badge">
              {%- render 'icon' with 'discount' -%} {{- discount_application.title -}}
            </div>

            <span class="text-subdued">-{{ discount_application.total_allocated_amount | money }}</span>
          </div>
        {% endfor %}
    
        {%- comment -%} TEST-CART_001 - START {%- endcomment -%}
        {%- liquid
          assign calculated_total_price = 0

          for line_item in cart.items
            if line_item.requires_shipping
              assign calculated_total_price = calculated_total_price | plus: line_item.final_line_price
            endif
          endfor

          # We have to remove the cart level discount from the calculated amount
          assign total_cart_discount = 0

          for discount_application in cart.cart_level_discount_applications
            assign total_cart_discount = total_cart_discount | plus: discount_application.total_allocated_amount
          endfor

          assign calculated_total_price = calculated_total_price | minus: total_cart_discount
        -%}

        {%- if cart.requires_shipping -%}
          <shipping-cost-display 
            class="cart-drawer__shipping-cost-display gap-2 justify-between" 
            threshold="{{ settings.cart_free_shipping_threshold | times: 100.0 }}" 
            total-price="{{ calculated_total_price }}"
            free-label="{{ section.settings.shipping_free_label | default: 'Free' }}"
            calculated-label="{{ section.settings.shipping_calculated_label | default: 'Calculated at checkout' }}">
            <span class="h5">{{ section.settings.shipping_cost_label | default: 'Shipping cost' }}</span>
            <span class="cart-drawer__shipping-cost-display-value">
              {%- assign shipping_threshold_in_cents = settings.cart_free_shipping_threshold | times: 100.0 -%}
              {%- if calculated_total_price >= shipping_threshold_in_cents -%}
                {{ section.settings.shipping_free_label | default: 'Free' }}
              {%- else -%}
                {{ section.settings.shipping_calculated_label | default: 'Calculated at checkout' }}
              {%- endif -%}
            </span>
          </shipping-cost-display>
        {%- endif -%}
        {%- comment -%} TEST-CART_001 - END {%- endcomment -%}

        <div class="h-stack gap-4 justify-between">
          <span class="h5 total-label">{{ 'cart.general.total' | t }}</span>
          <span class="total-value">{{- cart.total_price | money_with_currency -}}</span>
        </div>

        {%- if section.settings.show_shipping_text -%}
          {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
            <p class="text-subdued text-sm cart-drawer__shipping-info">{{ 'cart.general.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}</p>
          {%- elsif cart.taxes_included -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_included_but_shipping_at_checkout' | t }}</p>
          {%- elsif shop.shipping_policy.body != blank -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}</p>
          {%- else -%}
            <p class="text-subdued text-sm">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.show_cart_note -%}
         

          <cart-note-dialog id="cart-drawer-note" class="cart-drawer__note">
            <div class="cart-drawer__note-inner">
              <div class="v-stack gap-4 sm:gap-5">
                <p class="h5">{{ 'cart.general.order_note' | t }}</p>

                <cart-note class="v-stack gap-4">
                  {%- assign order_note = 'cart.general.order_note' | t -%}
                  {%- assign order_save_label = 'cart.general.save_note' | t -%}

                  {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note -%}

                  <div class="justify-self-start">
                    {%- render 'button', type: 'button', content: order_save_label, size: 'lg', is: 'close-button', secondary: true -%}
                  </div>
                </cart-note>
              </div>
            </div>
          </cart-note-dialog>
        {%- endif -%}
      </div>

      <form action="{{ routes.cart_url }}" method="POST" class="cart-checkout-btn buy-buttons {% if section.settings.show_checkout_button %}buy-buttons--compact{% endif %}">
        {%- assign checkout_label = 'cart.general.checkout' | t -%}


        {%- if section.settings.show_checkout_button -%}
          {%- render 'button', type: 'submit', content: checkout_label, icon: 'custom-cart-card', name: 'checkout', size: 'xl' -%}
        {%- endif -%}
      </form>
      <div class="free-c-text"></div>
      <div class="cart-drawer__guarantee-text">
        {% render 'icon' with 'check-circle-transparent' %}
        <span>{{ section.settings.guarantee_label }}</span>
      </div>
    </div>
  {%- endif -%}
</cart-drawer>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cart drawer won't appear to your customers if you have set the cart type to Page in the global theme settings."
    },
    {
      "type": "paragraph",
      "content": "Free shipping bar can be configured in global cart settings."
    },
       {
     "type": "image_picker",
     "id": "cart-icon-1",
     "label": "icon-1"
      },
              {
    "type": "text",
    "id": "cart-usp-1",
    "label": "usp-1"
      },
                    {
     "type": "image_picker",
     "id": "cart-icon-2",
     "label": "icon-2"
      },
              {
    "type": "text",
    "id": "cart-usp-2",
    "label": "usp-2"
      },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show cart note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "Show shipping text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "Show view cart button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "Show checkout button",
      "default": true
    },
    {
      "type": "header",
      "content": "Product recommendations"
    },
    {
      "type": "text",
      "id": "recommendations_title",
      "label": "Heading",
      "default": "Trending this month"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Recommendations",
      "info": "Suggest additional products to your customers. Recommendations already in the cart are automatically hidden.",
      "limit": 10
    },
    {
      "type": "color",
      "id": "product_card_background",
      "label": "Product card background"
    },
    {
      "type": "color",
      "id": "product_card_text_color",
      "label": "Product card text"
    },
    {
      "type": "header",
      "content": "Shipping cost labels"
    },
    {
      "type": "text",
      "id": "shipping_cost_label",
      "label": "Shipping cost label",
      "default": "Shipping cost"
    },
    {
      "type": "text",
      "id": "shipping_free_label",
      "label": "Shipping free label",
      "default": "Free"
    },
    {
      "type": "text",
      "id": "shipping_calculated_label",
      "label": "Shipping calculated label",
      "default": "Calculated at checkout"
    },
    {
      "type": "text",
      "id": "guarantee_label",
      "label": "Guarantee label",
      "default": "30-Day Money-Back Guarantee"
    },
    {
      "type": "header",
      "content": "Lio bundle info"
    },
    {
      "type": "text",
      "id": "subscription_label",
      "label": "Subscription label",
      "default": "Subscribed"
    },
    {
      "type": "image_picker",
      "id": "subscription_icon",
      "label": "Subscription icon"
    }
  ]
}
{% endschema %}
