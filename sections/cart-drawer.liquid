{%- comment -%}
  ============================================================
  LIO CART DRAWER — universal, Huel-inspired
  Replaces Impact's <cart-drawer> shell with a custom drawer
  driven by lio-cart.{css,js}. One drawer for everything; per-
  line subscription toggle, free-shipping bar, tier rewards,
  cross-sell carousel, undo toast.

  Header keeps using [aria-controls="cart-drawer"] — lio-cart.js
  delegates clicks on that selector to open this drawer.
  ============================================================
{%- endcomment -%}
{{ 'lio-cart.css'        | asset_url | stylesheet_tag }}
{{ 'lio-bundle-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'lio-bundle-cart.js' | asset_url }}" defer></script>
<script src="{{ 'lio-cart.js'        | asset_url }}" defer></script>

{%- liquid
  assign currency = cart.currency.iso_code | default: 'EUR'
  assign locale   = request.locale.iso_code | default: 'en'
  assign ship_threshold_cents = section.settings.ship_threshold | default: 65 | times: 100

  capture cross_sell_json
    echo '['
    assign first = true
    for product in section.settings.cross_sell_products
      if first == false
        echo ','
      endif
      assign first = false
      assign img = product.featured_image | image_url: width: 240
      assign variant = product.first_available_variant
      echo '{'
      echo '"handle":'
      echo product.handle | json
      echo ',"title":'
      echo product.title | json
      echo ',"image":'
      echo img | json
      echo ',"price":'
      echo product.price
      echo ',"variantId":'
      if variant
        echo variant.id
      else
        echo 'null'
      endif
      echo '}'
    endfor
    echo ']'
  endcapture
-%}

<div
  id="lio-cart"
  class="lc-drawer-root"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping cart"
  data-currency="{{ currency }}"
  data-locale="{{ locale }}"
  data-ship-threshold="{{ ship_threshold_cents }}"
  data-selling-plan-id="{{ section.settings.loop_selling_plan_id }}"
  data-cross-sell-handles='{{ cross_sell_json | strip_newlines | strip }}'
>
  <div class="lc-backdrop" data-lc-close></div>

  <aside class="lc-drawer" aria-labelledby="lc-head-title">
    <header class="lc-head">
      <h2 class="lc-head-title" id="lc-head-title">
        {{ section.settings.title | default: 'Your cart' }}
        <span class="lc-head-count" aria-live="polite">{{ cart.item_count }}</span>
      </h2>
      <button type="button" class="lc-head-close" data-lc-close aria-label="Close cart">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 3l10 10M13 3 3 13"/></svg>
      </button>
    </header>

    <div class="lc-rewards" aria-live="polite"></div>

    <div class="lc-body">
      {%- comment -%} JS hydrates with /cart.json on open {%- endcomment -%}
    </div>

    <div class="lc-xsell" style="display:none">
      {%- comment -%} Cross-sell carousel — JS hydrates from data-cross-sell-handles {%- endcomment -%}
    </div>

    <footer class="lc-foot">
      {%- if section.settings.show_discount_field -%}
        <div class="lc-discount">
          <button type="button" class="lc-discount-toggle">{{ section.settings.discount_label | default: 'Have a discount code?' }}</button>
          <form class="lc-discount-form" action="/discount" method="get">
            <input type="text" name="code" class="lc-discount-input" placeholder="Code" autocomplete="off">
            <button type="submit" class="lc-discount-apply">Apply</button>
          </form>
        </div>
      {%- endif -%}

      <div class="lc-totals" aria-live="polite"></div>

      <button type="button" class="lc-checkout" disabled>
        <span class="lc-checkout-label">Checkout</span>
        <span class="lc-checkout-arrow" aria-hidden="true">
          <svg viewBox="0 0 14 14" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h8m-3-3 3 3-3 3"/></svg>
        </span>
      </button>

      <div class="lc-trust" aria-hidden="true">
        <span>
          <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5h12l-1 8H3L2 5Z"/><path d="M5 5V3a3 3 0 0 1 6 0v2"/></svg>
          {{ section.settings.trust_1 | default: 'Free EU €65+' }}
        </span>
        <span>
          <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M5 8l2 2 4-4"/></svg>
          {{ section.settings.trust_2 | default: 'Pause anytime' }}
        </span>
        <span>
          <svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 1v14M3 8h10"/></svg>
          {{ section.settings.trust_3 | default: '90-day refund' }}
        </span>
      </div>
    </footer>
  </aside>

  {%- comment -%} Undo toast — sits above the drawer so it stays visible during line removals {%- endcomment -%}
  <div class="lc-undo" role="status" aria-live="polite">
    <span class="lc-undo-text">Removed item</span>
    <button type="button" class="lc-undo-action">Undo</button>
  </div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "paragraph", "content": "Universal Lio cart drawer. Same drawer everywhere — PDP, Flow, Journey Pack." },
    { "type": "text",    "id": "title",            "label": "Drawer title",                 "default": "Your cart" },
    { "type": "number",  "id": "ship_threshold",   "label": "Free-shipping threshold (€)",  "default": 65 },
    { "type": "text",    "id": "loop_selling_plan_id", "label": "Loop selling plan ID",     "info": "Numeric ID. Used by the per-line Auto-refill toggle to switch items into subscription." },
    { "type": "checkbox","id": "show_discount_field","label": "Show discount code field",   "default": true },
    { "type": "text",    "id": "discount_label",   "label": "Discount toggle label",        "default": "Have a discount code?" },

    { "type": "header",  "content": "Trust line (above-checkout)" },
    { "type": "text",    "id": "trust_1", "label": "Trust 1", "default": "Free EU €65+" },
    { "type": "text",    "id": "trust_2", "label": "Trust 2", "default": "Pause anytime" },
    { "type": "text",    "id": "trust_3", "label": "Trust 3", "default": "90-day refund" },

    { "type": "header",  "content": "Cross-sell" },
    { "type": "product_list", "id": "cross_sell_products", "label": "Cross-sell products", "limit": 8, "info": "Shown in the cart drawer's 'You might like' rail. Items already in cart are auto-hidden." }
  ]
}
{% endschema %}
