<!-- ================== SECTION 11: FAQ ================== -->
<section class="faq" id="help">
  <div class="faq-inner">
    <div class="faq-head">
      <div class="section-eyebrow">Questions, answered</div>
      <h2 class="section-h2">
        Anything<br>
        <span class="italic-word">else?</span>
      </h2>
      <p class="section-lede" style="margin-top: 20px;">
        The things people ask us most, with straight answers. Still stuck? Our team replies on WhatsApp within the hour.
      </p>

      {%- if section.settings.show_whatsapp and section.settings.whatsapp_number != blank -%}
        {%- assign wa_num_top = section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
        {%- assign wa_msg_top = section.settings.whatsapp_message | default: 'Hi Lio team — got a question before I order.' | url_encode -%}
        <div class="faq-whatsapp faq-whatsapp-top">
          <div class="faq-whatsapp-text">
            <strong>{{ section.settings.whatsapp_title | default: 'Still have a question?' }}</strong>
            <span>{{ section.settings.whatsapp_sub | default: 'Message our team on WhatsApp — usually within the hour.' }}</span>
          </div>
          <a class="faq-whatsapp-btn" href="https://wa.me/{{ wa_num_top }}?text={{ wa_msg_top }}" target="_blank" rel="noopener" aria-label="Chat with Lio on WhatsApp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 14.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.2 3.4 5.4 4.8.8.3 1.4.5 1.8.7.8.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4ZM12 22a10 10 0 0 1-5.1-1.4L2 22l1.5-4.7A10 10 0 1 1 12 22Zm0-18.3a8.3 8.3 0 0 0-7 12.7l.2.4-.9 2.7 2.8-.9.3.2A8.3 8.3 0 1 0 12 3.7Z"/></svg>
            {{ section.settings.whatsapp_label | default: 'Chat on WhatsApp' }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="faq-list">
      <div class="faq-item open">
        <button class="faq-q" aria-expanded="true">
          What does Lio actually taste like?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            Think herbal tea, not soda. If you're used to vapor, Lio is lighter and more natural than you'd expect — not as sweet, not as heavy. Just clean, flavored air carried on your own breath. The Minty core is the most recognizable; Cinnamon is warmer; Fruity is brightest; <strong>Cold Turkey has almost no flavor at all — just the airflow and the ritual.</strong>
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          Is this actually safe?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            Yes. Every core is tested by an independent EU toxicology lab. The aromatic oils are <strong>pharmaceutical-grade and IFRA-certified.</strong> There's zero nicotine, zero combustion, zero vapor, no synthetic compounds. Nothing heats up — air simply passes over a fiber core. That said, Lio is a wellness product, not a medical device, and we make no therapeutic claims.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          How is this different from a vape?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            A vape heats liquid into vapor. Lio doesn't heat anything. There's no battery, no coil, no e-liquid, no visible exhale. <strong>You're breathing normal air that passed over a plant-oil core.</strong> The mechanism is closer to walking past a flower than it is to smoking anything.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          Will it actually work for my habit?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            Lio is built for habits driven by <strong>ritual and repetition</strong> — the hand-to-mouth motion, the deep breath, the small pause. If your habit has that structure, Lio gives it a physical anchor. Most people feel a real shift in the first week; by month one, many report a significant drop-off in the urge. If it doesn't work for you, you have 30 days to send it back.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          How long does a core last?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            Roughly <strong>300 draws per core</strong>, or about ten days of regular use. The Journey Pack includes three cores — a full month. After that, you can subscribe to refills (pause or cancel anytime) or reorder one-off.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          Can I use it on a plane or at work?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            Yes. There's <strong>no vapor, no smoke, no smell beyond a subtle natural aroma.</strong> Customers use Lio in flights, offices, restaurants, hotels, and meetings. We still suggest you ask your crew on a plane before the first draw — policies vary by airline — but mechanically there's nothing being emitted.
          </div>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-q" aria-expanded="false">
          What if it doesn't work for me?
          <span class="faq-q-icon"></span>
        </button>
        <div class="faq-a">
          <div class="faq-a-inner">
            You have a full <strong>30-day home trial</strong>. If the ritual doesn't stick, email us — we send a prepaid return label, and we refund the full amount once we receive the device back. No forms, no phone calls, no guilt trips.
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-whatsapp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 24px 0 8px;
    padding: 16px 20px;
    background: #effaf2;
    border: 1px solid #c8e6cd;
    border-radius: 14px;
  }
  .faq-whatsapp-top { margin: 18px 0 0; }
  .faq-whatsapp-text { display: flex; flex-direction: column; gap: 2px; line-height: 1.4; }
  .faq-whatsapp-text strong { color: #1f3a2c; font-size: 14px; }
  .faq-whatsapp-text span { color: #2a2a2a; font-size: 13px; opacity: 0.78; }
  .faq-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .faq-whatsapp-btn:hover { background: #1fb554; }
  @media (max-width: 640px) {
    .faq-whatsapp { flex-direction: column; align-items: stretch; padding: 16px; }
    .faq-whatsapp-btn { justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Lio · FAQ",
  "tag": "section",
  "class": "section-lio-faq",
  "settings": [
    { "type": "header",   "content": "WhatsApp button" },
    { "type": "checkbox", "id": "show_whatsapp",     "label": "Show WhatsApp button", "default": true },
    { "type": "text",     "id": "whatsapp_number",   "label": "WhatsApp (digits only, intl format, no +)", "default": "31612345678" },
    { "type": "text",     "id": "whatsapp_title",    "label": "Title",   "default": "Still have a question?" },
    { "type": "text",     "id": "whatsapp_sub",      "label": "Sub-line","default": "Message our team on WhatsApp — usually within the hour." },
    { "type": "text",     "id": "whatsapp_label",    "label": "Button label", "default": "Chat on WhatsApp" },
    { "type": "text",     "id": "whatsapp_message",  "label": "Pre-filled message", "default": "Hi Lio team — got a question before I order." }
  ],
  "presets": [{ "name": "Lio · FAQ" }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
