<!-- ================== SECTION 11: FAQ ================== -->
<section class="faq" id="help">
  <div class="faq-inner">
    <div class="faq-head">
      <div class="section-eyebrow">{{ 'lander.faq.eyebrow' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}</div>
      <h2 class="section-h2">
        {{ 'lander.faq.h2_pre' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}<br>
        <span class="italic-word">{{ 'lander.faq.h2_em' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}</span>
      </h2>
      <p class="section-lede" style="margin-top: 20px;">{{ 'lander.faq.lede' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}</p>

      {%- if section.settings.show_whatsapp and section.settings.whatsapp_number != blank -%}
        {%- assign wa_num_top = section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
        {%- assign wa_msg_top = section.settings.whatsapp_message | default: 'Hi Lio team — got a question before I order.' | url_encode -%}
        <div class="faq-whatsapp faq-whatsapp-top">
          <div class="faq-whatsapp-text">
            <strong>{{ 'lander.faq.wa_title' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}</strong>
            <span>{{ 'lander.faq.wa_sub' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}</span>
          </div>
          <a class="faq-whatsapp-btn" href="https://wa.me/{{ wa_num_top }}?text={{ wa_msg_top }}" target="_blank" rel="noopener" aria-label="Chat with Lio on WhatsApp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.6 14.4c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.5-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5 0-.1-.7-1.7-1-2.3-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.2 3.4 5.4 4.8.8.3 1.4.5 1.8.7.8.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.5.3-.7.3-1.4.2-1.5-.1-.2-.3-.2-.6-.4ZM12 22a10 10 0 0 1-5.1-1.4L2 22l1.5-4.7A10 10 0 1 1 12 22Zm0-18.3a8.3 8.3 0 0 0-7 12.7l.2.4-.9 2.7 2.8-.9.3.2A8.3 8.3 0 1 0 12 3.7Z"/></svg>
            {{ 'lander.faq.wa_label' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="faq-list">
      {%- for i in (1..7) -%}
        <div class="faq-item{% if i == 1 %} open{% endif %}">
          <button class="faq-q" aria-expanded="{% if i == 1 %}true{% else %}false{% endif %}">
            {%- case i -%}
              {%- when 1 -%}{{ 'lander.faq.q1_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- when 2 -%}{{ 'lander.faq.q2_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- when 3 -%}{{ 'lander.faq.q3_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- when 4 -%}{{ 'lander.faq.q4_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- when 5 -%}{{ 'lander.faq.q5_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- when 6 -%}{{ 'lander.faq.q6_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- when 7 -%}{{ 'lander.faq.q7_q' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
            {%- endcase -%}
            <span class="faq-q-icon"></span>
          </button>
          <div class="faq-a">
            <div class="faq-a-inner">
              {%- case i -%}
                {%- when 1 -%}{{ 'lander.faq.q1_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
                {%- when 2 -%}{{ 'lander.faq.q2_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
                {%- when 3 -%}{{ 'lander.faq.q3_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
                {%- when 4 -%}{{ 'lander.faq.q4_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
                {%- when 5 -%}{{ 'lander.faq.q5_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
                {%- when 6 -%}{{ 'lander.faq.q6_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
                {%- when 7 -%}{{ 'lander.faq.q7_a' | t | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' }}
              {%- endcase -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .faq-whatsapp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 24px 0 8px;
    padding: 16px 20px;
    background: #effaf2;
    border: 1px solid #c8e6cd;
    border-radius: 14px;
  }
  .faq-whatsapp-top { margin: 18px 0 0; }
  .faq-whatsapp-text { display: flex; flex-direction: column; gap: 2px; line-height: 1.4; }
  .faq-whatsapp-text strong { color: #1f3a2c; font-size: 14px; }
  .faq-whatsapp-text span { color: #2a2a2a; font-size: 13px; opacity: 0.78; }
  .faq-whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #25d366;
    color: #fff;
    text-decoration: none;
    padding: 12px 20px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .faq-whatsapp-btn:hover { background: #1fb554; }
  @media (max-width: 640px) {
    .faq-whatsapp { flex-direction: column; align-items: stretch; padding: 16px; }
    .faq-whatsapp-btn { justify-content: center; }
  }
</style>

{% schema %}
{
  "name": "Lio · FAQ",
  "tag": "section",
  "class": "section-lio-faq",
  "settings": [
    { "type": "header",   "content": "WhatsApp button" },
    { "type": "checkbox", "id": "show_whatsapp",     "label": "Show WhatsApp button", "default": true },
    { "type": "text",     "id": "whatsapp_number",   "label": "WhatsApp (digits only, intl format, no +)", "default": "31612345678" },
    { "type": "text",     "id": "whatsapp_title",    "label": "Title",   "default": "Still have a question?" },
    { "type": "text",     "id": "whatsapp_sub",      "label": "Sub-line","default": "Message our team on WhatsApp — usually within the hour." },
    { "type": "text",     "id": "whatsapp_label",    "label": "Button label", "default": "Chat on WhatsApp" },
    { "type": "text",     "id": "whatsapp_message",  "label": "Pre-filled message", "default": "Hi Lio team — got a question before I order." }
  ],
  "presets": [{ "name": "Lio · FAQ" }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
