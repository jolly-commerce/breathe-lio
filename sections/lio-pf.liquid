<!-- ================== PRODUCT FEATURE (The Original) ================== -->
<section class="lio-pf">
  <div class="lio-pf__top">
    <div class="lio-pf__label">
      <span class="lio-pf__label-line"></span>
      <span>The Original</span>
    </div>
    <div class="lio-pf__monogram">Lio<sup>®</sup></div>
  </div>

  <div class="lio-pf__container">

    <!-- COLUMN 1 -->
    <div class="lio-pf__col-left">
      <h2 class="lio-pf__h1">
        <span class="lio-pf__h1-line">The <span class="lio-pf__h1-italic">original</span></span>
        <span class="lio-pf__h1-line">flavored air device.</span>
        <span class="lio-pf__h1-line"><span class="lio-pf__h1-soft">Since</span> <span class="lio-pf__underline">2018.<svg viewBox="0 0 300 10" preserveAspectRatio="none"><path d="M 5 5 L 295 5"/></svg></span></span>
      </h2>

      <p class="lio-pf__lead">
        A <strong>mouth diffuser</strong> for the hand-to-mouth ritual. Breathe in natural flavored air — nothing to light, nothing to charge. Just breathe.
      </p>

      <div class="lio-pf__signature">
        <div class="lio-pf__signature-stamp">Est. 2022</div>
        <div class="lio-pf__signature-label">Founder's note</div>
        <p class="lio-pf__signature-text">
          <strong>The original flavored air device in Europe.</strong>
          Built in Amsterdam, 2022. Refined over four years and 100,000+ customers. Every brand that followed started where we were two years ago.
        </p>
        <div class="lio-pf__signature-attr">
          <div class="lio-pf__signature-avatar">M</div>
          <div>
            <div class="lio-pf__signature-attr-name">Mees van Lier</div>
            <div class="lio-pf__signature-attr-role">Founder · Amsterdam</div>
          </div>
        </div>
      </div>
    </div>

    <!-- COLUMN 2: GIF PANEL -->
    <div class="lio-pf__media-wrap">
      <div class="lio-pf__media" data-parallax>
        <img
          src="https://cdn.shopify.com/s/files/1/0659/6676/8379/files/1744795548_V3-ezgif.com-resize_1_e80d9f10-215d-41b6-a431-fd5bbc180e3a_2.gif?v=1765685909"
          alt="Lio nicotine-free flavored air device"
          class="lio-pf__media-img"
          loading="lazy"
          decoding="async"
          width="800"
          height="1000">

        <span class="lio-pf__media-pill">
          <span class="lio-pf__media-pill-dot"></span>
          It's just air
        </span>

        <div class="lio-pf__media-stat">
          <span class="lio-pf__media-stat-num">100K+</span>
          <span class="lio-pf__media-stat-label">Europeans</span>
        </div>
      </div>
    </div>

    <!-- COLUMN 3 -->
    <div class="lio-pf__col-right">
      <div class="lio-pf__spec-intro">
        <span>What's inside</span>
      </div>

      <div class="lio-pf__specs">
        <div class="lio-pf__spec">
          <span class="lio-pf__spec-num">01</span>
          <div class="lio-pf__spec-icon">
            <svg viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 40c0-14 8-24 22-28 2 8 0 20-8 28-6 6-14 6-14 0z"/>
              <path d="M20 40c4-6 10-10 16-12"/>
            </svg>
          </div>
          <div>
            <div class="lio-pf__spec-title">Plant-based</div>
            <p class="lio-pf__spec-sub">Natural essential oils — nothing synthetic.</p>
          </div>
        </div>

        <div class="lio-pf__spec">
          <span class="lio-pf__spec-num">02</span>
          <div class="lio-pf__spec-icon">
            <svg viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 26c0-4 3-6 6-6s6 2 6 6v10"/>
              <path d="M28 36V14c0-3 2-5 5-5s5 2 5 5v16"/>
              <path d="M38 30V18c0-3 2-5 5-5s5 2 5 5v18c0 7-5 12-12 12h-8c-5 0-9-3-10-8l-3-10"/>
            </svg>
          </div>
          <div>
            <div class="lio-pf__spec-title">Handcrafted</div>
            <p class="lio-pf__spec-sub">Precision wooden diffuser, built to last.</p>
          </div>
        </div>

        <div class="lio-pf__spec">
          <span class="lio-pf__spec-num">03</span>
          <div class="lio-pf__spec-icon">
            <svg viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M30 8l-14 6v10c0 10 6 18 14 22 8-4 14-12 14-22V14z"/>
              <path d="M24 28l4 4 8-10"/>
            </svg>
          </div>
          <div>
            <div class="lio-pf__spec-title">Nicotine-free</div>
            <p class="lio-pf__spec-sub">Zero nicotine. Zero vapor. Zero batteries.</p>
          </div>
        </div>

        <div class="lio-pf__spec">
          <span class="lio-pf__spec-num">04</span>
          <div class="lio-pf__spec-icon">
            <svg viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M30 10v10m0 20v10M10 30h10m20 0h10"/>
              <path d="M17 17l6 6m14 14l6 6M17 43l6-6m14-14l6-6"/>
            </svg>
          </div>
          <div>
            <div class="lio-pf__spec-title">Fidget-friendly</div>
            <p class="lio-pf__spec-sub">A calming ritual for your hands.</p>
          </div>
        </div>
      </div>

      <div class="lio-pf__live">
        <span class="lio-pf__live-dot"></span>
        <span><strong>847 people</strong> bought this week</span>
      </div>

      <div class="lio-pf__cta-wrap">
        <a href="#" class="lio-pf__btn">
          Shop the original
          <span class="lio-pf__btn-arrow">→</span>
        </a>
        <div class="lio-pf__micro">
          <span>60-day money-back</span>
          <span class="lio-pf__micro-dot"></span>
          <span>Free EU shipping €30+</span>
        </div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Lio · Product feature",
  "tag": "section",
  "class": "section-lio-pf",
  "settings": [],
  "presets": [{ "name": "Lio · Product feature" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
