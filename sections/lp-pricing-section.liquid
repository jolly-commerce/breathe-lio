<script>
(function() {
  function formatDate(date) {
    const months = ['January', 'February', 'March', 'April', 'May', 'June', 
                    'July', 'August', 'September', 'October', 'November', 'December'];
    const month = months[date.getMonth()];
    const day = date.getDate();
    return `${month} ${day}`;
  }
  
  function isSameDay(date1, date2) {
    return date1.getFullYear() === date2.getFullYear() &&
           date1.getMonth() === date2.getMonth() &&
           date1.getDate() === date2.getDate();
  }

  function formatCountdown(hours, minutes, seconds) {
    const parts = [];
    if (hours > 0) parts.push(`${hours}hr`);
    if (minutes > 0) parts.push(`${minutes}mins`);
    if (seconds > 0 || parts.length === 0) parts.push(`${seconds} sec`);
    return parts.join(' ');
  }

  function updateShippingInfo() {
    const cutoffHour = {{ section.settings.cutoff_hour | default: 15 }};
    const cutoffMinute = {{ section.settings.cutoff_minute | default: 0 }};
    const now = new Date();
    
    const todayCutoff = new Date();
    todayCutoff.setHours(cutoffHour, cutoffMinute, 0, 0);
    todayCutoff.setSeconds(0);
    todayCutoff.setMilliseconds(0);

    const nowTime = now.getTime();
    const cutoffTime = todayCutoff.getTime();
    const isBeforeCutoff = nowTime < cutoffTime;
    
    const shippingDate = new Date(now);
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    
    if (!isBeforeCutoff) {
      shippingDate.setDate(shippingDate.getDate() + 1);
    }

    const isShippingToday = isSameDay(shippingDate, today);
    const dateText = isShippingToday
      ? `Ships today, ${formatDate(shippingDate)}`
      : `Ships tomorrow, ${formatDate(shippingDate)}`;

    const targetCutoff = new Date(todayCutoff);
    if (!isBeforeCutoff) {
      targetCutoff.setDate(targetCutoff.getDate() + 1);
    }

    const diff = Math.max(0, targetCutoff.getTime() - nowTime);
    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    document.querySelectorAll('.shipping-date-text').forEach(el => {
      el.textContent = dateText;
    });
    document.querySelectorAll('.shipping-countdown-text').forEach(el => {
      el.textContent = `${formatCountdown(hours, minutes, seconds)}`;
    });
  }

  updateShippingInfo();
  setInterval(updateShippingInfo, 1000);
})();
</script>

<script>
(function() {
  function updateCardPrices(card, targetVariant) {
    const priceContainer = card.querySelector('.pricing-card-price-container');
    if (!priceContainer) {
      return;
    }
    
    const soloPrice = card.getAttribute('data-solo-price') || '';
    const soloOldPrice = card.getAttribute('data-solo-old-price') || '';
    const soloSaveAmount = card.getAttribute('data-solo-save-amount') || '';
    const togetherPrice = card.getAttribute('data-together-price') || '';
    const togetherOldPrice = card.getAttribute('data-together-old-price') || '';
    const togetherSaveAmount = card.getAttribute('data-together-save-amount') || '';
    
    const currentPrice = targetVariant === 'solo' ? soloPrice : togetherPrice;
    const currentOldPrice = targetVariant === 'solo' ? soloOldPrice : togetherOldPrice;
    const currentSaveAmount = targetVariant === 'solo' ? soloSaveAmount : togetherSaveAmount;
    
    const oldPriceEl = priceContainer.querySelector('.pricing-card-old-price');
    const priceEl = priceContainer.querySelector('.pricing-card-price');
    const saveAmountEl = priceContainer.querySelector('.pricing-card-save-amount');
    const saveAmountText = saveAmountEl ? saveAmountEl.querySelector('span') : null;
    
    if (priceEl && currentPrice) {
      priceEl.textContent = currentPrice;
    }
    
    if (oldPriceEl && currentOldPrice) {
      oldPriceEl.textContent = currentOldPrice;
      oldPriceEl.style.display = 'inline';
    } else if (oldPriceEl) {
      oldPriceEl.style.display = 'none';
    }
    
    if (saveAmountEl && saveAmountText && currentSaveAmount) {
      saveAmountText.textContent = `🔥 Save ${currentSaveAmount}`;
      saveAmountEl.style.display = 'flex';
    } else if (saveAmountEl) {
      saveAmountEl.style.display = 'none';
    }
    
    const soloImage = card.getAttribute('data-solo-image') || '';
    const togetherImage = card.getAttribute('data-together-image') || '';
    const currentImage = targetVariant === 'solo' ? soloImage : togetherImage;
    
    if (currentImage) {
      const imageEl = card.querySelector('.pricing-card-image-img');
      if (imageEl) {
        imageEl.src = currentImage;
      }
    }
  }
  
  const toggleSwitch = document.querySelector('.pricing-toggle-wrapper .toggle-switch');
  const toggleSlider = document.querySelector('.pricing-toggle-wrapper .toggle-slider');
  const toggleLabels = document.querySelectorAll('.pricing-toggle-wrapper .toggle-label');
  const pricingCards = document.querySelectorAll('.pricing-card');
  
  if (!toggleSwitch || !toggleSlider || toggleLabels.length < 2) return;
  
  const leftLabelText = toggleLabels[0].textContent.trim().toLowerCase();
  const rightLabelText = toggleLabels[1].textContent.trim().toLowerCase();
  
  const isSoloLeft = leftLabelText.includes('solo') || leftLabelText.includes('Start Solo');
  const isTogetherRight = rightLabelText.includes('together') || rightLabelText.includes('Start together');
  
  let isLeftActive = true;
  
  function updateToggleState(activeLeft) {
    isLeftActive = activeLeft;
    
    if (activeLeft) {
      toggleSlider.style.transform = 'translateX(0)';
    } else {
      toggleSlider.style.transform = 'translateX(36px)';
    }
    
    toggleLabels.forEach((label, index) => {
      if (activeLeft) {
        if (index === 0) {
          label.style.color = '#00B67C';
          label.style.opacity = '1';
        } else {
          label.style.color = '#0A3213';
          label.style.opacity = '0.5';
        }
      } else {
        if (index === 0) {
          label.style.color = '#0A3213';
          label.style.opacity = '0.5';
        } else {
          label.style.color = '#00B67C';
          label.style.opacity = '1';
        }
      }
    });
    
    const targetVariant = activeLeft ? 'solo' : 'together';
    
    pricingCards.forEach(card => {
      card.style.display = 'flex';
      updateCardPrices(card, targetVariant);
    });
    
    const allForms = document.querySelectorAll('.pricing-card-add-to-cart-form');
    
    const pricingSection = document.querySelector('.pricing-section');
    const productHandle = pricingSection ? pricingSection.getAttribute('data-section-product-handle') : 
                         (allForms[0] ? allForms[0].getAttribute('data-product-handle') : null);
    
    if (!productHandle) {
      return;
    }
    
    fetch(`/products/${productHandle}.js`)
      .then(response => response.json())
      .then(product => {
        const targetPackOption = targetVariant === 'solo' ? 'Start Solo' : 'Start Together';
        
        allForms.forEach((form, formIndex) => {
          const variantInput = form.querySelector('.variant-id-input');
          if (!variantInput) {
            return;
          }
          
          const formLioVersion = form.getAttribute('data-lio-version') || 'decoy';
          
       let lioVersionOption = '';
if (formLioVersion === 'hero') {
  lioVersionOption = 'Lio 90-Day Starter Kit (1 month free + free Lio)';
} else if (formLioVersion === 'decoy') {
  lioVersionOption = 'Lio 30-Day Starter Kit (free Lio)';
}
          
          let matchingVariant = null;
          
          matchingVariant = product.variants.find(v => {
            if (!v.available) return false;
            
            const hasPackOption = v.option1 === targetPackOption || v.option2 === targetPackOption || v.option3 === targetPackOption;
            if (!hasPackOption) return false;
            
            if (lioVersionOption) {
              const hasLioVersion = v.option1 === lioVersionOption || v.option2 === lioVersionOption || v.option3 === lioVersionOption;
              if (!hasLioVersion) return false;
            }
            
            return true;
          });
          
          if (!matchingVariant) {
            matchingVariant = product.variants.find(v => {
              if (!v.available) return false;
              return v.option1 === targetPackOption || v.option2 === targetPackOption || v.option3 === targetPackOption;
            });
          }
          
          if (matchingVariant) {
            variantInput.value = matchingVariant.id;
            
            const form = variantInput.closest('.pricing-card-add-to-cart-form');
            if (form) {
              form.setAttribute('data-variant-id', matchingVariant.id);
              form.setAttribute('data-pack-variant', targetVariant);
            }
            
            const card = form ? form.closest('.pricing-card') : null;
            if (card) {
              updateCardPrices(card, targetVariant);
            }
          }
        });
      })
      .catch(error => {
      });
  }
  
  function initializePrices() {
    const pricingCards = document.querySelectorAll('.pricing-card');
    const targetVariant = 'solo';
    
    pricingCards.forEach(card => {
      updateCardPrices(card, targetVariant);
      
      const soloImage = card.getAttribute('data-solo-image') || '';
      if (soloImage) {
        const imageEl = card.querySelector('.pricing-card-image-img');
        if (imageEl) {
          imageEl.src = soloImage;
        }
      }
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePrices);
  } else {
    initializePrices();
  }
  
  toggleSwitch.addEventListener('click', function() {
    updateToggleState(!isLeftActive);
  });
  
  updateToggleState(true);
})();
</script>

<script>
(function() {
  const addToCartForms = document.querySelectorAll('.pricing-card-add-to-cart-form');
  
  addToCartForms.forEach(form => {
    form.addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const button = this.querySelector('.pricing-card-add-to-cart');
      const buttonText = button.querySelector('.button-text');
      const originalText = buttonText.textContent;
      const variantInput = this.querySelector('input[name="id"]');
      let variantId = variantInput ? variantInput.value : null;
      const dataVariantId = this.getAttribute('data-variant-id');
      
      if (!variantId || variantId === '0' || variantId === '') {
        if (dataVariantId) {
          variantId = dataVariantId;
          if (variantInput) {
            variantInput.value = dataVariantId;
          }
        } else {
          alert('Please wait a moment for the product to load, then try again.');
          return;
        }
      }
      
      if (!variantId || variantId === '0' || variantId === '') {
        return;
      }
      
      button.disabled = true;
      button.style.opacity = '0.7';
      buttonText.textContent = 'Adding...';
      
      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          })
        });
        
        if (!response.ok) {
          const errorData = await response.json().catch(() => ({}));
          throw new Error(errorData.description || errorData.message || 'Failed to add product to cart');
        }

        await response.json();
        window.location.href = '/checkout';
        
      } catch (error) {
        const errorMessage = error.message || 'Failed to add product to cart. Please try again.';
        alert(errorMessage);
        button.disabled = false;
        button.style.opacity = '1';
        buttonText.textContent = originalText;
      }
    });
  });
})();
</script>

<script>
(function() {
  const isMobile = window.innerWidth <= 768;
  
  function handleTooltipClick() {
    const tooltipWrappers = document.querySelectorAll('.gift-tooltip-wrapper');
    
    tooltipWrappers.forEach(wrapper => {
      const icon = wrapper.querySelector('.gift-info-icon');
      if (!icon) return;
      
      icon.addEventListener('click', function(e) {
        e.stopPropagation();
        
        tooltipWrappers.forEach(otherWrapper => {
          if (otherWrapper !== wrapper) {
            otherWrapper.classList.remove('mobile-active');
          }
        });
        
        wrapper.classList.toggle('mobile-active');
      });
    });
    
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.gift-tooltip-wrapper')) {
        tooltipWrappers.forEach(wrapper => {
          wrapper.classList.remove('mobile-active');
        });
      }
    });
  }
  
  if (isMobile) {
    handleTooltipClick();
  }
  
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      const newIsMobile = window.innerWidth <= 768;
      if (newIsMobile !== isMobile) {
        location.reload();
      }
    }, 250);
  });
})();
</script>

