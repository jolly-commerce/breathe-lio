                            <path d="M10 18.3327C5.39762 18.3327 1.66667 14.6017 1.66667 9.99935C1.66667 5.39697 5.39762 1.66602 10 1.66602C14.6023 1.66602 18.3333 5.39697 18.3333 9.99935C18.3333 14.6017 14.6023 18.3327 10 18.3327ZM10 7.91602C10.6903 7.91602 11.25 7.35637 11.25 6.66602C11.25 5.97566 10.6903 5.41602 10 5.41602C9.30967 5.41602 8.75 5.97566 8.75 6.66602C8.75 7.35637 9.30967 7.91602 10 7.91602ZM11.6667 12.4993H10.8333V8.74935H8.33333V10.416H9.16667V12.4993H8.33333V14.166H11.6667V12.4993Z" fill="{% if block.settings.is_featured and block.settings.card_type == 'hero' %}#FAFEFC{% else %}currentColor{% endif %}"/>
                          </svg>
