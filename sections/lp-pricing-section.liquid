                            <div class="gift-tooltip" style="position: absolute; top: 50%; left: calc(100% + 12px); transform: translateY(-50%); background-color: #FFFFFF; border: 1px solid #0A3213; border-radius: 8px; padding: 16px; max-width: 325px; width: max-content; box-shadow: 0px 4px 6px -2px rgba(16, 24, 40, 0.03), 0px 12px 16px -4px rgba(16, 24, 40, 0.08); opacity: 0; visibility: hidden; transition: opacity 0.2s ease, visibility 0.2s ease; z-index: 1000; pointer-events: none;">
