{{ 'ecom-store-benefits.css' | asset_url | stylesheet_tag: preload: true }}


<style>
  .ecom-store-benefits {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 0 !important;
    padding-right: 0 !important;

    @media (min-width: 1150px) {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
</style>

<div class="ecom-store-benefits">
  <div class="ecom-store-benefits__wrapper container">
    {% for block in section.blocks %}
      <div class="ecom-store-benefits__item">
        <div class="ecom-store-benefits__item-icon">
          {{ block.settings.icon | image_url: width: 250 | image_tag: loading: 'lazy', width: 250, height: 250, class: 'ecom-store-benefits__item-icon-image'  }}
        </div>
        <div class="ecom-store-benefits__item-content">
          <h3 class="ecom-store-benefits__item-title">
            {{ block.settings.title }}
          </h3>
          <p class="ecom-store-benefits__item-description">
            {{ block.settings.description }}
          </p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "Ecom Store Benefits",
    "settings": [
      {
        "type": "header",
        "content": "Paddings",
        "info": "Paddings for section"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 32
      },
      {
        "type": "range",
        "id": "padding_top_desktop",
        "label": "Padding Top Desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 40
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 64
      },
      {
        "type": "range",
        "id": "padding_bottom_desktop",
        "label": "Padding Bottom Desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 80
      }
    ],
    "blocks": [
      {
        "type": "benefit",
        "name": "Benefit",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "text",
            "id": "description",
            "label": "Description"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Ecom Store Benefits"
      }
    ]
  }
{% endschema %}

