      </div>

      <div class="review-card">
        <div class="review-card-head">
          <div class="review-avatar" style="background: linear-gradient(135deg, #d4a5b8, #8a5d7a);">M</div>
          <div>
            <div class="review-meta-name">Michael J.</div>
