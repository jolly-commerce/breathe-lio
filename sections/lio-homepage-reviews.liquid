            <svg><use href="#star"/></svg><svg><use href="#star"/></svg><svg><use href="#star"/></svg><svg><use href="#star"/></svg><svg><use href="#star"/></svg>
          </div>
        </div>
        <div class="review-body">
          "It's insane — this stuff really helps. People ask me what it is, they try it, and they order one too. <span class="highlight">I'm really satisfied.</span>"
        </div>
        <div class="review-foot">
          <div class="review-verified">Verified</div>
          <span>Mixed Pack · 5 months in</span>
        </div>
      </div>
    </div>
  </div>
</section>

