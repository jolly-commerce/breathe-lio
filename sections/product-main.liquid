{% comment %}
  Section: "product-main"
  Created by: Nazarii Prokopchuk / Yevhen Hryhorenko

  Snippets:
  - product-main-gallery
  - product-main-price
  - product-main-variant-picker
  - product-main-subscription
  - product-main-buy-buttons
  - product-main-description-list
  - product-main-best-reviews
  - product-main-accordion
  - product-main-recommendations
  - product-main-features
  - product-main-info-tabs
  - product-main-sticky-atc
{% endcomment %}
{% style %}
  .background-{{ section.id }} {
    background: {{ section.settings.background }};
  }

  .paddings-{{ section.id }} {
    padding-top: {{ section.settings.padding_mob_t }}px;
    padding-bottom: {{ section.settings.padding_mob_b }}px;
  }

  @media screen and (min-width: 768px) {
    .paddings-{{ section.id }} {
      padding-top: {{ section.settings.padding_dsk_t }}px;
      padding-bottom: {{ section.settings.padding_dsk_b }}px;
    }
  }
{% endstyle %}

{%- assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id -%}
{%- assign pack_selector_block = section.blocks | where: 'type', 'pack_selector' | first -%}
{%- assign product = section.settings.product_main | default: product -%}

{% # Page url %}
{%- assign page_url = content_for_header
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{% assign gallery_block = section.blocks | where: 'type', 'gallery' | first %}

<div class="background-{{ section.id }} jc-overflow-hidden lg:jc-overflow-visible">
  <div class="jc-container paddings-{{ section.id }}">
    <div class="lg:jc-flex-row jc-gap-10 xl:jc-gap-20 jc-relative jc-flex jc-flex-col">
      {%- # Gallery -%}

      {%- assign wrapper_class = '' -%}
      {%- if gallery_block.settings.enable_thumbnails_mob -%}
        {%- assign wrapper_class = '-jc-mx-5 lg:jc-mx-0' -%}
      {%- endif -%}

      <div class="jc-basis-full lg:jc-basis-[51.7%] jc-min-w-0 {{ wrapper_class }}">
        {% render 'product-main-gallery', root: gallery_block, product_form_id: product_form_id, product: product %}
      </div>

      {%- # Product info -%}
      <div class="jc-basis-full lg:jc-basis-[48.3%] jc-min-w-0">
        <div data-sticky class="jc-sticky jc-top-0 jc-flex jc-flex-col jc-gap-8 jc-pdp-content">
          {%- # Product titles -%}
          <div class="jc-space-y-4">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  <div class="[&_.loox-rating-label]:jc-underline jc-mb-4 [&_.loox-rating-label]:!jc-ml-4 [&_.loox-rating-label]:!jc-text-sm [&_.loox-rating-label]:lg:!jc-text-base
                     [&_.loox-rating-label]:!jc-leading-4 [&_.loox-rating-label]:lg:!jc-leading-5 [&_.loox-icon]:!jc-size-5">
                    {% render block %}
                  </div>
                {%- when 'loox_reviews' -%}
                  {%- if product.metafields.loox.avg_rating != blank and product.metafields.loox.num_reviews != blank -%}          
                    <div class="jc-flex jc-gap-4 jc-items-center">
                      <a href="#looxReviews" class="[&_.loox-rating-label]:!jc-hidden [&_.loox-icon]:!jc-size-5"><div class="loox-rating" data-id="{{ product.id }}" data-rating="{{ product.metafields.loox.avg_rating }}" data-raters="{{ product.metafields.loox.num_reviews }}"></div></a>
                      <a href="#looxReviews">
                        <span class="jc-text-sm lg:jc-text-base jc-leading-4 lg:jc-leading-5 jc-text-darkGreen jc-font-normal jc-underline">{{ block.settings.loox_rating_text | replace: '[rating]', product.metafields.loox.avg_rating | replace: '[count]', product.metafields.loox.num_reviews }}</span>
                      </a>
                    </div>
                  {%- endif -%}
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    <div class="jc-font-poppins jc-font-normal jc-text-base [&_*]:!jc-leading-6 !jc-mt-2 jc-text-amazon [&_strong]:!jc-font-semibold">
                      {{- product.description -}}
                    </div>
                  {%- endif -%}
                {%- when 'product_tags' -%}
                  {% assign product_tags = product.metafields.jolly_meta.product_tags.value %}
                  {% if product_tags != blank %}
                    <div class="jc-flex jc-gap-2 jc-flex-wrap !jc-mt-3">
                    {% for tag in product_tags %}
                      <div class="jc-py-1 jc-px-2 lg:jc-px-2.5 jc-rounded-xs jc-border-munsell jc-border jc-border-solid">
                        <span class="jc-block jc-text-xs lg:jc-text-sm jc-leading-4 lg:jc-leading-5 jc-font-normal jc-text-britishRacingGreen">
                          {{ tag }}
                        </span>
                      </div>
                    {% endfor %}
                    </div>
                  {%- endif -%}
                {%- when 'title' -%}
                  {%- if product.title != blank -%}
                    <h1 class="jc-text-7xl jc-leading-11 lg:jc-text-[46px] lg:jc-leading-13 jc-font-normal jc-font-sigumL jc-uppercase">
                      {{- product.title -}}
                    </h1>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- # Product blocks -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'pack_selector' -%}
                {%- render 'product-main-pack-selector', root: block, product: product -%}
              {%- when 'delivery_info' -%}
                {%- render 'product-main-delivery-info', root: block, product: product -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if pack_selector_block != blank -%}
  {% assign step_2_products = pack_selector_block.settings.step_2_packs %}
  {%- render 'product-main-pack-selector-popup', step_2_products: step_2_products, product: product -%}
{%- endif -%}

