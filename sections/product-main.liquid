{% comment %}
  Section: "product-main"
  Created by: Nazarii Prokopchuk / Yevhen Hryhorenko

  Snippets:
  - product-main-gallery
  - product-main-price
  - product-main-variant-picker
  - product-main-subscription
  - product-main-buy-buttons
  - product-main-description-list
  - product-main-best-reviews
  - product-main-accordion
  - product-main-recommendations
  - product-main-features
  - product-main-info-tabs
  - product-main-sticky-atc
{% endcomment %}

{% style %}
  .background-{{ section.id }} {
    background: {{ section.settings.background }};
  }

  .paddings-{{ section.id }} {
    padding-top: {{ section.settings.padding_mob_t }}px;
    padding-bottom: {{ section.settings.padding_mob_b }}px;
  }

  @media screen and (min-width: 768px) {
    .paddings-{{ section.id }} {
      padding-top: {{ section.settings.padding_dsk_t }}px;
      padding-bottom: {{ section.settings.padding_dsk_b }}px;
    }
  }
{% endstyle %}

{%- # ! PRODUCT FORM ID -%}
{%- assign product_form_id = 'product-form-' | append: section.id | append: '-' | append: product.id -%}

{%- # Sticky ATC block -%}
{% assign sticky_atc = section.blocks | where: 'type', 'sticky_atc' | first %}

{% # Page url %}
{%- assign page_url = content_for_header
  | split: '"pageurl":"'
  | last
  | split: '"'
  | first
  | split: '.myshopify.com'
  | last
  | replace: '\/', '/'
  | replace: '%20', ' '
  | replace: '\u0026', '&'
-%}

{% assign gallery_block = section.blocks | where: 'type', 'gallery' | first %}

<div class="background-{{ section.id }} jc-overflow-hidden md:jc-overflow-visible">
  <div class="jc-container paddings-{{ section.id }}">
    <div class="md:jc-flex-row md:jc-gap-10 jc-relative jc-flex jc-flex-col jc-gap-4">
      {%- # Gallery -%}

      <div class="jc-basis-full md:jc-basis-1/2 jc-min-w-0">
        {% render 'product-main-gallery', root: gallery_block, product_form_id: product_form_id %}
      </div>

      {%- # Product info -%}
      <div class="jc-basis-full md:jc-basis-1/2 jc-min-w-0">
        <div data-sticky class="jc-sticky jc-top-0 jc-flex jc-flex-col jc-gap-8 jc-pdp-content jc-overflow-hidden">
          {%- # Product titles -%}
          <div>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'tagline' -%}
                  {%- if block.settings.tagline != blank -%}
                    <p class="jc-uppercase jc-text-xs jc-font-semibold jc-leading-4 jc-mb-4">
                      {{- block.settings.tagline -}}
                    </p>
                  {%- endif -%}
                {%- when 'title' -%}
                  {%- if product.title != blank -%}
                    <h1 class="jc-text-7xl jc-leading-12 lg:jc-text-9xl lg:jc-leading-14 jc-font-bold">
                      {{- product.title -}}
                    </h1>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>

          {%- # Product blocks -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="jc-text-md jc-leading-8">
                    {{- product.description -}}
                  </div>
                {%- endif -%}
              {%- when 'price' -%}
                {%- render 'g-price-block',
                  quantity_update: false,
                  show_sale_badge: block.settings.show_sale_badge,
                  product_form_id: product_form_id,
                  class: 'jc-text-3xl jc-leading-8 jc-gap-4'
                -%}
              {%- when 'buy_buttons' -%}
                {%- render 'product-main-buy-buttons', root: block, product_form_id: product_form_id -%}
              {%- when 'accordion' -%}
                {%- render 'product-main-accordion', root: block -%}
              {%- when 'pack_selector' -%}
                {%- render 'product-main-pack-selector', root: block -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>


{%- # Render of sticky add to cart -%}
{% if sticky_atc != blank %}
  {% render 'product-main-sticky-atc', root: sticky_atc, product_form_id: product_form_id %}
{% endif %}

{% if gallery_block.settings.enable_lightbox %}
  {% render 'product-main-gallery-lightbox', root: gallery_block %}
{% endif %}

{% schema %}
