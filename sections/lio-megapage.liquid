        <div class="lio-mp-compare-cell lio-mp-compare-cell--brand" role="columnheader"><span class="lio-mp-logo-mini">Lio</span></div>
        <div class="lio-mp-compare-cell" role="columnheader">Vape</div>
        <div class="lio-mp-compare-cell" role="columnheader">Cigarette</div>
        <div class="lio-mp-compare-cell" role="columnheader">Patches</div>
      </div>
      <div class="lio-mp-compare-row lio-mp-compare-row--price" role="row">
        <div class="lio-mp-compare-cell" role="cell">Cost per day*</div>
        <div class="lio-mp-compare-cell lio-mp-compare-cell--brand" role="cell">€0.79</div>
        <div class="lio-mp-compare-cell" role="cell">€4.50</div>
        <div class="lio-mp-compare-cell" role="cell">€11.50</div>
        <div class="lio-mp-compare-cell" role="cell">€2.30</div>
      </div>
      {% assign rows = "0% nicotine|y|n|n|n,Hand-to-mouth ritual|y|y|y|n,No vapor or smoke|y|n|n|y,Battery-free no charging|y|n|y|y,Refillable forever|y|n|n|n,Use anywhere offices flights|y|n|n|y,90-day money-back|y|n|n|n" | split: "," %}
