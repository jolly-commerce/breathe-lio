    </header>

    {% assign reasons = "Break the addiction not the habit|0% nicotine — no addictive substances ever|The hand-to-mouth ritual stays — only the chemicals leave|Built on Rose %26 Behm Sayette %26 Parrott research on sensorimotor replacement,Affordable %26 effective|€0.79/day vs ~€11.50/day for a pack-a-day habit|~3 weeks to break even on the device cost|€3,670 saved per year on the typical smoker spend (NL/DE/IE 2026)|One device lasts forever only the cores need refilling,Designed around the breath|Real menthol throat hit — the physical sensation is there|Patented airflow geometry refined since 2018|Plant-oil cores: cool clean never sweet never artificial|No heat no combustion no vapor — just air,Tested cited independently verified|0% nicotine 0% tobacco — Eurofins Lab Report 2024|Plant-based aroma cores — Independent assay by TNO|82% of users report reduced cravings (n=1243 study 2024)|IFRA-certified pharmaceutical-grade oils nothing synthetic,Discreet portable everywhere-friendly|Smaller than a pen — fits any pocket any bag|No vapor no smell beyond a subtle natural aroma|Use it on flights in offices in restaurants — no rules to break|Wooden body lasts forever refills ship from Amsterdam" | split: "," %}

    {% for reason in reasons %}
      {% assign parts = reason | split: "|" %}
      {% assign idx = forloop.index %}
      <article class="lio-mp-reason{% if idx == 2 or idx == 4 %} lio-mp-reason--alt{% endif %}">
        <div class="lio-mp-reason-visual">
          <div class="lio-mp-reason-visual-placeholder">
            <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="40" cy="40" r="28"/>
              <circle cx="40" cy="40" r="4" fill="currentColor"/>
            </svg>
          </div>
        </div>
        <div class="lio-mp-reason-body">
          <div class="lio-mp-reason-num-row">
            <span class="lio-mp-reason-num-dot" aria-hidden="true"></span>
            <span class="lio-mp-reason-num">REASON {{ idx | prepend: '00' | slice: -2, 2 }}</span>
          </div>
          <h3 class="lio-mp-reason-h3">{{ parts[0] }}</h3>
          <ul class="lio-mp-reason-list">
            {% for i in (1..4) %}
              {% if parts[i] %}<li>{{ parts[i] | replace: '%26', '&' }}</li>{% endif %}
            {% endfor %}
          </ul>
          <div class="lio-mp-reason-cta-row">
            <a href="#lio-cta" class="lio-mp-cta">
              Order now &amp; save
              <span class="lio-mp-cta-arrow" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </a>
            {% if idx == 1 %}
              <div class="lio-mp-reason-trust-strip">
                <span>90-day money-back</span>
                <span>Free worldwide shipping over €60</span>
              </div>
            {% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

