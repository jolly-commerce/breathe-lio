        {% assign cells = r | split: "|" %}
        <div class="lio-mp-compare-row" role="row">
          <div class="lio-mp-compare-cell" role="cell">{{ cells[0] }}</div>
          {% for i in (1..4) %}
            <div class="lio-mp-compare-cell{% if i == 1 %} lio-mp-compare-cell--brand{% endif %}" role="cell">
              {% if cells[i] == "y" %}
                <span class="lio-mp-yes" aria-label="Yes"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              {% else %}
                <span class="lio-mp-no" aria-label="No"><svg viewBox="0 0 16 16" fill="none"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg></span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    <!-- CRO: mid-section CTA -->
    <div class="lio-mp-compare-cta-row">
      <a href="#lio-cta" class="lio-mp-cta lio-mp-cta--mint">
