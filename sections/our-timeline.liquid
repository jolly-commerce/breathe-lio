<style>
  .our-timeline h2 {
    font-size: 25px;
    font-weight: 400;
    letter-spacing: -0.8px;
    line-height: 1.2;
    max-width: 800px;
    margin: 30px 0px;
}
.our-timeline p.sub-head {
    font-weight: 600;
  font-size : 14px;
    padding: 5px 25px 5px 25px;
    max-width: fit-content;
  color : var(--lio-yellow);
    background: var(--lio-dark-green);
    border-radius: 7px;
    line-height: 1.3;
}
  .our-timeline h2 span{
    font-weight : 700;
  }
  .our-timeline{
    max-width: 1400px;
    margin: auto;
    width : 100%;
    display : flex;
    flex-direction : column;
    padding : 30px 30px 50px 30px;
  }


  .timelinet {
      max-width: 100%;
    }

    /* Tabs Container */
   .timeline-tabs {
    list-style-type: none;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #ccc;
    margin-bottom: 1.5rem;
}

  

    .tab-button {
      background: none;
      border: none;
      font-size: 60px;
      padding: 0.75rem 0rem;
      cursor: pointer;
      position: relative;
      outline: none;
      color: #302F2F;
       font-weight: 400;
        border-bottom: 2px solid transparent;
      display :flex;
      align-items : center;
      gap : 20px;
      font-family : 'Sigum';
    }

    .tab-button.gactive {
      border-bottom: 2px solid #222;
    }

    /* Tab Content Panels */
    .tab-content {
      display: none; /* Hidden by default */
      animation: fadeInI 0.5s ease-in-out;
    }
    .tab-content.gactive {
      display: block; /* Only show the active tab’s content */
    }

    /* A simple fade-in animation for when content changes */
    @keyframes fadeInI {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
.circle-tab-button {
    min-width: 35px;
    min-height: 35px;
    border-radius: 50%;
    border: 1px solid #005128;
    background: transparent;
    transition: all 0.4s ease;
    transform: translateY(-3px);
}
      .tab-button.gactive .circle-tab-button{
 background  : #005128;
}
 @media screen and (max-width: 1023px){
.our-timeline{
    padding : 30px 30px 0px 30px;
}
   .timeline-tabs {
    list-style-type: none;
    display: flex;
    justify-content: space-between;
    border-bottom: 0px solid #1F524D40;
    margin-bottom: 1.5rem;
    flex-direction: column;
}
   .tab-content{
     padding : 0px 0px 25px;
   }
   .tab-button {
    font-size: 2rem;
    border-bottom: 0px solid transparent;
}
   .tab-button.gactive {
    border-bottom: 0px solid #222;
}
 .our-timeline h2 {
    font-size: 20px;
    letter-spacing: -0.6px;
    max-width: 325px;
}
   .circle-tab-button {
    min-width: 20px;
    min-height: 20px;
    transform: translateY(-1px);
}
 }
</style>
<div class="our-timeline">
  <p class="sub-head">{{ section.settings.sub-heading }}</p>
   <h2>
        {{ section.settings['heading-before'] -}}
        {% if section.settings['high-heading'] != blank %}
          <span class="">{{ section.settings['high-heading'] }}</span>
        {% endif %}
         {{ section.settings['heading-after'] -}}
      </h2>
<div class="timelinet">
  <!-- Tabs -->
  <ul class="timeline-tabs">
    <li>
      <button class="tab-button gactive" data-tab="2023">
        <div class="circle-tab-button"></div>
        2022
      </button>
    </li>
      <div class="desktop-hidden tab-content gactive" id="content-2023">
   
      {{ section.settings.content1 }}
 
  </div>

    <li>
      <button class="tab-button" data-tab="2024">
          <div class="circle-tab-button"></div>
        2023
      </button>
    </li>
     <div class="desktop-hidden tab-content" id="content-2024">
    
      {{ section.settings.content2 }}

  </div>

    <li>
      <button class="tab-button" data-tab="2025">
          <div class="circle-tab-button"></div>
        2025
      </button>
    </li>
     <div class="desktop-hidden  tab-content" id="content-2025">
 
     {{ section.settings.content3 }}

  </div>
  </ul>

  <!-- Tab Content for 2023 -->
  <div class="mobile-hidden tab-content gactive" id="content-2023">
   
      {{ section.settings.content1 }}
 
  </div>

  <!-- Tab Content for 2024 -->
  <div class="mobile-hidden tab-content" id="content-2024">
    
      {{ section.settings.content2 }}

  </div>

  <!-- Tab Content for 2025 -->
  <div class="mobile-hidden  tab-content" id="content-2025">
 
     {{ section.settings.content3 }}

  </div>
</div>


</div>
<!-- Simple Tab Toggle Script -->
<script>
  const tabButtons = document.querySelectorAll('.tab-button');
  const mobileContents = document.querySelectorAll('.desktop-hidden.tab-content');
  const desktopContents = document.querySelectorAll('.mobile-hidden.tab-content');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const year = button.getAttribute('data-tab');

      // Remove active state from all tab buttons
      tabButtons.forEach(btn => btn.classList.remove('gactive'));

      // Hide all mobile tab contents
      mobileContents.forEach(content => content.classList.remove('gactive'));

      // Hide all desktop tab contents
      desktopContents.forEach(content => content.classList.remove('gactive'));

      // Add active class to the clicked tab button
      button.classList.add('gactive');

      // Show mobile and desktop content for the selected year
      const mobileContent = document.querySelector(`.desktop-hidden#content-${year}`);
      const desktopContent = document.querySelector(`.mobile-hidden#content-${year}`);

      if (mobileContent) mobileContent.classList.add('gactive');
      if (desktopContent) desktopContent.classList.add('gactive');
    });
  });
</script>

{% schema %}
  {
    "name": "our-timeline",
    "settings": [
   {
    "type": "text",
    "id": "sub-heading",
    "label": "sub heading"
      },
       {
    "type": "text",
    "id": "heading-before",
    "label": "Heading Before"
      },
     {
    "type": "text",
    "id": "high-heading",
    "label": "Heighlighted heading"
      },
     {
    "type": "text",
    "id": "heading-after",
    "label": "Heading After"
      },
       {
    "type": "richtext",
    "id": "content1",
    "label": "content1"
      },
        {
    "type": "richtext",
    "id": "content2",
    "label": "content2"
      },
        {
    "type": "richtext",
    "id": "content3",
    "label": "content3"
      },
      
      
      
    ],
    "presets": [{
      "name": "our-timeline"
    }]
  }
{% endschema %}