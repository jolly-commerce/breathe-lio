{{ 'ecom-faq.css' | asset_url | stylesheet_tag: preload: true }}

<div class="ecom-faq" id="faq-{{ section.id }}">
  <div class="ecom-faq__container">
    <div class="ecom-faq__header">
      <h2 class="ecom-faq__title">
        {{ section.settings.title }} 
        <span class="ecom-faq__title-highlight">{{ section.settings.high_title }}</span>
      </h2>
      
      {% if section.settings.show_categories and section.blocks.size > 0 %}
        <div class="ecom-faq__tabs">
          <button class="ecom-faq__tab ecom-faq__tab--active" data-category="product">
            {{ section.settings.category_1_name }}
          </button>
          <button class="ecom-faq__tab" data-category="general">
            {{ section.settings.category_2_name }}
          </button>
        </div>
      {% endif %}
    </div>

    <div class="ecom-faq__grid">
      {% for block in section.blocks %}
        <div class="ecom-faq__item" data-category="{{ block.settings.category }}" {{ block.shopify_attributes }}>
          <button class="ecom-faq__question" data-index="{{ forloop.index }}">
            <span>{{ block.settings.title }}</span>
            <svg class="ecom-faq__icon" width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M19 9l-7 7-7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="ecom-faq__answer">
            <div class="ecom-faq__answer-content">{{ block.settings.content }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<script>
(function() {
  const faq = document.getElementById('faq-{{ section.id }}');
  if (!faq) return;

  // Accordion
  faq.querySelectorAll('.ecom-faq__question').forEach(btn => {
    btn.addEventListener('click', function() {
      const item = this.closest('.ecom-faq__item');
      const isOpen = item.classList.contains('active');
      
      faq.querySelectorAll('.ecom-faq__item').forEach(i => i.classList.remove('active'));
      if (!isOpen) item.classList.add('active');
    });
  });

  // Category tabs
  faq.querySelectorAll('.ecom-faq__tab').forEach(tab => {
    tab.addEventListener('click', function() {
      const category = this.dataset.category;
      
      faq.querySelectorAll('.ecom-faq__item').forEach(i => i.classList.remove('active'));
      faq.querySelectorAll('.ecom-faq__tab').forEach(t => t.classList.remove('ecom-faq__tab--active'));
      this.classList.add('ecom-faq__tab--active');
      
      faq.querySelectorAll('.ecom-faq__item').forEach(item => {
        item.style.display = item.dataset.category === category ? '' : 'none';
      });
    });
  });
  
  // Init first category
  const firstTab = faq.querySelector('.ecom-faq__tab');
  if (firstTab) {
    const firstCategory = firstTab.dataset.category;
    faq.querySelectorAll('.ecom-faq__item').forEach(item => {
      if (item.dataset.category !== firstCategory) item.style.display = 'none';
    });
  }
})();
</script>

{% schema %}
{
  "name": "Ecom FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked"
    },
    {
      "type": "text",
      "id": "high_title",
      "label": "Highlighted Title",
      "default": "Questions"
    },
    {
      "type": "header",
      "content": "Categories"
    },
    {
      "type": "checkbox",
      "id": "show_categories",
      "label": "Show Category Switcher",
      "default": true
    },
    {
      "type": "text",
      "id": "category_1_name",
      "label": "Category 1 Name",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "category_2_name",
      "label": "Category 2 Name",
      "default": "General"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            {"value": "product", "label": "Product"},
            {"value": "general", "label": "General"}
          ],
          "default": "product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "How does it work?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Answer",
          "default": "<p>Answer goes here</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ecom FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "category": "product",
            "title": "How does BreatheLio work?",
            "content": "<p>BreatheLio uses natural aromatherapy to help reduce cravings.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}