{{ 'ecom-faq.css' | asset_url | stylesheet_tag: preload: true }}


<style>
  .ecom-faq {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: 0 !important;
    padding-right: 0 !important;

    @media (min-width: 1280px) {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }
h2.ecom-faq__title {
    max-width: 290px;
}
@media (min-width: 1000px) {
  h2.ecom-faq__title {
    font-size: 55px;
    letter-spacing: -1.28px;
    margin-bottom: 40px;
    max-width: 500px;
    text-wrap: balance;
}
}  
</style>

<div class="ecom-faq">
  <div class="ecom-faq__container container">
    <div class="ecom-faq__header">
      <h2 class="ecom-faq__title">{{ section.settings.title }} <span>{{ section.settings.high-title }}</span></h2>
    </div>

    <div class="ecom-faq__questions-wrapper">
      <div>
        {% for block in section.blocks %}
          {% assign middle = forloop.index | modulo: 2 %}
          {% if middle == 1 %}
           <div class="faq-accordion-item">
            <div class="faq-accordion-header" data-target="{{ section.id }}-panel{{ forloop.index }}">
              <div class="faq-acc-con">
                <span>{{ block.settings.title }}</span>
              </div>
              <button class="faq-toggle"></button>
            </div>
            <div class="faq-accordion-panel" id="{{ section.id }}-panel{{ forloop.index }}">
              <p>{{ block.settings['content'] }}</p>
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
      <div>
        {% for block in section.blocks %}
          {% assign middle = forloop.index | modulo: 2 %}
          {% if middle == 0 %}
            <div class="faq-accordion-item">
            <div class="faq-accordion-header" data-target="{{ section.id }}-panel{{ forloop.index }}">
              <div class="faq-acc-con">
                <span>{{ block.settings.title }}</span>
              </div>
              <button class="faq-toggle"></button>
            </div>
            <div class="faq-accordion-panel" id="{{ section.id }}-panel{{ forloop.index }}">
              <p>{{ block.settings['content'] }}</p>
            </div>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ecom FAQ",
  "settings": [
    {
      "type": "header",
      "content": "Paddings",
      "info": "Paddings for the testimonials section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom Desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    },
     {
      "type": "text",
      "id": "high-title",
      "label": "highlighted Title",
      "default": "answered"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Answer",
          "default": "<p>Share some content to your customers about your products.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ecom FAQ",
    }
  ]
}
{% endschema %}