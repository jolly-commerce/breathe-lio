              assign variants_option2 = product_SvUZa1Ij16OPjiJd.variants | map: 'option2'
              assign variants_option3 = product_SvUZa1Ij16OPjiJd.variants | map: 'option3'
              assign selected_option = product_SvUZa1Ij16OPjiJd.options_with_values | where: 'name', 'Lio' | first

