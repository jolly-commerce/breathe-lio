{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
LIO WELCOME — multi-step signup card with scratch-card prize reveal
----------------------------------------------------------------------------------------------------------------------
Posts directly to Klaviyo's client-side Subscribe API. To manage copy/styling, edit this file and re-deploy.
{%- endcomment -%}

{%- assign company_id = section.settings.company_id | default: 'WmF2Pv' -%}
{%- assign list_id = section.settings.list_id -%}
{%- assign sms_list_id = section.settings.sms_list_id -%}
{%- assign privacy_url = section.settings.privacy_url | default: '/policies/privacy-policy' -%}
{%- assign success_cta_url = section.settings.success_cta_url | default: '/collections/all' -%}
{%- assign success_cta_label = section.settings.success_cta_label | default: 'Build your Flow' -%}
{%- assign uid = section.id | replace: '-', '' -%}

<link rel="preconnect" href="https://use.typekit.net">
<link rel="stylesheet" href="https://use.typekit.net/xhz7hhk.css">

<style>
  #lio-welcome-{{ uid }} {
    --forest:    #0b2410;
    --forest-2:  #133019;
    --white:     #ffffff;
    --cream:     #fcfefb;
    --cream-2:   #f4f7f2;
    --cream-3:   #ebf0e6;
    --mint:      #94fca9;
    --mint-soft: #cdfee1;
    --mint-deep: #6fde87;
    --f-04: rgba(11, 36, 16, 0.04);
    --f-06: rgba(11, 36, 16, 0.06);
    --f-08: rgba(11, 36, 16, 0.08);
    --f-10: rgba(11, 36, 16, 0.10);
    --f-14: rgba(11, 36, 16, 0.14);
    --f-25: rgba(11, 36, 16, 0.25);
    --f-40: rgba(11, 36, 16, 0.40);
    --f-55: rgba(11, 36, 16, 0.55);
    --f-72: rgba(11, 36, 16, 0.72);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    background: var(--cream);
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    font-weight: 400;
    color: var(--forest);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.005em;
    font-feature-settings: "ss01", "kern";
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    overflow-x: hidden;
  }
  #lio-welcome-{{ uid }} *,
  #lio-welcome-{{ uid }} *::before,
  #lio-welcome-{{ uid }} *::after { box-sizing: border-box; }
  #lio-welcome-{{ uid }} ::selection { background: var(--mint); color: var(--forest); }
  #lio-welcome-{{ uid }} button {
    font-family: inherit; cursor: pointer; -webkit-tap-highlight-color: transparent;
    border: none; background: none;
  }
  #lio-welcome-{{ uid }} input,
  #lio-welcome-{{ uid }} select { font-family: inherit; -webkit-appearance: none; appearance: none; }
  #lio-welcome-{{ uid }} .italic-word { font-style: italic; font-weight: 300; }
  #lio-welcome-{{ uid }} .circle { position: relative; display: inline-block; padding: 0 0.02em; isolation: isolate; }
  #lio-welcome-{{ uid }} .circle svg {
    position: absolute; left: 0; right: 0; bottom: -0.06em;
    width: 100%; height: 0.18em; z-index: -1; pointer-events: none; overflow: visible;
  }
  #lio-welcome-{{ uid }} .circle svg path {
    fill: none; stroke: var(--mint); stroke-width: 8; stroke-linecap: round; opacity: 0.7;
  }

  @keyframes lio-fade-in-up-{{ uid }} { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes lio-fade-in-{{ uid }} { from { opacity: 0; } to { opacity: 1; } }
  @keyframes lio-check-draw-{{ uid }} { from { stroke-dashoffset: 50; } to { stroke-dashoffset: 0; } }
  @keyframes lio-shake-{{ uid }} {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }
  @keyframes lio-spin-{{ uid }} { to { transform: rotate(360deg); } }

  #lio-welcome-{{ uid }} .signup-card {
    width: 100%; max-width: 460px; background: var(--white);
    border: 1px solid var(--f-08); border-radius: 24px; padding: 36px 28px;
    position: relative;
    box-shadow: 0 20px 50px rgba(11, 36, 16, 0.06), 0 8px 16px rgba(11, 36, 16, 0.03);
    animation: lio-fade-in-up-{{ uid }} 0.6s var(--ease);
  }
  @media (min-width: 480px) { #lio-welcome-{{ uid }} .signup-card { padding: 44px 40px; } }

  #lio-welcome-{{ uid }} .eyebrow-wrap { text-align: center; margin-bottom: 18px; }
  #lio-welcome-{{ uid }} .eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--f-55); font-size: 11px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  #lio-welcome-{{ uid }} .eyebrow-line { width: 18px; height: 1px; background: var(--f-25); }

  #lio-welcome-{{ uid }} .step { display: none; }
  #lio-welcome-{{ uid }} .step.is-active { display: block; animation: lio-fade-in-up-{{ uid }} 0.5s var(--ease); }

  #lio-welcome-{{ uid }} .step-title {
    font-size: 28px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.15;
    color: var(--forest); margin-bottom: 12px; text-align: center;
  }
  @media (min-width: 480px) { #lio-welcome-{{ uid }} .step-title { font-size: 32px; } }
  #lio-welcome-{{ uid }} .step-sub {
    font-size: 15px; line-height: 1.55; color: var(--f-72); margin-bottom: 28px;
    text-align: center; max-width: 360px; margin-left: auto; margin-right: auto;
  }

  #lio-welcome-{{ uid }} .scratch-stage {
    position: relative; width: 100%; aspect-ratio: 1.5 / 1;
    max-width: 380px; margin: 0 auto 16px;
    border-radius: 18px; overflow: hidden; background: var(--forest);
    box-shadow: 0 12px 32px rgba(11, 36, 16, 0.12);
    transition: box-shadow 0.6s var(--ease);
  }
  #lio-welcome-{{ uid }} .scratch-stage.is-revealed { box-shadow: 0 16px 40px rgba(11, 36, 16, 0.16); }

  #lio-welcome-{{ uid }} .scratch-prize {
    position: absolute; inset: 0;
    background: linear-gradient(160deg, var(--forest) 0%, var(--forest-2) 100%);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    color: var(--cream); text-align: center; padding: 20px;
  }
  #lio-welcome-{{ uid }} .scratch-prize::before {
    content: ""; position: absolute; inset: 0;
    background: radial-gradient(circle at 50% 40%, rgba(148, 252, 169, 0.10), transparent 60%);
    pointer-events: none;
  }
  #lio-welcome-{{ uid }} .scratch-prize-content {
    position: relative; display: flex; flex-direction: column; align-items: center;
    width: 100%; opacity: 1;
  }
  #lio-welcome-{{ uid }} .scratch-prize-label {
    font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--mint); margin-bottom: 10px; opacity: 0.85;
  }
  #lio-welcome-{{ uid }} .scratch-prize-headline {
    font-size: 28px; font-weight: 800; letter-spacing: -0.03em; line-height: 1.1;
    margin-bottom: 8px; color: var(--cream); padding: 0 4px;
  }
  @media (min-width: 480px) { #lio-welcome-{{ uid }} .scratch-prize-headline { font-size: 32px; } }
  #lio-welcome-{{ uid }} .scratch-prize-sub {
    font-size: 13px; font-weight: 500; color: rgba(252, 254, 251, 0.75);
    line-height: 1.45; max-width: 280px;
  }

  #lio-welcome-{{ uid }} .scratch-surface {
    position: absolute; inset: 0; cursor: grab; touch-action: none; z-index: 3;
    transition: opacity 0.6s var(--ease);
  }
  #lio-welcome-{{ uid }} .scratch-surface:active { cursor: grabbing; }
  #lio-welcome-{{ uid }} .scratch-surface.is-hidden { pointer-events: none; opacity: 0; }

  #lio-welcome-{{ uid }} .scratch-hint {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    pointer-events: none; color: var(--cream); z-index: 4;
    transition: opacity 0.4s var(--ease);
  }
  #lio-welcome-{{ uid }} .scratch-hint.is-fading { opacity: 0; }
  #lio-welcome-{{ uid }} .scratch-hint-icon { width: 38px; height: 38px; margin-bottom: 12px; opacity: 0.85; }
  #lio-welcome-{{ uid }} .scratch-hint-text {
    font-size: 14px; font-weight: 700; letter-spacing: -0.005em;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }
  #lio-welcome-{{ uid }} .scratch-hint-sub {
    font-size: 11px; font-weight: 500; color: rgba(255, 255, 255, 0.7);
    margin-top: 4px; letter-spacing: 0.04em; text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  #lio-welcome-{{ uid }} .scratch-progress {
    text-align: center; font-size: 11px; font-weight: 600;
    color: var(--f-40); letter-spacing: 0.06em; margin-bottom: 8px;
    min-height: 16px; text-transform: uppercase; transition: color 0.4s var(--ease);
  }
  #lio-welcome-{{ uid }} .scratch-progress.is-revealed { color: var(--mint-deep); }

  #lio-welcome-{{ uid }} .claim-prize-banner {
    display: flex; align-items: center; gap: 14px;
    background: var(--cream-2); border: 1px solid var(--f-08); border-radius: 14px;
    padding: 14px 16px; margin-bottom: 22px; text-align: left;
  }
  #lio-welcome-{{ uid }} .claim-prize-icon {
    width: 40px; height: 40px; flex-shrink: 0;
    background: var(--white); border: 1px solid var(--f-08); border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
  }
  #lio-welcome-{{ uid }} .claim-prize-icon svg { width: 18px; height: 18px; color: var(--mint-deep); }
  #lio-welcome-{{ uid }} .claim-prize-text { flex: 1; font-size: 13px; line-height: 1.4; color: var(--forest); }
  #lio-welcome-{{ uid }} .claim-prize-text strong { font-weight: 800; font-size: 14px; display: block; margin-bottom: 1px; }
  #lio-welcome-{{ uid }} .claim-prize-meta { font-size: 11px; color: var(--f-55); letter-spacing: 0.02em; }

  #lio-welcome-{{ uid }} .form-field { margin-bottom: 12px; position: relative; }
  #lio-welcome-{{ uid }} .form-field input {
    width: 100%; padding: 18px 18px 18px 48px;
    background: var(--cream-2); border: 1.5px solid transparent; border-radius: 14px;
    font-size: 16px; font-weight: 500; color: var(--forest);
    transition: all 0.2s var(--ease); min-height: 58px;
  }
  #lio-welcome-{{ uid }} .form-field input::placeholder { color: var(--f-40); font-weight: 500; }
  #lio-welcome-{{ uid }} .form-field input:focus {
    outline: none; border-color: var(--mint-deep); background: var(--white);
    box-shadow: 0 0 0 4px rgba(148, 252, 169, 0.14);
  }
  #lio-welcome-{{ uid }} .form-field input.is-invalid {
    border-color: #c44545; background: rgba(196, 69, 69, 0.04);
    animation: lio-shake-{{ uid }} 0.4s var(--ease);
  }
  #lio-welcome-{{ uid }} .form-field-icon {
    position: absolute; left: 18px; top: 50%; transform: translateY(-50%);
    color: var(--f-40); pointer-events: none;
  }
  #lio-welcome-{{ uid }} .form-field-icon svg { width: 20px; height: 20px; }
  #lio-welcome-{{ uid }} .form-field input:focus ~ .form-field-icon { color: var(--forest); }

  #lio-welcome-{{ uid }} .form-field-phone { display: flex; gap: 8px; }
  #lio-welcome-{{ uid }} .country-select {
    width: 92px; padding: 0 12px;
    background: var(--cream-2); border: 1.5px solid transparent; border-radius: 14px;
    font-size: 14px; font-weight: 700; color: var(--forest); cursor: pointer;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6' fill='none'><path d='M1 1l4 4 4-4' stroke='%230b2410' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat; background-position: right 12px center;
    padding-right: 28px; min-height: 58px;
  }
  #lio-welcome-{{ uid }} .country-select:focus {
    outline: none; border-color: var(--mint-deep);
    box-shadow: 0 0 0 4px rgba(148, 252, 169, 0.14);
  }
  #lio-welcome-{{ uid }} .form-field-phone .form-field { flex: 1; margin-bottom: 0; }
  #lio-welcome-{{ uid }} .form-field-phone input { padding-left: 18px; }

  #lio-welcome-{{ uid }} .form-consent {
    display: flex; align-items: flex-start; gap: 10px;
    margin: 16px 0 22px; cursor: pointer; user-select: none;
  }
  #lio-welcome-{{ uid }} .form-consent input[type="checkbox"] {
    appearance: none; width: 20px; height: 20px; flex-shrink: 0;
    border: 1.5px solid var(--f-25); border-radius: 6px; background: var(--white);
    cursor: pointer; margin-top: 1px; position: relative; transition: all 0.2s var(--ease);
  }
  #lio-welcome-{{ uid }} .form-consent input[type="checkbox"]:checked {
    background: var(--forest); border-color: var(--forest);
  }
  #lio-welcome-{{ uid }} .form-consent input[type="checkbox"]:checked::after {
    content: ""; position: absolute; left: 5px; top: 1px;
    width: 6px; height: 11px; border: solid var(--mint);
    border-width: 0 2px 2px 0; transform: rotate(45deg);
  }
  #lio-welcome-{{ uid }} .form-consent-text { font-size: 12px; line-height: 1.5; color: var(--f-55); }
  #lio-welcome-{{ uid }} .form-consent-text a {
    color: var(--forest); text-decoration: underline; text-underline-offset: 2px;
  }

  #lio-welcome-{{ uid }} .cta-button {
    width: 100%; background: var(--forest); color: var(--cream);
    padding: 18px 24px; border-radius: 14px;
    font-size: 15px; font-weight: 700; letter-spacing: -0.005em;
    min-height: 58px; display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: all 0.2s var(--ease); position: relative; overflow: hidden;
  }
  #lio-welcome-{{ uid }} .cta-button:hover:not(:disabled) {
    background: var(--forest-2); transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(11, 36, 16, 0.15);
  }
  #lio-welcome-{{ uid }} .cta-button:disabled { opacity: 0.4; cursor: not-allowed; }
  #lio-welcome-{{ uid }} .cta-button .arrow { transition: transform 0.2s var(--ease); }
  #lio-welcome-{{ uid }} .cta-button:hover:not(:disabled) .arrow { transform: translateX(2px); }
  #lio-welcome-{{ uid }} .cta-button.is-loading .label,
  #lio-welcome-{{ uid }} .cta-button.is-loading .arrow { opacity: 0; }
  #lio-welcome-{{ uid }} .cta-button.is-loading::after {
    content: ""; position: absolute; width: 22px; height: 22px;
    border: 2px solid rgba(252, 254, 251, 0.25); border-top-color: var(--mint);
    border-radius: 50%; animation: lio-spin-{{ uid }} 0.7s linear infinite;
  }

  #lio-welcome-{{ uid }} .form-skip {
    text-align: center; margin-top: 14px;
    font-size: 13px; font-weight: 500; color: var(--f-55);
    background: none; width: 100%; padding: 8px;
    transition: color 0.2s var(--ease);
  }
  #lio-welcome-{{ uid }} .form-skip:hover { color: var(--forest); text-decoration: underline; text-underline-offset: 2px; }

  #lio-welcome-{{ uid }} .sms-bonus {
    background: var(--cream-2); border: 1px solid var(--f-08); color: var(--forest);
    padding: 14px 16px; border-radius: 14px; margin-bottom: 18px;
    display: flex; align-items: center; gap: 12px; text-align: left;
  }
  #lio-welcome-{{ uid }} .sms-bonus-icon {
    width: 36px; height: 36px;
    background: var(--white); border: 1px solid var(--f-08); color: var(--mint-deep);
    border-radius: 10px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  #lio-welcome-{{ uid }} .sms-bonus-icon svg { width: 16px; height: 16px; }
  #lio-welcome-{{ uid }} .sms-bonus-text { flex: 1; font-size: 13px; line-height: 1.4; color: var(--forest); }
  #lio-welcome-{{ uid }} .sms-bonus-text strong { font-weight: 800; }

  #lio-welcome-{{ uid }} .trust-row {
    display: flex; justify-content: center; gap: 18px;
    margin-top: 22px; padding-top: 20px; border-top: 1px solid var(--f-06);
  }
  #lio-welcome-{{ uid }} .trust-badge {
    display: flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 600; color: var(--f-55); letter-spacing: -0.005em;
  }
  #lio-welcome-{{ uid }} .trust-badge svg { width: 12px; height: 12px; color: var(--mint-deep); flex-shrink: 0; }

  #lio-welcome-{{ uid }} .success-state { display: none; text-align: center; padding: 12px 0; }
  #lio-welcome-{{ uid }} .success-state.is-active { display: block; animation: lio-fade-in-up-{{ uid }} 0.6s var(--ease); }
  #lio-welcome-{{ uid }} .success-icon {
    width: 72px; height: 72px; background: var(--mint-soft); border-radius: 50%;
    margin: 0 auto 22px; display: flex; align-items: center; justify-content: center;
  }
  #lio-welcome-{{ uid }} .success-icon svg {
    width: 32px; height: 32px; stroke: var(--forest); stroke-width: 2.5;
    stroke-linecap: round; stroke-linejoin: round; fill: none;
    stroke-dasharray: 50; animation: lio-check-draw-{{ uid }} 0.7s var(--ease) 0.3s forwards;
  }
  #lio-welcome-{{ uid }} .success-title { font-size: 26px; font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin-bottom: 10px; }
  #lio-welcome-{{ uid }} .success-sub { font-size: 15px; line-height: 1.55; color: var(--f-72); margin-bottom: 24px; max-width: 340px; margin-left: auto; margin-right: auto; }
  #lio-welcome-{{ uid }} .success-prize-box {
    background: var(--cream-2); border: 1px solid var(--f-08); border-radius: 14px;
    padding: 18px; margin-bottom: 22px; position: relative; text-align: left;
    display: flex; align-items: center; gap: 14px;
  }
  #lio-welcome-{{ uid }} .success-prize-info { flex: 1; }
  #lio-welcome-{{ uid }} .success-prize-name { font-size: 15px; font-weight: 800; letter-spacing: -0.015em; color: var(--forest); margin-bottom: 4px; }
  #lio-welcome-{{ uid }} .success-prize-code {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--f-55);
    background: var(--white); border: 1px solid var(--f-08); border-radius: 6px; padding: 4px 8px;
  }
  #lio-welcome-{{ uid }} .success-code-copy {
    font-size: 11px; font-weight: 700; color: var(--f-55);
    background: var(--white); padding: 8px 14px; border-radius: 8px; cursor: pointer;
    transition: all 0.2s var(--ease); border: 1px solid var(--f-10); flex-shrink: 0;
  }
  #lio-welcome-{{ uid }} .success-code-copy:hover { color: var(--forest); border-color: var(--forest); }
  #lio-welcome-{{ uid }} .success-code-copy.is-copied { background: var(--forest); color: var(--mint); border-color: var(--forest); }
  #lio-welcome-{{ uid }} .success-cta {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--forest); color: var(--cream); padding: 14px 28px;
    border-radius: 999px; font-size: 14px; font-weight: 700; text-decoration: none;
    transition: all 0.2s var(--ease);
  }
  #lio-welcome-{{ uid }} .success-cta:hover { background: var(--forest-2); transform: translateY(-1px); box-shadow: 0 6px 16px rgba(11, 36, 16, 0.16); }

  #lio-welcome-{{ uid }} .form-error {
    display: none;
    background: rgba(196, 69, 69, 0.06); color: #a83838;
    border-radius: 10px; padding: 10px 14px; font-size: 13px; font-weight: 500; margin-bottom: 12px;
  }
  #lio-welcome-{{ uid }} .form-error.is-shown { display: block; animation: lio-fade-in-{{ uid }} 0.3s var(--ease); }
</style>

<div id="lio-welcome-{{ uid }}">
  <div class="signup-card">

    <div class="step is-active" data-step="1" id="step-1-{{ uid }}">
      <div class="eyebrow-wrap">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          <span>An invitation</span>
          <span class="eyebrow-line"></span>
        </div>
      </div>
      <h2 class="step-title">
        Your welcome to <span class="circle">Lio<svg viewBox="0 0 200 28" preserveAspectRatio="none"><path d="M5 14 Q 100 4, 195 14 Q 100 24, 5 14"/></svg></span>
      </h2>
      <p class="step-sub">We've prepared a small welcome inside. Open the card to see what's yours.</p>
      <div class="scratch-stage" id="scratch-stage-{{ uid }}">
        <div class="scratch-prize" id="scratch-prize-{{ uid }}">
          <div class="scratch-prize-content">
            <div class="scratch-prize-label" id="prize-label-{{ uid }}">Inside your invitation</div>
            <div class="scratch-prize-headline" id="prize-headline-{{ uid }}">A Lio, on us</div>
            <div class="scratch-prize-sub" id="prize-sub-{{ uid }}">A complimentary Lio device with your first Flow box.</div>
          </div>
        </div>
        <canvas class="scratch-surface" id="scratch-canvas-{{ uid }}"></canvas>
        <div class="scratch-hint" id="scratch-hint-{{ uid }}">
          <svg class="scratch-hint-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="9" width="22" height="16" rx="1.5"/>
            <path d="M5 11 L16 19 L27 11"/>
          </svg>
          <div class="scratch-hint-text">Swipe to open</div>
          <div class="scratch-hint-sub">One gentle motion</div>
        </div>
      </div>
      <div class="scratch-progress" id="scratch-progress-{{ uid }}">Drag across to open</div>
    </div>

    <div class="step" data-step="2" id="step-2-{{ uid }}">
      <div class="eyebrow-wrap">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          <span>Save your welcome</span>
          <span class="eyebrow-line"></span>
        </div>
      </div>
      <h2 class="step-title">
        Where should we <span class="circle">send it?<svg viewBox="0 0 200 28" preserveAspectRatio="none"><path d="M5 14 Q 100 4, 195 14 Q 100 24, 5 14"/></svg></span>
      </h2>
      <p class="step-sub">Add your email and we'll save it for you. No spam — just the occasional thoughtful update.</p>

      <div class="claim-prize-banner">
        <div class="claim-prize-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 12v10H4V12"/>
            <path d="M2 7h20v5H2z"/>
            <path d="M12 22V7"/>
            <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7zM12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
          </svg>
        </div>
        <div class="claim-prize-text">
          <strong id="claim-headline-{{ uid }}">A Lio, on us</strong>
          <span class="claim-prize-meta">Saved to your email · valid 30 days</span>
        </div>
      </div>

      <div class="form-error" id="form-error-1-{{ uid }}"></div>
      <div class="form-field">
        <input type="email" id="email-input-{{ uid }}" name="email" placeholder="your@email.com" autocomplete="email" inputmode="email" required>
        <span class="form-field-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="5" width="18" height="14" rx="2"/>
            <path d="m3 7 9 6 9-6"/>
          </svg>
        </span>
      </div>

      <label class="form-consent">
        <input type="checkbox" id="consent-checkbox-{{ uid }}" required>
        <span class="form-consent-text">
          I'd like to receive my welcome, occasional product updates and habit tips. Unsubscribe anytime. <a href="{{ privacy_url }}" target="_blank" rel="noopener">Privacy</a>.
        </span>
      </label>

      <button class="cta-button" type="button" id="step-2-submit-{{ uid }}">
        <span class="label">Save my welcome</span>
        <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </button>

      <div class="trust-row">
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="11" width="16" height="10" rx="2"/>
            <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
          </svg>
          Privacy-first
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 12 2 2 4-4"/>
            <path d="M12 3a9 9 0 1 0 9 9"/>
          </svg>
          No spam
        </div>
        <div class="trust-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12h4l3-9 4 18 3-9h4"/>
          </svg>
          1-tap unsubscribe
        </div>
      </div>
    </div>

    <div class="step" data-step="3" id="step-3-{{ uid }}">
      <div class="eyebrow-wrap">
        <div class="eyebrow">
          <span class="eyebrow-line"></span>
          <span>One more thing — optional</span>
          <span class="eyebrow-line"></span>
        </div>
      </div>
      <h2 class="step-title">
        Want first dibs on <span class="circle">new flavors?<svg viewBox="0 0 200 28" preserveAspectRatio="none"><path d="M5 14 Q 100 4, 195 14 Q 100 24, 5 14"/></svg></span>
      </h2>
      <p class="step-sub">Add your number and we'll send a quiet text when something new drops. Plus, a free bonus core with your welcome.</p>

      <div class="sms-bonus">
        <div class="sms-bonus-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2L9 8l-7 .8 5.2 4.8L5.6 21 12 17.6 18.4 21l-1.6-7.4L22 8.8 15 8z"/>
          </svg>
        </div>
        <div class="sms-bonus-text">Adds a <strong>free bonus core</strong> to your welcome. Text-only.</div>
      </div>

      <div class="form-error" id="form-error-2-{{ uid }}"></div>
      <div class="form-field-phone">
        <select class="country-select" id="country-code-{{ uid }}" aria-label="Country code">
          <option value="+31" data-country="NL">🇳🇱 +31</option>
          <option value="+32" data-country="BE">🇧🇪 +32</option>
          <option value="+49" data-country="DE">🇩🇪 +49</option>
          <option value="+33" data-country="FR">🇫🇷 +33</option>
          <option value="+39" data-country="IT">🇮🇹 +39</option>
          <option value="+44" data-country="GB">🇬🇧 +44</option>
          <option value="+971" data-country="AE">🇦🇪 +971</option>
          <option value="+1" data-country="US">🇺🇸 +1</option>
        </select>
        <div class="form-field">
          <input type="tel" id="phone-input-{{ uid }}" name="phone" placeholder="6 12345678" autocomplete="tel-national" inputmode="tel">
        </div>
      </div>

      <label class="form-consent">
        <input type="checkbox" id="sms-consent-{{ uid }}">
        <span class="form-consent-text">I'd like to receive occasional text updates and my bonus core. Msg & data rates may apply.</span>
      </label>

      <button class="cta-button" type="button" id="step-3-submit-{{ uid }}">
        <span class="label">Add my number</span>
        <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </button>
      <button class="form-skip" type="button" id="skip-sms-{{ uid }}">Skip — just send my welcome</button>
    </div>

    <div class="success-state" id="success-state-{{ uid }}">
      <div class="success-icon">
        <svg viewBox="0 0 24 24"><path d="m4 12 5 5L20 6"/></svg>
      </div>
      <h2 class="success-title">You're all set.</h2>
      <p class="success-sub" id="success-sub-text-{{ uid }}">We've sent your welcome to your inbox. Check your email in the next minute or two.</p>

      <div class="success-prize-box">
        <div class="success-prize-info">
          <div class="success-prize-name" id="success-name-{{ uid }}">A Lio, on us</div>
          <div class="success-prize-code">CODE · <span id="success-code-{{ uid }}">FREELIO</span></div>
        </div>
        <button class="success-code-copy" id="copy-code-{{ uid }}">Copy</button>
      </div>

      <a href="{{ success_cta_url }}" class="success-cta">
        <span>{{ success_cta_label }}</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13">
          <path d="M3 8h10M9 4l4 4-4 4"/>
        </svg>
      </a>
    </div>

  </div>
</div>

<script>
(function() {
  'use strict';

  const KLAVIYO_PUBLIC_KEY  = {{ company_id | json }};
  const KLAVIYO_LIST_ID     = {{ list_id | json }};
  const KLAVIYO_SMS_LIST_ID = {{ sms_list_id | json }};
  const UID = {{ uid | json }};

  if (!KLAVIYO_LIST_ID) {
    console.warn('[Lio Welcome] List ID is not configured. Set it in the section settings.');
  }

  const PRIZES = [
    { id: 'free_lio',   label: 'Inside your invitation', headline: 'A Lio, on us',          sub: 'A complimentary Lio device with your first Flow box.',     claimHeadline: 'A Lio, on us',           successName: 'A Lio, on us',           code: 'FREELIO', weight: 4  },
    { id: 'free_pro',   label: 'Inside your invitation', headline: 'Free Pro upgrade',      sub: 'Upgrade to Lio Pro at no extra cost.',                     claimHeadline: 'Free Pro upgrade',       successName: 'Free Pro upgrade',       code: 'PROFREE', weight: 6  },
    { id: 'free_core',  label: 'Inside your invitation', headline: 'A free 7th core',       sub: 'A bonus core in your first Flow box — flavor of our pick.', claimHeadline: 'A free 7th core',        successName: 'A free 7th core',        code: 'CORE7',   weight: 25 },
    { id: 'thirty_off', label: 'Inside your invitation', headline: '30% off your first Flow', sub: 'Our most generous welcome offer.',                       claimHeadline: '30% off your first Flow', successName: '30% off your first Flow', code: 'FLOW30', weight: 25 },
    { id: 'twenty_off', label: 'Inside your invitation', headline: '20% off + free shipping', sub: 'Off your first Flow, with shipping included.',          claimHeadline: '20% off + free shipping', successName: '20% off + free shipping', code: 'FLOW20', weight: 40 }
  ];

  const state = { prize: null, email: '', phone: '', countryCode: '+31' };
  const root = document.getElementById('lio-welcome-' + UID);
  const $ = (sel) => root.querySelector(sel);

  function pickPrize() {
    const total = PRIZES.reduce((s, p) => s + p.weight, 0);
    let r = Math.random() * total;
    for (const p of PRIZES) { r -= p.weight; if (r <= 0) return { ...p }; }
    return PRIZES[PRIZES.length - 1];
  }

  function goToStep(n) {
    root.querySelectorAll('.step').forEach(s => s.classList.toggle('is-active', parseInt(s.dataset.step) === n));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showError(slotId, msg) {
    const el = root.querySelector('#' + slotId);
    el.textContent = msg; el.classList.add('is-shown');
    setTimeout(() => el.classList.remove('is-shown'), 4500);
  }

  function paintPrizeIntoDOM() {
    const p = state.prize;
    $('#prize-label-' + UID).textContent = p.label;
    $('#prize-headline-' + UID).textContent = p.headline;
    $('#prize-sub-' + UID).textContent = p.sub;
  }

  let scratchRevealed = false;
  let firstScratchTime = null;
  let timeBasedRevealId = null;

  function initScratchCard() {
    state.prize = pickPrize();
    paintPrizeIntoDOM();

    const canvas = $('#scratch-canvas-' + UID);
    const stage = $('#scratch-stage-' + UID);
    const hintEl = $('#scratch-hint-' + UID);
    const progressEl = $('#scratch-progress-' + UID);

    requestAnimationFrame(() => {
      const rect = stage.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      canvas.style.width = rect.width + 'px';
      canvas.style.height = rect.height + 'px';
      const ctx = canvas.getContext('2d');
      ctx.scale(dpr, dpr);

      const grad = ctx.createLinearGradient(0, 0, rect.width, rect.height);
      grad.addColorStop(0, '#cdfee1');
      grad.addColorStop(0.5, '#94fca9');
      grad.addColorStop(1, '#cdfee1');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, rect.width, rect.height);

      ctx.fillStyle = 'rgba(11, 36, 16, 0.04)';
      for (let i = 0; i < 25; i++) {
        const x = Math.random() * rect.width;
        const y = Math.random() * rect.height;
        const r = 2 + Math.random() * 5;
        ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
      }

      ctx.fillStyle = 'rgba(11, 36, 16, 0.18)';
      ctx.font = '700 18px sofia-pro, sans-serif';
      ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
      ctx.fillText('Lio', rect.width / 2, rect.height / 2 - 10);
      ctx.font = '600 10px sofia-pro, sans-serif';
      ctx.fillStyle = 'rgba(11, 36, 16, 0.32)';
      ctx.fillText('SEALED — SWIPE TO OPEN', rect.width / 2, rect.height / 2 + 12);

      let isDrawing = false;
      let lastPoint = null;
      let hintFaded = false;
      let lastCheck = 0;
      const SCRATCH_RADIUS = 55;
      const REVEAL_THRESHOLD = 25;
      const MAX_TIME_MS = 2000;

      function getPos(e) {
        const r = canvas.getBoundingClientRect();
        const isTouch = e.touches && e.touches.length;
        const cx = isTouch ? e.touches[0].clientX : e.clientX;
        const cy = isTouch ? e.touches[0].clientY : e.clientY;
        return { x: cx - r.left, y: cy - r.top };
      }

      function scratchAt(x, y) {
        ctx.globalCompositeOperation = 'destination-out';
        ctx.beginPath(); ctx.arc(x, y, SCRATCH_RADIUS, 0, Math.PI * 2); ctx.fill();
      }

      function scratchLine(from, to) {
        const dx = to.x - from.x, dy = to.y - from.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const steps = Math.max(1, Math.ceil(dist / 8));
        for (let i = 0; i <= steps; i++) {
          const t = i / steps;
          scratchAt(from.x + dx * t, from.y + dy * t);
        }
      }

      function checkProgress() {
        if (scratchRevealed) return;
        try {
          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          let cleared = 0, total = 0;
          for (let i = 3; i < imgData.data.length; i += 32) {
            total++;
            if (imgData.data[i] < 50) cleared++;
          }
          const pct = total > 0 ? Math.round((cleared / total) * 100) : 0;
          progressEl.textContent = `Opening · ${pct}%`;
          if (pct >= REVEAL_THRESHOLD) revealPrize();
        } catch (err) { console.warn('Pixel check failed', err); }
      }

      function handleMove(e) {
        if (!isDrawing || scratchRevealed) return;
        if (e.cancelable) e.preventDefault();
        const pos = getPos(e);
        if (lastPoint) scratchLine(lastPoint, pos); else scratchAt(pos.x, pos.y);
        lastPoint = pos;
        if (!hintFaded) { hintFaded = true; hintEl.classList.add('is-fading'); }
        if (firstScratchTime === null) {
          firstScratchTime = Date.now();
          timeBasedRevealId = setTimeout(() => { if (!scratchRevealed) revealPrize(); }, MAX_TIME_MS);
        }
        const now = Date.now();
        if (now - lastCheck > 80) { lastCheck = now; checkProgress(); }
      }

      function start(e) { isDrawing = true; lastPoint = null; handleMove(e); }
      function end() { isDrawing = false; lastPoint = null; }

      canvas.addEventListener('mousedown', start);
      canvas.addEventListener('mousemove', handleMove);
      canvas.addEventListener('mouseup', end);
      canvas.addEventListener('mouseleave', end);
      canvas.addEventListener('touchstart', start, { passive: false });
      canvas.addEventListener('touchmove', handleMove, { passive: false });
      canvas.addEventListener('touchend', end);
      canvas.addEventListener('touchcancel', end);
    });
  }

  function revealPrize() {
    if (scratchRevealed) return;
    scratchRevealed = true;
    if (timeBasedRevealId) { clearTimeout(timeBasedRevealId); timeBasedRevealId = null; }
    const canvas = $('#scratch-canvas-' + UID);
    const stage = $('#scratch-stage-' + UID);
    const progressEl = $('#scratch-progress-' + UID);
    canvas.classList.add('is-hidden');
    stage.classList.add('is-revealed');
    progressEl.classList.add('is-revealed');
    progressEl.textContent = 'Saved to your account';
    if (navigator.vibrate) navigator.vibrate(30);
    setTimeout(() => {
      goToStep(2);
      updateClaimBanner();
      if (window.matchMedia('(min-width: 768px)').matches) {
        setTimeout(() => $('#email-input-' + UID).focus(), 200);
      }
    }, 1800);
  }

  function updateClaimBanner() {
    $('#claim-headline-' + UID).textContent = state.prize.claimHeadline;
  }

  function detectCountry() {
    try {
      const lang = (navigator.language || 'en-NL').toLowerCase();
      const map = {
        'nl': '+31', 'nl-nl': '+31', 'nl-be': '+32',
        'be': '+32', 'fr-be': '+32',
        'de': '+49', 'de-de': '+49', 'de-at': '+49',
        'fr': '+33', 'fr-fr': '+33',
        'it': '+39', 'it-it': '+39',
        'en-gb': '+44',
        'ar': '+971', 'ar-ae': '+971',
        'en-us': '+1'
      };
      const code = map[lang] || map[lang.split('-')[0]];
      if (code) {
        const select = $('#country-code-' + UID);
        if (select.querySelector(`option[value="${code}"]`)) {
          select.value = code;
          state.countryCode = code;
        }
      }
    } catch (e) {}
  }
  detectCountry();
  $('#country-code-' + UID).addEventListener('change', (e) => state.countryCode = e.target.value);

  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email);
  }

  async function subscribeToKlaviyo({ email, phone, listId }) {
    if (!listId) throw new Error('Klaviyo list ID is not configured.');
    const profileAttrs = {
      email: email,
      properties: {
        signup_source: 'Lio Welcome',
        signup_page: window.location.pathname,
        signup_url: window.location.href,
        referrer: document.referrer || 'direct',
        prize_id: state.prize ? state.prize.id : null,
        prize_name: state.prize ? state.prize.successName : null,
        prize_code: state.prize ? state.prize.code : null,
        timestamp: new Date().toISOString()
      }
    };
    if (phone) profileAttrs.phone_number = phone;

    const body = {
      data: {
        type: 'subscription',
        attributes: {
          profile: { data: { type: 'profile', attributes: profileAttrs } },
          custom_source: 'Lio Welcome'
        },
        relationships: { list: { data: { type: 'list', id: listId } } }
      }
    };

    const response = await fetch(
      `https://a.klaviyo.com/client/subscriptions/?company_id=${KLAVIYO_PUBLIC_KEY}`,
      { method: 'POST', headers: { 'Content-Type': 'application/json', 'revision': '2024-10-15' }, body: JSON.stringify(body) }
    );
    if (!response.ok && response.status !== 202) {
      let detail = 'Subscription failed';
      try { const err = await response.json(); detail = err.errors?.[0]?.detail || detail; } catch (_) {}
      throw new Error(detail);
    }
    return true;
  }

  function trackLead(stage, value) {
    if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: stage, value: value || 0, currency: 'EUR' });
    if (typeof gtag === 'function') gtag('event', 'generate_lead', { method: stage, value: value || 0, currency: 'EUR' });
    if (typeof ttq !== 'undefined' && ttq.track) ttq.track('CompleteRegistration', { content_name: stage });
  }

  $('#step-2-submit-' + UID).addEventListener('click', handleEmailSubmit);
  $('#email-input-' + UID).addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); handleEmailSubmit(); } });
  $('#email-input-' + UID).addEventListener('input', (e) => e.target.classList.remove('is-invalid'));

  async function handleEmailSubmit() {
    const email = $('#email-input-' + UID).value.trim().toLowerCase();
    const consented = $('#consent-checkbox-' + UID).checked;
    if (!isValidEmail(email)) {
      $('#email-input-' + UID).classList.add('is-invalid');
      showError('form-error-1-' + UID, 'Please enter a valid email address.');
      $('#email-input-' + UID).focus();
      return;
    }
    if (!consented) { showError('form-error-1-' + UID, 'Please confirm consent to continue.'); return; }
    state.email = email;
    const btn = $('#step-2-submit-' + UID);
    btn.classList.add('is-loading'); btn.disabled = true;
    try {
      await subscribeToKlaviyo({ email, listId: KLAVIYO_LIST_ID });
      trackLead('email_signup', 5);
      btn.classList.remove('is-loading'); btn.disabled = false;
      goToStep(3);
      setTimeout(() => $('#phone-input-' + UID).focus(), 200);
    } catch (err) {
      btn.classList.remove('is-loading'); btn.disabled = false;
      showError('form-error-1-' + UID, err.message || 'Something went wrong. Please try again.');
    }
  }

  $('#step-3-submit-' + UID).addEventListener('click', handleSmsSubmit);
  $('#phone-input-' + UID).addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); handleSmsSubmit(); } });
  $('#phone-input-' + UID).addEventListener('input', (e) => e.target.classList.remove('is-invalid'));
  $('#skip-sms-' + UID).addEventListener('click', () => showSuccess(false));

  async function handleSmsSubmit() {
    const phoneRaw = $('#phone-input-' + UID).value.trim().replace(/\s+/g, '');
    const smsOpt = $('#sms-consent-' + UID).checked;
    if (!phoneRaw || phoneRaw.length < 6) {
      $('#phone-input-' + UID).classList.add('is-invalid');
      showError('form-error-2-' + UID, 'Please enter a valid phone number.');
      $('#phone-input-' + UID).focus();
      return;
    }
    if (!smsOpt) { showError('form-error-2-' + UID, 'Please confirm consent or skip below.'); return; }
    const fullPhone = state.countryCode + phoneRaw.replace(/^0/, '');
    state.phone = fullPhone;
    const btn = $('#step-3-submit-' + UID);
    btn.classList.add('is-loading'); btn.disabled = true;
    try {
      await subscribeToKlaviyo({ email: state.email, phone: fullPhone, listId: KLAVIYO_SMS_LIST_ID || KLAVIYO_LIST_ID });
      trackLead('sms_signup', 10);
      showSuccess(true);
    } catch (err) {
      console.error('SMS subscribe error:', err);
      showSuccess(false);
    }
  }

  function showSuccess(withSMS) {
    root.querySelectorAll('.step').forEach(s => s.classList.remove('is-active'));
    $('#success-state-' + UID).classList.add('is-active');
    const p = state.prize;
    $('#success-name-' + UID).textContent = p.successName;
    $('#success-code-' + UID).textContent = p.code;
    if (withSMS) {
      $('#success-sub-text-' + UID).textContent = "We've sent your welcome to your inbox and your bonus core to your phone. Check your email and texts in the next minute or two.";
    }
  }

  $('#copy-code-' + UID).addEventListener('click', () => {
    const code = $('#success-code-' + UID).textContent;
    navigator.clipboard.writeText(code).then(() => {
      const btn = $('#copy-code-' + UID);
      btn.textContent = '✓ Copied';
      btn.classList.add('is-copied');
      setTimeout(() => { btn.textContent = 'Copy'; btn.classList.remove('is-copied'); }, 2000);
    });
  });

  initScratchCard();
})();
</script>

{% schema %}
{
  "name": "Lio Welcome",
  "tag": "section",
  "class": "shopify-section--lio-welcome",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Multi-step welcome card with scratch-card prize reveal. Posts directly to Klaviyo's client-side Subscribe API."
    },
    {
      "type": "header",
      "content": "Klaviyo connection"
    },
    {
      "type": "text",
      "id": "company_id",
      "label": "Public Site ID",
      "default": "WmF2Pv",
      "info": "Klaviyo → Account → Settings → API Keys → Public API Key"
    },
    {
      "type": "text",
      "id": "list_id",
      "label": "Email list ID",
      "info": "Required. Klaviyo → Lists & Segments → click list → Settings → List ID"
    },
    {
      "type": "text",
      "id": "sms_list_id",
      "label": "SMS list ID",
      "info": "Optional. If empty, falls back to the email list."
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy policy URL"
    },
    {
