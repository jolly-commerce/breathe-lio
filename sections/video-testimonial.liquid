     "blocks": [
    {
      "type": "infinite-video",
      "name": "auto scroll video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        }
       
      ]
    }
  ],
    "presets" : [{
      "name" : "video testimonial"
    }]
  }
{% endschema %}