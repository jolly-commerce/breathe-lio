<!-- Chart CSS -->


<!-- Intersection Observer + animation triggers -->
<script>
  document.addEventListener('DOMContentLoaded', function () {
  const container = document.querySelector('.chart-container');
  const paths = container.querySelectorAll('.chart-path');
  const labels = container.querySelectorAll('.chart-label, .chart-source');

  let hasAnimated = false; // 🔒 Flag to prevent repeat animation

  const observer = new IntersectionObserver((entries, obs) => {
    entries.forEach(entry => {
      if (entry.isIntersecting && !hasAnimated) {
        hasAnimated = true; // ✅ Lock animation
  container.style.opacity = '1';

        // Start counter animation
const counter = document.getElementById("lio-counter");
const duration = 2000;
const endValue = 80;
let frame = 0;
const frameRate = 1000 / 60;
const totalFrames = Math.round(duration / frameRate);

const counterInterval = setInterval(() => {
  frame++;
  const progress = frame / totalFrames;
  const current = Math.round(endValue * easeOutQuad(progress));
  counter.innerText = current.toLocaleString("en-US");
  if (frame === totalFrames) clearInterval(counterInterval);
}, frameRate);

function easeOutQuad(t) {
  return t * (2 - t);
}


        
        paths.forEach(path => {
          const length = path.getTotalLength();
          path.style.strokeDasharray = length;
          path.style.strokeDashoffset = length;

          // Trigger reflow before applying offset 0
          path.getBoundingClientRect();
          path.style.transition = 'stroke-dashoffset 2s ease-out';
          path.style.strokeDashoffset = '0';
        });

        labels.forEach((el, i) => {
          el.style.transition = `opacity 0.3s ease-out ${1.5 + i * 0.2}s`;
          el.style.opacity = 1;
        });

        obs.unobserve(container); // 🔁 Stop observing
      }
    });
  }, { threshold: 0.4 }); // Try 0.4–0.5 for middle-of-element visibility

  observer.observe(container);
});

</script>

