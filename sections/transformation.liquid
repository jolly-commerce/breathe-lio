<style>
  .transformation-section{
    padding :50px 30px ;
  }
  .transformation-top {
    display: flex;
    gap: 15px;

  }
  .transformation-top h2.h2::after {
    content: "";
    position: absolute;
    right: -40px;
    top: 40px;
    width: 95px;
    height: 20px;
    background: url("https://cdn.shopify.com/s/files/1/0659/6676/8379/files/Squiggle_Mini_10d.svg?v=1747923212");
    background-size: contain;
    background-repeat: no-repeat;
}
   .transformation-top h2.h2 span {
    color: var(--lio-light-green);
    display: block;
    line-height: 0.9;
}
  .transformation-top p{
    margin-top : 5px;
  }
 .separator-trans {
    height: 1px;
    width: 40px;
    background: #00512850;
    margin-top: 15px;
}
  .transformation-bottom{
    padding-top : 20px;
    display : flex;
    
  }
 .trans-bottom-left {
    width: 35%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 20px;
    padding-right: 30px;
    flex-direction: column;
}
  .trans-bottom-left p:last-of-type {
  margin-top: 0;
}

 .trans-bottom-left h1 {
  font-family: Sigum;
  font-size: 250px;
  font-weight: 700; /* No px here */
  line-height: 1;
  letter-spacing: -4px;
  background: var(--Grad, linear-gradient(270deg, #EDED5E 0.01%, #005128 57.58%, #005128 115.15%));
  background-clip: text;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-align: center;
  width: 100%;
  max-width: 350px;


}
  .trans-bottom-left p {
    font-size: 35px;
    font-weight: 500;
    max-width: 300px;
    text-align: center;
    line-height: 1.1;
    letter-spacing: -0.7px;
}
  .trans-bottom-right {
    width: 65%;
    padding-right: 15px;
}

.chart-container {
  width: 100%;
  opacity: 0;
transition: opacity 1.5s ease 0.3s;

}
.chart-vertical-line {
  stroke: #00512850;
  stroke-width: 1;
  stroke-dasharray: 4,4;
}
.chart-path {
  fill: none;
  stroke: #005128;
  stroke-width: 1;
  stroke-dasharray: 1000;
  stroke-dashoffset: 1000;
  transition: stroke-dashoffset 2s ease-out;
}

.chart-point {
  fill: #005128;
}

.chart-label, .chart-source {
    fill: #005128;
    font-size: 10px;
    opacity: 0;
}

.chart-texts {
    width: 110%;
    display: flex;
    margin-left: -5%;
    justify-content: space-between;
  position : relative;
}
  .chart-texts span{
    font-weight : 400;
    font-family : "Sigum";
  }
  .chart-texts span:nth-child(2){
    transform : translateX(30px);
  }
  .chart-servey-text{
    text-align : center;
    font-weight : 600;
    line-height : 1.25;
       margin-top : 15px;
  }
 @media (max-width: 990px){
    .chart-servey-text{
    line-height : 1.25;
    margin : auto;
        margin-top : 15px;
   max-width : 320px;
      text-wrap : balance;
  }
   .transformation-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap; /* Optional for mobile responsiveness */
  gap: 30px;

}
   .trans-bottom-left {
    width: 100%;
      padding-right: 0px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-direction: column;
}
   .trans-bottom-right {
    width: 100%;
      padding-right: 0px;
}
   .trans-bottom-left h1 {
    font-size: 150px;
    height: 170px;
    width: 100%;
}
   .trans-bottom-left p {
    font-size: 17px;
    letter-spacing: -0.5px;
}
   .transformation-top {
    display: flex;
    gap: 15px;
    flex-direction: column;
    align-items: center;
}
  .transformation-top h2.h2 {
    max-width: 320px;
    font-size: 35px;
    line-height: 0.9;
    position: relative;
    text-align: center;
}
   .transformation-top h2.h2::after {
    right: 10px;
    top: 60px;
    width: 85px;
    height: 20px;
}
   .separator-trans {
    display: none;
}
   .transformation-top h2.h2 span {
    display: inline;
       line-height: 1;
}
 .transformation-section.width-wrapper {
    padding: 40px 30px;
}
  .chart-label, .chart-source {
    font-size: 20px;
} 
.chart-texts span {
    font-weight: 400;
    font-size: 13px;
    max-width: 80px;
    line-height: 1;
    text-align: center;
    font-family: "Sigum";
    margin-top: -10px;
    transform: translateX(-10px);
}
  .chart-texts span:nth-child(2) {
    transform: translateX(0px);
}

 }
</style>
