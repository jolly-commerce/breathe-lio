{%- comment -%}
  Lio Lander Header — minimal, in-page-nav header for the cold-traffic lander.
  Includes: announcement bar, logo, in-page section nav, cart icon, primary CTA.
  Renders only on the page.theliokit template (added directly in that template).
{%- endcomment -%}

<style>
  /* smooth in-page scrolling + sticky-header offset for any anchor target on this lander */
  html { scroll-behavior: smooth; }
  body [id^="shopify-section-"] { scroll-margin-top: 92px; }
  @media (max-width: 900px) { body [id^="shopify-section-"] { scroll-margin-top: 76px; } }

  /* ─────────────────────────────────────────────────────────────
     LANDER-WIDE polish: applied via body.lio-lander-page so other
     templates are unaffected.
     ───────────────────────────────────────────────────────────── */

  /* Section-to-section spacing — reduce by ~20% globally */
  .lio-lander-page section[class*="section-lio-"] { padding-top: 0; padding-bottom: 0; }
  .lio-lander-page .how,
  .lio-lander-page .killblock,
  .lio-lander-page .flavors,
  .lio-lander-page .science,
  .lio-lander-page .costcomp,
  .lio-lander-page .faq,
  .lio-lander-page .flavored-air,
  .lio-lander-page .social-proof,
  .lio-lander-page .videowall,
  .lio-lander-page .moments,
  .lio-lander-page .ugc {
    padding-top: 56px !important;
    padding-bottom: 56px !important;
  }
  @media (max-width: 768px) {
    .lio-lander-page .how,
    .lio-lander-page .killblock,
    .lio-lander-page .flavors,
    .lio-lander-page .science,
    .lio-lander-page .costcomp,
    .lio-lander-page .faq,
    .lio-lander-page .flavored-air,
    .lio-lander-page .social-proof,
    .lio-lander-page .videowall {
      padding-top: 36px !important;
      padding-bottom: 36px !important;
    }
  }

  /* The two specific gaps the user flagged: shrink them harder */
  .lio-lander-page .section-lio-social-proof + .section-lio-videowall .videowall,
  .lio-lander-page .section-lio-videowall + .section-lio-how .how,
  .lio-lander-page .section-lio-killblock + .section-lio-videowall .videowall,
  .lio-lander-page .section-lio-videowall + .section-lio-flavors .flavors,
  .lio-lander-page .section-lio-flavors + .section-lio-evidence .levp,
  .lio-lander-page .flavors,
  .lio-lander-page .levp {
    padding-top: 28px !important;
  }
  @media (max-width: 768px) {
    .lio-lander-page .section-lio-social-proof + .section-lio-videowall .videowall,
    .lio-lander-page .section-lio-videowall + .section-lio-how .how,
    .lio-lander-page .section-lio-killblock + .section-lio-videowall .videowall,
    .lio-lander-page .section-lio-videowall + .section-lio-flavors .flavors,
    .lio-lander-page .section-lio-flavors + .section-lio-evidence .levp,
    .lio-lander-page .flavors,
    .lio-lander-page .levp {
      padding-top: 18px !important;
    }
  }

  /* Configurator (Build your perfect kit) — mobile L/R padding */
  @media (max-width: 768px) {
    .lio-lander-page .lio-pdp,
    .lio-lander-page .lio-pdp-section { padding-left: 20px !important; padding-right: 20px !important; box-sizing: border-box; }
    .lio-lander-page .lio-announcement,
    .lio-lander-page .lio-breadcrumbs { padding-left: 20px; padding-right: 20px; }
  }

  /* Sticky CTA — equal padding all sides */
  .lio-lander-page .sticky-cta {
    padding: 12px 14px !important;
    box-sizing: border-box !important;
    gap: 12px;
    align-items: center;
  }
  .lio-lander-page .sticky-cta .btn-primary {
    padding: 10px 18px !important;
    box-sizing: border-box;
  }

  /* ─────────────────────────────────────────────────────────────
     UNIFORM HORIZONTAL PADDING across every section on the lander.
     One rule, one value. Desktop: 24px. Mobile: 20px.
     Targets every known Lio section wrapper class.
     ───────────────────────────────────────────────────────────── */
  .lio-lander-page .lio-lh-bar,
  .lio-lander-page .lio-lh-announce,
  .lio-lander-page .hero,
  .lio-lander-page .lhx-hero,
  .lio-lander-page .social-proof,
  .lio-lander-page .lsp-section,
  .lio-lander-page .flavored-air,
  .lio-lander-page .lfl-section,
  .lio-lander-page .videowall,
  .lio-lander-page .vw-section,
  .lio-lander-page .how,
  .lio-lander-page .killblock,
  .lio-lander-page .kb-section,
  .lio-lander-page .flavors,
  .lio-lander-page .lfv-section,
  .lio-lander-page .moments,
  .lio-lander-page .science,
  .lio-lander-page .ugc,
  .lio-lander-page .costcomp,
  .lio-lander-page .offer,
  .lio-lander-page .faq,
  .lio-lander-page .finalcta,
  .lio-lander-page .levp,
  .lio-lander-page .lio-ev,
  .lio-lander-page .lio-lf,
  .lio-lander-page .lio-pdp-section,
  .lio-lander-page .lio-pdp {
    padding-left: 24px !important;
    padding-right: 24px !important;
    box-sizing: border-box !important;
  }
  @media (max-width: 768px) {
    .lio-lander-page .lio-lh-bar,
    .lio-lander-page .lio-lh-announce,
    .lio-lander-page .hero,
    .lio-lander-page .lhx-hero,
    .lio-lander-page .social-proof,
    .lio-lander-page .lsp-section,
    .lio-lander-page .flavored-air,
    .lio-lander-page .lfl-section,
    .lio-lander-page .videowall,
    .lio-lander-page .vw-section,
    .lio-lander-page .how,
    .lio-lander-page .killblock,
    .lio-lander-page .kb-section,
    .lio-lander-page .flavors,
    .lio-lander-page .lfv-section,
    .lio-lander-page .moments,
    .lio-lander-page .science,
    .lio-lander-page .ugc,
    .lio-lander-page .costcomp,
    .lio-lander-page .offer,
    .lio-lander-page .faq,
    .lio-lander-page .finalcta,
    .lio-lander-page .levp,
    .lio-lander-page .lio-ev,
    .lio-lander-page .lio-lf,
    .lio-lander-page .lio-pdp-section,
    .lio-lander-page .lio-pdp {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
  }
  /* And inner content containers — ensure they don't double-pad */
  .lio-lander-page [class$="-inner"],
  .lio-lander-page .lvm-band,
  .lio-lander-page .levp-modal-card {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  /* Exception: some inner containers carry the only padding (no outer wrapper).
     Restore for these specific cases. */
  .lio-lander-page .lvm-band { padding-left: 28px !important; padding-right: 28px !important; }
  @media (max-width: 600px) {
    .lio-lander-page .lvm-band { padding-left: 20px !important; padding-right: 20px !important; }
  }

  .lio-lh-announce {
    background: {{ section.settings.announce_bg | default: '#1f3a2c' }};
    color: {{ section.settings.announce_color | default: '#f5f1eb' }};
    text-align: center;
    padding: 8px 16px;
    font-size: 12px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    font-family: inherit;
  }
  .lio-lh-announce a { color: inherit; text-decoration: underline; }
  .lio-lh-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #ffffff;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: inherit;
  }
  .lio-lh-logo {
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    color: #1f3a2c;
    text-decoration: none;
  }
  .lio-lh-nav {
    display: flex;
    gap: 22px;
    flex: 1;
    justify-content: center;
  }
  .lio-lh-nav a {
    color: #2a2a2a;
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    transition: opacity 0.15s ease;
  }
  .lio-lh-nav a:hover { opacity: 0.6; }
  .lio-lh-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lio-lh-cart {
    color: #1f3a2c;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.08);
    transition: background 0.15s ease;
  }
  .lio-lh-cart:hover { background: rgba(0,0,0,0.04); }
  .lio-lh-cart-count {
    position: absolute;
    background: #1f3a2c;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    border-radius: 10px;
    padding: 1px 6px;
    margin-top: -22px;
    margin-left: 22px;
  }
  .lio-lh-cta {
    background: #1f3a2c;
    color: #fff;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .lio-lh-cta:hover { background: #2a4d3c; }

  /* country/currency switcher */
  .lh-locale { position: relative; }
  .lh-locale > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px 6px 8px;
    border: 1px solid rgba(0,0,0,0.10);
    border-radius: 999px;
    background: #fff;
    font-size: 12px;
    font-weight: 600;
    color: #1f3a2c;
    line-height: 1;
    user-select: none;
  }
  .lh-locale > summary::-webkit-details-marker { display: none; }
  .lh-locale > summary:hover { background: rgba(0,0,0,0.03); }
  .lh-locale-flag {
    font-size: 16px;
    line-height: 1;
  }
  .lh-locale-code { letter-spacing: 0.04em; }
  .lh-locale-caret { width: 10px; height: 10px; opacity: 0.6; }
  .lh-locale-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
    list-style: none;
    margin: 0;
    padding: 6px;
    min-width: 240px;
    max-height: 360px;
    overflow-y: auto;
    overscroll-behavior: contain;
    z-index: 60;
  }
  .lh-locale-menu::-webkit-scrollbar { width: 8px; }
  .lh-locale-menu::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.18); border-radius: 8px; }
  .lh-locale-menu form { margin: 0; }
  .lh-locale-menu button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 10px;
    background: transparent;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    font-size: 13px;
    color: #2a2a2a;
    text-align: left;
    font-family: inherit;
  }
  .lh-locale-menu button:hover { background: rgba(31,58,44,0.06); }
  .lh-locale-menu button[aria-current="true"] { background: rgba(31,58,44,0.10); font-weight: 700; color: #1f3a2c; }
  .lh-locale-menu .lh-locale-flag { font-size: 18px; }
  .lh-locale-menu .lh-locale-name { flex: 1; }
  .lh-locale-menu .lh-locale-curr { opacity: 0.6; font-size: 11px; letter-spacing: 0.04em; }

  @media (max-width: 900px) {
    .lio-lh-nav { display: none; }
    .lio-lh-bar { padding: 10px 16px; }
    .lio-lh-cta { padding: 8px 14px; font-size: 12px; }
    .lio-lh-logo { font-size: 18px; }
    .lh-locale > summary { padding: 5px 8px 5px 6px; font-size: 11px; }
    .lh-locale-menu { min-width: 200px; right: auto; left: 0; }
  }
</style>

{%- if section.settings.announce_text != blank -%}
  <div class="lio-lh-announce">
    {{ section.settings.announce_text }}
  </div>
{%- endif -%}

<header class="lio-lh-bar">
  <a href="{{ section.settings.logo_link | default: '#' }}" class="lio-lh-logo">
    {{ section.settings.logo_text | default: 'Lio' }}
  </a>

  <nav class="lio-lh-nav" aria-label="Page sections">
    {%- for block in section.blocks -%}
      {%- if block.type == 'nav_link' -%}
        <a href="{{ block.settings.anchor }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="lio-lh-actions">
    {%- if section.settings.show_locale and localization.available_countries.size > 1 -%}
      {%- liquid
        assign cur = localization.country
        assign cur_flag = cur.iso_code | replace: 'A','🇦' | replace: 'B','🇧' | replace: 'C','🇨' | replace: 'D','🇩' | replace: 'E','🇪' | replace: 'F','🇫' | replace: 'G','🇬' | replace: 'H','🇭' | replace: 'I','🇮' | replace: 'J','🇯' | replace: 'K','🇰' | replace: 'L','🇱' | replace: 'M','🇲' | replace: 'N','🇳' | replace: 'O','🇴' | replace: 'P','🇵' | replace: 'Q','🇶' | replace: 'R','🇷' | replace: 'S','🇸' | replace: 'T','🇹' | replace: 'U','🇺' | replace: 'V','🇻' | replace: 'W','🇼' | replace: 'X','🇽' | replace: 'Y','🇾' | replace: 'Z','🇿'
      -%}
      <details class="lh-locale">
        <summary aria-label="Change country and currency">
          <span class="lh-locale-flag">{{ cur_flag }}</span>
          <span class="lh-locale-code">{{ cur.currency.iso_code }}</span>
          <svg class="lh-locale-caret" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 4.5 6 8l3-3.5"/></svg>
        </summary>
        <ul class="lh-locale-menu">
          {%- form 'localization', id: 'lh-locale-form' -%}
            {%- if section.settings.locale_filter == blank -%}
              {%- comment -%} No filter — render all available_countries in Shopify's order {%- endcomment -%}
              {%- for country in localization.available_countries -%}
                {%- assign code = country.iso_code -%}
                {%- assign flag = code | replace: 'A','🇦' | replace: 'B','🇧' | replace: 'C','🇨' | replace: 'D','🇩' | replace: 'E','🇪' | replace: 'F','🇫' | replace: 'G','🇬' | replace: 'H','🇭' | replace: 'I','🇮' | replace: 'J','🇯' | replace: 'K','🇰' | replace: 'L','🇱' | replace: 'M','🇲' | replace: 'N','🇳' | replace: 'O','🇴' | replace: 'P','🇵' | replace: 'Q','🇶' | replace: 'R','🇷' | replace: 'S','🇸' | replace: 'T','🇹' | replace: 'U','🇺' | replace: 'V','🇻' | replace: 'W','🇼' | replace: 'X','🇽' | replace: 'Y','🇾' | replace: 'Z','🇿' -%}
                <li>
                  <button type="submit" name="country_code" value="{{ code }}"
                          {% if code == cur.iso_code %}aria-current="true"{% endif %}>
                    <span class="lh-locale-flag">{{ flag }}</span>
                    <span class="lh-locale-name">{{ country.name }}</span>
                    <span class="lh-locale-curr">{{ country.currency.iso_code }}</span>
                  </button>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- comment -%} Filter present — iterate the filter LIST in user-defined order, match each to available_countries {%- endcomment -%}
              {%- assign filter_clean = section.settings.locale_filter | replace: ' ', '' | upcase -%}
              {%- assign filter_list = filter_clean | split: ',' -%}
              {%- for code in filter_list -%}
                {%- assign matched_name = '' -%}
                {%- assign matched_curr = '' -%}
                {%- for c in localization.available_countries -%}
                  {%- if c.iso_code == code -%}
                    {%- assign matched_name = c.name -%}
                    {%- assign matched_curr = c.currency.iso_code -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if matched_name != '' -%}
                  {%- assign flag = code | replace: 'A','🇦' | replace: 'B','🇧' | replace: 'C','🇨' | replace: 'D','🇩' | replace: 'E','🇪' | replace: 'F','🇫' | replace: 'G','🇬' | replace: 'H','🇭' | replace: 'I','🇮' | replace: 'J','🇯' | replace: 'K','🇰' | replace: 'L','🇱' | replace: 'M','🇲' | replace: 'N','🇳' | replace: 'O','🇴' | replace: 'P','🇵' | replace: 'Q','🇶' | replace: 'R','🇷' | replace: 'S','🇸' | replace: 'T','🇹' | replace: 'U','🇺' | replace: 'V','🇻' | replace: 'W','🇼' | replace: 'X','🇽' | replace: 'Y','🇾' | replace: 'Z','🇿' -%}
                  <li>
                    <button type="submit" name="country_code" value="{{ code }}"
                            {% if code == cur.iso_code %}aria-current="true"{% endif %}>
                      <span class="lh-locale-flag">{{ flag }}</span>
                      <span class="lh-locale-name">{{ matched_name }}</span>
                      <span class="lh-locale-curr">{{ matched_curr }}</span>
                    </button>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            <input type="hidden" name="return_to" value="{{ request.path }}">
          {%- endform -%}
        </ul>
      </details>
    {%- endif -%}

    {%- if section.settings.show_cart -%}
      <a href="{{ routes.cart_url }}" class="lio-lh-cart" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="lio-lh-cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
    <a href="{{ section.settings.cta_link | default: '#shopify-section-main' }}" class="lio-lh-cta">
      {{ section.settings.cta_label | default: 'Build my kit' }}
    </a>
  </div>
</header>

<script>
  /* close locale dropdown when clicking outside */
  (function () {
    var d = document.querySelector('.lh-locale');
    if (!d) return;
    document.addEventListener('click', function (e) {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  })();
</script>

<script>
  /* ============================================================
     Lio lander — explicit CTA scroll handler.
     Catches ALL hash-anchor clicks and scrolls with header offset.
     Also normalizes #shopify-section-main / #offer / #main / #lio-pdp-*
     to whatever wrapper the configurator actually rendered into.
     This works even if the section's href setting got transformed
     by Shopify's url-type validation, or if the section ID format
     differs in a future Shopify build.
     ============================================================ */
  (function () {
    function findConfigurator () {
      // ordered: most specific first
      return document.querySelector('#shopify-section-main')
          || document.querySelector('[id^="shopify-section-"][id$="__main"]')
          || document.querySelector('.lio-pdp-builder-wrap')
          || document.querySelector('.lio-pdp-section')
          || document.querySelector('[data-section-type="lio-pdp-builder"]');
    }

    function getOffset () {
      return window.matchMedia('(max-width: 900px)').matches ? 76 : 92;
    }

    function smoothTo (el) {
      if (!el) return false;
      var top = el.getBoundingClientRect().top + window.pageYOffset - getOffset();
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      return true;
    }

    var configAliases = ['#shopify-section-main', '#offer', '#main', '#cost', '#lio-pdp-main'];

    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href]');
      if (!link) return;

      var href = link.getAttribute('href') || '';
      // only handle in-page anchors
      if (href.charAt(0) !== '#') return;
      if (href === '#' || href.length < 2) return;

      var target;
      // Configurator aliases — always resolve to the configurator wrapper
      if (configAliases.indexOf(href) !== -1) {
        target = findConfigurator();
      } else {
        try { target = document.querySelector(href); } catch (_) { target = null; }
      }

      if (!target) return; // let browser handle / no-op

      e.preventDefault();
      smoothTo(target);
      // update URL hash without re-jumping
      if (history.replaceState) history.replaceState(null, '', href);
    }, false);

    /* Heuristic safety net: rewrite obviously-broken CTA hrefs on page load.
       If a CTA button contains words like "Build", "Pick", "Start", "Kit"
       and its href is empty / "#" / external journey-pack URL, point it
       at the configurator on this page instead. */
    function normalizeCtas () {
      var config = findConfigurator();
      if (!config) return;
      var aliasHref = '#' + config.id;
      var verbs = /(build|pick|start|kit|order|get the|shop the journey|claim)/i;

      var candidates = document.querySelectorAll(
        'a.lhx-btn-primary, a.lfl-btn, a.kb-btn, a.lfv-btn, a.btn-primary, a.lio-lh-cta, .sticky-cta a'
      );
      candidates.forEach(function (a) {
        var label = (a.textContent || '').trim();
        var href = a.getAttribute('href') || '';
        var external = /^https?:/i.test(href);
        var brokenHash = (href === '' || href === '#');
        // Only touch if it looks like a config CTA AND href is broken/external journey-pack
        var isJourneyExt = external && /journey-pack/i.test(href);
        if ((brokenHash || isJourneyExt) && verbs.test(label)) {
          a.setAttribute('href', aliasHref);
          a.dataset.lioRewritten = '1';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', normalizeCtas);
    } else {
      normalizeCtas();
    }
  })();
</script>

{% schema %}
{
  "name": "Lio · Lander header",
  "tag": "section",
  "class": "section-lio-lander-header",
  "settings": [
    { "type": "header",   "content": "Announcement bar" },
    { "type": "richtext", "id": "announce_text", "label": "Announcement text", "default": "<p>We invented Flavored Air. <strong>Patented &amp; made in Amsterdam since 2018.</strong></p>" },
