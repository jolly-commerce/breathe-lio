{%- comment -%}
  Lio Lander Header — minimal, in-page-nav header for the cold-traffic lander.
  Includes: announcement bar, logo, in-page section nav, cart icon, primary CTA.
  Renders only on the page.theliokit template (added directly in that template).
{%- endcomment -%}

{%- if template.suffix == 'theliokit' -%}
<script>(function(){document.documentElement.classList.add('lio-lander-page');document.body && document.body.classList.add('lio-lander-page');document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('lio-lander-page');});})();</script>
<style>
  /* ============================================================
     theliokit — header simplification + LOGO IMAGE
     ============================================================ */
  .lio-lh-nav { display: none !important; }
  .lio-lh-actions { margin-left: auto; }

  .lio-lh-logo--img { padding: 4px 0; line-height: 0; display: inline-flex; align-items: center; }
  .lio-lh-logo-img { display: block; height: 32px; width: auto; max-width: 140px; object-fit: contain; }
  @media (max-width: 900px) { .lio-lh-logo-img { height: 26px; max-width: 112px; } }
  @media (max-width: 480px) { .lio-lh-logo-img { height: 24px; max-width: 96px; } }

  /* ============================================================
     theliokit — GLOBAL MOBILE PASS
     Applies to all sections under .lio-lander-page on screens ≤ 900px.
     Goals: ≥48px touch targets, fluid type scale, consistent rhythm,
     no horizontal overflow, breathable spacing, predictable hierarchy.
     ============================================================ */

  body.lio-lander-page,
  body.lio-lander-page main { overflow-x: hidden; }

  /* Ensure all images are fluid — never break layout on small screens */
  .lio-lander-page img:not(.lio-lh-logo-img) { max-width: 100%; height: auto; }

  /* iOS no-zoom-on-focus: minimum 16px on inputs */
  .lio-lander-page input, .lio-lander-page textarea, .lio-lander-page select { font-size: 16px; }

  /* Generic CTA touch target — anything resembling a primary button */
  @media (max-width: 900px) {
    .lio-lander-page .lhx-btn-primary,
    .lio-lander-page .kb-btn,
    .lio-lander-page .lfl-btn,
    .lio-lander-page .lfv-btn,
    .lio-lander-page .lio-purchase-cta,
    .lio-lander-page .lio-offer-card-cta,
    .lio-lander-page .lio-ot-card-cta,
    .lio-lander-page .lfc-tk-cta,
    .lio-lander-page .btn-primary {
      min-height: 52px !important;
      padding-top: 14px !important;
      padding-bottom: 14px !important;
      font-size: 15px !important;
      letter-spacing: -0.005em !important;
    }
    /* Ghost / secondary CTAs */
    .lio-lander-page .kb-btn-ghost,
    .lio-lander-page .lhx-btn-ghost,
    .lio-lander-page .btn-ghost {
      min-height: 48px !important;
      padding-top: 12px !important;
      padding-bottom: 12px !important;
    }
    /* Any small interactive pill or chip */
    .lio-lander-page .lbs-link,
    .lio-lander-page .lio-offer-customize a,
    .lio-lander-page .lio-ot-customize a {
      min-height: 44px !important;
      display: inline-flex !important;
      align-items: center;
    }
    /* Tap highlight */
    .lio-lander-page button,
    .lio-lander-page a {
      -webkit-tap-highlight-color: rgba(11,36,16,0.08);
    }
    /* :active feedback */
    .lio-lander-page .lhx-btn-primary:active,
    .lio-lander-page .lio-ot-card-cta:active,
    .lio-lander-page .lfc-tk-cta:active,
    .lio-lander-page .kb-btn:active { transform: scale(0.98); }
  }

  /* Vertical rhythm — section padding (one consistent value).
     Existing rules in this section file already cap horizontal padding;
     here we tune vertical only. */
  @media (max-width: 768px) {
    .lio-lander-page .lhx-hero,
    .lio-lander-page .lbs,
    .lio-lander-page .lio-qf,
    .lio-lander-page .section-lio-offer-tiers .lio-ot,
    .lio-lander-page .lsp-section,
    .lio-lander-page .flavored-air,
    .lio-lander-page .how,
    .lio-lander-page .killblock,
    .lio-lander-page .flavors,
    .lio-lander-page .levp,
    .lio-lander-page .costcomp,
    .lio-lander-page .faq,
    .lio-lander-page .lfc-tk { padding-top: 40px !important; padding-bottom: 40px !important; }
    .lio-lander-page .lhx-hero { padding-top: 20px !important; padding-bottom: 28px !important; }
    .lio-lander-page .lbs { padding-top: 18px !important; padding-bottom: 22px !important; }
    .lio-lander-page .lio-qf { padding-top: 28px !important; padding-bottom: 36px !important; }
  }
  @media (max-width: 480px) {
    .lio-lander-page .lhx-hero,
    .lio-lander-page .lbs,
    .lio-lander-page .lio-qf,
    .lio-lander-page .section-lio-offer-tiers .lio-ot,
    .lio-lander-page .lsp-section,
    .lio-lander-page .flavored-air,
    .lio-lander-page .how,
    .lio-lander-page .killblock,
    .lio-lander-page .flavors,
    .lio-lander-page .levp,
    .lio-lander-page .costcomp,
    .lio-lander-page .faq,
    .lio-lander-page .lfc-tk { padding-top: 32px !important; padding-bottom: 32px !important; }
    .lio-lander-page .lhx-hero { padding-top: 16px !important; padding-bottom: 24px !important; }
  }

  /* Typography scale for mobile — predictable, never giant */
  @media (max-width: 768px) {
    .lio-lander-page h1, .lio-lander-page .lhx-title { font-size: clamp(38px, 9vw, 48px) !important; line-height: 1.0 !important; letter-spacing: -0.04em !important; }
    .lio-lander-page h2:not(.lhx-title) { font-size: clamp(24px, 6.2vw, 30px) !important; line-height: 1.1 !important; letter-spacing: -0.025em !important; }
    .lio-lander-page h3:not(.lhx-title) { font-size: clamp(18px, 4.6vw, 22px) !important; line-height: 1.2 !important; }
    .lio-lander-page p { font-size: 14.5px; line-height: 1.6; }
    /* Hero subhead a touch larger for readability */
    .lio-lander-page .lhx-sub { font-size: 15px !important; line-height: 1.55 !important; }
  }

  /* Sticky header on mobile — keep tight + safe-area aware */
  @media (max-width: 768px) {
    .lio-lh-bar {
      padding: 10px 16px !important;
      padding-top: max(10px, env(safe-area-inset-top)) !important;
    }
    .lio-lh-cta { padding: 9px 14px !important; font-size: 12.5px !important; }
    .lio-lh-cart { width: 36px !important; height: 36px !important; }
    .lio-lh-actions { gap: 10px !important; }
  }

  /* Killblock — ensure dark-on-light contrast + mobile padding inside */
  @media (max-width: 768px) {
    .lio-killblock-v33 { padding: 48px 20px !important; }
    .lio-killblock-v33 .kb-h { font-size: clamp(28px, 7.2vw, 34px) !important; line-height: 1.05 !important; }
    .lio-killblock-v33 .kb-grid { grid-template-columns: 1fr !important; gap: 12px !important; }
  }

  /* Flavored-air explainer — center text on mobile, image stacks */
  @media (max-width: 768px) {
    .lio-lander-page .flavored-air .lfl-grid,
    .lio-lander-page .lfl-section .lfl-grid { grid-template-columns: 1fr !important; gap: 24px !important; }
  }

  /* Flavors picker — touch-friendly tabs */
  @media (max-width: 768px) {
    .lio-lander-page .lfv-tabs,
    .lio-lander-page .flavors .tabs {
      gap: 6px !important;
      padding: 4px !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .lio-lander-page .lfv-tabs::-webkit-scrollbar,
    .lio-lander-page .flavors .tabs::-webkit-scrollbar { display: none; }
    .lio-lander-page .lfv-tab,
    .lio-lander-page .flavors .tab {
      flex-shrink: 0 !important;
      scroll-snap-align: center !important;
      min-height: 44px !important;
    }
  }

  /* PDP builder — single column always on mobile, tightened */
  @media (max-width: 980px) {
    .lio-lander-page .lio-pdp { display: flex !important; flex-direction: column !important; gap: 22px !important; }
    .lio-lander-page .lio-pdp-config { width: 100% !important; }
  }
  @media (max-width: 768px) {
    .lio-lander-page .lio-device-options { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
    .lio-lander-page .lio-device-card { padding: 14px 10px !important; min-height: 200px; }
    .lio-lander-page .lio-preset-grid { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
    .lio-lander-page .lio-preset { min-height: 110px !important; }
    .lio-lander-page .lio-flavor-list { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
    .lio-lander-page .lio-rhythm-toggle { gap: 6px !important; }
    .lio-lander-page .lio-rhythm-opt { padding: 12px 10px !important; min-height: 56px; }
    .lio-lander-page .lio-totals-row { font-size: 13.5px; }
    .lio-lander-page .lio-pdp-h1 { font-size: clamp(24px, 6vw, 30px) !important; line-height: 1.1 !important; }
  }

  /* Social proof — give review carousel breathing room + larger taps */
  @media (max-width: 768px) {
    .lio-lander-page .lsp-section,
    .lio-lander-page .social-proof { padding-left: 0 !important; padding-right: 0 !important; }
    .lio-lander-page .lsp-rail,
    .lio-lander-page .lsp-track { padding-left: 20px; padding-right: 20px; }
  }

  /* Evidence cards — 2-up always on mobile */
  @media (max-width: 768px) {
    .lio-lander-page .levp .lv-grid { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
  }

  /* FAQ section — bigger tap area */
  @media (max-width: 768px) {
    .lio-lander-page .faq summary { min-height: 56px !important; padding: 18px 4px !important; }
  }

  /* Reduced motion respect */
  @media (prefers-reduced-motion: reduce) {
    .lio-lander-page * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
  }

  /* ============================================================
     theliokit — UNIVERSAL CONTAINER WIDTH
     Every wide content container caps at 1180px. Narrow text
     sections (quick-faq 760, finalcta 720) keep intentional smaller
     widths because narrow line lengths read better.
     This single rule supersedes the per-section max-width values
     (1080 / 1100 / 1200 / 1280 / 1320 / 1440) for visual rhythm.
     ============================================================ */
  .lio-lander-page .lhx-hero,
  .lio-lander-page .lhx-proof-tile,
  .lio-lander-page .lbs-inner,
  .lio-lander-page .lio-ot-inner,
  .lio-lander-page .lfl-inner,
  .lio-lander-page .how-v2-inner,
  .lio-lander-page .kb-inner,
  .lio-lander-page .lfv-inner,
  .lio-lander-page .levp .lv-inner,
  .lio-lander-page .costcomp-inner,
  .lio-lander-page .ccx-tk,
  .lio-lander-page .lio-pdp,
  .lio-lander-page .lio-lf-inner {
    max-width: 1180px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    width: 100%;
  }

  /* ============================================================
     theliokit — FULL-WIDTH SECTION WRAPPERS
     Section wrappers (the Shopify outer <div>) get ZERO horizontal
     padding so each section's background stretches edge-to-edge of
     the viewport. Each section's INNER element provides the
     content gutter — that gutter is the next rule below.
     ============================================================ */
  .lio-lander-page section[class*="section-lio-"],
  .lio-lander-page .shopify-section,
  .lio-lander-page .shopify-section-group-header-group {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
  body.lio-lander-page,
  body.lio-lander-page main { margin: 0 !important; padding-left: 0 !important; padding-right: 0 !important; }

  /* ============================================================
     theliokit — INNER SECTION GUTTER
     Every section's inner content element gets one universal
     horizontal padding. Three breakpoints, one rule.
     ≥769px:  24px
     ≤768px:  20px
     ≤480px:  16px
     ============================================================ */
  .lio-lander-page .lio-lh-bar,
  .lio-lander-page .lhx-hero,
  .lio-lander-page .lbs,
  .lio-lander-page .lio-qf,
  .lio-lander-page .lhx-proof,
  .lio-lander-page .lio-flavored-2026,
  .lio-lander-page .how-v2,
  .lio-lander-page .lio-flavor-2026,
  .lio-lander-page .levp,
  .lio-lander-page .costcomp,
  .lio-lander-page .lio-pdp-section,
  .lio-lander-page .lio-killblock-v33,
  .lio-lander-page .faq,
  .lio-lander-page .lfc-tk,
  .lio-lander-page .finalcta,
  .lio-lander-page .lio-lf {
    padding-left: 24px !important;
    padding-right: 24px !important;
    box-sizing: border-box !important;
  }
  @media (max-width: 768px) {
    .lio-lander-page .lio-lh-bar,
    .lio-lander-page .lhx-hero,
    .lio-lander-page .lbs,
    .lio-lander-page .lio-qf,
    .lio-lander-page .lhx-proof,
    .lio-lander-page .lio-flavored-2026,
    .lio-lander-page .how-v2,
    .lio-lander-page .lio-flavor-2026,
    .lio-lander-page .levp,
    .lio-lander-page .costcomp,
    .lio-lander-page .lio-pdp-section,
    .lio-lander-page .lio-killblock-v33,
    .lio-lander-page .faq,
    .lio-lander-page .lfc-tk,
    .lio-lander-page .finalcta,
    .lio-lander-page .lio-lf {
      padding-left: 20px !important;
      padding-right: 20px !important;
    }
  }
  @media (max-width: 480px) {
    .lio-lander-page .lio-lh-bar,
    .lio-lander-page .lhx-hero,
    .lio-lander-page .lbs,
    .lio-lander-page .lio-qf,
    .lio-lander-page .lhx-proof,
    .lio-lander-page .lio-flavored-2026,
    .lio-lander-page .how-v2,
    .lio-lander-page .lio-flavor-2026,
    .lio-lander-page .levp,
    .lio-lander-page .costcomp,
    .lio-lander-page .lio-pdp-section,
    .lio-lander-page .lio-killblock-v33,
    .lio-lander-page .faq,
    .lio-lander-page .lfc-tk,
    .lio-lander-page .finalcta,
    .lio-lander-page .lio-lf {
      padding-left: 16px !important;
      padding-right: 16px !important;
    }
  }

  /* ============================================================
     theliokit — section-specific polish (round 2)
     ============================================================ */

  /* Flavored-air: gif fills the square fully (object-fit: cover, no scale hack) */
  .lio-lander-page .lio-flavored-2026 .lfl-visual {
    aspect-ratio: 1 / 1;
    max-width: 560px;
    margin-left: auto; margin-right: auto;
    width: 100%;
    background: #f4f7f2;
  }
  .lio-lander-page .lio-flavored-2026 .lfl-visual-img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center !important;
    transform: none !important;
    display: block;
  }
  /* Hide the empty-state placeholder always — we always have a real image URL */
  .lio-lander-page .lio-flavored-2026 .lfl-visual-placeholder { display: none !important; }
  @media (max-width: 768px) {
    .lio-lander-page .lio-flavored-2026 .lfl-visual { max-width: 100%; border-radius: 22px; }
  }

  /* Costcomp mobile — much more compact: cards side-by-side, smaller numbers,
     savings strip becomes a single horizontal pill row not stacked. */
  @media (max-width: 600px) {
    .lio-lander-page .costcomp.cc-compact { padding: 24px 16px !important; }
    .lio-lander-page .ccx-tk { font-size: 13px; }
    .lio-lander-page .ccx-tk-head { margin-bottom: 18px !important; }
    .lio-lander-page .ccx-tk-eyebrow { margin-bottom: 8px !important; font-size: 10px !important; }
    .lio-lander-page .ccx-tk-h2 { font-size: clamp(20px, 5.4vw, 24px) !important; line-height: 1.05 !important; }
    /* Two cards SIDE-BY-SIDE on mobile (was stacked) */
    .lio-lander-page .ccx-tk-grid { grid-template-columns: 1fr 1fr !important; gap: 8px !important; margin-bottom: 14px !important; }
    .lio-lander-page .ccx-tk-card { padding: 14px 12px !important; border-radius: 12px !important; }
    .lio-lander-page .ccx-tk-card-flag { left: 10px !important; top: -10px !important; font-size: 8px !important; padding: 3px 7px !important; letter-spacing: 0.14em !important; }
    .lio-lander-page .ccx-tk-card-head { margin-bottom: 10px !important; gap: 2px !important; }
    .lio-lander-page .ccx-tk-card-tag { font-size: 12px !important; }
    .lio-lander-page .ccx-tk-card-mono { font-size: 8.5px !important; letter-spacing: 0.14em !important; }
    .lio-lander-page .ccx-tk-card-price { padding: 6px 0 10px !important; margin-bottom: 10px !important; gap: 4px !important; }
    .lio-lander-page .ccx-tk-card-num { font-size: 26px !important; letter-spacing: -0.025em !important; }
    .lio-lander-page .ccx-tk-card-unit { font-size: 10px !important; }
    .lio-lander-page .ccx-tk-card-list { font-size: 11px !important; gap: 3px !important; line-height: 1.4 !important; }
    .lio-lander-page .ccx-tk-card-list li { padding: 0 !important; }
    /* Savings strip: keep 3-up horizontal */
    .lio-lander-page .ccx-tk-savings { grid-template-columns: 1fr 1fr 1fr !important; padding: 12px 8px !important; gap: 0 !important; border-radius: 12px !important; }
    .lio-lander-page .ccx-tk-savings-num { padding: 4px 6px !important; border-right: 1px solid rgba(11,36,16,0.10) !important; border-bottom: 0 !important; }
    .lio-lander-page .ccx-tk-savings-num:last-child { border-right: 0 !important; }
    .lio-lander-page .ccx-tk-savings-num span { font-size: 14px !important; line-height: 1 !important; }
    .lio-lander-page .ccx-tk-savings-num small { font-size: 8px !important; letter-spacing: 0.1em !important; margin-top: 4px !important; }
    .lio-lander-page .ccx-tk-foot { font-size: 10.5px !important; line-height: 1.45 !important; }
  }

  /* Flavors: revert to ONE per row on mobile (previous override forced 2-up) */
  @media (max-width: 768px) {
    .lio-lander-page .lio-flavor-list,
    .lio-lander-page .lfv-list,
    .lio-lander-page .flavors .flavor-list { grid-template-columns: 1fr !important; gap: 12px !important; }
  }

  /* Configurator: hide 90-day promise badge when one-time payment is selected.
     The rhythm toggle has [data-mode="sub|otp"] with aria-checked on the active one.
     :has() selector covers modern browsers; degrades gracefully if unsupported. */
  .lio-lander-page .lio-purchase-block:has(.lio-rhythm-opt[data-mode="otp"][aria-checked="true"]) .lio-promise-badge {
    display: none !important;
  }
  /* Belt-and-suspenders fallback via JS-set body attribute */
  body[data-rhythm="otp"] .lio-lander-page .lio-promise-badge { display: none !important; }

  /* Killblock now sits BELOW the configurator — drop the dark-section heaviness
     so it ends the page on a confident, not loud, note */
  .lio-lander-page section.section-lio-killblock { margin-top: 0; }
  @media (max-width: 768px) {
    .lio-lander-page .lio-killblock-v33 .kb-h { font-size: clamp(26px, 6.4vw, 32px) !important; }
  }

  /* ============================================================
     theliokit — proportion / typography polish (round 3)
     ============================================================ */

  /* Hero: fix runaway title scale on small mobile, tighten image frame */
  @media (max-width: 600px) {
    .lio-lander-page .lhx-title { font-size: clamp(36px, 9vw, 48px) !important; line-height: 0.98 !important; }
    .lio-lander-page .lhx-sub { font-size: 14.5px !important; max-width: 100% !important; }
    .lio-lander-page .lhx-cta { gap: 10px !important; margin-top: 8px !important; }
    .lio-lander-page .lhx-visual { border-radius: 22px !important; }
    .lio-lander-page .lhx-ticks { gap: 8px 14px !important; font-size: 11.5px !important; }
  }

  /* Brand-strip: 2x2 USP grid on mobile (was 4-cramped) */
  @media (max-width: 720px) {
    .lio-lander-page .lbs-usps { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
    .lio-lander-page .lbs-usp { padding: 11px 12px !important; }
    .lio-lander-page .lbs-usp-icon { width: 28px !important; height: 28px !important; }
    .lio-lander-page .lbs-usp-text strong { font-size: 12.5px !important; }
    .lio-lander-page .lbs-usp-text span { font-size: 11px !important; }
    /* Geo pill full width, centered */
    .lio-lander-page .lbs-geo {
      width: 100% !important;
      flex-direction: row !important;
      justify-content: center !important;
      gap: 12px !important;
      padding: 14px 16px !important;
      border-radius: 14px !important;
      text-align: left !important;
    }
    .lio-lander-page .lbs-geo-text { align-items: flex-start !important; }
    .lio-lander-page .lbs-geo-text strong { font-size: 13px !important; }
    .lio-lander-page .lbs-geo-meta { font-size: 10.5px !important; }
  }

  /* Quick-FAQ outer summary — bigger tap target, tighter on mobile */
  @media (max-width: 600px) {
    .lio-lander-page .lio-qf-h2 { font-size: clamp(20px, 5.4vw, 24px) !important; }
    .lio-lander-page .lio-qf-outer-summary { padding: 18px 18px !important; }
    .lio-lander-page .lio-qf-item summary { padding: 14px 4px !important; min-height: 50px !important; }
    .lio-lander-page .lio-qf-item-q { font-size: 13.5px !important; line-height: 1.4 !important; }
    .lio-lander-page .lio-qf-item-a { font-size: 13px !important; padding: 0 4px 14px !important; }
  }

  /* Social proof carousel — tighter card padding on mobile */
  @media (max-width: 600px) {
    .lio-lander-page .lhx-proof-headline { gap: 14px !important; flex-direction: column !important; align-items: flex-start !important; }
    .lio-lander-page .lhx-proof-num { font-size: clamp(48px, 12vw, 72px) !important; line-height: 0.95 !important; }
  }

  /* Configurator — give wood swatches breathing room, shrink rhythm toggle on small */
  @media (max-width: 480px) {
    .lio-lander-page .lio-rhythm-opt { font-size: 12.5px !important; padding: 11px 10px !important; }
    .lio-lander-page .lio-wood-options { gap: 6px !important; }
    .lio-lander-page .lio-wood-opt { padding: 8px 12px !important; font-size: 12.5px !important; }
    .lio-lander-page .lio-pdp-step { margin-bottom: 18px !important; }
  }

  /* Hide leftover sticky CTA (chrome was removed but its CSS is still in this file) */
  .lio-lander-page .sticky-cta { display: none !important; }

  /* Innermost content containers (max-width: 1180px wrappers) sit INSIDE
     the gutter-padded section — they must not double-pad. */
  .lio-lander-page .lbs-inner,
  .lio-lander-page .lio-qf-inner,
  .lio-lander-page .lhx-proof-tile,
