<style>
  .lio-page-loader {
    position: fixed; inset: 0; z-index: 9999;
    background: #fcfefb;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    color: #0b2410;
  }
  .lio-page-loader.is-hidden { opacity: 0; visibility: hidden; pointer-events: none; }
  .lio-page-loader-inner { display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .lio-page-loader-mark { display: inline-flex; align-items: center; gap: 12px; }
  .lio-page-loader-mark svg { width: 18px; height: 36px; opacity: 0.85; }
  .lio-page-loader-mark strong { font-size: 32px; font-weight: 900; letter-spacing: -0.04em; color: #0b2410; }
  .lio-page-loader-bar { width: 120px; height: 2px; background: rgba(11,36,16,0.08); border-radius: 2px; overflow: hidden; display: block; }
  .lio-page-loader-bar > span {
    display: block; height: 100%;
    background: linear-gradient(90deg, transparent 0%, #94fca9 30%, #0b2410 60%, transparent 100%);
    background-size: 200% 100%;
    animation: lio-loader-shift 1.1s linear infinite;
  }
  @keyframes lio-loader-shift {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
  .lio-page-loader-text {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(11,36,16,0.55);
  }
</style>
<script>
  (function () {
    var l = document.getElementById('lio-page-loader');
    if (!l) return;
    var hide = function () { l.classList.add('is-hidden'); };
    if (document.readyState === 'complete') { setTimeout(hide, 100); return; }
    window.addEventListener('load', function () { setTimeout(hide, 150); });
    setTimeout(hide, 2800); // hard cap
  })();
</script>

