<!-- ================== UGC / "IN THE WILD" WALL ================== -->
<section class="ugc" id="ugc">
  <div class="ugc-inner">
    <div class="ugc-head">
      <div>
        <div class="ugc-eyebrow">In the wild</div>
        <h2 class="ugc-h2">
          Real phones. Real <span class="italic-word">rooms.</span><br>
          Lio is already out there.
        </h2>
      </div>
      <div class="ugc-head-right">
        Tagged posts from Instagram and TikTok — phone-shot, unedited, uploaded by the people using Lio every day. Tag <a href="https://www.instagram.com/breathelio/" target="_blank" rel="noopener">@breathelio</a> to get featured.
      </div>
    </div>

    <div class="mobile-swipe-hint">Swipe</div>
    <div class="ugc-grid">
      <div class="ugc-tile t1">
        <div class="ugc-tile-bg"></div>
        <div class="ugc-tile-platform"><svg><use href="#plat-ig"/></svg></div>
        <div class="ugc-tile-handle">@maria.vg</div>
      </div>
