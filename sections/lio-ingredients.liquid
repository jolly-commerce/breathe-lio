<!-- ================== SECTION 5: INGREDIENTS ================== -->
<section class="ingredients">
  <div class="ingredients-inner">
    <div class="ingredients-visual">
      <div class="ingredients-visual-inner">
        <svg class="ingredients-visual-leaf"><use href="#leaf-deco"/></svg>
        <svg class="ingredients-visual-leaf two"><use href="#leaf-deco"/></svg>
        <div class="ingredients-visual-badge">
          <div class="ingredients-visual-badge-num">5</div>
          <div class="ingredients-visual-badge-label">Plant-based<br>ingredients</div>
        </div>
      </div>
    </div>

    <div class="ingredients-list-wrap">
      <div class="section-eyebrow">What's inside</div>
      <h2 class="section-h2" style="margin-bottom: 20px;">
        Five things.<br>
        <span class="italic-word">Nothing else.</span>
      </h2>
      <p class="section-lede" style="margin-bottom: 44px;">
        Pharmaceutical-grade aromatics from <strong>IFRA-certified EU farms.</strong> Food-safe carriers. A walnut body and a steel core-holder. That's the whole ingredient deck.
      </p>

      <div class="ingredients-list">
        <div class="ingredient-row">
          <div class="ingredient-num">01</div>
          <div>
            <div class="ingredient-body-title">Natural menthol</div>
            <div class="ingredient-body-desc">Steam-distilled from peppermint leaf. The clean, cool note you feel at the back of the throat.</div>
          </div>
          <div class="ingredient-tag">Plant-based</div>
        </div>
        <div class="ingredient-row">
          <div class="ingredient-num">02</div>
          <div>
            <div class="ingredient-body-title">Food-grade glycerin</div>
            <div class="ingredient-body-desc">A carrier that holds the aromatic oils on the core fiber. Food & pharma grade, from plant sources.</div>
          </div>
          <div class="ingredient-tag">Carrier</div>
        </div>
        <div class="ingredient-row">
          <div class="ingredient-num">03</div>
          <div>
            <div class="ingredient-body-title">IFRA-certified flavor oils</div>
            <div class="ingredient-body-desc">Natural aromatic compounds — mint, cinnamon, citrus, berry — blended to a specific profile per core.</div>
          </div>
          <div class="ingredient-tag">EU sourced</div>
        </div>
        <div class="ingredient-row">
          <div class="ingredient-num">04</div>
          <div>
            <div class="ingredient-body-title">Cotton fiber core</div>
            <div class="ingredient-body-desc">A tightly wound, fray-ready fiber that holds the aromatic blend and releases it cleanly through airflow.</div>
          </div>
          <div class="ingredient-tag">Compostable</div>
        </div>
        <div class="ingredient-row">
          <div class="ingredient-num">05</div>
          <div>
            <div class="ingredient-body-title">Walnut body + steel chamber</div>
            <div class="ingredient-body-desc">Hand-finished walnut, weighted for feel. A stainless steel inner chamber that holds the core and shapes the draw.</div>
          </div>
          <div class="ingredient-tag">Hand-finished</div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lio · Ingredients",
  "tag": "section",
  "class": "section-lio-ingredients",
  "settings": [],
  "presets": [{ "name": "Lio · Ingredients" }],
  "enabled_on": { "templates": ["index"] }
}
{% endschema %}
