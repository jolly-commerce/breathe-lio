{%- comment -%}
  Section: Lio · Flavored Air.
  Premium product introduction: split hero with headline, sub, trust row
  (as blocks), CTA + micro-copy, and a 1:1 product GIF/image.
  Every text string is a schema setting → Translate & Adapt compatible.
  Scoped under .lio-flavored-2026 to avoid CSS collisions.
{%- endcomment -%}

{%- liquid
  assign trust_blocks = section.blocks | where: 'type', 'trust'
-%}

<section class="lio-flavored-2026">
  <div class="lfl-inner">

    <div class="lfl-grid">
      <div class="lfl-left">

        <div class="lfl-eyebrow">{{ 'lander.fa.eyebrow' | t }}</div>

        <h2 class="lfl-title">
          <span class="lfl-line">{{ 'lander.fa.title_line_1' | t }}</span>
          <span class="lfl-line">
            {%- if section.settings.show_underline -%}
              <span class="lfl-circle" data-lfl-circle>
                <svg viewBox="0 0 360 10" preserveAspectRatio="none" aria-hidden="true"><path d="M 5 5 L 355 5"/></svg>
                {{ 'lander.fa.title_line_2' | t }}
              </span>
            {%- else -%}
              {{ 'lander.fa.title_line_2' | t }}
            {%- endif -%}
          </span>
        </h2>

        <p class="lfl-sub">{{ 'lander.fa.subhead' | t }}</p>

        {%- if trust_blocks.size > 0 -%}
          <div class="lfl-trust" role="list" aria-label="{{ section.settings.trust_aria | default: 'Product proof points' }}">
            {%- for block in trust_blocks -%}
              <div class="lfl-trust-cell" role="listitem" {{ block.shopify_attributes }}>
                <span class="lfl-trust-ico" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'patent' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7"/><path d="M7 10.5l2 2 4-4"/></svg>
                    {%- when 'flask' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h4v4l3 7a2 2 0 01-1.8 2.8H6.8A2 2 0 015 13.8L8 7V3z"/><path d="M6.5 3h7"/></svg>
                    {%- when 'leaf' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 3.5c0 8.3-5 12.5-12.5 12.5C4 8.5 9 3.5 16.5 3.5z"/><path d="M4 16l8.5-8.5"/></svg>
                    {%- when 'bolt-off' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2L5 11h4l-1 7 6-9h-4l1-7z"/><path d="M3 3l14 14"/></svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V5z"/><path d="M7 10.3l2 2 4-4"/></svg>
                    {%- when 'check' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="10" cy="10" r="7"/><path d="M6.5 10l2.5 2.5L14 7.5"/></svg>
                    {%- when 'no' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="10" cy="10" r="7"/><path d="M5 15L15 5"/></svg>
                    {%- when 'star' -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M10 2l2 4 5 .8-3.5 3.4.8 4.8-4.3-2.3-4.3 2.3.8-4.8L3 6.8 8 6z"/></svg>
                    {%- else -%}
                      <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 10l3 3 7-7"/></svg>
                  {%- endcase -%}
                </span>
                <div class="lfl-trust-text">
                  {%- if block.settings.title != blank -%}<strong>{{ block.settings.title }}</strong>{%- endif -%}
                  {%- if block.settings.sub != blank -%}<span>{{ block.settings.sub }}</span>{%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="lfl-cta-row">
          <a href="{{ section.settings.cta_link | default: '#offer' }}" class="lfl-btn">
            <span>{{ 'lander.fa.cta_label' | t }}</span>
            <span class="lfl-btn-arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
          <div class="lfl-cta-micro">
            <span class="lfl-cta-micro-item">{{ 'lander.fa.micro_1' | t }}</span>
            <span class="lfl-cta-micro-sep" aria-hidden="true"></span><span class="lfl-cta-micro-item">{{ 'lander.fa.micro_2' | t }}</span>
            <span class="lfl-cta-micro-sep" aria-hidden="true"></span><span class="lfl-cta-micro-item">{{ 'lander.fa.micro_3' | t }}</span>
          </div>
        </div>
      </div>

      <div class="lfl-visual{% if section.settings.visual_accent %} lfl-visual--accent{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
             widths: '400,600,800,1000,1200,1400',
             sizes: '(min-width: 900px) 45vw, 100vw',
             loading: 'lazy',
             decoding: 'async',
             alt: section.settings.image_alt | default: section.settings.title_line_2,
             class: 'lfl-visual-img' }}
        {%- elsif section.settings.image_url != blank -%}
          <img
            class="lfl-visual-img"
            src="{{ section.settings.image_url }}"
            alt="{{ section.settings.image_alt | default: section.settings.title_line_2 | escape }}"
            loading="lazy"
            decoding="async">
        {%- else -%}
          <div class="lfl-visual-placeholder" aria-hidden="true">
            <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="24" y="28" width="72" height="64" rx="10"/>
              <circle cx="44" cy="48" r="5"/>
              <path d="M24 80l22-20 16 14 10-10 24 20"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .lio-flavored-2026 {
    --forest:    #0b2410;
    --white:     #ffffff;
    --cream:     #fcfefb;
    --cream-2:   #f4f7f2;
    --mint:      #94fca9;
    --mint-soft: #cdfee1;
    --f-06:   rgba(11, 36, 16, 0.06);
    --f-08:   rgba(11, 36, 16, 0.08);
    --f-10:   rgba(11, 36, 16, 0.10);
    --f-14:   rgba(11, 36, 16, 0.14);
    --f-40:   rgba(11, 36, 16, 0.40);
    --f-55:   rgba(11, 36, 16, 0.55);
    --f-72:   rgba(11, 36, 16, 0.72);
    --lfl-ease: cubic-bezier(0.22, 1, 0.36, 1);

    display: block;
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    color: var(--forest);
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.005em;
    font-feature-settings: "ss01", "kern";
    background: var(--white);
    padding: 96px 40px;
    position: relative;
    overflow: hidden;
  }
  .lio-flavored-2026 *, .lio-flavored-2026 *::before, .lio-flavored-2026 *::after { box-sizing: border-box; }
  .lio-flavored-2026::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 88% 12%, rgba(148, 252, 169, 0.09) 0%, transparent 55%);
    pointer-events: none;
  }
  .lio-flavored-2026 .lfl-inner {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Grid */
  .lio-flavored-2026 .lfl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 72px;
    align-items: center;
  }

  /* Copy */
  .lio-flavored-2026 .lfl-eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--f-55);
    margin-bottom: 24px;
  }
  .lio-flavored-2026 .lfl-title {
    font-weight: 900;
    font-size: clamp(40px, 4.8vw, 76px);
    line-height: 0.96;
    letter-spacing: -0.045em;
    margin-bottom: 24px;
    color: var(--forest);
  }
  .lio-flavored-2026 .lfl-title .lfl-line { display: block; }
  .lio-flavored-2026 .lfl-title .lfl-line:last-child { padding-bottom: 0.18em; }

  /* Underline annotation */
  .lio-flavored-2026 .lfl-circle {
    position: relative;
    display: inline-block;
  }
  .lio-flavored-2026 .lfl-circle svg {
    position: absolute;
    left: 0; right: 0; bottom: -0.18em;
    width: 100%; height: 0.18em;
    pointer-events: none;
    overflow: visible;
  }
  .lio-flavored-2026 .lfl-circle svg path {
    fill: none;
    stroke: var(--mint);
    stroke-width: 10;
    stroke-linecap: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    transition: stroke-dashoffset 1.4s var(--lfl-ease);
  }
  .lio-flavored-2026 .lfl-circle.is-visible svg path { stroke-dashoffset: 0; }

  .lio-flavored-2026 .lfl-sub {
    font-size: 17px;
    line-height: 1.55;
    color: var(--f-72);
    max-width: 460px;
    margin-bottom: 36px;
  }
  .lio-flavored-2026 .lfl-sub strong { color: var(--forest); font-weight: 600; }

  /* Trust row */
  .lio-flavored-2026 .lfl-trust {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 24px;
    padding: 20px 0;
    border-top: 1px solid var(--f-08);
    border-bottom: 1px solid var(--f-08);
    margin-bottom: 28px;
  }
  .lio-flavored-2026 .lfl-trust-cell {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .lio-flavored-2026 .lfl-trust-ico {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--cream-2);
    color: var(--forest);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lio-flavored-2026 .lfl-trust-ico svg { width: 15px; height: 15px; }
  .lio-flavored-2026 .lfl-trust-text strong {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: var(--forest);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .lio-flavored-2026 .lfl-trust-text span {
    display: block;
    font-size: 12px;
    color: var(--f-55);
    margin-top: 2px;
    line-height: 1.3;
  }

  /* CTA */
  .lio-flavored-2026 .lfl-cta-row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .lio-flavored-2026 .lfl-btn {
    background: var(--mint);
    color: var(--forest);
    padding: 16px 22px 16px 28px;
    border: none;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: color 0.3s var(--lfl-ease);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    font-family: inherit;
    text-decoration: none;
  }
  .lio-flavored-2026 .lfl-btn::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--forest);
    transform: translateY(101%);
    transition: transform 0.4s var(--lfl-ease);
    z-index: -1;
  }
  .lio-flavored-2026 .lfl-btn:hover { color: var(--mint); }
  .lio-flavored-2026 .lfl-btn:hover::after { transform: translateY(0); }
  .lio-flavored-2026 .lfl-btn-arrow {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--forest);
    color: var(--mint);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s var(--lfl-ease);
  }
  .lio-flavored-2026 .lfl-btn:hover .lfl-btn-arrow {
    background: var(--mint);
    color: var(--forest);
    transform: translateX(3px);
  }
  .lio-flavored-2026 .lfl-btn-arrow svg { width: 13px; height: 13px; }

  .lio-flavored-2026 .lfl-cta-micro {
    font-size: 12px;
    color: var(--f-55);
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
  }
  .lio-flavored-2026 .lfl-cta-micro-item strong {
    color: var(--forest);
    font-weight: 700;
  }
  .lio-flavored-2026 .lfl-cta-micro-sep {
    display: inline-block;
    width: 3px; height: 3px;
    background: var(--f-40);
    border-radius: 50%;
    margin: 0 10px;
    vertical-align: middle;
  }

  /* Visual */
  .lio-flavored-2026 .lfl-visual {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--cream-2);
    border-radius: 32px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lio-flavored-2026 .lfl-visual--accent {
    background: var(--forest);
  }
  .lio-flavored-2026 .lfl-visual::before {
    content: "";
    position: absolute;
    top: -15%; right: -15%;
    width: 55%; height: 55%;
    background: radial-gradient(circle, var(--mint-soft) 0%, transparent 70%);
    opacity: 0.5;
    pointer-events: none;
  }
  .lio-flavored-2026 .lfl-visual-img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .lio-flavored-2026 .lfl-visual-placeholder {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(11, 36, 16, 0.25);
    width: 100%;
    height: 100%;
  }
  .lio-flavored-2026 .lfl-visual-placeholder svg { width: 45%; height: 45%; }

  /* Mobile */
  @media (max-width: 900px) {
    .lio-flavored-2026 { padding: 64px 20px; }
    .lio-flavored-2026 .lfl-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .lio-flavored-2026 .lfl-title { font-size: clamp(36px, 10vw, 56px); }
    .lio-flavored-2026 .lfl-sub { font-size: 16px; }
    .lio-flavored-2026 .lfl-visual {
      max-width: 440px;
      margin: 0 auto;
      width: 100%;
      border-radius: 24px;
    }
    .lio-flavored-2026 .lfl-trust {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 16px;
    }
  }

  @media (max-width: 480px) {
    .lio-flavored-2026 .lfl-cta-row { align-items: stretch; }
    .lio-flavored-2026 .lfl-btn { justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lio-flavored-2026 .lfl-circle svg path { stroke-dashoffset: 0 !important; }
    .lio-flavored-2026 .lfl-btn,
    .lio-flavored-2026 .lfl-btn::after,
    .lio-flavored-2026 .lfl-btn-arrow { transition: none !important; }
  }
{% endstylesheet %}

{% javascript %}
  (function() {
    document.querySelectorAll('.lio-flavored-2026 [data-lfl-circle]').forEach(function(el) {
      el.classList.remove('is-visible');
    });
    if (!('IntersectionObserver' in window)) {
      document.querySelectorAll('.lio-flavored-2026 [data-lfl-circle]').forEach(function(el) {
        el.classList.add('is-visible');
      });
      return;
    }
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('.lio-flavored-2026 [data-lfl-circle]').forEach(function(el) {
      io.observe(el);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Lio · Flavored Air",
  "tag": "section",
  "class": "section-lio-flavored-air",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Invented in Amsterdam · Since 2018" },
    { "type": "text", "id": "title_line_1", "label": "Title — line 1", "default": "Europe's first" },
    { "type": "text", "id": "title_line_2", "label": "Title — line 2 (the underlined phrase)", "default": "flavored air device." },
    { "type": "checkbox", "id": "show_underline", "label": "Show mint underline on line 2", "default": true },
    { "type": "textarea", "id": "subhead", "label": "Subhead (HTML allowed: <strong>, <br>)", "default": "An all-natural, <strong>nicotine-free wooden mouth diffuser</strong>. Draw on it like you would anything else, the only thing you breathe is flavored air." },

    { "type": "header", "content": "Primary CTA" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start the ritual — €39" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "micro_1", "label": "Micro copy — item 1", "default": "<strong>€0.88/day</strong>" },
    { "type": "text", "id": "micro_2", "label": "Micro copy — item 2", "default": "90-day money-back" },
    { "type": "text", "id": "micro_3", "label": "Micro copy — item 3", "default": "Ships from Amsterdam" },

    { "type": "header", "content": "Visual" },
    { "type": "image_picker", "id": "image", "label": "Image / GIF" },
    { "type": "text", "id": "image_url", "label": "Image URL (fallback)", "default": "https://cdn.shopify.com/s/files/1/0659/6676/8379/files/1744795548_V3-ezgif.com-resize_1_e80d9f10-215d-41b6-a431-fd5bbc180e3a_2.gif?v=1765685909" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Lio wooden mouth diffuser in motion" },
    { "type": "checkbox", "id": "visual_accent", "label": "Use forest (dark) visual background", "default": false },

    { "type": "header", "content": "Accessibility" },
    { "type": "text", "id": "trust_aria", "label": "Trust row aria-label", "default": "Product proof points" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust cell",
      "limit": 8,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "patent", "options": [
          { "value": "patent",   "label": "Patent (circle + check)" },
          { "value": "flask",    "label": "Flask (lab)" },
          { "value": "leaf",     "label": "Leaf (natural)" },
          { "value": "bolt-off", "label": "Bolt off (no battery)" },
          { "value": "shield",   "label": "Shield (guarantee)" },
          { "value": "check",    "label": "Check (verified)" },
          { "value": "no",       "label": "No circle (restriction-free)" },
          { "value": "star",     "label": "Star (rating)" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Trust title" },
        { "type": "text", "id": "sub", "label": "Subtitle", "default": "Supporting detail" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lio · Flavored Air",
      "blocks": [
        { "type": "trust", "settings": { "icon": "patent",   "title": "Patented design",   "sub": "Invented in 2018" } },
        { "type": "trust", "settings": { "icon": "flask",    "title": "3rd-party tested",  "sub": "Independent toxicology" } },
        { "type": "trust", "settings": { "icon": "leaf",     "title": "Nicotine-free",     "sub": "Zero addictive substances" } },
        { "type": "trust", "settings": { "icon": "bolt-off", "title": "Battery-free",      "sub": "No charging, no vapor" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
