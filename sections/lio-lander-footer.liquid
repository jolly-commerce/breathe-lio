<template id="lio-policy-cookie">
  <h4>What cookies are</h4>
  <p>Cookies are small files stored on your device when you visit a website. They help the site remember your preferences and give us anonymised insight into how the site is used.</p>
  <h4>Cookies we use</h4>
  <ul>
    <li><strong>Strictly necessary</strong> — Shopify's session cookies that keep your cart working and let you log in. Cannot be disabled.</li>
    <li><strong>Functional</strong> — remember your country/currency preference, your accepted cookie banner choice, and any saved kit configuration.</li>
    <li><strong>Analytics</strong> — anonymised page-view and click data via Shopify Analytics, Google Analytics 4, and similar tools. Used only with your consent.</li>
    <li><strong>Marketing</strong> — Meta (Facebook), TikTok, Google Ads pixels for retargeting and ad measurement. Used only with your consent.</li>
  </ul>
  <h4>Your choices</h4>
  <p>On your first visit you choose which non-essential cookies to allow via our cookie banner. You can change this at any time by clearing site data in your browser, then revisiting the site.</p>
  <h4>Third-party cookies</h4>
  <p>Some content (e.g., embedded videos) may set cookies from the third party serving it. Their cookie policies apply.</p>
  <h4>Contact</h4>
  <p>Questions: <a href="mailto:hello@breathelio.com">hello@breathelio.com</a></p>
  <div class="lio-modal-meta">Last updated {{ 'now' | date: '%B %Y' }}.</div>
</template>

<script>
  (function () {
    var overlay = document.getElementById('lio-policy-overlay');
    var titleEl = document.getElementById('lio-policy-title');
    var bodyEl  = document.getElementById('lio-policy-body');
    if (!overlay) return;

    var titles = {
      privacy:  'Privacy policy',
      terms:    'Terms of service',
      refund:   'Refund policy',
      shipping: 'Shipping policy',
      legal:    'Legal notice',
      cookie:   'Cookie policy'
    };

    function open (key) {
      var tpl = document.getElementById('lio-policy-' + key);
      if (!tpl) return;
      titleEl.textContent = titles[key] || 'Policy';
      bodyEl.innerHTML = tpl.innerHTML;
      bodyEl.scrollTop = 0;
      overlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lio-modal-open');
    }
    function close () {
      overlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lio-modal-open');
    }

    document.addEventListener('click', function (e) {
      var trig = e.target.closest('[data-policy]');
      if (trig) { e.preventDefault(); open(trig.getAttribute('data-policy')); return; }
      if (e.target.closest('.lio-modal-close')) { close(); return; }
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && overlay.getAttribute('aria-hidden') === 'false') close();
    });
  })();
</script>

{% schema %}
{
  "name": "Lio · Lander footer",
  "tag": "section",
  "class": "section-lio-lander-footer",
  "settings": [
    { "type": "color",    "id": "bg",          "label": "Background",   "default": "#0f2418" },
    { "type": "textarea", "id": "tagline",     "label": "Tagline",      "default": "Wooden mouth diffusers, made in Amsterdam. 150,000+ habits broken since 2018." },
    { "type": "text",     "id": "email",       "label": "Email",        "default": "hello@breathelio.com" },
    { "type": "text",     "id": "whatsapp_number", "label": "WhatsApp (intl format, no +)", "default": "31612345678" },
    { "type": "text",     "id": "trust_1",     "label": "Trust pill 1", "default": "90-day money-back" },
    { "type": "text",     "id": "trust_2",     "label": "Trust pill 2", "default": "Free EU shipping" },
    { "type": "text",     "id": "trust_3",     "label": "Trust pill 3", "default": "Patented EU design" },
    { "type": "text",     "id": "patent",      "label": "Patent line",  "default": "EU Patent EP3784213" },
    { "type": "text",     "id": "closing_tag", "label": "Closing tagline", "default": "Replace the ritual." }
  ],
  "presets": [{ "name": "Lio · Lander footer" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
