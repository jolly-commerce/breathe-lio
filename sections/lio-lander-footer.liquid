{%- comment -%}
  Lio Lander Footer — dark-green detailed footer with in-page modals
  for Privacy, Terms, Refund, Shipping, Legal notice, Cookie.
  All policy links open as modals (no navigation away from page).
{%- endcomment -%}

{%- liquid
  assign privacy_body = shop.privacy_policy.body | default: blank
  assign terms_body   = shop.terms_of_service.body | default: blank
  assign refund_body  = shop.refund_policy.body | default: blank
  assign shipping_body = shop.shipping_policy.body | default: blank
-%}

<style>
  .lio-lf {
    background: {{ section.settings.bg | default: '#0f2418' }};
    color: #e8e0d4;
    padding: 60px 24px 130px;
    border-top: 1px solid rgba(255,255,255,0.06);
    font-size: 13px;
    line-height: 1.7;
    font-family: inherit;
  }
  .lio-lf-inner { max-width: 1100px; margin: 0 auto; }
  .lio-lf-cols {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 36px;
  }
  .lio-lf-cols h4 {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #f5f1eb;
    font-weight: 700;
  }
  .lio-lf-cols a, .lio-lf-cols button.lio-policy-trigger {
    display: block;
    color: rgba(232,224,212,0.78);
    text-decoration: none;
    padding: 4px 0;
    background: none;
    border: 0;
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition: color 0.15s ease;
    width: 100%;
  }
  .lio-lf-cols a:hover, .lio-lf-cols button.lio-policy-trigger:hover { color: #ffffff; text-decoration: underline; }
  .lio-lf-tagline {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.5;
    color: #f5f1eb;
    font-weight: 500;
    max-width: 320px;
  }
  .lio-lf-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #c8e6cd;
    margin-top: 14px;
  }
  .lio-lf-trust span { display: inline-flex; align-items: center; gap: 6px; }
  .lio-lf-trust span::before { content: "✓"; color: #94fca9; font-weight: 700; }
  .lio-lf-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 12px;
    color: rgba(232,224,212,0.66);
  }
  .lio-lf-tag { font-style: italic; color: #f5f1eb; font-weight: 500; }
  .lio-lf-payments {
    display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px;
  }
  .lio-lf-payments span {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 600;
    color: #f5f1eb;
    letter-spacing: 0.04em;
  }
  @media (max-width: 768px) {
    .lio-lf-cols { grid-template-columns: 1fr 1fr; gap: 28px; }
    .lio-lf { padding: 40px 20px 110px; }
    .lio-lf-bottom { flex-direction: column; align-items: flex-start; }
  }

  /* ======================== POLICY MODAL ======================== */
  .lio-modal-overlay {
    position: fixed; inset: 0;
    background: rgba(15, 36, 24, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 200;
    display: none;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .lio-modal-overlay[aria-hidden="false"] { display: flex; opacity: 1; }
  .lio-modal {
    background: #ffffff;
    color: #2a2a2a;
    width: 100%;
    max-width: 720px;
    max-height: 88vh;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: translateY(20px);
    transition: transform 0.25s ease;
    font-family: inherit;
  }
  .lio-modal-overlay[aria-hidden="false"] .lio-modal { transform: translateY(0); }
  @media (min-width: 700px) {
    .lio-modal-overlay { align-items: center; padding: 24px; }
    .lio-modal { border-radius: 16px; }
  }
  .lio-modal-head {
    padding: 18px 22px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-shrink: 0;
  }
  .lio-modal-head h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    color: #1f3a2c;
  }
  .lio-modal-close {
    background: rgba(0,0,0,0.04);
    border: 0;
    width: 32px; height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #2a2a2a;
    transition: background 0.15s;
  }
  .lio-modal-close:hover { background: rgba(0,0,0,0.08); }
  .lio-modal-body {
    padding: 24px 26px 32px;
    overflow-y: auto;
    flex: 1;
    line-height: 1.7;
    font-size: 14px;
  }
  .lio-modal-body h4 { margin: 18px 0 8px; font-size: 14px; color: #1f3a2c; font-weight: 700; }
  .lio-modal-body h4:first-child { margin-top: 0; }
  .lio-modal-body p { margin: 0 0 12px; }
  .lio-modal-body ul, .lio-modal-body ol { margin: 0 0 12px 20px; padding: 0; }
  .lio-modal-body li { margin-bottom: 6px; }
  .lio-modal-body a { color: #1f3a2c; text-decoration: underline; }
  .lio-modal-meta { font-size: 12px; color: #777; margin-top: 18px; padding-top: 14px; border-top: 1px solid rgba(0,0,0,0.06); }
  body.lio-modal-open { overflow: hidden; }
</style>

<footer class="lio-lf">
  <div class="lio-lf-inner">
    <div class="lio-lf-cols">
      <div>
        <p class="lio-lf-tagline">{{ section.settings.tagline | default: 'Wooden mouth diffusers, made in Amsterdam. 150,000+ habits broken since 2018.' }}</p>
        <div class="lio-lf-trust">
          <span>{{ section.settings.trust_1 | default: '90-day money-back' }}</span>
          <span>{{ section.settings.trust_2 | default: 'Free EU shipping' }}</span>
          <span>{{ section.settings.trust_3 | default: 'Patented EU design' }}</span>
        </div>
        <div class="lio-lf-payments">
          <span>VISA</span><span>Mastercard</span><span>iDEAL</span><span>Apple Pay</span><span>Shop Pay</span><span>PayPal</span>
        </div>
      </div>
      <div>
        <h4>On this page</h4>
        <a href="#shopify-section-flavored_air">What it is</a>
        <a href="#shopify-section-how">How it works</a>
        <a href="#shopify-section-flavors">Flavors</a>
        <a href="#shopify-section-evidence">Lio evidence</a>
        <a href="#shopify-section-faq">FAQ</a>
        <a href="#shopify-section-main">Build my kit</a>
      </div>
      <div>
        <h4>Customer care</h4>
        <a href="mailto:{{ section.settings.email | default: 'hello@breathelio.com' }}">{{ section.settings.email | default: 'hello@breathelio.com' }}</a>
        {%- if section.settings.whatsapp_number != blank -%}
          <a href="https://wa.me/{{ section.settings.whatsapp_number | replace: '+', '' | replace: ' ', '' }}" target="_blank" rel="noopener">WhatsApp us</a>
        {%- endif -%}
        <button type="button" class="lio-policy-trigger" data-policy="refund">90-day money-back</button>
        <button type="button" class="lio-policy-trigger" data-policy="shipping">Shipping &amp; delivery</button>
        <a href="mailto:{{ section.settings.email | default: 'hello@breathelio.com' }}">Contact info</a>
      </div>
      <div>
        <h4>Legal</h4>
        <button type="button" class="lio-policy-trigger" data-policy="privacy">Privacy policy</button>
        <button type="button" class="lio-policy-trigger" data-policy="terms">Terms of service</button>
        <button type="button" class="lio-policy-trigger" data-policy="refund">Refund policy</button>
        <button type="button" class="lio-policy-trigger" data-policy="shipping">Shipping policy</button>
        <button type="button" class="lio-policy-trigger" data-policy="legal">Legal notice</button>
        <button type="button" class="lio-policy-trigger" data-policy="cookie">Cookie policy</button>
      </div>
    </div>
    <div class="lio-lf-bottom">
      <span>© {{ 'now' | date: '%Y' }} Lio · Made in Amsterdam · {{ section.settings.patent | default: 'EU Patent EP3784213' }}</span>
      <span class="lio-lf-tag">{{ section.settings.closing_tag | default: 'Replace the ritual.' }}</span>
    </div>
  </div>
</footer>

<!-- ============================ POLICY MODALS ============================ -->
<div class="lio-modal-overlay" id="lio-policy-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="lio-policy-title">
  <div class="lio-modal" tabindex="-1">
    <div class="lio-modal-head">
      <h3 id="lio-policy-title">Policy</h3>
      <button type="button" class="lio-modal-close" aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12"/></svg>
      </button>
    </div>
    <div class="lio-modal-body" id="lio-policy-body"></div>
  </div>
</div>

<!-- Hidden policy bodies -->
<template id="lio-policy-privacy">
  {% if privacy_body != blank %}
    {{ privacy_body }}
  {% else %}
    <h4>Who we are</h4>
    <p>Lio is operated by BreatheLio B.V., registered in Amsterdam, the Netherlands. We collect personal information to fulfil orders, support customers, and improve our products. This policy explains what we collect, why, and how to exercise your rights under the EU General Data Protection Regulation (GDPR).</p>
    <h4>What we collect</h4>
    <ul>
      <li><strong>Order &amp; account data</strong> — name, email, shipping address, billing details, order history.</li>
      <li><strong>Communication</strong> — emails, WhatsApp messages, and chat transcripts when you contact us.</li>
      <li><strong>Site usage</strong> — anonymised analytics (pages viewed, device type, country) via Shopify and our analytics partners.</li>
      <li><strong>Marketing preferences</strong> — your subscription status to email/SMS marketing, recorded only with explicit consent.</li>
    </ul>
    <h4>How we use it</h4>
    <p>We use your data to (a) process and ship orders, (b) provide customer support, (c) prevent fraud and abuse, (d) send transactional emails (order confirmation, shipping updates), and (e) — only with your consent — send marketing.</p>
    <h4>Who we share data with</h4>
    <p>We share data only with vendors that help us run the business: Shopify (commerce platform), our payment processors, our shipping carriers, our email/SMS providers, and our analytics provider. All are GDPR-compliant.</p>
    <h4>Your rights</h4>
    <p>You have the right to access, correct, delete, restrict, or port your data, and to object to processing. Email <a href="mailto:hello@breathelio.com">hello@breathelio.com</a> with your request — we respond within 14 days.</p>
    <h4>Retention</h4>
    <p>Order data is retained for 7 years to satisfy EU tax and accounting obligations. Marketing data is retained until you unsubscribe.</p>
    <h4>Contact</h4>
    <p>BreatheLio B.V. · Amsterdam, the Netherlands · <a href="mailto:hello@breathelio.com">hello@breathelio.com</a></p>
  {% endif %}
  <div class="lio-modal-meta">Last updated {{ 'now' | date: '%B %Y' }}.</div>
</template>

<template id="lio-policy-terms">
  {% if terms_body != blank %}
    {{ terms_body }}
  {% else %}
    <h4>Acceptance</h4>
    <p>By placing an order on this site you agree to these Terms of Service. They form a binding agreement between you and BreatheLio B.V., the operator of Lio.</p>
    <h4>Eligibility</h4>
    <p>You must be 18 or older and able to enter a binding contract under the law of your country to purchase. Our products are wellness aromatherapy devices. They are not medical devices, are not nicotine replacement therapy, and make no medical claims.</p>
    <h4>Orders</h4>
    <p>Orders are accepted upon successful payment. We may refuse, cancel, or limit any order at our discretion (suspected fraud, pricing error, restricted shipping address). Where an order is cancelled, we issue a full refund within 5 business days.</p>
    <h4>Pricing &amp; taxes</h4>
    <p>Prices are shown in your local currency where Shopify Markets is enabled. EU prices include VAT. Outside the EU, applicable customs/duties are the buyer's responsibility.</p>
    <h4>Intellectual property</h4>
    <p>The Lio brand, logo, product designs, copy, photography, and the patented mouthpiece (EU Patent EP3784213) are the property of BreatheLio B.V. You may not reproduce or commercially use any of it without written permission.</p>
    <h4>Liability</h4>
    <p>To the fullest extent permitted by law, BreatheLio B.V.'s liability for any claim arising from a purchase is limited to the amount paid for that order. We are not liable for indirect or consequential damages.</p>
    <h4>Governing law</h4>
    <p>These terms are governed by the law of the Netherlands. Disputes shall be brought before the competent courts of Amsterdam, without prejudice to your statutory rights as a consumer in your country of residence.</p>
  {% endif %}
  <div class="lio-modal-meta">Last updated {{ 'now' | date: '%B %Y' }}.</div>
</template>

<template id="lio-policy-refund">
  {% if refund_body != blank %}
    {{ refund_body }}
  {% else %}
