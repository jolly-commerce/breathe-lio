    <h4>EU statutory withdrawal</h4>
    <p>EU residents have a statutory 14-day cooling-off period independently of our 90-day promise. Our promise extends, not replaces, your statutory rights.</p>
  {% endif %}
  <div class="lio-modal-meta">Last updated {{ 'now' | date: '%B %Y' }}.</div>
</template>

