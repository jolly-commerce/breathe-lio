{{ 'ecom-hero.css' | asset_url | stylesheet_tag: preload: true }}

<style>
  .ecom-hero__content {
    background-image: url('https://cdn.shopify.com/s/files/1/0659/6676/8379/files/Frame_mask_for_green_bg.png?v=1747063115');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-color: #005128;
  }
</style>
<div class="ecom-hero">
  <div class="ecom-hero__media">
    {% if section.settings.image != blank %}
      <div class="ecom-hero__media-image">
        <img loading="lazy" src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.image.alt }}" width="100%" height="100%">
      </div>
    {% endif %}

    {% if section.settings.logo != blank %}
      <div class="ecom-hero__logo">
        <div class="ecom-hero__trustpilot-wrapper ecom-hero__trustpilot-wrapper--mobile">
          <img loading="lazy" src="{{ section.settings.logo | image_url: width: 1920 }}" alt="{{ section.settings.logo.alt }}" width="100%" height="100%">
          {% render 'ecom-trustpilot-label', class: 'ecom-hero__trustpilot', trustpilot_text: section.settings.trustpilot_text %}
        </div>
      </div>
    {% endif %}


    <button class="ecom-hero__toggle" id="ecom-hero-toggle" aria-expanded="false" aria-controls="ecom-hero-cards">
      <div class="ecom-hero__toggle__inner">
        <span class="ecom-hero__toggle-icon-plus">
          {% render 'icon', icon: 'plus-thin', width: 18, height: 18 %}
        </span>
        <span class="ecom-hero__toggle-icon-minus" style="display: none;">
          {% render 'icon', icon: 'minus-thin', width: 24, height: 24 %}
        </span>
      </div>
    </button>

    <div class="ecom-hero__cards" id="ecom-hero-cards" style="display: none;">
      {% for block in section.blocks %}
        <div class="ecom-hero__card">
          {% if block.settings.icon != blank %}
            <img loading="lazy" src="{{ block.settings.icon | image_url }}" alt="{{ block.settings.icon.alt }}" class="ecom-hero__card-icon" width="{{ block.settings.icon.width | default: 32 }}" height="{{ block.settings.icon.height | default: 32 }}">
          {% endif %}
          <div class="ecom-hero__card-desc">{{ block.settings.description }}</div>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="ecom-hero__content">
    <div class="ecom-hero__trustpilot-wrapper ecom-hero__trustpilot-wrapper--desktop">
      {% render 'ecom-trustpilot-label', class: 'ecom-hero__trustpilot', trustpilot_text: section.settings.trustpilot_text, trustpilot_avatars: section.settings.trustpilot_avatars %}
    </div>

    <div class="ecom-hero__content-inner">
      <h1 class="ecom-hero__title">
        <span class="ecom-hero__title-main">{{ section.settings.title }}</span>
        <div class="ecom-hero__title-highlight">
          <img loading="lazy" src="{{ section.settings.title_highlight_image | image_url: width: 320 }}" alt="mask icon" width="320" height="auto">
          <span>{{ section.settings.title_highlight }}</span>
        </div>
      </h1>
  
      <div class="ecom-hero__benefits">
        <div class="ecom-hero__benefit">
          {% if section.settings.benefit_icon_1 != blank %}
            <img loading="lazy" src="{{ section.settings.benefit_icon_1 | image_url: width: 64 }}" alt="{{ section.settings.benefit_text_1 }}" class="ecom-hero__benefit-icon" width="64" height="64">
          {% endif %}
          <div class="ecom-hero__benefit-text">{{ section.settings.benefit_text_1 }}</div>
        </div>
        <div class="ecom-hero__benefit">
          {% if section.settings.benefit_icon_2 != blank %}
            <img loading="lazy" src="{{ section.settings.benefit_icon_2 | image_url: width: 64 }}" alt="{{ section.settings.benefit_text_2 }}" class="ecom-hero__benefit-icon" width="64" height="64">
          {% endif %}
          <div class="ecom-hero__benefit-text">{{ section.settings.benefit_text_2 }}</div>
        </div>
        <div class="ecom-hero__benefit">
          {% if section.settings.benefit_icon_3 != blank %}
            <img loading="lazy" src="{{ section.settings.benefit_icon_3 | image_url: width: 64 }}" alt="{{ section.settings.benefit_text_3 }}" class="ecom-hero__benefit-icon" width="64" height="64">
          {% endif %}
          <div class="ecom-hero__benefit-text">{{ section.settings.benefit_text_3 }}</div>
        </div>
      </div>

      <div class="ecom-hero__cta-wrapper">
        {% render 'ecom-cta', text: section.settings.cta_text, link: '#ecom-pack-selector' %}
        {% if section.settings.label != blank %}
          <p class="ecom-hero__label">
            {% render 'icon', icon: 'guarantee', width: 16, height: 16 %}
            <span class="ecom-hero__label-text">{{ section.settings.label }}</span>
          </p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.querySelector('#ecom-hero-toggle');
    const cards = document.querySelector('#ecom-hero-cards');
    const iconPlus = document.querySelector('.ecom-hero__toggle-icon-plus');
    const iconMinus = document.querySelector('.ecom-hero__toggle-icon-minus');
    let expanded = false;
    toggleBtn.addEventListener('click', () => {
      expanded = !expanded;
      toggleBtn.setAttribute('aria-expanded', expanded);
      cards.style.display = expanded ? 'grid' : 'none';
      iconPlus.style.display = expanded ? 'none' : 'block';
      iconMinus.style.display = expanded ? 'block' : 'none';
    });
  });
</script>

{% schema %}
{
  "name": "Ecom Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "It's time to break your"
    },
    {
      "type": "image_picker",
      "id": "title_highlight_image",
      "label": "Title Highlight Image"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Title Highlight",
      "default": "bad habit."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "start my journey"
    },
    {
      "type": "text",
      "id": "trustpilot_text",
      "label": "Trustpilot Text",
      "default": "Trusted by 50,000+ people"
    },
    {
      "type": "image_picker",
      "id": "trustpilot_avatars",
      "label": "Trustpilot Avatars"
    },
    {
      "type": "image_picker",
      "id": "benefit_icon_1",
      "label": "Benefit Icon 1"
    },
    {
      "type": "text",
      "id": "benefit_text_1",
      "label": "Benefit Text 1",
      "default": "NO VAPOR"
    },
    {
      "type": "image_picker",
      "id": "benefit_icon_2",
      "label": "Benefit Icon 2"
    },
    {
      "type": "text",
      "id": "benefit_text_2",
      "label": "Benefit Text 2",
      "default": "NO NICOTINE"
    },
    {
      "type": "image_picker",
      "id": "benefit_icon_3",
      "label": "Benefit Icon 3"
    },
    {
      "type": "text",
      "id": "benefit_text_3",
      "label": "Benefit Text 3",
      "default": "PLANT-BASED"
    },
    {
      "type": "textarea",
      "id": "label",
      "label": "Label",
      "default": "Didn't quit? Money Back!"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Card Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Card Description"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Ecom Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}
