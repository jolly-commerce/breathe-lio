{%- comment -%}
  Section: Lio · Versus — Comparison Table
  Static content (brand comparison). CSS scoped to .lio-versus. No SVG.
{%- endcomment -%}

<div class="lio-versus" id="lio-versus-{{ section.id }}">
  <div class="lio-versus__inner">

    <div class="lio-versus__head">
      <span class="lio-versus__eyebrow">Why Lio wins</span>
      <h2>Every other quit tool<br><span class="lio-versus__soft">solves the</span> <span class="lio-versus__hl">wrong problem.</span></h2>
      <p>The industry told you nicotine was the addiction. So they sold you nicotine — in a patch, in a gum, in a vape — and called it a solution. Here's what the data actually says.</p>
    </div>

    <div class="lio-versus__table">

      <div class="lio-versus__row lio-versus__row--header">
        <div class="lio-versus__col lio-versus__col--feature"></div>
        <div class="lio-versus__col lio-versus__col--us">
          <div class="lio-versus__brand">Lio</div>
          <div class="lio-versus__tag">Ritual replacement</div>
        </div>
        <div class="lio-versus__col">
          <div class="lio-versus__brand lio-versus__brand--other">Patches &amp; Gum</div>
          <div class="lio-versus__tag">NRT</div>
        </div>
        <div class="lio-versus__col">
          <div class="lio-versus__brand lio-versus__brand--other">Vapes</div>
          <div class="lio-versus__tag">Nicotine delivery</div>
        </div>
        <div class="lio-versus__col">
          <div class="lio-versus__brand lio-versus__brand--other">Cold turkey</div>
          <div class="lio-versus__tag">Willpower</div>
        </div>
      </div>

      <div class="lio-versus__row">
        <div class="lio-versus__col lio-versus__col--feature">Contains nicotine</div>
        <div class="lio-versus__col lio-versus__col--us"><span class="lio-versus__v-no">No</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-yes">Yes</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-yes">Yes</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-no">No</span></div>
      </div>

      <div class="lio-versus__row">
        <div class="lio-versus__col lio-versus__col--feature">Replaces hand-to-mouth ritual</div>
        <div class="lio-versus__col lio-versus__col--us"><span class="lio-versus__v-check">✓</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x">✕</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-partial">Partial</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x">✕</span></div>
      </div>

      <div class="lio-versus__row">
        <div class="lio-versus__col lio-versus__col--feature">Replaces the breath / pause</div>
        <div class="lio-versus__col lio-versus__col--us"><span class="lio-versus__v-check">✓</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x">✕</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-partial">Partial</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x">✕</span></div>
      </div>

      <div class="lio-versus__row">
        <div class="lio-versus__col lio-versus__col--feature">Usable indoors, in meetings, on flights</div>
        <div class="lio-versus__col lio-versus__col--us"><span class="lio-versus__v-check">✓</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-partial">Mostly</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x">✕</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-check">✓</span></div>
      </div>

      <div class="lio-versus__row">
        <div class="lio-versus__col lio-versus__col--feature">Long-term success rate</div>
        <div class="lio-versus__col lio-versus__col--us"><strong class="lio-versus__v-stat">High</strong><br><span class="lio-versus__v-stat-sub">100k+ users</span></div>
        <div class="lio-versus__col"><strong class="lio-versus__v-stat-bad">~8%</strong><br><span class="lio-versus__v-stat-sub">Cochrane meta-analysis</span></div>
        <div class="lio-versus__col"><strong class="lio-versus__v-stat-bad">Trades habit</strong><br><span class="lio-versus__v-stat-sub">For another</span></div>
        <div class="lio-versus__col"><strong class="lio-versus__v-stat-bad">~3–5%</strong><br><span class="lio-versus__v-stat-sub">Unassisted quit rate</span></div>
      </div>

      <div class="lio-versus__row">
        <div class="lio-versus__col lio-versus__col--feature">Monthly cost</div>
        <div class="lio-versus__col lio-versus__col--us"><strong>€21.60</strong></div>
        <div class="lio-versus__col"><strong>€40–80</strong></div>
        <div class="lio-versus__col"><strong>€60–120</strong></div>
        <div class="lio-versus__col"><strong>€0</strong></div>
      </div>

      <div class="lio-versus__row lio-versus__row--last">
        <div class="lio-versus__col lio-versus__col--feature">Solves the <em>real</em> addiction (the ritual)</div>
        <div class="lio-versus__col lio-versus__col--us"><span class="lio-versus__v-check lio-versus__v-check--big">✓</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x lio-versus__v-x--big">✕</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x lio-versus__v-x--big">✕</span></div>
        <div class="lio-versus__col"><span class="lio-versus__v-x lio-versus__v-x--big">✕</span></div>
      </div>

    </div>

    <div class="lio-versus__foot">
      <p>Sources: Cochrane Tobacco Review (2018, 64,640 participants) · Rose &amp; Behm, Duke University · Duhigg, <em>The Power of Habit</em>.</p>
    </div>

  </div>
</div>

{% stylesheet %}
  .lio-versus {
    --lv-forest:     var(--lio-forest, #0b2410);
    --lv-forest-lift: #122e18;
    --lv-chalk:      var(--lio-chalk, #fcfefb);
    --lv-mint:       var(--lio-mint, #94fca9);
    --lv-f-06:       var(--lio-f-06, rgba(11, 36, 16, 0.06));
    --lv-f-10:       var(--lio-f-10, rgba(11, 36, 16, 0.10));
    --lv-f-40:       var(--lio-f-40, rgba(11, 36, 16, 0.40));
    --lv-f-55:       var(--lio-f-55, rgba(11, 36, 16, 0.55));
    --lv-m-18:       var(--lio-m-18, rgba(148, 252, 169, 0.18));
    --lv-c-55:       var(--lio-c-55, rgba(252, 254, 251, 0.55));
    --lv-c-75:       var(--lio-c-75, rgba(252, 254, 251, 0.75));

    max-width: 1440px;
    margin: 96px auto 88px;
    padding: 0 56px;
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .lio-versus__inner {
    background: var(--lv-chalk);
    border: 1px solid var(--lv-f-10);
    border-radius: 32px;
    padding: 72px 64px 56px;
  }

  .lio-versus__head {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 56px;
  }
  .lio-versus__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--lv-f-55);
    justify-content: center;
    margin-bottom: 20px;
  }
  .lio-versus__eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--lv-forest); }

  .lio-versus__head h2 {
    font-size: clamp(40px, 5.2vw, 68px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 20px 0 18px;
    color: var(--lv-forest);
  }
  .lio-versus__soft { font-weight: 300; color: var(--lv-f-40); }
  .lio-versus__hl {
    background: var(--lv-mint);
    padding: 2px 14px;
    border-radius: 8px;
    display: inline-block;
    transform: rotate(-0.5deg);
  }
  .lio-versus__head p {
    font-size: 17px;
    color: var(--lv-f-55);
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto;
  }

  .lio-versus__table {
    display: grid;
    border: 1px solid var(--lv-f-10);
    border-radius: 20px;
    overflow: hidden;
    background: var(--lv-chalk);
  }
  .lio-versus__row {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr;
    border-bottom: 1px solid var(--lv-f-10);
    align-items: stretch;
  }
  .lio-versus__row:last-child { border-bottom: none; }

  .lio-versus__col {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 15px;
    border-right: 1px solid var(--lv-f-06);
  }
  .lio-versus__col:last-child { border-right: none; }

  .lio-versus__col--feature {
    justify-content: center;
    align-items: flex-start;
    text-align: left;
    font-weight: 500;
    color: var(--lv-forest);
    background: var(--lv-f-06);
    font-size: 14px;
    line-height: 1.35;
  }
  .lio-versus__col--feature em { font-style: italic; font-weight: 700; }

  .lio-versus__row--header .lio-versus__col {
    padding: 22px 14px 20px;
    background: var(--lv-forest);
    color: var(--lv-chalk);
    border-right: 1px solid var(--lv-forest-lift);
  }
  .lio-versus__row--header .lio-versus__col--feature {
    background: var(--lv-forest);
    border-right: 1px solid var(--lv-forest-lift);
  }
  .lio-versus__row--header .lio-versus__col--us {
    background: var(--lv-mint) !important;
    color: var(--lv-forest) !important;
    border-right: 1px solid var(--lv-forest-lift);
  }
  .lio-versus__row--header .lio-versus__col--us .lio-versus__brand { color: var(--lv-forest); }
  .lio-versus__row--header .lio-versus__col--us .lio-versus__tag   { color: var(--lv-forest); opacity: 0.7; }

  .lio-versus__col--us { background: var(--lv-m-18); }

  .lio-versus__brand      { font-size: 18px; font-weight: 700; letter-spacing: -0.015em; }
  .lio-versus__brand--other { color: var(--lv-c-75); }
  .lio-versus__tag        { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 600; color: var(--lv-c-55); margin-top: 4px; }

  .lio-versus__v-check {
    color: var(--lv-forest);
    background: var(--lv-mint);
    width: 28px; height: 28px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 900;
    font-size: 14px;
  }
  .lio-versus__v-check--big { width: 36px; height: 36px; font-size: 18px; }
  .lio-versus__v-x     { color: var(--lv-f-40); font-size: 20px; font-weight: 400; }
  .lio-versus__v-x--big { font-size: 28px; }
  .lio-versus__v-yes   { font-size: 13px; font-weight: 600; color: var(--lv-forest); background: var(--lv-f-10); padding: 4px 10px; border-radius: 999px; }
  .lio-versus__v-no    { font-size: 13px; font-weight: 700; color: var(--lv-forest); background: var(--lv-mint); padding: 4px 10px; border-radius: 999px; }
  .lio-versus__v-partial { font-size: 12px; font-weight: 500; color: var(--lv-f-55); font-style: italic; }
  .lio-versus__v-stat    { font-size: 16px; font-weight: 700; color: var(--lv-forest); display: block; letter-spacing: -0.01em; }
  .lio-versus__v-stat-bad { font-size: 16px; font-weight: 700; color: var(--lv-f-55); display: block; letter-spacing: -0.01em; }
  .lio-versus__v-stat-sub { font-size: 11px; color: var(--lv-f-40); margin-top: 2px; display: inline-block; }

  .lio-versus__row--last .lio-versus__col { padding-top: 24px; padding-bottom: 24px; }

  .lio-versus__foot { margin-top: 24px; text-align: center; }
  .lio-versus__foot p { font-size: 12px; color: var(--lv-f-40); letter-spacing: 0.01em; }
  .lio-versus__foot em { font-style: italic; }

  @media (max-width: 860px) {
    .lio-versus { padding: 0 16px; margin: 64px auto 56px; }
    .lio-versus__inner { padding: 40px 20px 32px; border-radius: 24px; }
    .lio-versus__head  { margin-bottom: 32px; }
    .lio-versus__table { border-radius: 16px; }
    .lio-versus__row   { grid-template-columns: 1fr 1fr; border-bottom: 2px solid var(--lv-f-10); }
    .lio-versus__row .lio-versus__col--feature {
      grid-column: 1 / -1;
      padding: 14px 16px;
      background: var(--lv-forest);
      color: var(--lv-chalk);
      font-weight: 600;
      border-right: none;
      border-bottom: 1px solid var(--lv-forest-lift);
      font-size: 13px;
    }
    .lio-versus__row .lio-versus__col--feature em { color: var(--lv-mint); }
    .lio-versus__col { padding: 14px 10px; font-size: 13px; border-right: 1px solid var(--lv-f-06); border-bottom: 1px solid var(--lv-f-06); }
    .lio-versus__col:nth-child(even) { border-right: none; }
    .lio-versus__row--header { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lio · Versus",
  "tag": "section",
  "class": "section-lio-versus",
  "settings": [],
  "presets": [
    { "name": "Lio · Versus" }
  ]
}
{% endschema %}
