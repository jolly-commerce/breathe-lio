<script>
(function(){
  var SLIDE_WIDTH = 360;
  var MOBILE_GAP = 16;
  var DESKTOP_GAP = 16;
  var MOBILE_BREAKPOINT = 1024;
  
  function isMobile() {
    return window.innerWidth < MOBILE_BREAKPOINT;
  }
  
  function checkAllSlidesVisible() {
    if (isMobile()) return false;
    var container = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-swiper-container');
    if (!container) return false;
    var availableWidth = container.offsetWidth;
    var totalWidth = (5 * SLIDE_WIDTH) + ((5 - 1) * DESKTOP_GAP);
    return totalWidth <= availableWidth;
  }
  
  function updateNavVisibility(swiper) {
    var navContainer = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-container');
    var swiperEl = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-swiper');
    if (!navContainer || !swiperEl) return;
    
    var allVisible = checkAllSlidesVisible();
    
    if (allVisible) {
      navContainer.classList.add('hidden');
      swiperEl.style.width = 'fit-content';
      swiperEl.style.marginLeft = 'auto';
      swiperEl.style.marginRight = 'auto';
    } else {
      navContainer.classList.remove('hidden');
      swiperEl.style.width = '100%';
      swiperEl.style.marginLeft = '0';
      swiperEl.style.marginRight = '0';
    }
    
    updateDots(swiper);
  }
  
  function updateDots(swiper) {
    var dotsContainer = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-dots');
    if (!dotsContainer || !swiper.snapGrid) return;
    
    var totalSnaps = swiper.snapGrid.length;
    var currentSnap = swiper.snapIndex || 0;
    var existingDots = dotsContainer.querySelectorAll('.testimonial04-nav-dot');
    
    if (existingDots.length !== totalSnaps) {
      dotsContainer.innerHTML = '';
      for (var i = 0; i < totalSnaps; i++) {
        var dot = document.createElement('span');
        dot.className = 'testimonial04-nav-dot' + (i === currentSnap ? ' active' : '');
        dot.setAttribute('data-index', i);
        dot.onclick = (function(index) {
          return function() { swiper.slideTo(index); };
        })(i);
        dotsContainer.appendChild(dot);
      }
    } else {
      existingDots.forEach(function(dot, i) {
        if (i === currentSnap) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }
  }
  
  function initTestimonial04Swiper() {
    if (typeof Swiper === 'undefined') return;
    var container = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-swiper');
    if (!container || container.swiper) return;
    
    var prevBtn = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-prev');
    var nextBtn = document.querySelector('#ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-next');
    var mobile = isMobile();
    
    var swiper = new Swiper(container, {
      slidesPerView: 'auto',
      spaceBetween: mobile ? MOBILE_GAP : DESKTOP_GAP,
      centeredSlides: mobile,
      loop: false,
      navigation: {
        nextEl: nextBtn,
        prevEl: prevBtn,
        disabledClass: 'disabled'
      },
      on: {
        init: function() { updateNavVisibility(this); },
        snapIndexChange: function() { updateDots(this); },
        resize: function() {
          var nowMobile = isMobile();
          this.params.spaceBetween = nowMobile ? MOBILE_GAP : DESKTOP_GAP;
          this.params.centeredSlides = nowMobile;
          this.update();
          updateNavVisibility(this);
        }
      }
    });
    
    var resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        if (swiper && !swiper.destroyed) {
          var nowMobile = isMobile();
          swiper.params.spaceBetween = nowMobile ? MOBILE_GAP : DESKTOP_GAP;
          swiper.params.centeredSlides = nowMobile;
          swiper.update();
          updateNavVisibility(swiper);
        }
      }, 100);
    });
  }
  
  if (typeof Swiper !== 'undefined') { initTestimonial04Swiper(); }
  else { document.addEventListener('swiper:loaded', initTestimonial04Swiper); }
  if (document.readyState === 'complete') { initTestimonial04Swiper(); }
  else { window.addEventListener('load', initTestimonial04Swiper); }
})();
</script>

