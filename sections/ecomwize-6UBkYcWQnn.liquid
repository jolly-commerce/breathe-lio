  /* Navigation hidden when all slides visible (via JS) */
  #ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-container.hidden {
    display: none !important;
  }
  
  #ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-arrow {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
    flex: 0 0 32px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: opacity 0.2s, background-color 0.2s;
    background-color: #05b67a;
    color: #ffffff;
    padding: 0;
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
  }
  
  #ecomwize-testimonial04-6UBkYcWQnn .testimonial04-nav-arrow:disabled {
    background-color: rgba(0, 0, 0, 0.1);
    color: rgba(0, 0, 0, 0.3);
