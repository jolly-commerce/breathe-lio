{%- style -%}
  #ecomwize-banner01-Rm-oKiHOKP {
    background-color: #143c2c;
    width: 100%;
    overflow: hidden;
    letter-spacing: normal;
  }
  
  #ecomwize-banner01-Rm-oKiHOKP .banner01-inner {
    padding: 12px 0;
    width: 100%;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-banner01-Rm-oKiHOKP .banner01-inner {
      padding: 16px 0;
    }
  }
  
  #ecomwize-banner01-Rm-oKiHOKP .ticker-track {
    display: flex;
    width: fit-content;
    align-items: center;
    will-change: transform;
  }
  
  #ecomwize-banner01-Rm-oKiHOKP .ticker-content,
  #ecomwize-banner01-Rm-oKiHOKP .ticker-clone {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
    padding-right: 24px;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-banner01-Rm-oKiHOKP .ticker-content,
    #ecomwize-banner01-Rm-oKiHOKP .ticker-clone {
      gap: 48px;
      padding-right: 48px;
    }
  }
  #ecomwize-banner01-Rm-oKiHOKP .banner01-item {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  
  #ecomwize-banner01-Rm-oKiHOKP .banner01-icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    color: #ffffff;
  }
  
  #ecomwize-banner01-Rm-oKiHOKP .banner01-icon svg {
    display: block;
  }
  
  #ecomwize-banner01-Rm-oKiHOKP .banner01-text {
    font-family: 'DM Sans',  sans-serif;
    font-size: 14px;
    font-weight: 400;
    font-style: normal;
    color: #ffffff;
    line-height: 1.4;
    white-space: nowrap;
    margin: 0;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-banner01-Rm-oKiHOKP .banner01-text {
      font-size: 16px;
    }
  }
  
  /* Responsive icon sizes */
  @media (max-width: 1023px) {
    #ecomwize-banner01-Rm-oKiHOKP .banner01-icon .desktop-icon {
      display: none !important;
    }
    #ecomwize-banner01-Rm-oKiHOKP .banner01-icon .mobile-icon {
      display: block !important;
    }
  }
  
  @media (min-width: 1024px) {
    #ecomwize-banner01-Rm-oKiHOKP .banner01-icon .mobile-icon {
      display: none !important;
    }
    #ecomwize-banner01-Rm-oKiHOKP .banner01-icon .desktop-icon {
      display: block !important;
    }
  }
{%- endstyle -%}

