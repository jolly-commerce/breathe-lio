{%- comment -%}
  Section: Lio · Product Support — supporting info cards (videos, blog,
  manuals, what's-in-the-box, common uses, USP details).
{%- endcomment -%}

<section class="lio-psu" id="lio-psu-{{ section.id }}">
  <div class="lio-psu__head">
    <span class="lio-psu__eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }} <span class="lio-psu__soft">{{ section.settings.heading_soft }}</span></h2>
    <p class="lio-psu__sub">{{ section.settings.sub }}</p>
  </div>

  <div class="lio-psu__grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#' }}"
         class="lio-psu__card {% if forloop.first %}lio-psu__card--feature{% endif %}"
         {{ block.shopify_attributes }}>
        <div class="lio-psu__kind">{{ block.settings.kind }}</div>
        <div class="lio-psu__body">
          <p class="lio-psu__title">{{ block.settings.title }}</p>
          <p class="lio-psu__text">{{ block.settings.text }}</p>
        </div>
        <span class="lio-psu__arrow" aria-hidden="true">→</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .lio-psu {
    --lp-forest: var(--lio-forest, #0b2410);
    --lp-chalk:  var(--lio-chalk, #fcfefb);
    --lp-mint:   var(--lio-mint, #94fca9);
    --lp-f-10:   rgba(11, 36, 16, 0.10);
    --lp-f-55:   rgba(11, 36, 16, 0.55);
    --lp-f-72:   rgba(11, 36, 16, 0.72);

    max-width: 1200px;
    margin: 0 auto;
    padding: 80px 40px;
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.005em;
  }
  .lio-psu__head { text-align: center; margin-bottom: 44px; }
  .lio-psu__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--lp-f-55);
    margin-bottom: 16px;
  }
  .lio-psu__eyebrow::before { content: ""; width: 22px; height: 1px; background: var(--lp-forest); }
  .lio-psu__head h2 {
    font-weight: 900;
    font-size: clamp(36px, 4.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--lp-forest);
    margin: 0 0 16px;
  }
  .lio-psu__soft { font-weight: 300; }
  .lio-psu__sub {
    color: var(--lp-f-72);
    font-size: 16px;
    line-height: 1.6;
    max-width: 540px;
    margin: 0 auto;
  }

  .lio-psu__grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
    grid-auto-rows: 1fr;
  }
  .lio-psu__card {
    grid-column: span 2;
    background: var(--lp-chalk);
    border: 1px solid var(--lp-f-10);
    border-radius: 20px;
    padding: 26px 22px;
    text-decoration: none;
    color: var(--lp-forest);
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    min-height: 180px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .lio-psu__card:hover {
    border-color: var(--lp-forest);
    transform: translateY(-3px);
  }
  .lio-psu__card--feature {
    grid-column: span 3;
    background: var(--lp-forest);
    border-color: var(--lp-forest);
    color: var(--lp-chalk);
    min-height: 200px;
  }
  .lio-psu__kind {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--lp-f-55);
    margin: 0;
  }
  .lio-psu__card--feature .lio-psu__kind { color: rgba(148, 252, 169, 0.7); }
  .lio-psu__body { flex-grow: 1; display: flex; flex-direction: column; gap: 8px; }
  .lio-psu__title {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.025em;
    margin: 0;
    line-height: 1.2;
  }
  .lio-psu__card--feature .lio-psu__title { font-size: 22px; color: var(--lp-chalk); }
  .lio-psu__text {
    font-size: 13px;
    line-height: 1.55;
    color: var(--lp-f-72);
    margin: 0;
  }
  .lio-psu__card--feature .lio-psu__text { color: rgba(252, 254, 251, 0.7); font-size: 14px; }
  .lio-psu__arrow {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--lp-forest);
    color: var(--lp-mint);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    align-self: flex-start;
    margin-top: auto;
    transition: transform 0.25s ease;
  }
  .lio-psu__card--feature .lio-psu__arrow { background: var(--lp-mint); color: var(--lp-forest); }
  .lio-psu__card:hover .lio-psu__arrow { transform: translateX(3px); }

  @media (max-width: 960px) {
    .lio-psu { padding: 60px 20px; }
    .lio-psu__grid { grid-template-columns: 1fr; gap: 12px; }
    .lio-psu__card, .lio-psu__card--feature { grid-column: span 1; min-height: 140px; }
  }
  @media (min-width: 961px) and (max-width: 1149px) {
    .lio-psu__grid { grid-template-columns: repeat(2, 1fr); }
    .lio-psu__card, .lio-psu__card--feature { grid-column: span 1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lio · Product Support",
  "tag": "section",
  "class": "section-lio-product-support",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Everything else you need" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Getting started —" },
    { "type": "text", "id": "heading_soft", "label": "Heading (soft)", "default": "the details." },
    { "type": "textarea", "id": "sub", "label": "Subhead", "default": "Videos, guides, and answers to the questions we hear before the product even arrives." }
  ],
  "blocks": [
    {
      "type": "support_item",
      "name": "Support item",
      "settings": [
        { "type": "text", "id": "kind", "label": "Kind label", "default": "Video" },
        { "type": "text", "id": "title", "label": "Title", "default": "How to use Lio in 90 seconds" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Watch a real user take their first three pulls. No acting, no script." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Lio · Product Support",
      "blocks": [
        {
          "type": "support_item",
          "settings": {
            "kind": "Video · 1:30",
            "title": "How to use Lio in 90 seconds",
            "text": "Watch a real user take their first three pulls. No acting, no script — just what it feels like."
          }
        },
        {
          "type": "support_item",
          "settings": {
            "kind": "What's in the box",
            "title": "Unboxing details",
            "text": "1× walnut device, 1× starter core of your choice, cleaning cloth, quick-start card."
          }
        },
        {
          "type": "support_item",
          "settings": {
            "kind": "Common uses",
            "title": "When to reach for it",
            "text": "After dinner, stressful calls, 3pm slump, flights, long drives, evening wind-down."
          }
        },
        {
          "type": "support_item",
          "settings": {
            "kind": "Manual",
            "title": "Care & cleaning",
            "text": "Walnut needs a minute a week — here's the exact routine to keep it pristine for years."
          }
        },
        {
          "type": "support_item",
          "settings": {
            "kind": "Blog",
            "title": "The science of ritual replacement",
            "text": "Why behavioral habit loops matter more than chemical dependence — with citations."
          }
        },
        {
          "type": "support_item",
          "settings": {
            "kind": "Blog",
            "title": "First 30 days with Lio",
            "text": "A day-by-day journal from someone who quit a pack-a-day vape habit cold turkey."
          }
        }
      ]
    }
  ]
}
{% endschema %}
