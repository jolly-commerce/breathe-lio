    {
      "type": "richtext",
      "id": "text_4fVg0mcGzX46XXSo",
      "label": "Title",
      "default": "<h3><strong>YOU ASKED</strong></h3>"
    },
    {
      "type": "richtext",
      "id": "text_29HvUl2tI0Ilvq4v",
