<script>
(function(){
  function initIngredients04Swiper(){
    if(typeof Swiper==='undefined')return;
    var container=document.querySelector('#ecomwize-ingredients04-d0yyQiiylO .ingredients04-swiper');
    if(!container||container.swiper)return;
    
    var prevBtn=document.querySelector('#ecomwize-ingredients04-d0yyQiiylO .ingredients04-nav-prev');
    var nextBtn=document.querySelector('#ecomwize-ingredients04-d0yyQiiylO .ingredients04-nav-next');
    
    var swiper=new Swiper(container,{
      slidesPerView:'auto',
      spaceBetween:16,
      centeredSlides:true,
      loop:false,
      navigation:{
        nextEl:nextBtn,
        prevEl:prevBtn,
        disabledClass:'disabled'
      },
      pagination:{
        el:'#ecomwize-ingredients04-d0yyQiiylO .ingredients04-nav-dots',
        clickable:true,
        bulletClass:'ingredients04-nav-dot',
        bulletActiveClass:'active'
      }
    });
  }
  
  if(typeof Swiper!=='undefined'){initIngredients04Swiper();}
  else{document.addEventListener('swiper:loaded',initIngredients04Swiper);}
  if(document.readyState==='complete'){initIngredients04Swiper();}
  else{window.addEventListener('load',initIngredients04Swiper);}
})();
</script>

