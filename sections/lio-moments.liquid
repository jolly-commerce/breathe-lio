<!-- ================== SECTION 4: MOMENTS (emotional timing) ================== -->
<section class="moments">
  <div class="moments-inner">
    <div class="moments-head">
      <div class="moments-eyebrow">The moments that matter</div>
      <h2 class="moments-h2">
        You know <span class="italic-word">exactly</span> when the urge hits.<br>
        Now you have something for it.
      </h2>
    </div>

    <div class="mobile-swipe-hint">Swipe</div>
    <div class="moments-grid">
      <div class="moment-card">
        <div class="moment-time">Morning · 07:42</div>
        <div class="moment-title">Right after <span class="italic-word">coffee</span></div>
        <div class="moment-body">The one that used to be automatic. Keep the ritual, kick the bad.</div>
      </div>
      <div class="moment-card">
        <div class="moment-time">Midday · 11:15</div>
        <div class="moment-title">Between <span class="italic-word">meetings</span></div>
        <div class="moment-body">Three deep breaths, one pause, one reset — and you're back to it.</div>
      </div>
      <div class="moment-card">
        <div class="moment-time">Afternoon · 15:30</div>
        <div class="moment-title">The <span class="italic-word">3pm reset</span></div>
        <div class="moment-body">When the day dips and your hand starts looking for something to do.</div>
      </div>
      <div class="moment-card">
        <div class="moment-time">Evening · 19:04</div>
        <div class="moment-title">After <span class="italic-word">dinner</span></div>
        <div class="moment-body">The long-standing habit that's tied to the end of a meal. Substitute the object, keep the ritual.</div>
      </div>
      <div class="moment-card">
        <div class="moment-time">Night · 22:18</div>
        <div class="moment-title">The <span class="italic-word">wind-down</span></div>
        <div class="moment-body">Calm core, slow breath, lights low. A quiet ritual before sleep.</div>
      </div>
      <div class="moment-card">
        <div class="moment-time">Anytime · Anywhere</div>
        <div class="moment-title">When the <span class="italic-word">urge</span> arrives</div>
        <div class="moment-body">On the plane, in the meeting, at the gym, in a hotel room. No smoke, no rules.</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lio · Moments",
  "tag": "section",
  "class": "section-lio-moments",
  "settings": [],
  "presets": [{ "name": "Lio · Moments" }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
