{%- comment -%}
  Lio · Evidence dossier (rich)
  Clinical, paper-style proof block. Replaces the simple 4-card evidence.
  Content sections: header → premise → ingredient dossier → TNO testing
  → mechanism vs vape → limitations → references.

  All classes prefixed `levp-` (Lio Evidence Page) to avoid collisions.
  CSS variables scoped to .levp wrapper. Standalone-page chrome (nav,
  footer, final CTA) intentionally stripped — the lander provides those.
{%- endcomment -%}

<section class="levp" id="lio-evidence-dossier">

<style>
  /* Scoped variables + base */
  .levp {
    --levp-forest:    {{ section.settings.color_forest | default: '#0b2410' }};
    --levp-cream:     #fcfefb;
    --levp-cream-2:   #f4f7f2;
    --levp-paper:     #f8faf6;
    --levp-mint:      #94fca9;
    --levp-mint-soft: #cdfee1;
    --levp-f-04: rgba(11,36,16,0.04);
    --levp-f-06: rgba(11,36,16,0.06);
    --levp-f-08: rgba(11,36,16,0.08);
    --levp-f-10: rgba(11,36,16,0.10);
    --levp-f-22: rgba(11,36,16,0.22);
    --levp-f-40: rgba(11,36,16,0.40);
    --levp-f-55: rgba(11,36,16,0.55);
    --levp-f-72: rgba(11,36,16,0.72);
    --levp-ease: cubic-bezier(0.22,1,0.36,1);
    --levp-mono: "iA Writer Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: var(--levp-forest);
    background: var(--levp-cream);
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    line-height: 1.5;
    letter-spacing: -0.005em;
  }
  .levp *, .levp *::before, .levp *::after { box-sizing: border-box; }
  .levp ::selection { background: var(--levp-mint); color: var(--levp-forest); }
  .levp .levp-italic { font-style: italic; font-weight: 300; }

  /* Section primitive */
  .levp .levp-band { padding: 80px 40px; }
  .levp .levp-inner { max-width: 1200px; margin: 0 auto; }
  .levp .levp-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 7px 16px; border-radius: 999px;
    background: #fff; border: 1px solid var(--levp-f-10);
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    font-weight: 700; color: var(--levp-f-72); margin-bottom: 24px;
  }
  .levp .levp-eyebrow::before {
    content: ""; width: 6px; height: 6px;
    background: var(--levp-mint); border-radius: 50%;
  }
  .levp .levp-eyebrow.on-dark {
    background: rgba(252,254,251,0.06);
    border-color: rgba(252,254,251,0.12);
    color: rgba(252,254,251,0.8);
  }
  .levp .levp-h2 {
    font-weight: 900;
    font-size: clamp(30px, 4.4vw, 56px);
    line-height: 0.96; letter-spacing: -0.04em;
    margin: 0 0 18px; color: var(--levp-forest);
  }
  .levp .levp-h2.on-dark { color: var(--levp-cream); }
  .levp .levp-lede {
    font-size: 17px; line-height: 1.55;
    color: var(--levp-f-72); max-width: 620px; margin: 0;
  }
  .levp .levp-lede strong { color: var(--levp-forest); font-weight: 600; }
  .levp .levp-lede.on-dark { color: rgba(252,254,251,0.78); }
  .levp .levp-lede.on-dark strong { color: var(--levp-cream); }

  .levp .levp-ref {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 22px; height: 18px; padding: 0 6px; margin: 0 1px;
    background: var(--levp-mint-soft); color: var(--levp-forest);
    font-family: var(--levp-mono); font-size: 10px; font-weight: 700;
    border-radius: 4px; vertical-align: 2px; letter-spacing: 0.02em;
    transition: background 0.2s var(--levp-ease); cursor: pointer;
  }
  .levp .levp-ref:hover { background: var(--levp-mint); }

  /* === HERO === */
  .levp .levp-hero { padding: 64px 40px 80px; position: relative; overflow: hidden; border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-hero::before {
    content: ""; position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 88% 12%, rgba(148,252,169,0.14) 0%, transparent 45%),
      radial-gradient(circle at 8% 88%, rgba(148,252,169,0.05) 0%, transparent 38%);
    pointer-events: none;
  }
  .levp .levp-hero-inner { position: relative; max-width: 1200px; margin: 0 auto; z-index: 2; }
  .levp .levp-laurel-row {
    display: flex; align-items: center; justify-content: center;
    gap: 24px; color: var(--levp-forest); margin-bottom: 28px;
  }
  .levp .levp-laurel-row svg { width: 26px; height: 50px; }
  .levp .levp-laurel-row .levp-label {
    font-family: var(--levp-mono); font-size: 10px;
    letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--levp-f-55); font-weight: 500;
  }
  .levp .levp-h1 {
    font-weight: 900; font-size: clamp(38px, 6vw, 80px);
    line-height: 0.94; letter-spacing: -0.05em; text-align: center;
    margin: 0 auto 24px; max-width: 14ch; color: var(--levp-forest);
  }
  .levp .levp-hero-sub {
    font-size: 18px; line-height: 1.55; color: var(--levp-f-72);
    max-width: 640px; margin: 0 auto 40px; text-align: center;
  }
  .levp .levp-hero-sub strong { color: var(--levp-forest); font-weight: 600; }
  .levp .levp-hero-meta {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    border-top: 1px solid var(--levp-f-10);
    border-bottom: 1px solid var(--levp-f-10);
    margin-top: 48px;
  }
  .levp .levp-hero-meta-cell { padding: 22px 22px 22px 0; border-right: 1px solid var(--levp-f-08); }
  .levp .levp-hero-meta-cell:last-child { border-right: none; }
  .levp .levp-hero-meta-cell:first-child { padding-left: 22px; }
  .levp .levp-hero-meta-key {
    font-family: var(--levp-mono); font-size: 10px;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--levp-f-55); margin-bottom: 8px;
  }
  .levp .levp-hero-meta-val {
    font-size: 22px; font-weight: 800; letter-spacing: -0.02em;
    color: var(--levp-forest); line-height: 1.1;
  }
  .levp .levp-hero-meta-val small {
    display: block; font-size: 12px; font-weight: 400;
    color: var(--levp-f-55); margin-top: 4px; letter-spacing: 0;
  }
  @media (max-width: 768px) {
    .levp .levp-hero-meta { grid-template-columns: repeat(2, 1fr); }
    .levp .levp-hero-meta-cell:nth-child(2) { border-right: none; }
    .levp .levp-hero-meta-cell:nth-child(1),
    .levp .levp-hero-meta-cell:nth-child(2) { border-bottom: 1px solid var(--levp-f-08); }
    .levp .levp-hero { padding: 48px 24px 56px; }
  }

  /* === PREMISE === */
  .levp .levp-premise { background: var(--levp-paper); border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-premise-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; align-items: start; }
  .levp .levp-premise-thesis { position: sticky; top: 96px; }
  .levp .levp-premise-thesis .levp-h2 { max-width: 12ch; }
  .levp .levp-premise-pull {
    margin-top: 28px; padding: 22px 26px; background: #fff;
    border: 1px solid var(--levp-f-10); border-left: 3px solid var(--levp-mint);
    border-radius: 4px;
  }
  .levp .levp-premise-pull p { font-size: 16px; line-height: 1.55; color: var(--levp-forest); margin: 0; }
  .levp .levp-premise-pull cite {
    display: block; margin-top: 12px; font-family: var(--levp-mono);
    font-size: 11px; color: var(--levp-f-55); font-style: normal; letter-spacing: 0.04em;
  }
  .levp .levp-premise-points { display: flex; flex-direction: column; gap: 28px; }
  .levp .levp-premise-pt { display: grid; grid-template-columns: 56px 1fr; gap: 18px; padding-bottom: 28px; border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-premise-pt:last-child { border-bottom: none; padding-bottom: 0; }
  .levp .levp-premise-num { font-family: var(--levp-mono); font-size: 12px; letter-spacing: 0.04em; color: var(--levp-f-55); padding-top: 4px; }
  .levp .levp-premise-num strong { display: block; font-size: 22px; color: var(--levp-forest); font-weight: 800; letter-spacing: -0.01em; margin-bottom: 2px; }
  .levp .levp-premise-pt h3 { font-size: 20px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 8px; color: var(--levp-forest); }
  .levp .levp-premise-pt p { font-size: 15px; line-height: 1.6; color: var(--levp-f-72); margin: 0; }
  @media (max-width: 900px) {
    .levp .levp-premise-grid { grid-template-columns: 1fr; gap: 40px; }
    .levp .levp-premise-thesis { position: static; }
  }

  /* === DOSSIER === */
  .levp .levp-dossier-head { margin-bottom: 48px; max-width: 800px; }
  .levp .levp-dossier-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .levp .levp-dossier-card {
    background: #fff; border: 1px solid var(--levp-f-10); border-radius: 16px;
    padding: 30px 28px; display: flex; flex-direction: column;
    transition: border-color 0.25s var(--levp-ease), transform 0.25s var(--levp-ease);
  }
  .levp .levp-dossier-card:hover { border-color: var(--levp-f-22); transform: translateY(-2px); }
  .levp .levp-dossier-num { font-family: var(--levp-mono); font-size: 11px; color: var(--levp-f-40); letter-spacing: 0.18em; margin-bottom: 20px; }
  .levp .levp-dossier-latin { font-style: italic; font-weight: 300; font-size: 14px; color: var(--levp-f-55); margin-bottom: 4px; letter-spacing: -0.01em; }
  .levp .levp-dossier-name { font-size: 28px; font-weight: 900; letter-spacing: -0.03em; line-height: 1; margin-bottom: 20px; color: var(--levp-forest); }
  .levp .levp-dossier-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-dossier-chip { font-size: 11px; font-weight: 600; color: var(--levp-f-72); background: var(--levp-cream-2); padding: 4px 10px; border-radius: 999px; letter-spacing: 0.02em; }
  .levp .levp-dossier-find { font-size: 14px; line-height: 1.6; color: var(--levp-f-72); margin: 0 0 24px; flex: 1; }
  .levp .levp-dossier-find strong { color: var(--levp-forest); font-weight: 600; }
  .levp .levp-dossier-find em { font-style: italic; color: var(--levp-forest); }
  .levp .levp-dossier-cites { list-style: none; border-top: 1px solid var(--levp-f-08); padding: 18px 0 0; margin: 0; }
  .levp .levp-dossier-cites li { display: flex; gap: 10px; padding: 6px 0; font-size: 12px; line-height: 1.4; color: var(--levp-f-72); }
  .levp .levp-dossier-cites li .levp-ref { flex-shrink: 0; margin-top: 1px; }
  .levp .levp-dossier-cites li em { font-style: italic; color: var(--levp-forest); }
  @media (max-width: 900px) {
    .levp .levp-dossier-grid { grid-template-columns: 1fr; }
  }

  /* === TESTING (TNO) — dark band === */
  .levp .levp-testing {
    background: var(--levp-forest); color: var(--levp-cream);
    padding: 90px 40px; position: relative; overflow: hidden;
  }
  .levp .levp-testing::before {
    content: ""; position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 88% 18%, rgba(148,252,169,0.10) 0%, transparent 42%),
      radial-gradient(circle at 8% 92%, rgba(148,252,169,0.05) 0%, transparent 38%);
    pointer-events: none;
  }
  .levp .levp-testing-inner { max-width: 1200px; margin: 0 auto; position: relative; z-index: 2; }
  .levp .levp-testing-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 64px; align-items: start; }
  .levp .levp-testing-left .levp-h2 { max-width: 14ch; margin-bottom: 22px; }
  .levp .levp-testing-meta { display: flex; flex-direction: column; gap: 18px; padding-top: 28px; margin-top: 28px; border-top: 1px solid rgba(252,254,251,0.12); }
  .levp .levp-testing-row { display: grid; grid-template-columns: 130px 1fr; gap: 14px; font-size: 13px; line-height: 1.45; }
  .levp .levp-testing-key { font-family: var(--levp-mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(252,254,251,0.5); padding-top: 2px; }
  .levp .levp-testing-val { color: rgba(252,254,251,0.9); }
  .levp .levp-testing-val strong { color: var(--levp-cream); font-weight: 600; }
  .levp .levp-testing-tests { display: flex; flex-direction: column; }
  .levp .levp-test { padding: 24px 0; border-bottom: 1px solid rgba(252,254,251,0.10); display: grid; grid-template-columns: 1fr auto; gap: 22px; align-items: start; }
  .levp .levp-test:last-child { border-bottom: none; }
  .levp .levp-test-name { font-size: 17px; font-weight: 700; color: var(--levp-cream); margin: 0 0 6px; letter-spacing: -0.015em; }
  .levp .levp-test-desc { font-size: 13px; color: rgba(252,254,251,0.7); line-height: 1.5; margin: 0; }
  .levp .levp-test-result {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 14px; border-radius: 999px;
    font-family: var(--levp-mono); font-size: 11px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    background: rgba(148,252,169,0.12); color: var(--levp-mint);
    border: 1px solid rgba(148,252,169,0.28);
    flex-shrink: 0; margin-top: 4px; white-space: nowrap;
  }
  .levp .levp-test-result::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--levp-mint); }
  .levp .levp-testing-disclaimer { margin-top: 36px; padding: 18px 22px; background: rgba(252,254,251,0.04); border: 1px solid rgba(252,254,251,0.08); border-radius: 8px; font-size: 13px; line-height: 1.55; color: rgba(252,254,251,0.65); }
  .levp .levp-testing-disclaimer strong { color: var(--levp-cream); font-weight: 600; }
  .levp .levp-testing-disclaimer a { color: var(--levp-mint); border-bottom: 1px solid rgba(148,252,169,0.4); }
  @media (max-width: 900px) {
    .levp .levp-testing-grid { grid-template-columns: 1fr; gap: 40px; }
    .levp .levp-testing-row { grid-template-columns: 1fr; gap: 4px; }
    .levp .levp-test { grid-template-columns: 1fr; gap: 12px; }
    .levp .levp-testing { padding: 56px 24px; }
  }

  /* === SAFETY (vape vs Lio) === */
  .levp .levp-safety { padding: 90px 40px; background: var(--levp-cream-2); border-top: 1px solid var(--levp-f-08); border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-safety-head { margin-bottom: 48px; max-width: 800px; }
  .levp .levp-safety-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .levp .levp-safety-col { background: #fff; border: 1px solid var(--levp-f-10); border-radius: 16px; padding: 32px; }
  .levp .levp-safety-label { display: inline-flex; align-items: center; gap: 10px; font-family: var(--levp-mono); font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--levp-f-55); margin-bottom: 14px; }
  .levp .levp-safety-label .levp-marker { width: 8px; height: 8px; border-radius: 50%; }
  .levp .levp-safety-col.is-vape .levp-marker { background: rgba(255,138,138,0.6); }
  .levp .levp-safety-col.is-lio .levp-marker { background: var(--levp-mint); }
  .levp .levp-safety-col h3 { font-size: 26px; font-weight: 900; letter-spacing: -0.025em; line-height: 1.05; margin: 0 0 22px; color: var(--levp-forest); }
  .levp .levp-safety-flow { list-style: none; margin: 0 0 20px; padding: 0 0 20px; border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-safety-flow li { padding: 8px 0; font-size: 14px; color: var(--levp-f-72); display: flex; align-items: center; gap: 14px; }
  .levp .levp-safety-flow li .levp-step { width: 22px; height: 22px; border-radius: 50%; background: var(--levp-cream-2); color: var(--levp-forest); display: flex; align-items: center; justify-content: center; font-family: var(--levp-mono); font-size: 11px; font-weight: 700; flex-shrink: 0; border: 1px solid var(--levp-f-10); }
  .levp .levp-safety-flow li.muted .levp-step { color: rgba(255,138,138,0.85); border-color: rgba(255,138,138,0.35); background: rgba(255,138,138,0.06); }
  .levp .levp-safety-flow li.lit .levp-step { color: var(--levp-forest); background: var(--levp-mint-soft); border-color: var(--levp-mint); }
  .levp .levp-safety-out { font-size: 13px; color: var(--levp-f-55); line-height: 1.55; margin: 0; }
  .levp .levp-safety-out strong { color: var(--levp-forest); font-weight: 600; }
  .levp .levp-safety-note { margin-top: 32px; padding: 20px 22px; background: var(--levp-paper); border: 1px solid var(--levp-f-08); border-radius: 10px; font-size: 14px; line-height: 1.55; color: var(--levp-f-72); }
  .levp .levp-safety-note strong { color: var(--levp-forest); font-weight: 600; }
  @media (max-width: 900px) {
    .levp .levp-safety-grid { grid-template-columns: 1fr; }
    .levp .levp-safety { padding: 56px 24px; }
  }

  /* === LIMITS === */
  .levp .levp-limits { padding: 90px 40px; }
  .levp .levp-limits-inner { max-width: 980px; margin: 0 auto; }
  .levp .levp-limits-list { list-style: none; margin: 40px 0 0; padding: 0; }
  .levp .levp-limits-list li { display: grid; grid-template-columns: 100px 1fr; gap: 22px; padding: 26px 0; border-bottom: 1px solid var(--levp-f-08); }
  .levp .levp-limits-list li:last-child { border-bottom: none; }
  .levp .levp-limits-tag { font-family: var(--levp-mono); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--levp-f-55); padding-top: 4px; }
  .levp .levp-limits-list li h3 { font-size: 18px; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 8px; color: var(--levp-forest); }
  .levp .levp-limits-list li p { font-size: 14px; line-height: 1.6; color: var(--levp-f-72); margin: 0; }
  @media (max-width: 700px) {
    .levp .levp-limits-list li { grid-template-columns: 1fr; gap: 8px; }
    .levp .levp-limits { padding: 56px 24px; }
  }

  /* === REFERENCES === */
  .levp .levp-refs { padding: 80px 40px 96px; background: var(--levp-paper); border-top: 1px solid var(--levp-f-08); }
  .levp .levp-refs-inner { max-width: 980px; margin: 0 auto; }
  .levp .levp-refs-list { list-style: none; counter-reset: refs; margin: 40px 0 0; padding: 0; }
  .levp .levp-refs-list li { display: grid; grid-template-columns: 56px 1fr; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--levp-f-08); font-size: 13px; line-height: 1.55; color: var(--levp-f-72); transition: background 0.3s ease; }
  .levp .levp-refs-list li:last-child { border-bottom: none; }
  .levp .levp-refs-list li::before { counter-increment: refs; content: counter(refs, decimal-leading-zero); font-family: var(--levp-mono); font-size: 12px; color: var(--levp-f-40); letter-spacing: 0.04em; padding-top: 1px; }
  .levp .levp-refs-list li em { font-style: italic; color: var(--levp-forest); }
  .levp .levp-refs-list li strong { color: var(--levp-forest); font-weight: 600; }
  .levp .levp-refs-list li a { color: var(--levp-forest); border-bottom: 1px solid var(--levp-f-22); transition: border-color 0.2s var(--levp-ease); word-break: break-word; }
  .levp .levp-refs-list li a:hover { border-color: var(--levp-forest); }
  .levp .levp-refs-foot { margin-top: 36px; padding-top: 26px; border-top: 1px solid var(--levp-f-08); font-size: 13px; color: var(--levp-f-55); line-height: 1.55; }
  .levp .levp-refs-foot strong { color: var(--levp-forest); font-weight: 600; }
  @keyframes levpRefFlash {
    0%   { background: rgba(148,252,169,0); }
    20%  { background: rgba(148,252,169,0.35); }
    100% { background: rgba(148,252,169,0); }
  }
  .levp .levp-refs-list li.is-flash { animation: levpRefFlash 1.6s ease; }

  @media (max-width: 768px) {
    .levp .levp-band { padding: 56px 24px; }
  }
</style>

<!-- ============= HERO ============= -->
<div class="levp-hero">
  <div class="levp-hero-inner">
    <div class="levp-laurel-row">
