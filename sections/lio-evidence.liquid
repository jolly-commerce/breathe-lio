</section>

<script>
  /* Click an inline ref pill — smooth-scroll to the matching reference
     row and flash its background. Self-contained, no globals. */
  (function () {
    var root = document.getElementById('lio-evidence-dossier');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var pill = e.target.closest('.levp-ref[data-ref]');
      if (!pill) return;
      e.preventDefault();
      var n = pill.getAttribute('data-ref');
      var target = root.querySelector('#levp-ref-' + n);
      if (!target) return;
      var offset = window.matchMedia('(max-width: 900px)').matches ? 76 : 92;
      var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
      window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      // flash highlight
      target.classList.remove('is-flash');
      void target.offsetWidth; // restart animation
      target.classList.add('is-flash');
    });
  })();
</script>

