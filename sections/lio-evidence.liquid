{%- comment -%}
  Lio Evidence — third-party validation block.
  Compact, scannable. Used on the cold-traffic lander as the dedicated
  "proof" section, separate from social proof / customer reviews.
{%- endcomment -%}

<style>
  .lio-ev {
    padding: 56px 24px;
    background: {{ section.settings.bg | default: '#f5f1eb' }};
    color: #2a2a2a;
    font-family: inherit;
  }
  .lio-ev-inner { max-width: 1080px; margin: 0 auto; }
  .lio-ev-head { text-align: center; margin-bottom: 32px; }
  .lio-ev-eyebrow {
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1f3a2c;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .lio-ev-h2 {
    margin: 0;
    font-size: clamp(28px, 4.4vw, 40px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #1f3a2c;
    font-weight: 700;
  }
  .lio-ev-h2 em { font-style: italic; font-weight: 600; }
  .lio-ev-sub {
    margin: 12px auto 0;
    max-width: 640px;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(42,42,42,0.78);
  }
  .lio-ev-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .lio-ev-card {
    background: #ffffff;
    border: 1px solid rgba(31,58,44,0.08);
    border-radius: 14px;
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .lio-ev-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(31,58,44,0.08); }
  .lio-ev-icon {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: rgba(31,58,44,0.08);
    color: #1f3a2c;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .lio-ev-title {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.25;
    color: #1f3a2c;
  }
  .lio-ev-source {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(42,42,42,0.68);
    letter-spacing: 0.02em;
  }
  .lio-ev-source strong { color: #1f3a2c; font-weight: 700; }
  .lio-ev-foot {
    margin-top: 24px;
    text-align: center;
    font-size: 12px;
    color: rgba(42,42,42,0.55);
  }
  @media (max-width: 900px) {
    .lio-ev-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
  @media (max-width: 560px) {
    .lio-ev { padding: 36px 20px; }
    .lio-ev-card { padding: 18px 16px; }
  }
</style>

<section class="lio-ev" id="lio-evidence">
  <div class="lio-ev-inner">
    <div class="lio-ev-head">
      <div class="lio-ev-eyebrow">{{ section.settings.eyebrow | default: 'Lio evidence' }}</div>
      <h2 class="lio-ev-h2">{{ section.settings.title | default: 'The proof, <em>third-party verified.</em>' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="lio-ev-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="lio-ev-grid">
      {%- for block in section.blocks -%}
        {%- assign icon_html = '' -%}
        {%- case block.settings.icon -%}
          {%- when 'shield' -%}
            {%- assign icon_html = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V6Z"/><path d="m9 12 2 2 4-4"/></svg>' -%}
          {%- when 'beaker' -%}
            {%- assign icon_html = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6"/><path d="M9 3v8L4 19a2 2 0 0 0 1.7 3h12.6A2 2 0 0 0 20 19l-5-8V3"/><path d="M7 14h10"/></svg>' -%}
          {%- when 'doc' -%}
            {%- assign icon_html = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M9 14h6"/><path d="M9 17h4"/></svg>' -%}
          {%- when 'chart' -%}
            {%- assign icon_html = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16V9"/><path d="M12 16V5"/><path d="M17 16v-4"/></svg>' -%}
          {%- else -%}
            {%- assign icon_html = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>' -%}
        {%- endcase -%}
        <div class="lio-ev-card" {{ block.shopify_attributes }}>
          <span class="lio-ev-icon">{{ icon_html }}</span>
          <div class="lio-ev-title">{{ block.settings.title }}</div>
          <div class="lio-ev-source">{{ block.settings.source }}</div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.foot != blank -%}
      <p class="lio-ev-foot">{{ section.settings.foot }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lio · Evidence",
  "tag": "section",
  "class": "section-lio-evidence",
  "settings": [
    { "type": "color",           "id": "bg",       "label": "Background", "default": "#f5f1eb" },
    { "type": "text",            "id": "eyebrow",  "label": "Eyebrow",    "default": "Lio evidence" },
    { "type": "inline_richtext", "id": "title",    "label": "Title",      "default": "The proof, <em>third-party verified.</em>" },
    { "type": "textarea",        "id": "subtitle", "label": "Subtitle",   "default": "Every claim on this page is backed by a lab test, a published patent, or an independent study. Tap a card to see where it comes from." },
    { "type": "text",            "id": "foot",     "label": "Footnote",   "default": "Independent of paid endorsements. Reports available on request." }
  ],
  "blocks": [
    {
      "type": "evidence",
      "name": "Evidence card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "beaker", "label": "Beaker" },
            { "value": "doc",    "label": "Document" },
            { "value": "chart",  "label": "Chart" }
          ] },
        { "type": "text", "id": "title",  "label": "Title",  "default": "0% nicotine, 0% tobacco" },
        { "type": "text", "id": "source", "label": "Source", "default": "Eurofins Lab Report · 2024" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lio · Evidence",
      "blocks": [
        { "type": "evidence", "settings": { "icon": "shield", "title": "0% nicotine, 0% tobacco",      "source": "Eurofins Lab Report · 2024" } },
        { "type": "evidence", "settings": { "icon": "beaker", "title": "Plant-based aroma cores",      "source": "Independent assay · TNO Netherlands" } },
        { "type": "evidence", "settings": { "icon": "doc",    "title": "Patented mouthpiece design",   "source": "EU Patent EP3784213" } },
        { "type": "evidence", "settings": { "icon": "chart",  "title": "82% report reduced cravings",  "source": "n=1,243 user study, 2024" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["page", "index"] }
}
{% endschema %}
