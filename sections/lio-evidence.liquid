<!-- ============================ FULL DOSSIER MODAL ============================ -->
<style>
  .levp-modal {
    position: fixed; inset: 0;
    background: rgba(11, 36, 16, 0.72);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 220;
    display: none;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    --lv-mono: "iA Writer Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
  }
  .levp-modal[aria-hidden="false"] { display: flex; opacity: 1; }
  .levp-modal *, .levp-modal *::before, .levp-modal *::after { box-sizing: border-box; }
  .levp-modal-card {
    background: #fcfefb;
    color: #0b2410;
    width: 100%; max-width: 880px;
    max-height: 92vh;
    border-radius: 18px 18px 0 0;
    overflow: hidden;
    display: flex; flex-direction: column;
    transform: translateY(24px);
    transition: transform 0.3s cubic-bezier(0.22,1,0.36,1);
  }
  .levp-modal[aria-hidden="false"] .levp-modal-card { transform: translateY(0); }
  @media (min-width: 760px) {
    .levp-modal { align-items: center; padding: 24px; }
    .levp-modal-card { border-radius: 18px; }
  }
  .levp-modal-head {
    padding: 18px 22px;
    border-bottom: 1px solid rgba(11,36,16,0.08);
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px; flex-shrink: 0;
    background: #fcfefb;
    position: sticky; top: 0; z-index: 1;
  }
  .levp-modal-head h3 {
    margin: 0;
    font-size: 16px; font-weight: 800;
    color: #0b2410;
    letter-spacing: -0.01em;
  }
  .levp-modal-head h3 span {
    display: inline-block; font-family: var(--lv-mono);
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(11,36,16,0.55); margin-right: 10px; font-weight: 500;
  }
  .levp-modal-close {
    background: rgba(11,36,16,0.04); border: 0;
    width: 34px; height: 34px; border-radius: 50%;
    cursor: pointer; display: inline-flex;
    align-items: center; justify-content: center;
    color: #0b2410;
  }
  .levp-modal-close:hover { background: rgba(11,36,16,0.08); }
  .levp-modal-body {
    overflow-y: auto; flex: 1;
    padding: 0;
  }
  body.levp-modal-open { overflow: hidden; }

  /* Modal content */
  .lvm-band { padding: 36px 28px; }
  .lvm-band + .lvm-band { border-top: 1px solid rgba(11,36,16,0.08); }
  .lvm-band.dark { background: #0b2410; color: #fcfefb; }
  .lvm-band.paper { background: #f8faf6; }
  .lvm-band.cream { background: #f4f7f2; }
  @media (max-width: 600px) { .lvm-band { padding: 28px 20px; } }

  .lvm-eyebrow {
    font-family: var(--lv-mono);
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: rgba(11,36,16,0.55); font-weight: 700;
    margin-bottom: 10px;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .lvm-band.dark .lvm-eyebrow { color: rgba(252,254,251,0.6); }
  .lvm-eyebrow::before { content: ""; width: 6px; height: 6px; background: #94fca9; border-radius: 50%; }
  .lvm-h {
    font-size: clamp(22px, 3.6vw, 30px);
    line-height: 1.06; letter-spacing: -0.03em;
    margin: 0 0 12px; font-weight: 800;
  }
  .lvm-band.dark .lvm-h { color: #fcfefb; }
  .lvm-h em { font-style: italic; font-weight: 300; }
  .lvm-lede { margin: 0; font-size: 14px; line-height: 1.6; color: rgba(11,36,16,0.72); }
  .lvm-band.dark .lvm-lede { color: rgba(252,254,251,0.78); }
  .lvm-lede strong { color: #0b2410; font-weight: 600; }
  .lvm-band.dark .lvm-lede strong { color: #fcfefb; }

  /* Premise points */
  .lvm-points { margin-top: 22px; display: flex; flex-direction: column; gap: 18px; }
  .lvm-pt {
    display: grid; grid-template-columns: 44px 1fr; gap: 14px;
    padding-bottom: 18px; border-bottom: 1px solid rgba(11,36,16,0.08);
  }
  .lvm-pt:last-child { border: 0; padding-bottom: 0; }
  .lvm-pt-num {
    font-family: var(--lv-mono); font-size: 11px;
    color: rgba(11,36,16,0.55); padding-top: 3px;
  }
  .lvm-pt-num strong {
    display: block; font-size: 18px;
    color: #0b2410; font-weight: 800;
    letter-spacing: -0.01em; margin-bottom: 1px;
  }
  .lvm-pt h4 { margin: 0 0 6px; font-size: 15px; font-weight: 700; color: #0b2410; }
  .lvm-pt p { margin: 0; font-size: 13px; line-height: 1.55; color: rgba(11,36,16,0.72); }
  .lvm-ref {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 20px; height: 16px; padding: 0 5px; margin: 0 1px;
    background: #cdfee1; color: #0b2410;
    font-family: var(--lv-mono); font-size: 9px; font-weight: 700;
    border-radius: 4px; vertical-align: 2px; cursor: pointer;
    transition: background 0.2s;
  }
  .lvm-ref:hover { background: #94fca9; }

  /* Ingredient cards inside modal */
  .lvm-ing-grid { display: grid; grid-template-columns: 1fr; gap: 14px; margin-top: 20px; }
  @media (min-width: 720px) { .lvm-ing-grid { grid-template-columns: repeat(3, 1fr); } }
  .lvm-ing {
    background: #fff; border: 1px solid rgba(11,36,16,0.10); border-radius: 12px;
    padding: 18px 18px 14px;
  }
  .lvm-ing-num {
    font-family: var(--lv-mono); font-size: 10px; color: rgba(11,36,16,0.40);
    letter-spacing: 0.18em; margin-bottom: 12px;
  }
  .lvm-ing-latin { font-style: italic; font-weight: 300; font-size: 12px; color: rgba(11,36,16,0.55); margin-bottom: 2px; }
  .lvm-ing-name { font-size: 22px; font-weight: 900; letter-spacing: -0.025em; line-height: 1; margin-bottom: 14px; color: #0b2410; }
  .lvm-ing-chips { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(11,36,16,0.08); }
  .lvm-ing-chip { font-size: 10px; font-weight: 600; color: rgba(11,36,16,0.72); background: #f4f7f2; padding: 3px 8px; border-radius: 999px; }
  .lvm-ing-find { font-size: 12px; line-height: 1.55; color: rgba(11,36,16,0.72); margin: 0 0 12px; }
  .lvm-ing-find strong { color: #0b2410; font-weight: 600; }
  .lvm-ing-find em { font-style: italic; color: #0b2410; }
  .lvm-ing-cites { list-style: none; margin: 0; padding: 12px 0 0; border-top: 1px solid rgba(11,36,16,0.08); }
  .lvm-ing-cites li { display: flex; gap: 8px; padding: 4px 0; font-size: 11px; line-height: 1.4; color: rgba(11,36,16,0.72); }

  /* TNO test rows */
  .lvm-tests { margin-top: 18px; display: flex; flex-direction: column; }
  .lvm-test {
    padding: 14px 0; border-bottom: 1px solid rgba(252,254,251,0.10);
    display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: start;
  }
  .lvm-test:last-child { border: 0; }
  .lvm-test-name { font-size: 14px; font-weight: 700; color: #fcfefb; margin: 0 0 4px; }
  .lvm-test-desc { font-size: 12px; color: rgba(252,254,251,0.7); line-height: 1.5; margin: 0; }
  .lvm-test-result {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 4px 11px; border-radius: 999px;
    font-family: var(--lv-mono); font-size: 10px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    background: rgba(148,252,169,0.12); color: #94fca9;
    border: 1px solid rgba(148,252,169,0.28);
    flex-shrink: 0; white-space: nowrap;
  }
  .lvm-test-result::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: #94fca9; }
  .lvm-disc {
    margin-top: 18px; padding: 14px 16px;
    background: rgba(252,254,251,0.04); border: 1px solid rgba(252,254,251,0.08);
    border-radius: 8px; font-size: 12px; line-height: 1.55; color: rgba(252,254,251,0.65);
  }
  .lvm-disc strong { color: #fcfefb; }
  .lvm-disc a { color: #94fca9; border-bottom: 1px solid rgba(148,252,169,0.4); text-decoration: none; }

  /* Safety side-by-side */
  .lvm-safety { display: grid; grid-template-columns: 1fr; gap: 12px; margin-top: 18px; }
  @media (min-width: 720px) { .lvm-safety { grid-template-columns: 1fr 1fr; } }
  .lvm-safety-col { background: #fff; border: 1px solid rgba(11,36,16,0.10); border-radius: 12px; padding: 18px; }
  .lvm-safety-label { display: inline-flex; align-items: center; gap: 8px; font-family: var(--lv-mono); font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(11,36,16,0.55); margin-bottom: 10px; }
  .lvm-marker { width: 8px; height: 8px; border-radius: 50%; }
  .lvm-safety-col.is-vape .lvm-marker { background: rgba(255,138,138,0.6); }
  .lvm-safety-col.is-lio .lvm-marker { background: #94fca9; }
  .lvm-safety-col h4 { margin: 0 0 12px; font-size: 18px; font-weight: 900; letter-spacing: -0.02em; line-height: 1.05; color: #0b2410; }
  .lvm-flow { list-style: none; margin: 0 0 12px; padding: 0 0 12px; border-bottom: 1px solid rgba(11,36,16,0.08); }
  .lvm-flow li { padding: 5px 0; font-size: 12px; color: rgba(11,36,16,0.72); display: flex; align-items: center; gap: 10px; }
  .lvm-step { width: 18px; height: 18px; border-radius: 50%; background: #f4f7f2; color: #0b2410; display: flex; align-items: center; justify-content: center; font-family: var(--lv-mono); font-size: 9px; font-weight: 700; flex-shrink: 0; border: 1px solid rgba(11,36,16,0.10); }
  .lvm-flow li.muted .lvm-step { color: rgba(255,138,138,0.85); border-color: rgba(255,138,138,0.35); background: rgba(255,138,138,0.06); }
  .lvm-flow li.lit .lvm-step { color: #0b2410; background: #cdfee1; border-color: #94fca9; }
  .lvm-out { font-size: 11px; color: rgba(11,36,16,0.55); line-height: 1.5; margin: 0; }
  .lvm-out strong { color: #0b2410; font-weight: 600; }

  /* Limits */
  .lvm-limits { list-style: none; margin: 18px 0 0; padding: 0; }
  .lvm-limits li {
    display: grid; grid-template-columns: 80px 1fr; gap: 14px;
    padding: 14px 0; border-bottom: 1px solid rgba(11,36,16,0.08);
  }
  .lvm-limits li:last-child { border: 0; }
  .lvm-limits-tag { font-family: var(--lv-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(11,36,16,0.55); padding-top: 2px; }
  .lvm-limits li h4 { margin: 0 0 4px; font-size: 14px; font-weight: 700; color: #0b2410; }
  .lvm-limits li p { margin: 0; font-size: 12px; line-height: 1.55; color: rgba(11,36,16,0.72); }
  @media (max-width: 580px) {
    .lvm-limits li { grid-template-columns: 1fr; gap: 4px; }
  }

  /* References */
  .lvm-refs { list-style: none; counter-reset: lvmrefs; margin: 16px 0 0; padding: 0; }
  .lvm-refs li {
    display: grid; grid-template-columns: 36px 1fr; gap: 12px;
    padding: 10px 0; border-bottom: 1px solid rgba(11,36,16,0.08);
    font-size: 12px; line-height: 1.5; color: rgba(11,36,16,0.72);
  }
  .lvm-refs li:last-child { border: 0; }
  .lvm-refs li::before {
    counter-increment: lvmrefs;
    content: counter(lvmrefs, decimal-leading-zero);
    font-family: var(--lv-mono); font-size: 11px;
    color: rgba(11,36,16,0.40); padding-top: 1px;
  }
  .lvm-refs li strong { color: #0b2410; font-weight: 600; }
  .lvm-refs li em { font-style: italic; color: #0b2410; }
  .lvm-refs li a { color: #0b2410; border-bottom: 1px solid rgba(11,36,16,0.22); text-decoration: none; word-break: break-word; }
  @keyframes lvmFlash {
    0% { background: rgba(148,252,169,0); }
    20% { background: rgba(148,252,169,0.4); }
    100% { background: rgba(148,252,169,0); }
  }
  .lvm-refs li.is-flash { animation: lvmFlash 1.4s ease; }
</style>

<div class="levp-modal" id="levp-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="levp-modal-title">
  <div class="levp-modal-card">
    <div class="levp-modal-head">
      <h3 id="levp-modal-title"><span>Lio Evidence</span> The dossier</h3>
      <button type="button" class="levp-modal-close" data-lv-close aria-label="Close">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12"/></svg>
      </button>
    </div>
    <div class="levp-modal-body">

      <!-- PREMISE -->
      <section class="lvm-band paper">
        <span class="lvm-eyebrow">The premise</span>
        <h3 class="lvm-h">A habit isn't only chemical. <em>It's also a ritual.</em></h3>
        <p class="lvm-lede">Decades of cessation research show that the behavioral and sensorimotor components of a habit — the hand-to-mouth motion, the breath, the throat sensation, the scent — drive cravings independently of any active drug.</p>
        <div class="lvm-points">
          <div class="lvm-pt"><div class="lvm-pt-num"><strong>01</strong>Behavioral</div><div><h4>The ritual is roughly half the habit.</h4><p>Rose &amp; Behm (Duke, 1994): 48 abstinent smokers, three conditions (black-pepper inhaler / mint-menthol / empty). The black-pepper group reported significantly reduced craving and withdrawal versus the empty control — without nicotine being delivered. <span class="lvm-ref" data-ref="1">1</span></p></div></div>
          <div class="lvm-pt"><div class="lvm-pt-num"><strong>02</strong>Olfactory</div><div><h4>Pleasant scents reduce peak urge.</h4><p>Sayette &amp; Parrott (1999) and a 2019 follow-up replication (n=232, Pittsburgh/Brown) confirmed that an olfactory cue at peak craving produces a measurable, sustained drop in self-reported urge. <span class="lvm-ref" data-ref="2">2</span><span class="lvm-ref" data-ref="3">3</span></p></div></div>
          <div class="lvm-pt"><div class="lvm-pt-num"><strong>03</strong>Substitution</div><div><h4>Sensorimotor replacement is its own treatment category.</h4><p>The UK NHS has trialed de-nicotinised cigarettes specifically because the act, the breath, and the throat sensation matter <em>independently</em> of nicotine. <span class="lvm-ref" data-ref="4">4</span> Lio applies the same principle without combustion or any active drug.</p></div></div>
          <div class="lvm-pt"><div class="lvm-pt-num"><strong>04</strong>Mechanism</div><div><h4>Aromatherapy shows a small but consistent effect.</h4><p>Cordell &amp; Buckle (2013, n=20) and Yılmaz &amp; Karadağ (2022, n=58) reported reduced nicotine craving following short olfactory exposure to black-pepper or angelica essential oil. <span class="lvm-ref" data-ref="5">5</span><span class="lvm-ref" data-ref="6">6</span> Modest, but real.</p></div></div>
        </div>
      </section>

      <!-- INGREDIENT DOSSIER -->
      <section class="lvm-band">
        <span class="lvm-eyebrow">Ingredient dossier</span>
        <h3 class="lvm-h">Three plants. <em>All studied. All cited.</em></h3>
        <p class="lvm-lede">Each ingredient was selected because of independently published research on inhalation and craving — not because of how it tastes.</p>

        <div class="lvm-ing-grid">
          <article class="lvm-ing">
            <div class="lvm-ing-num">01 / 03</div>
            <div class="lvm-ing-latin">Mentha × piperita</div>
            <div class="lvm-ing-name">Peppermint</div>
            <div class="lvm-ing-chips"><span class="lvm-ing-chip">Cooling</span><span class="lvm-ing-chip">Menthol</span><span class="lvm-ing-chip">Throat hit</span><span class="lvm-ing-chip">Alertness</span></div>
            <p class="lvm-ing-find"><strong>Hirsch (2008)</strong> at the Smell &amp; Taste Treatment Foundation found peppermint inhalation correlated with ~2,700 fewer calories and lower hunger ratings. <strong>Kennedy et al. (2018)</strong> in <em>Nutrients</em> reported improved cognitive performance at higher peppermint doses. The cooling sensation closely mimics the menthol throat-hit familiar to most former vape users.</p>
            <ul class="lvm-ing-cites">
              <li><span class="lvm-ref" data-ref="7">7</span> Hirsch, A. R. (2008).</li>
              <li><span class="lvm-ref" data-ref="8">8</span> Kennedy et al. (2018), Nutrients 10(8).</li>
              <li><span class="lvm-ref" data-ref="9">9</span> Kazemi et al. (2024).</li>
            </ul>
          </article>
          <article class="lvm-ing">
            <div class="lvm-ing-num">02 / 03</div>
            <div class="lvm-ing-latin">Piper nigrum</div>
            <div class="lvm-ing-name">Black Pepper</div>
            <div class="lvm-ing-chips"><span class="lvm-ing-chip">Warming</span><span class="lvm-ing-chip">Earthy</span><span class="lvm-ing-chip">Throat hit</span><span class="lvm-ing-chip">Most-cited</span></div>
            <p class="lvm-ing-find">The most directly relevant ingredient. <strong>Rose &amp; Behm (1994)</strong> at Duke ran the foundational randomized study (n=48, 3 conditions). <strong>Cordell &amp; Buckle (2013)</strong> extended it to a US cohort. <strong>Yılmaz &amp; Karadağ (2022)</strong> confirmed in a randomized pilot (n=58).</p>
            <ul class="lvm-ing-cites">
              <li><span class="lvm-ref" data-ref="1">1</span> Rose &amp; Behm (1994), <em>Drug Alcohol Depend.</em></li>
              <li><span class="lvm-ref" data-ref="5">5</span> Cordell &amp; Buckle (2013).</li>
              <li><span class="lvm-ref" data-ref="6">6</span> Yılmaz &amp; Karadağ (2022).</li>
            </ul>
          </article>
          <article class="lvm-ing">
            <div class="lvm-ing-num">03 / 03</div>
            <div class="lvm-ing-latin">Eucalyptus globulus</div>
            <div class="lvm-ing-name">Eucalyptus</div>
            <div class="lvm-ing-chips"><span class="lvm-ing-chip">Crisp</span><span class="lvm-ing-chip">Respiratory</span><span class="lvm-ing-chip">1,8-cineole</span><span class="lvm-ing-chip">Calming</span></div>
            <p class="lvm-ing-find">Dominated by <strong>1,8-cineole</strong>, studied for over forty years for its respiratory and cognitive effects. A 2017 review summarized inhalation safety and documented anti-inflammatory and mucolytic actions. In Lio it serves a sensory role at concentrations far below therapeutic levels.</p>
            <ul class="lvm-ing-cites">
              <li><span class="lvm-ref" data-ref="10">10</span> Sadlon &amp; Lamson (2010).</li>
              <li><span class="lvm-ref" data-ref="11">11</span> Caldas et al. (2015).</li>
            </ul>
          </article>
        </div>
      </section>

      <!-- TNO -->
      <section class="lvm-band dark">
        <span class="lvm-eyebrow">Independent ingredient testing</span>
        <h3 class="lvm-h">We sent it to TNO. <em>Then we read the report.</em></h3>
        <p class="lvm-lede">We commissioned an independent toxicological assessment at <strong>TNO</strong>, the Netherlands Organisation for Applied Scientific Research. The report identified <strong>17 naturally-occurring aromatic compounds</strong> — all from essential oils such as peppermint, eucalyptus, and citrus (menthol, eucalyptol, menthone, limonene, α-pinene, etc.). Every finding below is taken directly from that report. <span class="lvm-ref" data-ref="12">12</span></p>
        <div class="lvm-tests">
          <div class="lvm-test"><div><div class="lvm-test-name">Combustion · heating · vapor</div><p class="lvm-test-desc">No burning, no heating element, no aerosolisation — confirmed in the report intro.</p></div><span class="lvm-test-result">None present</span></div>
          <div class="lvm-test"><div><div class="lvm-test-name">CMR-classified substances</div><p class="lvm-test-desc">Carcinogenic, mutagenic, or reprotoxic substances per Dutch Ministry of Social Affairs &amp; Employment (SZW) classification.</p></div><span class="lvm-test-result">Zero</span></div>
          <div class="lvm-test"><div><div class="lvm-test-name">DNEL safety thresholds</div><p class="lvm-test-desc">Estimated daily exposure vs. European Derived No-Effect Levels — the regulatory safety reference values.</p></div><span class="lvm-test-result">≥ 10× below</span></div>
          <div class="lvm-test"><div><div class="lvm-test-name">8-hour occupational exposure limits</div><p class="lvm-test-desc">Time-weighted limits applied to a full working-day exposure scenario.</p></div><span class="lvm-test-result">Below all</span></div>
          <div class="lvm-test"><div><div class="lvm-test-name">Limonene (long-term, year-round)</div><p class="lvm-test-desc">Daily-use scenario assessed against the indicative Maximum Permissible Risk (MTR) for general-population air quality.</p></div><span class="lvm-test-result">Below MTR</span></div>
          <div class="lvm-test"><div><div class="lvm-test-name">Compounds identified</div><p class="lvm-test-desc">All 17 are naturally-occurring aromatic molecules from essential oils (peppermint, eucalyptus, citrus).</p></div><span class="lvm-test-result">17 natural</span></div>
        </div>
        {%- assign lvm_email = 'hello@breathelio.com' -%}
        {%- if template.suffix == 'theliokit' -%}{%- assign lvm_email = 'support@breathelio.com' -%}{%- endif -%}
        <div class="lvm-disc"><strong>Important:</strong> An ingredient test confirms what is — and is not — present. It does <em>not</em> establish efficacy as a medical treatment. Lio is a wellness device. Reports available from <a href="mailto:{{ lvm_email }}">{{ lvm_email }}</a>.</div>
      </section>

      <!-- SAFETY -->
      <section class="lvm-band cream">
        <span class="lvm-eyebrow">Mechanism &amp; safety</span>
        <h3 class="lvm-h">No heat. No vapor. <em>No combustion.</em></h3>
        <p class="lvm-lede">Most safety questions about Lio come from people who've read about vape toxicology. Those concerns apply to a different category of device.</p>
        <div class="lvm-safety">
          <div class="lvm-safety-col is-vape">
            <div class="lvm-safety-label"><span class="lvm-marker"></span> A vape</div>
            <h4>Aerosolizes a heated liquid</h4>
            <ul class="lvm-flow">
              <li class="muted"><span class="lvm-step">1</span> Battery powers a heating coil</li>
              <li class="muted"><span class="lvm-step">2</span> Coil heats e-liquid to ~200–300°C</li>
              <li class="muted"><span class="lvm-step">3</span> Liquid aerosolizes into vapor</li>
              <li class="muted"><span class="lvm-step">4</span> User inhales aerosol particles</li>
              <li class="muted"><span class="lvm-step">5</span> Vapor exits the user's lungs</li>
            </ul>
            <p class="lvm-out"><strong>What enters the lungs:</strong> aerosolized propylene glycol, glycerin, nicotine (in most), heated flavorants. <span class="lvm-ref" data-ref="13">13</span><span class="lvm-ref" data-ref="14">14</span></p>
          </div>
          <div class="lvm-safety-col is-lio">
            <div class="lvm-safety-label"><span class="lvm-marker"></span> Lio</div>
            <h4>Passes air across a fiber matrix</h4>
            <ul class="lvm-flow">
              <li class="lit"><span class="lvm-step">1</span> User inhales through the wooden barrel</li>
              <li class="lit"><span class="lvm-step">2</span> Air flows across an oil-infused core</li>
              <li class="lit"><span class="lvm-step">3</span> Air picks up plant aromatic molecules</li>
              <li class="lit"><span class="lvm-step">4</span> Scent travels on the user's own breath</li>
              <li class="lit"><span class="lvm-step">5</span> Nothing exits the user's mouth</li>
            </ul>
            <p class="lvm-out"><strong>What enters the lungs:</strong> ambient air carrying volatile aromatic compounds — the same molecules diffused in any aromatherapy room.</p>
          </div>
        </div>
      </section>

      <!-- LIMITS -->
      <section class="lvm-band">
        <span class="lvm-eyebrow">What the evidence does not say</span>
        <h3 class="lvm-h">Things <em>we will not claim.</em></h3>
        <ul class="lvm-limits">
          <li><span class="lvm-limits-tag">Limit 01</span><div><h4>Lio is not a smoking-cessation drug.</h4><p>Not submitted to FDA, EMA, or equivalent. Lio is registered in the EU as a wellness and aromatherapy device.</p></div></li>
          <li><span class="lvm-limits-tag">Limit 02</span><div><h4>The cited studies are small.</h4><p>The Rose &amp; Behm trial had 48 participants. Cordell &amp; Buckle had 20. Pilot-scale, not phase-3. Direction is consistent across thirty years of replication; effect sizes are modest.</p></div></li>
          <li><span class="lvm-limits-tag">Limit 03</span><div><h4>It will not work for everyone.</h4><p>Lio addresses the sensorimotor-and-scent layer. Heavy chemical dependence or social-context triggers may need professional support. Our 30-day return policy exists for that.</p></div></li>
          <li><span class="lvm-limits-tag">Limit 04</span><div><h4>Long-term inhalation data is incomplete.</h4><p>Compounds Lio uses are food-safe and IFRA-certified, but no 20-year cohort study has been run on a product like this. We will update when better data exists.</p></div></li>
          <li><span class="lvm-limits-tag">Limit 05</span><div><h4>We are the manufacturer. We have an interest.</h4><p>Read the originals before forming a view. Every reference is publicly searchable.</p></div></li>
        </ul>
      </section>

      <!-- REFERENCES -->
      <section class="lvm-band paper">
        <span class="lvm-eyebrow">References · 14 sources</span>
        <h3 class="lvm-h">Cited in full.</h3>
        <p class="lvm-lede">Tap any inline reference above to jump here.</p>
        <ol class="lvm-refs">
          <li id="lvm-ref-1"><strong>Rose, J. E., &amp; Behm, F. M. (1994).</strong> <em>Inhalation of vapor from black pepper extract reduces smoking withdrawal symptoms.</em> Drug Alcohol Depend., 34(3), 225–229.</li>
          <li id="lvm-ref-2"><strong>Sayette et al. (2019).</strong> Olfactory cue replication, n=232, Pittsburgh/Brown.</li>
          <li id="lvm-ref-3"><strong>Sayette &amp; Parrott (1999).</strong> <em>Effects of olfactory stimuli on urge reduction in smokers.</em> Exp. Clin. Psychopharmacol., 7(2), 151–159.</li>
          <li id="lvm-ref-4"><strong>Rose, J. E., et al. (1985–2006 series).</strong> Sensory aspects of smoking and de-nicotinised cigarette trials; UK NHS reviews.</li>
          <li id="lvm-ref-5"><strong>Cordell, B., &amp; Buckle, J. (2013).</strong> J. Altern. Complement. Med., 19(8), 709–713.</li>
          <li id="lvm-ref-6"><strong>Yılmaz, D., &amp; Karadağ, A. (2022).</strong> Randomized pilot trial on nicotine craving, n=58.</li>
          <li id="lvm-ref-7"><strong>Hirsch, A. R. (2008).</strong> <em>Effects of peppermint scent on appetite control and caloric intake.</em></li>
          <li id="lvm-ref-8"><strong>Kennedy, D. O., et al. (2018).</strong> <em>Volatile terpenes and brain function.</em> Nutrients, 10(8), 1029.</li>
          <li id="lvm-ref-9"><strong>Kazemi, A., et al. (2024).</strong> <em>Peppermint and menthol: review.</em> Crit. Rev. Food Sci. Nutr.</li>
          <li id="lvm-ref-10"><strong>Sadlon, A. E., &amp; Lamson, D. W. (2010).</strong> <em>Immune-modifying and antimicrobial effects of Eucalyptus oil.</em> Altern. Med. Rev., 15(1), 33–47.</li>
          <li id="lvm-ref-11"><strong>Caldas, G. F. R., et al. (2015).</strong> Therapeutic profile of <em>Eucalyptus globulus</em> essential oil.</li>
          {%- if template.suffix == 'theliokit' -%}
            <li id="lvm-ref-12"><strong>TNO.</strong> <a href="https://www.tno.nl" target="_blank" rel="noopener">tno.nl</a></li>
          {%- else -%}
            <li id="lvm-ref-12"><strong>TNO.</strong> Established by Dutch Parliament, 1932. <a href="https://www.tno.nl" target="_blank" rel="noopener">tno.nl</a></li>
          {%- endif -%}
          <li id="lvm-ref-13"><strong>National Academies of Sciences, Engineering, and Medicine. (2018).</strong> <em>Public Health Consequences of E-Cigarettes.</em></li>
          <li id="lvm-ref-14"><strong>Goniewicz, M. L., et al. (2014).</strong> <em>Levels of selected carcinogens and toxicants in vapour from electronic cigarettes.</em> Tob. Control, 23(2), 133–139.</li>
        </ol>
      </section>

    </div>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById('levp-modal');
    var openBtns = document.querySelectorAll('[data-lv-open]');
    if (!modal || !openBtns.length) return;

    function open () {
      modal.setAttribute('aria-hidden', 'false');
      document.body.classList.add('levp-modal-open');
    }
    function close () {
      modal.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('levp-modal-open');
    }

    openBtns.forEach(function (b) { b.addEventListener('click', open); });

    modal.addEventListener('click', function (e) {
      if (e.target === modal) close();
      if (e.target.closest('[data-lv-close]')) close();
      // ref pill smooth-scroll within modal body
      var pill = e.target.closest('.lvm-ref[data-ref]');
      if (pill) {
        var n = pill.getAttribute('data-ref');
        var target = modal.querySelector('#lvm-ref-' + n);
        if (!target) return;
        var body = modal.querySelector('.levp-modal-body');
        var y = target.offsetTop - 64;
        body.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
        target.classList.remove('is-flash');
        void target.offsetWidth;
        target.classList.add('is-flash');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal.getAttribute('aria-hidden') === 'false') close();
    });
  })();
</script>

