{%- comment -%}
  Lio · Evidence — compact visible section + full dossier in modal.
  Visible: 4 proof claims + "Read the full dossier" CTA.
  Modal: premise · ingredient dossier · TNO · mechanism · limitations · refs.
  All CSS scoped under .levp / .levp-modal.
{%- endcomment -%}

<section class="levp" id="lio-evidence-block">

<style>
  .levp {
    --lv-forest:    {{ section.settings.color_forest | default: '#0b2410' }};
    --lv-cream:     #fcfefb;
    --lv-cream-2:   #f4f7f2;
    --lv-paper:     #f8faf6;
    --lv-mint:      #94fca9;
    --lv-mint-soft: #cdfee1;
    --lv-f-08: rgba(11,36,16,0.08);
    --lv-f-10: rgba(11,36,16,0.10);
    --lv-f-22: rgba(11,36,16,0.22);
    --lv-f-40: rgba(11,36,16,0.40);
    --lv-f-55: rgba(11,36,16,0.55);
    --lv-f-72: rgba(11,36,16,0.72);
    --lv-mono: "iA Writer Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    background: {{ section.settings.bg | default: '#ffffff' }};
    color: var(--lv-forest);
    font-family: "sofia-pro", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
    padding: 56px 24px;
  }
  .levp *, .levp *::before, .levp *::after { box-sizing: border-box; }
  .levp .lv-italic { font-style: italic; font-weight: 300; }

  .levp .lv-inner { max-width: 1080px; margin: 0 auto; }
  .levp .lv-head { text-align: center; margin-bottom: 28px; }
  .levp .lv-laurel {
    display: inline-flex; align-items: center; justify-content: center;
    gap: 14px;
    color: var(--lv-forest);
    margin-bottom: 14px;
  }
  .levp .lv-laurel svg { width: 22px; height: 44px; opacity: 0.9; }
  .levp .lv-laurel-mark {
    font-family: var(--lv-mono);
    font-size: 10px; letter-spacing: 0.32em;
    text-transform: uppercase; color: var(--lv-f-55);
    font-weight: 700;
  }
  .levp .lv-eyebrow {
    font-family: var(--lv-mono);
    font-size: 11px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--lv-f-55);
    font-weight: 700; margin-bottom: 12px;
    display: none; /* superseded by laurel mark */
  }
  .levp .lv-h2 {
    margin: 0 0 10px;
    font-size: clamp(26px, 4.2vw, 40px);
    line-height: 1.05; letter-spacing: -0.03em;
    color: var(--lv-forest); font-weight: 800;
  }
  .levp .lv-sub {
    margin: 0 auto; max-width: 540px;
    font-size: 14px; line-height: 1.55;
    color: var(--lv-f-72);
  }

  .levp .lv-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 28px;
  }
  .levp .lv-card {
    background: #fff;
    border: 1px solid var(--lv-f-10);
    border-radius: 12px;
    padding: 18px 16px;
    display: flex; flex-direction: column; gap: 8px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .levp .lv-card:hover { border-color: var(--lv-f-22); transform: translateY(-2px); }
  .levp .lv-icon {
    width: 30px; height: 30px;
    border-radius: 8px;
    background: var(--lv-mint-soft);
    color: var(--lv-forest);
    display: inline-flex; align-items: center; justify-content: center;
  }
  .levp .lv-title {
    font-weight: 700; font-size: 13px;
    line-height: 1.25; color: var(--lv-forest);
  }
  .levp .lv-source {
    font-size: 11px; line-height: 1.4;
    color: var(--lv-f-55); letter-spacing: 0.01em;
  }

  .levp .lv-cta-row {
    display: flex; justify-content: center; align-items: center;
    gap: 14px; flex-wrap: wrap;
    margin-top: 28px;
  }
  .levp .lv-readmore {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--lv-forest); color: var(--lv-cream);
    padding: 12px 20px;
    border: 0; border-radius: 999px;
    font-size: 13px; font-weight: 700;
    cursor: pointer; font-family: inherit;
    transition: background 0.2s;
  }
  .levp .lv-readmore:hover { background: #143b21; }
  .levp .lv-readmore svg { width: 14px; height: 14px; }
  .levp .lv-foot {
    font-size: 11px; color: var(--lv-f-55);
    letter-spacing: 0.04em;
  }

  /* Mobile compaction */
  @media (max-width: 768px) {
    .levp { padding: 40px 16px; }
    .levp .lv-grid { grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 22px; }
    .levp .lv-card { padding: 14px 12px; }
    .levp .lv-title { font-size: 12px; }
    .levp .lv-source { font-size: 10px; }
    .levp .lv-readmore { padding: 11px 18px; font-size: 12px; }
  }
  @media (max-width: 380px) {
    .levp .lv-grid { grid-template-columns: 1fr; }
  }
</style>

