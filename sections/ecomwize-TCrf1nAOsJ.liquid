{% schema %}
{
  "name": "FAQ 01",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Common questions</p>"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Everything you need to know about getting better sleep with Deep 8.</p>"
    },
    {
      "type": "header",
      "content": "FAQ 1"
    },
    {
      "type": "text",
      "id": "faq_1_question",
      "label": "Question 1",
      "default": "What is in Deep 8?"
    },
    {
      "type": "textarea",
      "id": "faq_1_answer",
      "label": "Answer 1",
      "default": "Deep 8 contains six clinically studied ingredients: Magnesium glycinate, L-Theanine, Ashwagandha, GABA, Valerian root, and Passion flower. All natural, no synthetic compounds."
    },
    {
      "type": "header",
      "content": "FAQ 2"
    },
    {
      "type": "text",
      "id": "faq_2_question",
      "label": "Question 2",
      "default": "How do I take it?"
    },
    {
      "type": "textarea",
      "id": "faq_2_answer",
      "label": "Answer 2",
      "default": "Take one serving 30 minutes before bed with water. Most people feel a gentle wave of relaxation within 20 minutes. For best results, dim lights and avoid screens."
    },
    {
      "type": "header",
      "content": "FAQ 3"
    },
    {
      "type": "text",
      "id": "faq_3_question",
      "label": "Question 3",
      "default": "Is it right for me?"
    },
    {
      "type": "textarea",
      "id": "faq_3_answer",
      "label": "Answer 3",
      "default": "Deep 8 works for adults of all ages who struggle with falling asleep, staying asleep, or waking up groggy. If pregnant or nursing, consult your doctor first."
    },
    {
      "type": "header",
      "content": "FAQ 4"
    },
    {
      "type": "text",
      "id": "faq_4_question",
      "label": "Question 4",
      "default": "Is it gluten-free and clean?"
    },
    {
      "type": "textarea",
      "id": "faq_4_answer",
      "label": "Answer 4",
      "default": "Yes. Deep 8 is 100% natural with no gluten, dairy, soy, or artificial additives. Just pure, clinically studied botanicals."
    },
    {
      "type": "header",
      "content": "FAQ 5"
    },
    {
      "type": "text",
      "id": "faq_5_question",
      "label": "Question 5",
      "default": "What are the main benefits?"
