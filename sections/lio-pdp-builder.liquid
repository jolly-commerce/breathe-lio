          <li title="Klarna"><svg viewBox="0 0 40 24" width="34" height="20" fill="none" aria-hidden="true"><rect width="40" height="24" rx="3" fill="#ffb3c7"/><text x="20" y="16" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" font-weight="800" fill="#0a0a0a">Klarna</text></svg></li>
          <li title="Apple Pay"><svg viewBox="0 0 40 24" width="34" height="20" fill="none" aria-hidden="true"><rect width="40" height="24" rx="3" fill="#000"/><text x="20" y="16" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" font-weight="700" fill="#fff">Pay</text></svg></li>
          <li title="Visa"><svg viewBox="0 0 40 24" width="34" height="20" fill="none" aria-hidden="true"><rect width="40" height="24" rx="3" fill="#fff" stroke="currentColor" stroke-opacity="0.15"/><text x="20" y="16" text-anchor="middle" font-family="system-ui,sans-serif" font-size="9" font-weight="800" fill="#1a1f71">VISA</text></svg></li>
          <li title="Mastercard"><svg viewBox="0 0 40 24" width="34" height="20" fill="none" aria-hidden="true"><rect width="40" height="24" rx="3" fill="#fff" stroke="currentColor" stroke-opacity="0.15"/><circle cx="17" cy="12" r="5" fill="#eb001b"/><circle cx="23" cy="12" r="5" fill="#f79e1b" fill-opacity="0.85"/></svg></li>
