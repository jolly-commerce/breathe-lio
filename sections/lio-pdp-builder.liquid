          <button type="button" class="lio-addon" data-addon="travel-pouch" data-price="{{ section.settings.addon_travel_pouch_price | default: 9.95 }}" aria-pressed="false">
            <span class="lio-addon-img"><span class="lio-addon-img-emoji" aria-hidden="true">{{ section.settings.addon_travel_pouch_emoji | default: '👜' }}</span></span>
            <span class="lio-addon-name">{{ section.settings.addon_travel_pouch_name | default: 'Travel Pouch' }}</span>
            <span class="lio-addon-price">€{{ section.settings.addon_travel_pouch_price | default: '9.95' }}</span>
