    <div class="lio-device-modal-card">
      <button type="button" class="lio-flavor-modal-close" data-device-modal-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <div class="lio-device-modal-head">
        <h3 class="lio-device-modal-title" id="lio-device-modal-title">{{ section.settings.device_modal_title | default: 'Lio Plus or Lio Pro?' }}</h3>
        <p class="lio-device-modal-sub">{{ section.settings.device_modal_sub | default: "One does the inhale. One does the inhale and gives your hands something to do." }}</p>
      </div>
      <div class="lio-device-compare">
        <div class="lio-device-compare-col">
          <span class="lio-device-compare-tag is-plus" aria-hidden="true">●</span>
          <div class="lio-device-compare-img">
            <img src="{{ section.settings.device_modal_plus_image | default: 'https://cdn.shopify.com/s/files/1/0659/6676/8379/files/ChatGPT_Image_Apr_26_2026_07_08_56_PM_4_-Photoroom.png?v=1777207154' }}" alt="{{ section.settings.device_plus_name | default: 'Lio Plus' | escape }}" width="200" height="200" loading="lazy" decoding="async">
          </div>
          <h4 class="lio-device-compare-name">{{ section.settings.device_plus_name | default: 'Lio Plus' }}</h4>
          <p class="lio-device-compare-line">{{ section.settings.device_modal_plus_line | default: 'Replaces the inhale. Period.' }}</p>
          <ul class="lio-device-compare-list">
            <li>Adjustable airflow (<strong>FlowDots</strong>)</li>
            <li>Standard cores</li>
            <li>Clean stainless steel interior</li>
            <li>Simple, functional feel</li>
          </ul>
          <div class="lio-device-compare-foot">
            {%- assign plus_sub2 = section.settings.device_plus_sub_price | default: '29.95' -%}
            {%- assign plus_otp2 = section.settings.device_plus_otp_price | default: '29.95' -%}
            <span class="lio-device-compare-price">€{{ plus_sub2 }}{%- if plus_sub2 != plus_otp2 -%}<small>/mo on sub</small>{%- endif -%}</span>
            {%- if plus_sub2 != plus_otp2 -%}<span class="lio-device-compare-strike">€{{ plus_otp2 }} one-time</span>{%- endif -%}
          </div>
          <button type="button" class="lio-device-compare-pick" data-device-pick="plus">{{ section.settings.device_modal_pick_plus | default: 'Pick Lio Plus' }}</button>
        </div>
        <div class="lio-device-compare-col is-pro">
          <span class="lio-device-compare-tag is-pro" aria-hidden="true">●</span>
          <div class="lio-device-compare-img">
            <img src="{{ section.settings.device_modal_pro_image | default: 'https://cdn.shopify.com/s/files/1/0659/6676/8379/files/Lio_Pro_1.png?v=1777207149' }}" alt="{{ section.settings.device_pro_name | default: 'Lio Pro' | escape }}" width="200" height="200" loading="lazy" decoding="async">
          </div>
          <h4 class="lio-device-compare-name">{{ section.settings.device_pro_name | default: 'Lio Pro' }}</h4>
          <p class="lio-device-compare-line">{{ section.settings.device_modal_pro_line | default: 'Replaces the moment — hands + inhale.' }}</p>
          <ul class="lio-device-compare-list">
            <li>Adjustable airflow (<strong>refined system</strong>)</li>
            <li><strong>Magnetic fidget</strong> — rotate / play in hand</li>
            <li><strong>Premium plated metal core</strong> (smoother, weighted)</li>
            <li><strong>Hollow Pro cores</strong> — more controlled airflow</li>
          </ul>
          <div class="lio-device-compare-foot">
            {%- assign pro_sub2 = section.settings.device_pro_sub_price | default: '79.95' -%}
            {%- assign pro_otp2 = section.settings.device_pro_otp_price | default: '79.95' -%}
            <span class="lio-device-compare-price">€{{ pro_sub2 }}{%- if pro_sub2 != pro_otp2 -%}<small>/mo on sub</small>{%- endif -%}</span>
            {%- if pro_sub2 != pro_otp2 -%}<span class="lio-device-compare-strike">€{{ pro_otp2 }} one-time</span>{%- endif -%}
          </div>
          <button type="button" class="lio-device-compare-pick" data-device-pick="pro">{{ section.settings.device_modal_pick_pro | default: 'Pick Lio Pro' }}</button>
        </div>
      </div>
      <div class="lio-device-compare-takeaway">
        <p>{{ section.settings.device_modal_takeaway_html | default: '<strong>Want it to work →</strong> Plus. <strong>Want it to feel addictive to use →</strong> Pro.' }}</p>
      </div>
    </div>
  </div>

  {%- comment -%} FAQ now renders inline at the bottom of the purchase column — no modal needed {%- endcomment -%}

  {%- comment -%} ============ JSON CONFIG ============ {%- endcomment -%}
  {%- liquid
