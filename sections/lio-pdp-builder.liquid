            <div class="lio-totals-row lio-totals-row--soft lio-totals-row--delivery" id="lio-totals-delivery" hidden>
              <span class="lio-totals-delivery-flag" id="lio-delivery-flag" aria-hidden="true">🌍</span>
              <span class="lio-totals-delivery-text"></span>
