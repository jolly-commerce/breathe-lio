      "totals_empty_partial": {{ 'lander.pdp.totals_empty_partial' | t | json }},
      "partner_discount_pct": {{ section.settings.partner_discount_pct | default: 25 }},
      "bestseller_discount_pct": {{ section.settings.bestseller_discount_pct | default: 10 }},
      "partner_discount_code": {{ section.settings.partner_discount_code | default: '' | json }},
      "bestseller_discount_code": {{ section.settings.bestseller_discount_code | default: '' | json }},
      "wood_olive_label": {{ section.settings.wood_olive_label | default: 'Olive' | json }},
      "wood_walnut_label": {{ section.settings.wood_walnut_label | default: 'Walnut' | json }},
      "devices": {
        "plus": {
          "variantId": {%- if d_plus and d_plus.first_available_variant -%}{{ d_plus.first_available_variant.id | json }}{%- else -%}null{%- endif -%},
          "otp": {{ section.settings.device_plus_otp_price | default: 29.95 }},
          "sub": {{ section.settings.device_plus_sub_price | default: 29.95 }},
          "name": {{ section.settings.device_plus_name | default: 'Lio Plus' | json }}
        },
        "pro": {
          "variantId": {%- if d_pro and d_pro.first_available_variant -%}{{ d_pro.first_available_variant.id | json }}{%- else -%}null{%- endif -%},
          "otp": {{ section.settings.device_pro_otp_price | default: 79.95 }},
          "sub": {{ section.settings.device_pro_sub_price | default: 79.95 }},
          "name": {{ section.settings.device_pro_name | default: 'Lio Pro' | json }}
        }
      },
      "flavors": {
        "minty-magic":    { "variantId": {%- if f_minty and f_minty.first_available_variant -%}{{ f_minty.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "description": {%- if f_minty -%}{{ f_minty.description | strip_html | strip | truncate: 380 | json }}{%- else -%}""{%- endif -%}, "bigImage": {%- if f_minty and f_minty.featured_image -%}{{ f_minty.featured_image | image_url: width: 600 | json }}{%- else -%}null{%- endif -%} },
        "peppery-mint":   { "variantId": {%- if f_pep and f_pep.first_available_variant -%}{{ f_pep.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "description": {%- if f_pep -%}{{ f_pep.description | strip_html | strip | truncate: 380 | json }}{%- else -%}""{%- endif -%}, "bigImage": {%- if f_pep and f_pep.featured_image -%}{{ f_pep.featured_image | image_url: width: 600 | json }}{%- else -%}null{%- endif -%} },
        "cinnamon-spice": { "variantId": {%- if f_cin and f_cin.first_available_variant -%}{{ f_cin.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "description": {%- if f_cin -%}{{ f_cin.description | strip_html | strip | truncate: 380 | json }}{%- else -%}""{%- endif -%}, "bigImage": {%- if f_cin and f_cin.featured_image -%}{{ f_cin.featured_image | image_url: width: 600 | json }}{%- else -%}null{%- endif -%} },
        "razzy-berry":    { "variantId": {%- if f_raz and f_raz.first_available_variant -%}{{ f_raz.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "description": {%- if f_raz -%}{{ f_raz.description | strip_html | strip | truncate: 380 | json }}{%- else -%}""{%- endif -%}, "bigImage": {%- if f_raz and f_raz.featured_image -%}{{ f_raz.featured_image | image_url: width: 600 | json }}{%- else -%}null{%- endif -%} },
        "mango-passion":  { "variantId": {%- if f_man and f_man.first_available_variant -%}{{ f_man.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "description": {%- if f_man -%}{{ f_man.description | strip_html | strip | truncate: 380 | json }}{%- else -%}""{%- endif -%}, "bigImage": {%- if f_man and f_man.featured_image -%}{{ f_man.featured_image | image_url: width: 600 | json }}{%- else -%}null{%- endif -%} },
        "ohh-my-orange":  { "variantId": {%- if f_orange and f_orange.first_available_variant -%}{{ f_orange.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "description": {%- if f_orange -%}{{ f_orange.description | strip_html | strip | truncate: 380 | json }}{%- else -%}""{%- endif -%}, "bigImage": {%- if f_orange and f_orange.featured_image -%}{{ f_orange.featured_image | image_url: width: 600 | json }}{%- else -%}null{%- endif -%} }
      },
      "addons": {
        "wood-stand":   { "variantId": {%- if a_stand and a_stand.first_available_variant -%}{{ a_stand.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "price": {{ section.settings.addon_wood_stand_price | default: 14.95 }} },
        "travel-pouch": { "variantId": {%- if a_pouch and a_pouch.first_available_variant -%}{{ a_pouch.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "price": {{ section.settings.addon_travel_pouch_price | default: 9.95 }} },
        "cleaning-kit": { "variantId": {%- if a_clean and a_clean.first_available_variant -%}{{ a_clean.first_available_variant.id | json }}{%- else -%}null{%- endif -%}, "price": {{ section.settings.addon_cleaning_kit_price | default: 6.95 }} }
      }
    }
  </script>

