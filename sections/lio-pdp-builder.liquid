{%- comment -%}
  ============================================================
  LIO PDP BUILDER — section
  Renders the kit configurator (device · flavors · add-ons),
  plus a JSON config blob that maps Shopify variant IDs and the
  Loop selling plan ID into the JS module without touching code.
  All merchant copy + variant pickers live in the schema below.
  ============================================================
{%- endcomment -%}

{{ 'lio-pdp-builder.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

{%- liquid
  assign d_plus  = section.settings.device_plus_product
  assign d_pro   = section.settings.device_pro_product
  assign f_minty = section.settings.flavor_minty_magic
  assign f_pep   = section.settings.flavor_peppery_mint
  assign f_cin   = section.settings.flavor_cinnamon_spice
  assign f_raz   = section.settings.flavor_razzy_berry
  assign f_man   = section.settings.flavor_mango_passion
  assign f_orange = section.settings.flavor_ohh_my_orange
  assign a_stand  = section.settings.addon_wood_stand
  assign a_pouch  = section.settings.addon_travel_pouch
  assign a_clean  = section.settings.addon_cleaning_kit

  assign hero_default = section.settings.gallery_image_1 | default: section.settings.gallery_image_2
-%}

<section class="lio-pdp-section" id="lio-pdp-{{ section.id }}" data-section-type="lio-pdp-builder">

  {%- if section.settings.announcement_text != blank -%}
    <div class="lio-announcement">{{ section.settings.announcement_text }}</div>
  {%- endif -%}

  <nav class="lio-breadcrumbs" aria-label="Breadcrumb">{{ 'lander.pdp.breadcrumbs' | t }}</nav>

  <div class="lio-pdp">

    {%- comment -%} ============ GALLERY ============ {%- endcomment -%}
    <div class="lio-gallery">
      <div class="lio-gallery-main" id="lio-gallery-main">
        <img id="lio-gallery-hero" class="hero"
          {% if hero_default %}
            src="{{ hero_default | image_url: width: 1200 }}"
            srcset="{{ hero_default | image_url: width: 600 }} 600w, {{ hero_default | image_url: width: 900 }} 900w, {{ hero_default | image_url: width: 1200 }} 1200w, {{ hero_default | image_url: width: 1800 }} 1800w"
            sizes="(max-width: 980px) 100vw, 540px"
          {% endif %}
          alt="{{ section.settings.heading | default: 'Lio kit' | strip_html | escape }}"
          width="1200" height="1200"
          fetchpriority="high"
          decoding="async">
        {%- if section.settings.gallery_pin_number != blank -%}
          <div class="lio-gallery-pin">
            <div class="lio-gallery-pin-num">{{ section.settings.gallery_pin_number }}</div>
            <div class="lio-gallery-pin-label">{{ section.settings.gallery_pin_label }}</div>
          </div>
        {%- endif -%}

        {%- comment -%} ============ LIO EVIDENCE STICKER ============ {%- endcomment -%}
        {%- liquid
          assign evidence_count = 0
          for b in section.blocks
            if b.type == 'evidence_point'
              assign evidence_count = evidence_count | plus: 1
            endif
          endfor
        -%}
        {%- if evidence_count > 0 -%}
          <div class="lio-evidence" id="lio-evidence" data-state="min" aria-label="Lio Evidence">

            {%- comment -%} ============ MAX (expanded) STATE ============ {%- endcomment -%}
            <div class="lio-evidence-card" id="lio-evidence-card">
              <div class="lio-evidence-heading">
                {%- comment -%} Left laurel {%- endcomment -%}
                <span class="lio-evidence-laurel" aria-hidden="true">
                  <svg width="17" height="35" viewBox="0 0 17 35" fill="none">
                    <path d="M2.60396 10.0782C2.63019 12.7275 5.0681 14.8472 5.0681 14.8472C5.0681 14.8472 7.46457 12.6717 7.43993 10.0222C7.41325 7.3697 4.97398 5.25178 4.97398 5.25178C4.97398 5.25178 2.57932 7.42863 2.60396 10.0782ZM1.34556 19.1722C2.78927 21.3977 5.99278 21.9007 5.99278 21.9007C5.99278 21.9007 6.85625 18.7951 5.41254 16.5696C3.96883 14.3441 0.763495 13.8397 0.763495 13.8397C0.763495 13.8397 -0.0997442 16.9469 1.34556 19.1722ZM3.82901 27.3622C6.16621 28.6381 9.23028 27.5709 9.23028 27.5709C9.23028 27.5709 8.50337 24.4335 6.16618 23.1576C3.82898 21.8817 0.764911 22.9489 0.764911 22.9489C0.764911 22.9489 1.49182 26.0862 3.82901 27.3622ZM10.5368 33.3638C13.0903 34.1327 15.868 32.4611 15.868 32.4611C15.868 32.4611 14.504 29.5425 11.9502 28.772C9.39665 28.0031 6.62082 29.6761 6.62082 29.6761C6.62082 29.6761 7.98323 32.5949 10.5368 33.3638ZM9.02056 3.29033C7.3448 5.35644 7.8659 8.53241 7.8659 8.53241C7.8659 8.53241 11.1079 8.36114 12.7836 6.29503C14.4594 4.22891 13.9381 1.05136 13.9381 1.05136C13.9381 1.05136 10.6963 1.22421 9.02056 3.29033Z" stroke="currentColor" stroke-linecap="round"/>
                  </svg>
                </span>
                <p class="lio-evidence-title">
                  <span>{{ section.settings.evidence_title_line1 | default: 'Lio' }}</span>
                  <span>{{ section.settings.evidence_title_line2 | default: 'Evidence' }}</span>
                </p>
                {%- comment -%} Right laurel {%- endcomment -%}
                <span class="lio-evidence-laurel" aria-hidden="true">
                  <svg width="17" height="35" viewBox="0 0 17 35" fill="none">
                    <path d="M14.1756 10.0782C14.1494 12.7275 11.7114 14.8472 11.7114 14.8472C11.7114 14.8472 9.31497 12.6717 9.33961 10.0222C9.36629 7.3697 11.8056 5.25178 11.8056 5.25178C11.8056 5.25178 14.2002 7.42863 14.1756 10.0782ZM15.434 19.1722C13.9903 21.3977 10.7868 21.9007 10.7868 21.9007C10.7868 21.9007 9.92329 18.7951 11.367 16.5696C12.8107 14.3441 16.016 13.8397 16.016 13.8397C16.016 13.8397 16.8793 16.9469 15.434 19.1722ZM12.9505 27.3622C10.6133 28.6381 7.54926 27.5709 7.54926 27.5709C7.54926 27.5709 8.27617 24.4335 10.6134 23.1576C12.9506 21.8817 16.0146 22.9489 16.0146 22.9489C16.0146 22.9489 15.2877 26.0862 12.9505 27.3622ZM6.24277 33.3638C3.68923 34.1327 0.911591 32.4611 0.911591 32.4611C0.911591 32.4611 2.27559 29.5425 4.82935 28.772C7.38289 28.0031 10.1587 29.6761 10.1587 29.6761C10.1587 29.6761 8.79631 32.5949 6.24277 33.3638ZM7.75898 3.29033C9.43474 5.35644 8.91365 8.53241 8.91365 8.53241C8.91365 8.53241 5.67166 8.36114 3.9959 6.29503C2.32014 4.22891 2.84146 1.05136 2.84146 1.05136C2.84146 1.05136 6.08322 1.22421 7.75898 3.29033Z" stroke="currentColor" stroke-linecap="round"/>
                </svg>
                </span>
              </div>

              <div class="lio-evidence-body">
                <p class="lio-evidence-claim">
                  {{ section.settings.evidence_claim_html | default: '<span class="bold">150,000+ people</span> have replaced the habit with Lio. Every claim third-party <span class="italics">tested</span>.' }}
                </p>

                <div class="lio-evidence-cta">
                  {%- if section.settings.evidence_avatar_1 or section.settings.evidence_avatar_2 or section.settings.evidence_avatar_3 -%}
                    <span class="lio-evidence-avatars" aria-hidden="true">
                      {%- if section.settings.evidence_avatar_1 -%}<img src="{{ section.settings.evidence_avatar_1 | image_url: width: 64 }}" alt="" loading="lazy" decoding="async" width="32" height="32" style="z-index: 0;">{%- endif -%}
                      {%- if section.settings.evidence_avatar_2 -%}<img src="{{ section.settings.evidence_avatar_2 | image_url: width: 64 }}" alt="" loading="lazy" decoding="async" width="32" height="32" style="z-index: 1;">{%- endif -%}
                      {%- if section.settings.evidence_avatar_3 -%}<img src="{{ section.settings.evidence_avatar_3 | image_url: width: 64 }}" alt="" loading="lazy" decoding="async" width="32" height="32" style="z-index: 2;">{%- endif -%}
                    </span>
                  {%- endif -%}

                  <button type="button" class="lio-evidence-learn" id="lio-evidence-learn" aria-controls="lio-evidence-panel" aria-expanded="false">
                    <span>{{ section.settings.evidence_cta_label | default: 'View evidence & learn more' }}</span>
                  </button>
                </div>
              </div>

              <button type="button" class="lio-evidence-close" id="lio-evidence-close" aria-label="Minimise evidence panel">
                <svg viewBox="0 0 6 6" width="6" height="6" fill="none" aria-hidden="true">
                  <path d="M1 5.5L0.5 5L2.5 3L0.5 1L1 0.5L3 2.5L5 0.5L5.5 1L3.5 3L5.5 5L5 5.5L3 3.5L1 5.5Z" fill="currentColor"/>
                </svg>
              </button>
            </div>

            {%- comment -%} ============ MIN (collapsed) PILL — visible when state="min" ============ {%- endcomment -%}
            <button type="button" class="lio-evidence-min" id="lio-evidence-min" aria-label="Open Lio Evidence" aria-expanded="false">
              <span class="lio-evidence-min-mark" aria-hidden="true">
                <svg width="12" height="24" viewBox="0 0 17 35" fill="none"><path d="M2.60396 10.0782C2.63019 12.7275 5.0681 14.8472 5.0681 14.8472C5.0681 14.8472 7.46457 12.6717 7.43993 10.0222C7.41325 7.3697 4.97398 5.25178 4.97398 5.25178C4.97398 5.25178 2.57932 7.42863 2.60396 10.0782ZM1.34556 19.1722C2.78927 21.3977 5.99278 21.9007 5.99278 21.9007C5.99278 21.9007 6.85625 18.7951 5.41254 16.5696C3.96883 14.3441 0.763495 13.8397 0.763495 13.8397C0.763495 13.8397 -0.0997442 16.9469 1.34556 19.1722ZM3.82901 27.3622C6.16621 28.6381 9.23028 27.5709 9.23028 27.5709C9.23028 27.5709 8.50337 24.4335 6.16618 23.1576C3.82898 21.8817 0.764911 22.9489 0.764911 22.9489C0.764911 22.9489 1.49182 26.0862 3.82901 27.3622ZM10.5368 33.3638C13.0903 34.1327 15.868 32.4611 15.868 32.4611C15.868 32.4611 14.504 29.5425 11.9502 28.772C9.39665 28.0031 6.62082 29.6761 6.62082 29.6761C6.62082 29.6761 7.98323 32.5949 10.5368 33.3638ZM9.02056 3.29033C7.3448 5.35644 7.8659 8.53241 7.8659 8.53241C7.8659 8.53241 11.1079 8.36114 12.7836 6.29503C14.4594 4.22891 13.9381 1.05136 13.9381 1.05136C13.9381 1.05136 10.6963 1.22421 9.02056 3.29033Z" stroke="currentColor" stroke-linecap="round"/></svg>
              </span>
              <span class="lio-evidence-min-text">{{ section.settings.evidence_min_label | default: 'Lio Evidence' }}</span>
            </button>

            {%- comment -%} ============ DETAILED PANEL — opens from "View evidence & learn more" ============ {%- endcomment -%}
            <div class="lio-evidence-panel" id="lio-evidence-panel" role="dialog" aria-modal="true" aria-labelledby="lio-evidence-panel-title" hidden>
              <div class="lio-evidence-panel-backdrop" data-evidence-panel-close></div>
              <div class="lio-evidence-panel-card">
                <button type="button" class="lio-evidence-panel-close" data-evidence-panel-close aria-label="Close">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
                <div class="lio-evidence-panel-head">
                  <span class="lio-evidence-panel-eyebrow"><span class="dot"></span>{{ section.settings.evidence_eyebrow | default: 'LIO EVIDENCE' }}</span>
                  <h3 class="lio-evidence-panel-title" id="lio-evidence-panel-title">{{ section.settings.evidence_panel_title | default: 'Verified by independent labs' }}</h3>
                </div>
                <ul class="lio-evidence-list" role="list">
                  {%- for block in section.blocks -%}
                    {%- if block.type == 'evidence_point' -%}
                      <li class="lio-evidence-row" {{ block.shopify_attributes }}>
                        <span class="lio-evidence-row-icon" aria-hidden="true">
                          {%- case block.settings.icon -%}
                            {%- when 'check' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            {%- when 'shield' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                            {%- when 'beaker' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3v6L4 19a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3L15 9V3"/><line x1="8" y1="3" x2="16" y2="3"/><line x1="6" y1="14" x2="18" y2="14"/></svg>
                            {%- when 'chart' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
                            {%- when 'doc' -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
                            {%- else -%}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                          {%- endcase -%}
                        </span>
                        <div class="lio-evidence-row-body">
                          {%- if block.settings.title != blank -%}<strong class="lio-evidence-row-title">{{ block.settings.title }}</strong>{%- endif -%}
                          {%- if block.settings.source != blank -%}<span class="lio-evidence-row-source">{{ block.settings.source }}</span>{%- endif -%}
                        </div>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if section.settings.evidence_foot != blank -%}
                  <p class="lio-evidence-foot">{{ section.settings.evidence_foot }}</p>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="lio-gallery-thumbs" id="lio-gallery-thumbs">
        {%- for i in (1..5) -%}
          {%- assign img_key = 'gallery_image_' | append: i -%}
          {%- assign img = section.settings[img_key] -%}
          {%- if img -%}
            {%- assign img_url = img | image_url: width: 1200 -%}
            <button type="button" class="lio-gallery-thumb{% if forloop.first %} is-active{% endif %}" data-img="{{ img_url }}" aria-label="View image {{ i }}">
              <img src="{{ img | image_url: width: 240 }}" alt="" loading="lazy" decoding="async" width="240" height="240">
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ============ CONFIG COLUMN ============ {%- endcomment -%}
    <div class="lio-pdp-config">

      <div class="lio-pdp-trust">
        {%- if section.settings.rating_text != blank -%}
          <span class="stars" aria-hidden="true">
            {%- for i in (1..5) -%}
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg>
            {%- endfor -%}
          </span>
          <span><strong>{{ section.settings.rating_text }}</strong></span>
        {%- endif -%}
        {%- if section.settings.rating_text != blank and section.settings.trust_meta != blank -%}
          <span class="pipe" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.trust_meta != blank -%}
          <span>{{ section.settings.trust_meta }}</span>
        {%- endif -%}
      </div>

      <h1 class="lio-pdp-h1">{{ section.settings.heading | default: product.title | default: 'Lio' }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="lio-pdp-sub">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.bullets != blank -%}
        <div class="lio-pdp-bullet-row">
          {%- assign bullets = section.settings.bullets | split: '|' -%}
          {%- for b in bullets -%}
            {%- assign bullet_text = b | strip -%}
            {%- if bullet_text != blank -%}
              <span class="lio-pdp-bullet">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                {{ bullet_text }}
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ============ STEP 1: DEVICE ============ {%- endcomment -%}
      <div class="lio-pdp-step" data-step="device">
        <div class="lio-pdp-step-head">
          <span class="lio-pdp-step-tag" data-step-dot="device">●</span>
          <span class="lio-pdp-step-title">{{ 'lander.pdp.step1_title' | t }}</span>
          <span class="lio-pdp-step-meta"><strong id="lio-device-meta">{{ 'lander.cta.pick_device' | t }}</strong></span>
        </div>

        <button type="button" class="lio-device-compare-cta" id="lio-device-info-btn" aria-haspopup="dialog">
          <span class="lio-device-compare-cta-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          </span>
          <span class="lio-device-compare-cta-text">{{ section.settings.device_info_label | default: 'Plus or Pro? — see the difference' }}</span>
          <span class="lio-device-compare-cta-arrow" aria-hidden="true">→</span>
        </button>

        <div class="lio-device-options" id="lio-device-options">
          <button type="button" class="lio-device-card" data-device="plus" aria-pressed="false">
            {%- if section.settings.device_plus_flag != blank -%}
              <span class="lio-device-card-flag">{{ section.settings.device_plus_flag }}</span>
            {%- endif -%}
            <span class="lio-device-card-img">
              {%- if section.settings.device_plus_image -%}
                <img src="{{ section.settings.device_plus_image | image_url: width: 360 }}" alt="{{ section.settings.device_plus_name | default: 'Lio Plus' | escape }}" width="360" height="360">
              {%- endif -%}
            </span>
            <span class="lio-device-card-name">{{ section.settings.device_plus_name | default: 'Lio Plus' }}</span>
            <span class="lio-device-card-tag">{{ section.settings.device_plus_tag | default: 'Replaces the inhale' }}</span>
            <span class="lio-device-card-price">
              {%- assign plus_sub = section.settings.device_plus_sub_price | default: '29.95' -%}
              {%- assign plus_otp = section.settings.device_plus_otp_price | default: '29.95' -%}
              <span class="lio-device-card-price-sub">€{{ plus_sub }}</span>
              {%- if plus_sub != plus_otp -%}<span class="lio-device-card-price-otp">€{{ plus_otp }}</span>{%- endif -%}
            </span>
            <span class="lio-device-card-radio" aria-hidden="true"></span>
          </button>

          <button type="button" class="lio-device-card" data-device="pro" aria-pressed="false">
            {%- if section.settings.device_pro_flag != blank -%}
              <span class="lio-device-card-flag">{{ section.settings.device_pro_flag }}</span>
            {%- endif -%}
            <span class="lio-device-card-img">
              {%- if section.settings.device_pro_image -%}
                <img src="{{ section.settings.device_pro_image | image_url: width: 360 }}" alt="{{ section.settings.device_pro_name | default: 'Lio Pro' | escape }}" width="360" height="360">
              {%- endif -%}
            </span>
            <span class="lio-device-card-name">{{ section.settings.device_pro_name | default: 'Lio Pro' }}</span>
            <span class="lio-device-card-tag">{{ section.settings.device_pro_tag | default: 'Inhale + magnetic fidget' }}</span>
            <span class="lio-device-card-price">
              {%- assign pro_sub = section.settings.device_pro_sub_price | default: '79.95' -%}
              {%- assign pro_otp = section.settings.device_pro_otp_price | default: '79.95' -%}
              <span class="lio-device-card-price-sub">€{{ pro_sub }}</span>
              {%- if pro_sub != pro_otp -%}<span class="lio-device-card-price-otp">€{{ pro_otp }}</span>{%- endif -%}
            </span>
            <span class="lio-device-card-radio" aria-hidden="true"></span>
          </button>
        </div>

        {%- comment -%} Wood selector — always visible, sits directly below the device cards {%- endcomment -%}
        <div class="lio-wood-block" id="lio-wood-block">
          <div class="lio-wood-row" data-wood-slot="primary">
            <span class="lio-wood-label">{{ section.settings.wood_label_solo | default: 'Wood finish' }}</span>
            <div class="lio-wood-options" data-wood-slot="primary" role="radiogroup" aria-label="Choose wood for device 1">
              <button type="button" class="lio-wood-opt is-selected" data-wood="olive" data-slot="primary" role="radio" aria-checked="true">
                <span class="lio-wood-swatch lio-wood-swatch--olive" aria-hidden="true"></span>
                {{ section.settings.wood_olive_label | default: 'Olive' }}
              </button>
              <button type="button" class="lio-wood-opt" data-wood="walnut" data-slot="primary" role="radio" aria-checked="false">
                <span class="lio-wood-swatch lio-wood-swatch--walnut" aria-hidden="true"></span>
                {{ section.settings.wood_walnut_label | default: 'Walnut' }}
              </button>
            </div>
          </div>
          <div class="lio-wood-row" data-wood-slot="secondary" hidden>
            <span class="lio-wood-label">{{ section.settings.wood_label_partner | default: "Partner's wood" }}</span>
            <div class="lio-wood-options" data-wood-slot="secondary" role="radiogroup" aria-label="Choose wood for device 2">
              <button type="button" class="lio-wood-opt is-selected" data-wood="olive" data-slot="secondary" role="radio" aria-checked="true">
                <span class="lio-wood-swatch lio-wood-swatch--olive" aria-hidden="true"></span>
                {{ section.settings.wood_olive_label | default: 'Olive' }}
              </button>
              <button type="button" class="lio-wood-opt" data-wood="walnut" data-slot="secondary" role="radio" aria-checked="false">
                <span class="lio-wood-swatch lio-wood-swatch--walnut" aria-hidden="true"></span>
                {{ section.settings.wood_walnut_label | default: 'Walnut' }}
              </button>
            </div>
          </div>
        </div>

