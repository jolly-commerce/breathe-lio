    <div class="lio-sticky-pricing" id="lio-sticky-pricing" hidden>
      <span class="lio-sticky-strike" id="lio-sticky-strike" hidden></span>
      <strong class="lio-sticky-total" id="lio-sticky-total">€0,00</strong>
    </div>
    <button type="button" class="lio-sticky-btn is-locked" id="lio-sticky-cta-btn">
      <span id="lio-sticky-cta-label">Pick a device</span>
      <span class="lio-sticky-btn-arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </span>
    </button>
  </div>
</div>

<script>
(function () {
  'use strict';

  var CONFIG = {};
  try {
    var configEl = document.getElementById('lio-pdp-config');
    if (configEl) CONFIG = JSON.parse(configEl.textContent);
  } catch (err) { console.warn('Lio config parse failed', err); }

  var state = {
    device: null,
    woodPrimary: 'olive',
    woodSecondary: 'olive',
    preset: 3,
    flavors: {},
    flavorMax: 3,
    addons: {},
    rhythm: 'sub',
    quitTogether: false
  };
  Object.keys(CONFIG.flavors || {}).forEach(function (k) { state.flavors[k] = 0; });

  function fmt(n) {
    if (typeof n !== 'number' || isNaN(n)) n = 0;
    var s = n.toFixed(2).replace('.', ',');
    return '€ ' + s;
  }
  function flavorTotal() {
    var t = 0;
    Object.keys(state.flavors).forEach(function (k) { t += state.flavors[k]; });
    return t;
  }
  function presetCount() { return state.preset === 'bestseller' ? 6 : 3; }
  function presetBagsPrice() { return state.preset === 'bestseller' ? 35.96 : 24.95; }
  function presetBagsStrike() { return state.preset === 'bestseller' ? 39.95 : null; }
  function devicePrice() {
    if (!state.device || !CONFIG.devices || !CONFIG.devices[state.device]) return 0;
    var d = CONFIG.devices[state.device];
    var base = state.rhythm === 'sub' ? d.sub : d.otp;
    return state.quitTogether ? base * 2 : base;
  }
  function deviceLabel() {
    if (!state.device) return 'No device picked';
    var d = CONFIG.devices && CONFIG.devices[state.device];
    var name = d ? d.name : state.device;
    if (state.quitTogether) name += ' × 2 (Quit Together)';
    return name;
  }
  function addonsTotal() {
    var t = 0, c = 0;
    Object.keys(state.addons).forEach(function (k) {
      if (state.addons[k] && CONFIG.addons[k]) {
        t += CONFIG.addons[k].price;
        c += 1;
      }
    });
    return { total: t, count: c };
  }

  var localeMap = {
    'NL': { currency: 'EUR', name: 'Netherlands', days: '2-3' },
    'BE': { currency: 'EUR', name: 'Belgium',     days: '2-3' },
    'DE': { currency: 'EUR', name: 'Germany',     days: '2-3' },
    'FR': { currency: 'EUR', name: 'France',      days: '2-4' },
    'IT': { currency: 'EUR', name: 'Italy',       days: '2-4' },
    'ES': { currency: 'EUR', name: 'Spain',       days: '3-5' },
    'IE': { currency: 'EUR', name: 'Ireland',     days: '3-5' },
    'AT': { currency: 'EUR', name: 'Austria',     days: '2-4' },
    'PT': { currency: 'EUR', name: 'Portugal',    days: '3-5' },
    'FI': { currency: 'EUR', name: 'Finland',     days: '3-5' },
    'GB': { currency: 'GBP', name: 'the UK',      days: '3-5' },
    'US': { currency: 'USD', name: 'the US',      days: '5-9' },
    'CA': { currency: 'CAD', name: 'Canada',      days: '5-9' },
    'AU': { currency: 'AUD', name: 'Australia',   days: '7-10' },
    'AE': { currency: 'AED', name: 'the UAE',     days: '4-7' },
    'CH': { currency: 'CHF', name: 'Switzerland', days: '3-5' }
  };
  function getRegion () {
    try {
      var lang = (navigator.language || '').toUpperCase();
      var match = lang.match(/-([A-Z]{2})$/);
      if (match && localeMap[match[1]]) return match[1];
      var primary = lang.slice(0, 2);
      if (localeMap[primary]) return primary;
    } catch (err) {}
    return null;
  }
  var region = getRegion();

  /* GALLERY SLIDER */
  (function () {
    var track  = document.getElementById('lio-gal-track');
    if (!track) return;
    var slides = track.querySelectorAll('.lio-gal-slide');
    if (!slides.length) return;
    var prev      = document.querySelector('[data-gal-prev]');
    var next      = document.querySelector('[data-gal-next]');
    var dotsWrap  = document.getElementById('lio-gal-dots');
    var thumbs    = document.querySelectorAll('.lio-gal-thumb');
    var thumbStrip= document.getElementById('lio-gal-thumbs');
    var counterC  = document.getElementById('lio-gal-counter-current');
    var counterT  = document.getElementById('lio-gal-counter-total');
    var current = 0;
    if (counterT) counterT.textContent = String(slides.length);
    if (dotsWrap) {
      dotsWrap.innerHTML = '';
      for (var i = 0; i < slides.length; i++) {
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'lio-gal-dot' + (i === 0 ? ' is-active' : '');
        b.setAttribute('aria-label', 'Image ' + (i + 1));
        b.dataset.idx = i;
        (function (idx) { b.addEventListener('click', function () { goTo(idx); }); })(i);
        dotsWrap.appendChild(b);
      }
    }
    var dots = dotsWrap ? dotsWrap.querySelectorAll('.lio-gal-dot') : [];
    function setActive (i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      current = i;
      dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === i); });
      thumbs.forEach(function (t, idx) {
        var on = idx === i;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (prev) prev.classList.toggle('is-disabled', i === 0);
      if (next) next.classList.toggle('is-disabled', i === slides.length - 1);
      if (counterC) counterC.textContent = String(i + 1);
      if (thumbStrip && thumbs[i]) {
        var stripRect = thumbStrip.getBoundingClientRect();
        var thumbRect = thumbs[i].getBoundingClientRect();
        if (thumbRect.left < stripRect.left || thumbRect.right > stripRect.right) {
          var delta = (thumbRect.left - stripRect.left) - (stripRect.width - thumbRect.width) / 2;
          thumbStrip.scrollBy({ left: delta, behavior: 'smooth' });
        }
      }
    }
    function goTo (i) {
      i = Math.max(0, Math.min(slides.length - 1, i));
      var target = slides[i];
      if (!target) return;
      track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        var best = null, bestRatio = 0;
        entries.forEach(function (e) {
          if (e.isIntersecting && e.intersectionRatio > bestRatio) {
            bestRatio = e.intersectionRatio;
            best = e.target;
          }
        });
        if (best) {
          var idx = Array.prototype.indexOf.call(slides, best);
          if (idx !== -1 && idx !== current) setActive(idx);
        }
      }, { root: track, threshold: [0.5, 0.75, 0.95] });
      slides.forEach(function (s) { io.observe(s); });
    } else {
      var scrollTimer;
      track.addEventListener('scroll', function () {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(function () {
          var i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== current) setActive(i);
        }, 80);
      });
    }
    if (prev) prev.addEventListener('click', function () { goTo(current - 1); });
    if (next) next.addEventListener('click', function () { goTo(current + 1); });
    thumbs.forEach(function (t, idx) { t.addEventListener('click', function () { goTo(idx); }); });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
    });
    setActive(0);
  })();

  /* EVIDENCE OVERLAY */
  (function () {
    var ev = document.getElementById('lio-evidence');
    if (!ev) return;
    var minBtn = document.getElementById('lio-evidence-min');
    var closeBtn = document.getElementById('lio-evidence-close');
    var learnBtn = document.getElementById('lio-evidence-learn');
    var panel = document.getElementById('lio-evidence-panel');
    if (minBtn) minBtn.addEventListener('click', function () {
      ev.setAttribute('data-state', 'card');
      minBtn.setAttribute('aria-expanded', 'true');
    });
    if (closeBtn) closeBtn.addEventListener('click', function () {
      ev.setAttribute('data-state', 'min');
      if (minBtn) minBtn.setAttribute('aria-expanded', 'false');
    });
    if (learnBtn && panel) {
      learnBtn.addEventListener('click', function () {
        panel.hidden = false;
        learnBtn.setAttribute('aria-expanded', 'true');
      });
    }
    if (panel) {
      panel.querySelectorAll('[data-evidence-panel-close]').forEach(function (el) {
        el.addEventListener('click', function () {
          panel.hidden = true;
          if (learnBtn) learnBtn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  })();

  /* DEVICE PICKER */
  function setDevice(d) {
    state.device = d;
    document.querySelectorAll('.lio-device-card').forEach(function (el) {
      var pressed = el.getAttribute('data-device') === d;
      el.setAttribute('aria-pressed', pressed ? 'true' : 'false');
    });
    var meta = document.getElementById('lio-device-meta');
    if (meta) meta.textContent = (CONFIG.devices && CONFIG.devices[d]) ? CONFIG.devices[d].name + ' selected' : 'Selected';
    setStepDot('device', true);
    revealStep('flavors');
    revealStep('addons');
    render();
  }
  document.querySelectorAll('.lio-device-card').forEach(function (el) {
    el.addEventListener('click', function () { setDevice(el.getAttribute('data-device')); });
  });

  /* WOOD FINISH */
  document.querySelectorAll('.lio-wood-opt').forEach(function (el) {
    el.addEventListener('click', function () {
      var slot = el.getAttribute('data-slot');
      var wood = el.getAttribute('data-wood');
      document.querySelectorAll('.lio-wood-opt[data-slot="' + slot + '"]').forEach(function (other) {
        other.classList.remove('is-selected');
        other.setAttribute('aria-checked', 'false');
      });
      el.classList.add('is-selected');
      el.setAttribute('aria-checked', 'true');
      if (slot === 'primary') state.woodPrimary = wood;
      else state.woodSecondary = wood;
      render();
    });
  });

  function setStepDot(name, active) {
    var dot = document.querySelector('[data-step-dot="' + name + '"]');
    if (dot) dot.classList.toggle('is-active', !!active);
  }
  function revealStep(name) {
    var el = document.querySelector('[data-step="' + name + '"]');
    if (el) el.hidden = false;
  }

  /* PRESET */
  function setPreset(p) {
    state.preset = p;
    state.flavorMax = p === 'bestseller' ? 6 : 3;
    document.querySelectorAll('.lio-preset').forEach(function (el) {
      var active = el.getAttribute('data-preset') === String(p);
      el.classList.toggle('is-selected', active);
      el.setAttribute('aria-checked', active ? 'true' : 'false');
    });
    var hint = document.getElementById('lio-bestseller-hint');
    if (p === 'bestseller') {
      state.flavors['minty-magic']    = 2;
      state.flavors['peppery-mint']   = 1;
      state.flavors['cinnamon-spice'] = 1;
      state.flavors['razzy-berry']    = 1;
      state.flavors['mango-passion']  = 1;
      state.flavors['ohh-my-orange']  = 0;
      if (hint) hint.hidden = false;
    } else {
      Object.keys(state.flavors).forEach(function (k) { state.flavors[k] = 0; });
      if (hint) hint.hidden = true;
    }
    refreshFlavorOutputs();
    render();
  }
  document.querySelectorAll('.lio-preset').forEach(function (el) {
    el.addEventListener('click', function () {
      var p = el.getAttribute('data-preset');
      setPreset(p === 'bestseller' ? 'bestseller' : parseInt(p, 10));
    });
  });

  /* FLAVOR STEPPERS */
  function refreshFlavorOutputs() {
    var total = flavorTotal();
    var max = state.flavorMax;
    document.querySelectorAll('output[data-out]').forEach(function (out) {
      var k = out.getAttribute('data-out');
      out.textContent = state.flavors[k] || 0;
    });
    document.querySelectorAll('button[data-action]').forEach(function (btn) {
      var k = btn.getAttribute('data-flavor');
      var act = btn.getAttribute('data-action');
      if (act === 'dec') btn.disabled = (state.flavors[k] || 0) <= 0;
      else if (act === 'inc') btn.disabled = total >= max;
    });
    var meta = document.getElementById('lio-flavors-meta');
    if (meta) meta.textContent = total + ' of ' + max + ' picked';
    setStepDot('flavors', total === max);
  }
  document.querySelectorAll('button[data-action]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var k = btn.getAttribute('data-flavor');
      var act = btn.getAttribute('data-action');
      var cur = state.flavors[k] || 0;
      var total = flavorTotal();
      if (act === 'inc' && total < state.flavorMax) state.flavors[k] = cur + 1;
      else if (act === 'dec' && cur > 0)             state.flavors[k] = cur - 1;
      refreshFlavorOutputs();
      render();
    });
  });

  /* ADD-ONS */
  document.querySelectorAll('.lio-addon').forEach(function (el) {
    el.addEventListener('click', function () {
      var k = el.getAttribute('data-addon');
      state.addons[k] = !state.addons[k];
      el.setAttribute('aria-pressed', state.addons[k] ? 'true' : 'false');
      var info = addonsTotal();
      setStepDot('addons', info.count > 0);
      render();
    });
  });

  /* RHYTHM TOGGLE */
  document.querySelectorAll('.lio-rhythm-opt').forEach(function (el) {
    el.addEventListener('click', function () {
      state.rhythm = el.getAttribute('data-mode');
      document.querySelectorAll('.lio-rhythm-opt').forEach(function (other) {
        other.classList.remove('is-selected');
        other.setAttribute('aria-checked', 'false');
      });
      el.classList.add('is-selected');
      el.setAttribute('aria-checked', 'true');
      setStepDot('delivery', true);
      render();
    });
  });
  setStepDot('delivery', true);

  /* QUIT TOGETHER */
  (function () {
    var btn = document.getElementById('lio-quit-together');
    if (!btn) return;
    btn.addEventListener('click', function () {
      state.quitTogether = !state.quitTogether;
      btn.setAttribute('aria-pressed', state.quitTogether ? 'true' : 'false');
      var sec = document.querySelector('[data-wood-slot="secondary"]');
      if (sec) sec.hidden = !state.quitTogether;
      render();
    });
  })();

  /* RENDER */
  var els = {
    totalsEmpty:   document.getElementById('lio-totals-empty'),
    totalsEmptyText: document.getElementById('lio-totals-empty-text'),
    totalsRows:    document.getElementById('lio-totals-rows'),
    deviceName:    document.getElementById('lio-device-line-name'),
    devicePrice:   document.getElementById('lio-device-line-price'),
    bagsName:      document.getElementById('lio-bags-line-name'),
    bagsPrice:     document.getElementById('lio-bags-line-price'),
    addonsRow:     document.getElementById('lio-addons-line-row'),
    addonsName:    document.getElementById('lio-addons-line-name'),
    addonsPrice:   document.getElementById('lio-addons-line-price'),
    delivery:      document.getElementById('lio-totals-delivery'),
    deliveryText:  document.getElementById('lio-delivery-text'),
    totalLabel:    document.getElementById('lio-total-label'),
    total:         document.getElementById('lio-total'),
    totalStrike:   document.getElementById('lio-total-strike'),
    cta:           document.getElementById('lio-cta-btn'),
    ctaLabel:      document.getElementById('lio-cta-label'),
    sticky:        document.getElementById('lio-sticky-cta'),
    stickyTitle:   document.getElementById('lio-sticky-title'),
    stickyMeta:    document.getElementById('lio-sticky-meta'),
    stickyPricing: document.getElementById('lio-sticky-pricing'),
    stickyTotal:   document.getElementById('lio-sticky-total'),
    stickyStrike:  document.getElementById('lio-sticky-strike'),
    stickyBtn:     document.getElementById('lio-sticky-cta-btn'),
    stickyBtnLabel:document.getElementById('lio-sticky-cta-label')
  };

  function render() {
    var hasDevice = !!state.device;
    var fTotal = flavorTotal();
    var flavorsDone = fTotal === state.flavorMax;
    var addons = addonsTotal();

    if (!hasDevice) {
      if (els.totalsEmpty) els.totalsEmpty.style.display = 'flex';
      if (els.totalsRows)  els.totalsRows.hidden = true;
      if (els.totalsEmptyText) els.totalsEmptyText.textContent = CONFIG.totals_empty_initial || 'Pick your device to see your total';
    } else if (!flavorsDone) {
      if (els.totalsEmpty) els.totalsEmpty.style.display = 'flex';
      if (els.totalsRows)  els.totalsRows.hidden = true;
      var partial = (CONFIG.totals_empty_partial || 'Pick {n} more to see your total').replace('{n}', state.flavorMax - fTotal);
      if (els.totalsEmptyText) els.totalsEmptyText.textContent = partial;
    } else {
      if (els.totalsEmpty) els.totalsEmpty.style.display = 'none';
      if (els.totalsRows)  els.totalsRows.hidden = false;
      var dPrice = devicePrice();
      if (els.deviceName)  els.deviceName.textContent = deviceLabel();
      if (els.devicePrice) els.devicePrice.textContent = fmt(dPrice);
      var bagsPrice = presetBagsPrice();
      if (els.bagsName) els.bagsName.textContent = presetCount() + ' bags · ' + fTotal + ' flavor' + (fTotal === 1 ? '' : 's');
      if (els.bagsPrice) els.bagsPrice.textContent = fmt(bagsPrice);
      if (addons.count > 0) {
        if (els.addonsRow) els.addonsRow.hidden = false;
        if (els.addonsName) els.addonsName.textContent = addons.count + ' add-on' + (addons.count === 1 ? '' : 's');
        if (els.addonsPrice) els.addonsPrice.textContent = fmt(addons.total);
      } else {
        if (els.addonsRow) els.addonsRow.hidden = true;
      }
      if (region && localeMap[region] && els.delivery) {
        els.delivery.hidden = false;
        if (els.deliveryText) els.deliveryText.textContent = 'Delivery to ' + localeMap[region].name + ' takes ' + localeMap[region].days + ' days';
      } else if (els.delivery) {
        els.delivery.hidden = true;
      }
      var subtotal = dPrice + bagsPrice + addons.total;
      var subDiscount = state.rhythm === 'sub' ? bagsPrice * 0.15 : 0;
      var presetDiscount = (state.preset === 'bestseller') ? presetBagsStrike() - bagsPrice : 0;
      var quitDiscount = state.quitTogether ? dPrice * (CONFIG.partner_discount_pct || 25) / 100 / 2 : 0;
      var grand = subtotal - subDiscount - quitDiscount;
      var strikeOriginal = subtotal + presetDiscount + (state.quitTogether ? quitDiscount : 0);
      if (els.total) els.total.textContent = fmt(grand);
      if (els.totalStrike) {
        if (subDiscount > 0 || presetDiscount > 0 || quitDiscount > 0) {
          els.totalStrike.hidden = false;
          els.totalStrike.textContent = fmt(strikeOriginal);
        } else {
          els.totalStrike.hidden = true;
        }
      }
      if (els.cta) {
        els.cta.disabled = false;
        els.ctaLabel.textContent = 'Add to cart — ' + fmt(grand);
      }
    }

    if (els.cta && !flavorsDone) {
      els.cta.disabled = true;
      els.ctaLabel.textContent = !hasDevice ? 'Pick a device' :
        (fTotal === 0 ? 'Pick ' + state.flavorMax + ' flavors' :
         'Pick ' + (state.flavorMax - fTotal) + ' more');
    }

    if (els.sticky) {
      els.sticky.classList.add('is-visible');
      var stickyState = !hasDevice ? 'empty' : (!flavorsDone ? 'partial' : 'ready');
      els.sticky.setAttribute('data-state', stickyState);
      if (stickyState === 'empty') {
        if (els.stickyTitle) els.stickyTitle.textContent = 'Your Lio Kit';
        if (els.stickyMeta)  els.stickyMeta.textContent  = 'Pick a device to start';
        if (els.stickyPricing) els.stickyPricing.hidden = true;
        if (els.stickyBtn) {
          els.stickyBtn.disabled = false;
          els.stickyBtn.classList.add('is-locked');
          els.stickyBtnLabel.textContent = 'Pick a device';
        }
      } else if (stickyState === 'partial') {
        if (els.stickyTitle) els.stickyTitle.textContent = deviceLabel();
        if (els.stickyMeta)  els.stickyMeta.textContent  = 'Pick ' + (state.flavorMax - fTotal) + ' more flavor' + ((state.flavorMax - fTotal) === 1 ? '' : 's');
        if (els.stickyPricing) els.stickyPricing.hidden = true;
        if (els.stickyBtn) {
          els.stickyBtn.disabled = false;
          els.stickyBtn.classList.add('is-locked');
          els.stickyBtnLabel.textContent = 'Pick flavors';
        }
      } else {
        if (els.stickyTitle) els.stickyTitle.textContent = deviceLabel() + ' · ' + presetCount() + ' bags';
        if (els.stickyMeta)  els.stickyMeta.textContent  = (state.rhythm === 'sub' ? 'Subscribe & save' : 'One-time') + (addons.count ? ' · ' + addons.count + ' add-on' + (addons.count === 1 ? '' : 's') : '');
        var stickyDeviceP = devicePrice();
        var stickyBagsP   = presetBagsPrice();
        var stickySubD    = state.rhythm === 'sub' ? stickyBagsP * 0.15 : 0;
        var stickyQuitD   = state.quitTogether ? stickyDeviceP * (CONFIG.partner_discount_pct || 25) / 100 / 2 : 0;
        var stickyGrand   = stickyDeviceP + stickyBagsP + addons.total - stickySubD - stickyQuitD;
        var stickyStrike  = stickyDeviceP + stickyBagsP + addons.total + (state.preset === 'bestseller' ? presetBagsStrike() - stickyBagsP : 0);
        if (els.stickyPricing) els.stickyPricing.hidden = false;
        if (els.stickyTotal) els.stickyTotal.textContent = fmt(stickyGrand);
        if (els.stickyStrike) {
          if (stickySubD + stickyQuitD + (state.preset === 'bestseller' ? (presetBagsStrike() - stickyBagsP) : 0) > 0) {
            els.stickyStrike.hidden = false;
            els.stickyStrike.textContent = fmt(stickyStrike);
          } else {
            els.stickyStrike.hidden = true;
          }
        }
        if (els.stickyBtn) {
          els.stickyBtn.disabled = false;
          els.stickyBtn.classList.remove('is-locked');
          els.stickyBtnLabel.textContent = 'Add to cart';
        }
      }
    }
  }

  if (els.cta) els.cta.addEventListener('click', function () {
    if (els.cta.disabled) return;
    window.location.href = (CONFIG.cart_url || '/cart');
  });
  if (els.stickyBtn) els.stickyBtn.addEventListener('click', function () {
    var stickyState = els.sticky ? els.sticky.getAttribute('data-state') : '';
    if (stickyState === 'empty') {
      var deviceStep = document.querySelector('[data-step="device"]');
      if (deviceStep) deviceStep.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else if (stickyState === 'partial') {
      var flavorStep = document.getElementById('lio-step-flavors') || document.querySelector('[data-step="flavors"]');
      if (flavorStep) flavorStep.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      var cta = document.getElementById('lio-cta');
      if (cta) cta.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

  /* FLAVOR MODAL */
  (function () {
    var modal = document.getElementById('lio-flavor-modal');
    if (!modal) return;
    var hero = document.getElementById('lio-flavor-modal-hero');
    var title = document.getElementById('lio-flavor-modal-title');
    var desc = document.getElementById('lio-flavor-modal-desc');
    var flag = document.getElementById('lio-flavor-modal-flag');
    var addBtn = document.getElementById('lio-flavor-modal-add');
    var addLabel = document.getElementById('lio-flavor-modal-cta-label');
    var currentFlavor = null;
    function open(key) {
      var f = CONFIG.flavors && CONFIG.flavors[key];
      if (!f) return;
      currentFlavor = key;
      if (hero) { hero.src = f.image; hero.alt = f.name; }
      if (title) title.textContent = f.name;
      if (desc) desc.textContent = f.desc || '';
      if (flag) {
        if (f.callout) { flag.hidden = false; flag.textContent = f.callout; }
        else flag.hidden = true;
      }
      if (addLabel) addLabel.textContent = (state.flavors[key] || 0) > 0 ? 'Add another' : 'Add to mix';
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
      currentFlavor = null;
    }
    document.querySelectorAll('[data-flavor-open]').forEach(function (el) {
      el.addEventListener('click', function () { open(el.getAttribute('data-flavor-open')); });
    });
    modal.querySelectorAll('[data-flavor-modal-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    if (addBtn) addBtn.addEventListener('click', function () {
      if (!currentFlavor) return close();
      var total = flavorTotal();
      if (total >= state.flavorMax) { close(); return; }
      state.flavors[currentFlavor] = (state.flavors[currentFlavor] || 0) + 1;
      refreshFlavorOutputs();
      render();
      close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  })();

  /* DEVICE COMPARE MODAL */
  (function () {
    var modal = document.getElementById('lio-device-modal');
    if (!modal) return;
    var openBtn = document.getElementById('lio-device-info-btn');
    function open() { modal.hidden = false; document.body.style.overflow = 'hidden'; }
    function close() { modal.hidden = true; document.body.style.overflow = ''; }
    if (openBtn) openBtn.addEventListener('click', open);
    modal.querySelectorAll('[data-device-modal-close]').forEach(function (el) { el.addEventListener('click', close); });
    modal.querySelectorAll('[data-device-pick]').forEach(function (el) {
      el.addEventListener('click', function () {
        setDevice(el.getAttribute('data-device-pick'));
        close();
      });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  })();

  refreshFlavorOutputs();
  render();
})();
</script>

