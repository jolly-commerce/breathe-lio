<style>
:root {
  --forest:        #0b2410;
  --forest-2:      #143b21;
  --cream:         #fcfefb;
  --mint:          #94fca9;
  --mint-2:        #6ce143;
  --mint-soft:     #cdfee1;
  --paper:         #f8faf6;
  --paper-2:       #f4f7f2;

  --f-04:  rgba(11,36,16,0.04);
  --f-08:  rgba(11,36,16,0.08);
  --f-12:  rgba(11,36,16,0.12);
  --f-16:  rgba(11,36,16,0.16);
  --f-22:  rgba(11,36,16,0.22);
  --f-40:  rgba(11,36,16,0.40);
  --f-55:  rgba(11,36,16,0.55);
  --f-72:  rgba(11,36,16,0.72);

  --c-55: rgba(252,254,251,0.55);
  --c-65: rgba(252,254,251,0.65);
  --c-75: rgba(252,254,251,0.75);

  --font-display: "Sofia Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-body:    "Sofia Pro", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-mono:    ui-monospace, "SF Mono", Menlo, Consolas, monospace;

  --max-w: 1200px;
  --header-h: 72px;
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
}

.lio-pdp-section *, .lio-pdp-section *::before, .lio-pdp-section *::after,
.lio-sticky *, .lio-sticky *::before, .lio-sticky *::after,
.lio-flavor-modal *, .lio-device-modal *,
.lio-evidence-panel * { box-sizing: border-box; }

.lio-pdp-section [hidden], .lio-sticky [hidden],
.lio-flavor-modal[hidden], .lio-device-modal[hidden],
.lio-evidence-panel[hidden] { display: none !important; }

.lio-pdp-section img { max-width: 100%; height: auto; display: block; }
.lio-pdp-section button { font-family: inherit; cursor: pointer; }
.lio-pdp-section h1, .lio-pdp-section h2, .lio-pdp-section h3,
.lio-pdp-section h4, .lio-pdp-section h5, .lio-pdp-section h6 {
  margin: 0; line-height: 1.05; letter-spacing: -0.02em;
}
.lio-pdp-section ul, .lio-pdp-section ol { padding: 0; margin: 0; list-style: none; }

@media (prefers-reduced-motion: reduce) {
  .lio-pdp-section *, .lio-sticky * {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ============================================================
   BREADCRUMBS
   ============================================================ */
.lio-breadcrumbs {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 18px 24px 0;
}
.lio-breadcrumbs p {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  color: var(--f-55);
}

/* ============================================================
   PDP CONTAINER
   ============================================================ */
.lio-pdp-section {
  background: var(--cream);
  padding: 8px 0 56px;
  color: var(--forest);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.55;
}
.lio-pdp {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 24px;
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  align-items: start;
}
@media (min-width: 980px) {
  .lio-pdp { grid-template-columns: 1.05fr 1fr; gap: 56px; padding-top: 24px; }
}

/* ============================================================
   GALLERY
   ============================================================ */
.lio-gallery { position: relative; }
.lio-gallery-main {
  position: relative;
  aspect-ratio: 1 / 1;
  background: var(--paper);
  border-radius: 24px;
  overflow: hidden;
  margin-bottom: 10px;
  width: 100%;
  isolation: isolate;
}
.lio-gallery-pin {
  position: absolute;
  top: 16px; left: 16px;
  background: rgba(11,36,16,0.92);
  color: var(--cream);
  padding: 8px 14px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  gap: 8px;
  backdrop-filter: blur(6px);
  z-index: 2;
}
.lio-gallery-pin-num {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--mint);
}
.lio-gallery-pin-label {
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: 0.18em;
  font-weight: 700;
}

/* ============================================================
   EVIDENCE OVERLAY
   ============================================================ */
.lio-evidence {
  position: absolute;
  bottom: 16px; left: 16px;
  z-index: 3;
}
.lio-evidence-card { display: none; }
.lio-evidence[data-state="card"] .lio-evidence-card {
  display: block;
  background: rgba(252,254,251,0.96);
  border: 1px solid rgba(11,36,16,0.10);
  border-radius: 14px;
  padding: 14px 16px;
  max-width: 320px;
  backdrop-filter: blur(8px);
  position: relative;
}
.lio-evidence[data-state="card"] .lio-evidence-min { display: none; }
.lio-evidence[data-state="min"] .lio-evidence-card { display: none; }

.lio-evidence-heading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 10px;
}
.lio-evidence-laurel { color: var(--forest); }
.lio-evidence-title {
  margin: 0;
  display: flex;
  flex-direction: column;
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--f-55);
  line-height: 1.1;
}
.lio-evidence-title span:first-child { color: var(--forest); font-size: 11px; }
.lio-evidence-claim p {
  margin: 0;
  font-size: 13px;
  line-height: 1.4;
  color: var(--f-72);
}
.lio-evidence-claim strong { color: var(--forest); font-weight: 700; }
.lio-evidence-cta { margin-top: 10px; }
.lio-evidence-learn {
  background: 0;
  border: 0;
  padding: 0;
  font-size: 12px;
  font-weight: 700;
  color: var(--forest);
  border-bottom: 1.5px solid var(--mint);
  padding-bottom: 1px;
  cursor: pointer;
}
.lio-evidence-close {
  position: absolute;
  top: 8px; right: 8px;
  width: 18px; height: 18px;
  border-radius: 50%;
  border: 0;
  background: var(--f-08);
  color: var(--forest);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}
.lio-evidence-min {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(252,254,251,0.94);
  border: 1px solid rgba(11,36,16,0.10);
  border-radius: 999px;
  padding: 7px 14px;
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.06em;
  font-weight: 700;
  color: var(--forest);
  backdrop-filter: blur(8px);
  cursor: pointer;
}
.lio-evidence-min-mark { color: var(--forest); display: inline-flex; }

.lio-evidence-panel {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.lio-evidence-panel-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(11,36,16,0.55);
  backdrop-filter: blur(4px);
}
.lio-evidence-panel-card {
  position: relative;
  background: var(--cream);
  border-radius: 20px;
  max-width: 440px;
  width: 100%;
  padding: 28px 28px 24px;
  max-height: 90vh;
  overflow: auto;
}
.lio-evidence-panel-close {
  position: absolute;
  top: 14px; right: 14px;
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 0;
  background: var(--paper);
  color: var(--forest);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.lio-evidence-panel-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--f-55);
  font-weight: 700;
  margin-bottom: 8px;
}
.lio-evidence-panel-eyebrow .dot {
  width: 6px; height: 6px;
  background: var(--mint);
  border-radius: 50%;
}
.lio-evidence-panel-title {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.025em;
  color: var(--forest);
  margin-bottom: 18px;
}
.lio-evidence-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 18px;
}
.lio-evidence-row {
  display: flex;
  gap: 12px;
  padding: 12px 14px;
  background: var(--paper);
  border-radius: 12px;
  border: 1px solid var(--f-08);
}
.lio-evidence-row-icon {
  width: 28px; height: 28px;
  border-radius: 8px;
  background: var(--mint-soft);
  color: var(--forest);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.lio-evidence-row-body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}
.lio-evidence-row-title {
  font-size: 13.5px;
  font-weight: 700;
  color: var(--forest);
}
.lio-evidence-row-source {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--f-55);
  letter-spacing: 0.04em;
}
.lio-evidence-foot {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.04em;
  color: var(--f-55);
  margin: 0;
}

/* ============================================================
   GALLERY SLIDER
   ============================================================ */
.lio-gal-track {
  position: absolute;
  inset: 0;
  display: flex;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  overscroll-behavior-x: contain;
  z-index: 0;
}
.lio-gal-track::-webkit-scrollbar { display: none; }

.lio-gal-slide {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  margin: 0;
  position: relative;
  background: var(--paper);
}
.lio-gal-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.lio-gal-img.is-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10px;
  background: linear-gradient(135deg, var(--paper-2), var(--paper));
  color: var(--f-22);
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-weight: 700;
}
.lio-gal-img.is-placeholder svg { width: 56px; height: 56px; }

.lio-gal-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 4;
  width: 40px; height: 40px;
  border-radius: 50%;
  border: 0;
  background: rgba(252,254,251,0.92);
  color: var(--forest);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  box-shadow: 0 2px 10px rgba(11,36,16,0.10);
  transition: background 0.15s, opacity 0.2s, transform 0.15s;
}
.lio-gal-arrow:hover {
  background: var(--cream);
  transform: translateY(-50%) scale(1.05);
}
.lio-gal-arrow.is-disabled {
  opacity: 0;
  pointer-events: none;
}
.lio-gal-arrow svg { width: 14px; height: 14px; }
.lio-gal-arrow--prev { left: 14px; }
.lio-gal-arrow--next { right: 14px; }

.lio-gal-counter {
  position: absolute;
  bottom: 16px;
  right: 16px;
  z-index: 3;
  background: rgba(11,36,16,0.84);
  color: var(--cream);
  padding: 6px 12px;
  border-radius: 999px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.06em;
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.lio-gal-counter-sep { opacity: 0.5; }

.lio-gal-dots {
  display: flex;
  gap: 6px;
  justify-content: center;
  padding: 12px 0 10px;
  flex-wrap: wrap;
}
.lio-gal-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--f-16);
  border: 0;
  padding: 0;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}
.lio-gal-dot:hover { background: var(--f-40); }
.lio-gal-dot.is-active {
  background: var(--forest);
  transform: scale(1.4);
}

.lio-gal-thumbs {
  display: flex;
  gap: 6px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 4px;
  scroll-behavior: smooth;
  scroll-padding-inline: 6px;
}
.lio-gal-thumbs::-webkit-scrollbar { display: none; }
.lio-gal-thumb {
  flex: 0 0 calc((100% - 6px * 5) / 6);
  aspect-ratio: 1 / 1;
  border-radius: 10px;
  overflow: hidden;
  background: var(--paper);
  border: 2px solid var(--f-08);
  cursor: pointer;
  padding: 0;
  transition: border-color 0.15s, transform 0.15s;
  scroll-snap-align: start;
  position: relative;
}
.lio-gal-thumb:hover { transform: translateY(-1px); border-color: var(--f-22); }
.lio-gal-thumb.is-active { border-color: var(--forest); }
.lio-gal-thumb-img {
  width: 100%; height: 100%;
  object-fit: cover;
  display: block;
}
.lio-gal-thumb-placeholder {
  width: 100%; height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--paper-2), var(--paper));
  color: var(--f-22);
}
.lio-gal-thumb-placeholder svg { width: 18px; height: 18px; }

@media (max-width: 600px) {
  .lio-gal-thumb {
    flex: 0 0 calc((100% - 6px * 4) / 5);
    border-radius: 8px;
  }
  .lio-gal-arrow { width: 36px; height: 36px; }
  .lio-gal-counter { font-size: 10px; padding: 5px 10px; bottom: 12px; right: 12px; }
}

/* ============================================================
   PDP CONFIG / BUILDER COLUMN
   ============================================================ */
.lio-pdp-config { position: relative; }
@media (min-width: 980px) {
  .lio-pdp-config { position: sticky; top: calc(var(--header-h) + 16px); }
}

.lio-pdp-trust {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 12px;
  font-size: 13px;
  color: var(--f-72);
}
.lio-pdp-trust .stars { display: inline-flex; color: #d4a05a; }
.lio-pdp-trust .stars svg { width: 16px; height: 16px; }
.lio-pdp-trust strong { color: var(--forest); font-weight: 700; }
.lio-pdp-trust .pipe {
  width: 1px; height: 14px;
  background: var(--f-22);
  display: inline-block;
}

.lio-pdp-h1 {
  font-family: var(--font-display);
  font-size: clamp(32px, 4.6vw, 44px);
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.02;
  color: var(--forest);
  margin-bottom: 10px;
}
.lio-pdp-sub p {
  margin: 0 0 16px;
  font-size: 15px;
  color: var(--f-72);
  line-height: 1.5;
}
.lio-pdp-sub strong { color: var(--forest); font-weight: 700; }

.lio-pdp-bullet-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 22px;
}
.lio-pdp-bullet {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--forest);
  background: var(--mint-soft);
  padding: 6px 12px;
  border-radius: 999px;
}
.lio-pdp-bullet svg { color: var(--forest); }

/* Steps */
.lio-pdp-step {
  background: var(--paper);
  border: 1px solid var(--f-08);
  border-radius: 18px;
  padding: 20px;
  margin-bottom: 14px;
  transition: opacity 0.2s, border-color 0.2s;
}
.lio-pdp-step--gated[hidden] { display: none !important; }
.lio-pdp-step-head {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}
.lio-pdp-step-tag {
  font-size: 8px;
  color: var(--f-22);
  transition: color 0.2s;
}
.lio-pdp-step-tag[data-step-dot].is-active { color: var(--mint-2); }
.lio-pdp-step-title {
  font-family: var(--font-display);
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--forest);
}
.lio-pdp-step-meta {
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--f-55);
  letter-spacing: 0.02em;
}
.lio-pdp-step-meta strong { color: var(--forest); font-weight: 700; }

/* DEVICE PICKER */
.lio-device-compare-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #fff;
  border: 1px solid var(--f-12);
  border-radius: 999px;
  padding: 9px 14px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--forest);
  margin-bottom: 14px;
  transition: border-color 0.15s, background 0.15s;
}
.lio-device-compare-cta:hover {
  border-color: var(--forest);
  background: var(--f-04);
}
.lio-device-compare-cta-icon { display: inline-flex; color: var(--mint-2); }
.lio-device-compare-cta-text { flex: 1; }
.lio-device-compare-cta-arrow {
  font-size: 14px;
  color: var(--forest);
  transition: transform 0.15s;
}
.lio-device-compare-cta:hover .lio-device-compare-cta-arrow { transform: translateX(2px); }

.lio-device-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.lio-device-card {
  position: relative;
  background: #fff;
  border: 2px solid var(--f-12);
  border-radius: 14px;
  padding: 16px 14px 14px;
  text-align: left;
  cursor: pointer;
  transition: border-color 0.15s, transform 0.15s;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.lio-device-card:hover { border-color: var(--f-22); transform: translateY(-2px); }
.lio-device-card[aria-pressed="true"] {
  border-color: var(--forest);
  background: linear-gradient(180deg, #fff 0%, var(--paper) 100%);
}
.lio-device-card-flag {
  position: absolute;
  top: -10px; right: 12px;
  background: var(--mint);
  color: var(--forest);
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
}
.lio-device-card-img {
  display: block;
  width: 64px; height: 64px;
  background: var(--mint-soft);
  border-radius: 12px;
  margin-bottom: 8px;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230b2410' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round' opacity='0.35'><rect x='8' y='3' width='8' height='18' rx='3'/><circle cx='12' cy='8' r='1.5'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: 70%;
}
.lio-device-card-name {
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--forest);
}
.lio-device-card-tag { font-size: 12px; color: var(--f-55); margin-bottom: 6px; }
.lio-device-card-price { display: flex; align-items: baseline; gap: 6px; }
.lio-device-card-price-sub {
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--forest);
}
.lio-device-card-radio {
  position: absolute;
  top: 14px; right: 14px;
  width: 18px; height: 18px;
  border-radius: 50%;
  border: 2px solid var(--f-22);
  background: #fff;
  transition: border-color 0.15s, background 0.15s;
}
.lio-device-card[aria-pressed="true"] .lio-device-card-radio {
  border-color: var(--forest);
  background: var(--forest);
  box-shadow: inset 0 0 0 3px #fff;
}

.lio-wood-block { margin-top: 14px; }
.lio-wood-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.lio-wood-row[hidden] { display: none; }
.lio-wood-label {
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
  color: var(--f-55);
  font-weight: 600;
  flex-shrink: 0;
}
.lio-wood-options { display: flex; gap: 6px; flex-wrap: wrap; }
.lio-wood-opt {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fff;
  border: 2px solid var(--f-12);
  border-radius: 999px;
  padding: 6px 12px 6px 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--forest);
  cursor: pointer;
  transition: border-color 0.15s;
}
.lio-wood-opt:hover { border-color: var(--f-22); }
.lio-wood-opt.is-selected { border-color: var(--forest); }
.lio-wood-swatch {
  width: 18px; height: 18px;
  border-radius: 50%;
  display: inline-block;
  flex-shrink: 0;
}
.lio-wood-swatch--olive { background: linear-gradient(135deg, #c9b88a, #8a7a52); }
.lio-wood-swatch--walnut { background: linear-gradient(135deg, #6e4f30, #3a2616); }

/* FLAVORS */
.lio-preset-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 14px;
}
.lio-preset {
  position: relative;
  background: #fff;
  border: 2px solid var(--f-12);
  border-radius: 14px;
  padding: 14px 12px;
  cursor: pointer;
  transition: border-color 0.15s, transform 0.15s;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.lio-preset:hover { transform: translateY(-2px); }
.lio-preset.is-selected {
  border-color: var(--forest);
  background: linear-gradient(180deg, #fff 0%, var(--paper) 100%);
}
.lio-preset--bestseller.is-selected {
  border-color: var(--mint-2);
  background: linear-gradient(180deg, var(--mint-soft) 0%, var(--paper) 100%);
}
.lio-preset-flag {
  position: absolute;
  top: -10px; left: 50%;
  transform: translateX(-50%);
  background: var(--mint);
  color: var(--forest);
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 999px;
  white-space: nowrap;
}
.lio-preset-count {
  font-family: var(--font-display);
  font-size: 28px;
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--forest);
  line-height: 1;
}
.lio-preset-label {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--f-55);
  font-weight: 700;
}
.lio-preset-foot { margin-top: 6px; display: flex; flex-direction: column; gap: 2px; }
.lio-preset-pricing { display: inline-flex; align-items: baseline; gap: 6px; justify-content: center; }
.lio-preset-price { font-size: 14px; font-weight: 700; color: var(--forest); }
.lio-preset-price-was { font-size: 11.5px; color: var(--f-40); text-decoration: line-through; }
.lio-preset-perbag {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--f-55);
  letter-spacing: 0.02em;
}

.lio-flavor-hint, .lio-bestseller-hint {
  display: flex;
  gap: 10px;
  padding: 10px 12px;
  background: var(--mint-soft);
  border: 1px solid rgba(108,225,67,0.3);
  border-radius: 10px;
  margin-bottom: 12px;
  font-size: 12.5px;
  color: var(--forest);
  line-height: 1.4;
}
.lio-flavor-hint-icon, .lio-bestseller-hint-icon {
  flex-shrink: 0;
  width: 22px; height: 22px;
  background: var(--forest);
  color: var(--mint);
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 800;
}
.lio-flavor-hint-icon svg { width: 12px; height: 12px; }
.lio-flavor-hint-body, .lio-bestseller-hint-body { display: flex; flex-direction: column; gap: 2px; }
.lio-flavor-hint-body strong, .lio-bestseller-hint-body strong { font-weight: 700; color: var(--forest); }
.lio-bestseller-hint[hidden] { display: none; }

.lio-flavor-list { display: flex; flex-direction: column; gap: 6px; }
.lio-flavor {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #fff;
  border: 1px solid var(--f-08);
  border-radius: 14px;
  padding: 8px 10px 8px 8px;
  transition: border-color 0.15s;
}
.lio-flavor-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  background: 0;
  border: 0;
  padding: 0;
  text-align: left;
  cursor: pointer;
  min-width: 0;
}
.lio-flavor-swatch {
  flex-shrink: 0;
  width: 48px; height: 48px;
  border-radius: 50%;
  background: var(--paper);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lio-flavor-swatch img { width: 100%; height: 100%; object-fit: cover; }
.lio-flavor-info { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.lio-flavor-name {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 700;
  color: var(--forest);
  flex-wrap: wrap;
}
.lio-flavor-callout {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 9px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--forest);
  background: var(--mint);
  padding: 2px 6px;
  border-radius: 4px;
}
.lio-flavor-callout.is-soft { background: var(--mint-soft); color: var(--forest); }
.lio-flavor-tag { font-size: 11.5px; color: var(--f-55); }
.lio-flavor-chev {
  flex-shrink: 0;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: var(--f-04);
  color: var(--f-55);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.lio-flavor-row:hover .lio-flavor-chev { background: var(--mint-soft); color: var(--forest); }

.lio-stepper {
  display: inline-flex;
  align-items: center;
  gap: 0;
  background: var(--paper);
  border-radius: 999px;
  border: 1px solid var(--f-08);
  flex-shrink: 0;
}
.lio-stepper button {
  width: 30px; height: 30px;
  background: 0;
  border: 0;
  font-size: 16px;
  font-weight: 700;
  color: var(--forest);
  cursor: pointer;
  border-radius: 50%;
  transition: background 0.15s;
}
.lio-stepper button:hover:not(:disabled) { background: var(--f-08); }
.lio-stepper button:disabled { opacity: 0.3; cursor: default; }
.lio-stepper output {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  font-size: 14px;
  font-weight: 800;
  color: var(--forest);
  font-variant-numeric: tabular-nums;
}

.lio-flavor-meta-bar {
  margin-top: 12px;
  padding: 10px 12px;
  background: var(--paper);
  border: 1px solid var(--f-08);
  border-radius: 10px;
  font-size: 12px;
  font-family: var(--font-mono);
  letter-spacing: 0.02em;
}
.lio-flavor-meta-bar strong { font-weight: 600; color: var(--forest); }

/* ADD-ONS */
.lio-pdp-step--addons summary { list-style: none; cursor: pointer; }
.lio-pdp-step--addons summary::-webkit-details-marker { display: none; }
.lio-addons-summary { margin-bottom: 0; cursor: pointer; }
.lio-addons-summary-meta {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  color: var(--f-55);
  letter-spacing: 0.02em;
}
.lio-addons-summary-chev {
  display: inline-flex;
  width: 22px; height: 22px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--paper);
  border: 1px solid var(--f-08);
  color: var(--forest);
  transition: transform 0.2s;
}
.lio-pdp-step--addons[open] .lio-addons-summary-chev { transform: rotate(180deg); }
.lio-addons-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 14px;
}
.lio-addon {
  position: relative;
  background: #fff;
  border: 2px solid var(--f-12);
  border-radius: 12px;
  padding: 12px 10px;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  text-align: center;
  transition: border-color 0.15s, transform 0.15s;
  font-family: inherit;
}
.lio-addon:hover { transform: translateY(-2px); border-color: var(--f-22); }
.lio-addon[aria-pressed="true"] { border-color: var(--forest); background: var(--paper); }
.lio-addon-img {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px; height: 40px;
  background: var(--mint-soft);
  border-radius: 50%;
  margin-bottom: 4px;
}
.lio-addon-img-emoji { font-size: 20px; }
.lio-addon-name {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--forest);
  line-height: 1.2;
  min-height: 28px;
  display: flex;
  align-items: center;
}
.lio-addon-price { font-size: 12.5px; font-weight: 800; color: var(--forest); }
.lio-addon-check {
  position: absolute;
  top: 8px; right: 8px;
  width: 16px; height: 16px;
  border-radius: 50%;
  border: 2px solid var(--f-22);
  background: #fff;
  transition: border-color 0.15s, background 0.15s;
}
.lio-addon[aria-pressed="true"] .lio-addon-check {
  border-color: var(--forest);
  background: var(--forest);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none' stroke='%23fcfefb' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><polyline points='2 6 5 9 10 3'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: 70%;
}

/* PURCHASE BLOCK */
.lio-purchase-block {
  background: var(--forest);
  color: var(--cream);
  border-radius: 18px;
  padding: 22px;
  margin-top: 14px;
  position: relative;
  overflow: hidden;
}
.lio-purchase-block::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(500px circle at 100% 0%, rgba(148,252,169,0.08), transparent 60%);
  pointer-events: none;
}
.lio-pdp-step-head--inverse { margin-bottom: 14px; position: relative; }
.lio-pdp-step-head--inverse .lio-pdp-step-tag { color: var(--mint-2); }
.lio-pdp-step-head--inverse .lio-pdp-step-title { color: var(--cream); }

.lio-rhythm-toggle {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  padding: 4px;
  background: rgba(252,254,251,0.06);
  border-radius: 12px;
  margin-bottom: 14px;
  position: relative;
}
.lio-rhythm-opt {
  background: 0;
  border: 0;
  padding: 12px;
  border-radius: 9px;
  font-family: inherit;
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 3px;
  color: var(--c-75);
  cursor: pointer;
  transition: background 0.15s, color 0.15s;
  font-size: 13px;
  font-weight: 700;
}
.lio-rhythm-opt.is-selected { background: var(--mint); color: var(--forest); }
.lio-rhythm-opt-savings {
  font-family: var(--font-mono);
  font-size: 10.5px;
  font-weight: 600;
  letter-spacing: 0.02em;
  opacity: 0.9;
}
.lio-rhythm-opt.is-selected .lio-rhythm-opt-savings { color: var(--forest); }

.lio-rhythm-explainer { margin-bottom: 14px; position: relative; }
.lio-rhythm-explainer summary {
  display: flex;
  align-items: center;
  gap: 8px;
  list-style: none;
  cursor: pointer;
  font-size: 12px;
  color: var(--c-75);
}
.lio-rhythm-explainer summary::-webkit-details-marker { display: none; }
.lio-rhythm-explainer-icon {
  width: 18px; height: 18px;
  border-radius: 50%;
  background: rgba(252,254,251,0.1);
  color: var(--cream);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
}
.lio-rhythm-explainer-label { flex: 1; font-weight: 600; }
.lio-rhythm-explainer-chev {
  display: inline-flex;
  color: var(--c-65);
  transition: transform 0.2s;
}
.lio-rhythm-explainer[open] .lio-rhythm-explainer-chev { transform: rotate(180deg); }
.lio-rhythm-explainer-body {
  margin-top: 10px;
  padding: 12px 14px;
  background: rgba(252,254,251,0.04);
  border-radius: 10px;
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--c-75);
}
.lio-rhythm-explainer-body p { margin: 0 0 6px; }
.lio-rhythm-explainer-body p:last-child { margin-bottom: 0; }
.lio-rhythm-explainer-body strong { color: var(--cream); font-weight: 700; }

.lio-promise-badge {
  display: flex;
  gap: 10px;
  align-items: center;
  padding: 12px 14px;
  background: rgba(148,252,169,0.10);
  border: 1px solid rgba(148,252,169,0.30);
  border-radius: 12px;
  margin-bottom: 14px;
  position: relative;
}
.lio-promise-badge-icon {
  flex-shrink: 0;
  width: 30px; height: 30px;
  background: var(--mint);
  color: var(--forest);
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.lio-promise-badge-body { display: flex; flex-direction: column; gap: 2px; line-height: 1.4; }
.lio-promise-badge-body strong { color: var(--cream); font-size: 13px; font-weight: 700; }
.lio-promise-badge-body span { color: var(--c-75); font-size: 12px; }

.lio-benefits {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 14px;
  position: relative;
}
.lio-benefits li {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--c-75);
}
.lio-benefits li::before {
  content: "";
  width: 16px; height: 16px;
  background: var(--mint);
  border-radius: 50%;
  flex-shrink: 0;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none' stroke='%230b2410' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><polyline points='3 8 7 12 13 4'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
}
.lio-benefits li strong { color: var(--cream); font-weight: 700; }

.lio-quit-together {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  background: rgba(252,254,251,0.06);
  border: 1.5px dashed rgba(148,252,169,0.4);
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 14px;
  font-family: inherit;
  text-align: left;
  transition: background 0.15s, border-color 0.15s;
}
.lio-quit-together:hover { background: rgba(252,254,251,0.10); }
.lio-quit-together[aria-pressed="true"] {
  border-style: solid;
  border-color: var(--mint);
  background: rgba(148,252,169,0.12);
}
.lio-quit-together-flag {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 9.5px;
  letter-spacing: 0.16em;
  font-weight: 700;
  color: var(--forest);
  background: var(--mint);
  padding: 4px 8px;
  border-radius: 6px;
}
.lio-quit-together-body { flex: 1; display: flex; flex-direction: column; gap: 2px; line-height: 1.4; }
.lio-quit-together-title { font-size: 13px; font-weight: 700; color: var(--cream); }
.lio-quit-together-meta { font-size: 11.5px; color: var(--c-65); }
.lio-quit-together-check {
  flex-shrink: 0;
  width: 22px; height: 22px;
  border-radius: 50%;
  border: 2px solid var(--c-55);
  background: transparent;
  transition: border-color 0.15s, background 0.15s;
}
.lio-quit-together[aria-pressed="true"] .lio-quit-together-check {
  border-color: var(--mint);
  background: var(--mint);
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 14' fill='none' stroke='%230b2410' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><polyline points='3 7 6 10 11 4'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
  background-size: 70%;
}

/* TOTALS */
.lio-totals {
  background: rgba(252,254,251,0.04);
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 14px;
  position: relative;
}
.lio-totals-empty {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--c-65);
  font-size: 13px;
}
.lio-totals-empty-icon { display: inline-flex; flex-shrink: 0; }
.lio-totals-rows { display: flex; flex-direction: column; gap: 8px; }
.lio-totals-rows[hidden] { display: none; }
.lio-totals-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-size: 13.5px;
  color: var(--c-75);
  gap: 12px;
}
.lio-totals-row[hidden] { display: none; }
.lio-totals-row strong { color: var(--cream); font-weight: 700; }
.lio-totals-row--soft { color: var(--c-55); font-size: 12.5px; }
.lio-totals-row--soft strong { color: var(--c-75); font-weight: 600; }
.lio-totals-row--delivery { color: var(--mint); }
.lio-totals-delivery-flag { font-size: 14px; }
.lio-totals-total {
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid rgba(252,254,251,0.10);
  font-size: 16px;
  align-items: center;
}
.lio-totals-total > span:first-child {
  display: inline-flex;
  flex-direction: column;
  font-weight: 800;
  color: var(--cream);
}
.lio-total-label-sub {
  display: block;
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 600;
  color: var(--c-55);
  letter-spacing: 0.02em;
  margin-top: 1px;
}
.lio-totals-total > span:last-child {
  display: flex;
  align-items: baseline;
  gap: 8px;
}
.lio-total-strike {
  font-size: 13px;
  color: var(--c-55);
  text-decoration: line-through;
  font-weight: 600;
}
.lio-total-value {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--mint);
}

.lio-purchase-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  background: var(--mint);
  color: var(--forest);
  padding: 18px 24px;
  border: 0;
  border-radius: 999px;
  font-family: var(--font-display);
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  box-shadow: 0 8px 24px rgba(148, 252, 169, 0.20);
  transition: background 0.18s, transform 0.15s, box-shadow 0.2s;
  position: relative;
}
.lio-purchase-cta:hover:not(:disabled) {
  background: var(--cream);
  transform: translateY(-1px);
  box-shadow: 0 12px 30px rgba(148, 252, 169, 0.30);
}
.lio-purchase-cta:disabled {
  background: rgba(252,254,251,0.10);
  color: var(--c-55);
  cursor: not-allowed;
  box-shadow: none;
}
.lio-purchase-cta-arrow { font-size: 16px; font-weight: 800; }

.lio-cta-meta { margin-top: 10px; text-align: center; position: relative; }
.lio-reassurance { margin: 0 0 4px; font-size: 11.5px; color: var(--c-75); font-weight: 600; }
.lio-cta-scarcity {
  margin: 0;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.04em;
  color: var(--c-55);
}
.lio-cta-scarcity-dot {
  width: 6px; height: 6px;
  background: var(--mint-2);
  border-radius: 50%;
  animation: lio-pulse 2s ease-in-out infinite;
}
@keyframes lio-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.lio-cta-payments {
  margin: 14px 0 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
  position: relative;
}
.lio-cta-payments li { display: inline-flex; }

.lio-cta-review {
  margin: 16px 0 0;
  padding: 14px 16px;
  background: rgba(252,254,251,0.06);
  border-radius: 12px;
  text-align: center;
  position: relative;
}
.lio-cta-review-stars {
  color: var(--mint);
  font-size: 13px;
  letter-spacing: 1.5px;
  margin-bottom: 6px;
}
.lio-cta-review blockquote {
  margin: 0 0 6px;
  font-style: italic;
  font-size: 13px;
  line-height: 1.5;
  color: var(--cream);
}
.lio-cta-review figcaption {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.04em;
  color: var(--c-65);
}

.lio-pdp-trust-strip {
  margin-top: 14px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  padding: 12px;
  background: var(--paper);
  border: 1px solid var(--f-08);
  border-radius: 12px;
}
.lio-trust-item-label {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--f-72);
  display: flex;
  align-items: center;
  gap: 6px;
}
.lio-trust-item-label::before {
  content: "";
  width: 6px; height: 6px;
  background: var(--mint-2);
  border-radius: 50%;
}
@media (min-width: 600px) {
  .lio-pdp-trust-strip { grid-template-columns: repeat(4, 1fr); }
}

/* INLINE FAQ */
.lio-faq-inline {
  margin-top: 22px;
  padding: 20px;
  background: var(--paper);
  border: 1px solid var(--f-08);
  border-radius: 18px;
}
.lio-faq-inline-head { margin-bottom: 14px; }
.lio-faq-inline-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--f-55);
  margin-bottom: 8px;
}
.lio-faq-inline-eyebrow::before {
  content: "";
  width: 5px; height: 5px;
  background: var(--mint);
  border-radius: 50%;
}
.lio-faq-inline-title {
  font-family: var(--font-display);
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--forest);
}
.lio-faq-inline-list { display: flex; flex-direction: column; }
.lio-faq-item { border-top: 1px solid var(--f-08); }
.lio-faq-item:first-child { border-top: 0; }
.lio-faq-item summary {
  list-style: none;
  cursor: pointer;
  padding: 14px 4px;
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--forest);
  line-height: 1.4;
}
.lio-faq-item summary::-webkit-details-marker { display: none; }
.lio-faq-item-q { flex: 1; }
.lio-faq-item-caret {
  flex-shrink: 0;
  width: 24px; height: 24px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid var(--f-12);
  color: var(--forest);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s, background 0.15s;
}
.lio-faq-item[open] .lio-faq-item-caret {
  transform: rotate(180deg);
  background: var(--mint);
}
.lio-faq-item-a {
  padding: 0 4px 14px;
  font-size: 13px;
  line-height: 1.55;
  color: var(--f-72);
}
.lio-faq-item-a strong { color: var(--forest); font-weight: 700; }
.lio-faq-item-a p { margin: 0; }

/* STICKY CTA BAR */
.lio-sticky {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  z-index: 30;
  background: rgba(252,254,251,0.96);
  backdrop-filter: saturate(140%) blur(12px);
  -webkit-backdrop-filter: saturate(140%) blur(12px);
  border-top: 1px solid var(--f-08);
  transform: translateY(100%);
  transition: transform 0.3s var(--ease-out);
  font-family: var(--font-body);
  color: var(--forest);
}
.lio-sticky.is-visible { transform: translateY(0); }
.lio-sticky-shell {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 10px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
}
.lio-sticky-thumb {
  flex-shrink: 0;
  width: 48px; height: 48px;
  border-radius: 12px;
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.lio-sticky-thumb img { width: 100%; height: 100%; object-fit: cover; }
.lio-sticky-thumb-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--f-22);
}
.lio-sticky-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.lio-sticky-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--forest);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.lio-sticky-meta {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.02em;
  color: var(--f-55);
}
.lio-sticky-pricing {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 1px;
}
.lio-sticky-pricing[hidden] { display: none; }
.lio-sticky-strike { font-size: 11px; text-decoration: line-through; color: var(--f-40); }
.lio-sticky-strike[hidden] { display: none; }
.lio-sticky-total {
  font-size: 16px;
  font-weight: 800;
  color: var(--forest);
  letter-spacing: -0.01em;
}
.lio-sticky-btn {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--forest);
  color: var(--cream);
  padding: 12px 16px;
  border: 0;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  transition: background 0.15s, transform 0.15s;
}
.lio-sticky-btn:hover:not(:disabled) {
  background: var(--forest-2);
  transform: translateY(-1px);
}
.lio-sticky-btn:disabled,
.lio-sticky-btn.is-locked {
  background: var(--f-22);
  color: var(--f-55);
  cursor: pointer;
}
.lio-sticky-btn.is-locked:hover {
  background: var(--f-40);
  transform: translateY(-1px);
}
.lio-sticky-btn-arrow {
  display: inline-flex;
  width: 22px; height: 22px;
  background: var(--mint);
  color: var(--forest);
  border-radius: 50%;
  align-items: center;
  justify-content: center;
}
.lio-sticky-btn-arrow svg { width: 12px; height: 12px; }
.lio-sticky-btn:disabled .lio-sticky-btn-arrow,
.lio-sticky-btn.is-locked .lio-sticky-btn-arrow {
  background: var(--f-12);
  color: var(--f-55);
}
@media (max-width: 600px) {
  .lio-sticky-info { display: none; }
  .lio-sticky-pricing[hidden] { display: none; }
}

/* MODALS */
.lio-flavor-modal, .lio-device-modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.lio-flavor-modal-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(11,36,16,0.65);
  backdrop-filter: blur(6px);
}
.lio-flavor-modal-stage, .lio-device-modal-card {
  position: relative;
  background: var(--cream);
  border-radius: 20px;
  max-width: 480px;
  width: 100%;
  max-height: 90vh;
  overflow: auto;
}
.lio-device-modal-card { max-width: 720px; padding: 28px; }
.lio-flavor-modal-close {
  position: absolute;
  top: 14px; right: 14px;
  z-index: 5;
  width: 32px; height: 32px;
  border-radius: 50%;
  border: 0;
  background: rgba(252,254,251,0.94);
  color: var(--forest);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.lio-flavor-modal-card { padding: 24px; position: relative; }
.lio-flavor-modal-visual {
  aspect-ratio: 1.6 / 1;
  background: linear-gradient(135deg, var(--mint-soft), var(--paper));
  border-radius: 16px;
  margin-bottom: 18px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.lio-flavor-modal-hero { width: 100%; height: 100%; object-fit: cover; }
.lio-flavor-modal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
  gap: 10px;
}
.lio-flavor-modal-eyebrow {
  font-family: var(--font-mono);
  font-size: 10.5px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--f-55);
  font-weight: 700;
}
.lio-flavor-modal-flag {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--forest);
  background: var(--mint);
  padding: 4px 10px;
  border-radius: 999px;
}
.lio-flavor-modal-title {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 800;
  letter-spacing: -0.025em;
  color: var(--forest);
  margin-bottom: 8px;
}
.lio-flavor-modal-desc {
  font-size: 14px;
  line-height: 1.55;
  color: var(--f-72);
  margin: 0 0 16px;
}
.lio-flavor-modal-cta-row { margin-top: 18px; }
.lio-flavor-modal-cta {
  width: 100%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: var(--forest);
  color: var(--cream);
  padding: 14px 22px;
  border: 0;
  border-radius: 999px;
  font-family: var(--font-display);
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.lio-flavor-modal-cta-arrow {
  width: 24px; height: 24px;
  border-radius: 50%;
  background: var(--mint);
  color: var(--forest);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.lio-device-modal-head { text-align: center; margin-bottom: 22px; }
.lio-device-modal-title {
  font-family: var(--font-display);
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.025em;
  color: var(--forest);
  margin-bottom: 6px;
}
.lio-device-modal-sub { font-size: 14px; color: var(--f-72); margin: 0; }
.lio-device-compare {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  margin-bottom: 18px;
}
@media (min-width: 600px) {
  .lio-device-compare { grid-template-columns: 1fr 1fr; }
}
.lio-device-compare-col {
  background: var(--paper);
  border: 2px solid var(--f-08);
  border-radius: 16px;
  padding: 18px 16px;
  text-align: center;
  position: relative;
}
.lio-device-compare-col.is-pro {
  border-color: var(--mint-2);
  background: linear-gradient(180deg, var(--mint-soft) 0%, var(--paper) 100%);
}
.lio-device-compare-img {
  width: 100px;
  margin: 0 auto 10px;
  aspect-ratio: 1;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}
.lio-device-compare-img img { width: 100%; height: 100%; object-fit: cover; }
.lio-device-compare-name {
  font-family: var(--font-display);
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--forest);
  margin-bottom: 4px;
}
.lio-device-compare-line {
  font-size: 13px;
  font-style: italic;
  color: var(--f-72);
  margin: 0 0 12px;
}
.lio-device-compare-list {
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12.5px;
  color: var(--f-72);
  margin-bottom: 14px;
}
.lio-device-compare-list li { padding-left: 18px; position: relative; }
.lio-device-compare-list li::before {
  content: "";
  position: absolute;
  left: 0; top: 4px;
  width: 12px; height: 12px;
  background: var(--mint);
  border-radius: 50%;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' fill='none' stroke='%230b2410' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><polyline points='2 6 5 9 10 3'/></svg>");
  background-position: center;
  background-repeat: no-repeat;
}
.lio-device-compare-list li strong { color: var(--forest); font-weight: 700; }
.lio-device-compare-foot { margin-bottom: 14px; }
.lio-device-compare-price {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--forest);
}
.lio-device-compare-pick {
  width: 100%;
  background: var(--forest);
  color: var(--cream);
  padding: 12px 20px;
  border: 0;
  border-radius: 999px;
  font-family: var(--font-display);
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s;
}
.lio-device-compare-pick:hover { background: var(--forest-2); }
.lio-device-compare-takeaway {
  text-align: center;
  font-size: 13px;
  color: var(--f-72);
  font-style: italic;
}
.lio-device-compare-takeaway p { margin: 0; }
</style>

