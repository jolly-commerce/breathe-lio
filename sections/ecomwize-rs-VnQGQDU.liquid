{%- style -%}
  #ecomwize-benefit08-rs-VnQGQDU {
    background-color: #ffffff;
    padding: 24px 12px;
    letter-spacing: normal;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU {
      padding: 64px 32px;
    }
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-container {
    max-width: 1440px;
    margin: 0 auto;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-heading {
    font-family: 'DM Sans',  sans-serif;
    font-size: 28px;
    font-weight: 500;
    color: #143c2c;
    line-height: 120%;
    text-transform: none;
    text-align: center;
    margin: 0 0 16px 0;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-heading {
      font-size: 38px;
    }
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-subheading {
    font-family: 'DM Sans',  sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #143c2c;
    line-height: 160%;
    text-align: center;
    margin: 0 0 24px 0;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-subheading {
      font-size: 16px;
      margin-bottom: 48px;
    }
  }
  
  /* Cards Grid */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-cards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-cards-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }
  
  /* Card */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card {
    background-color: #f5fffc;
    border-radius: 0px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  
  /* Card image wrapper */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-image img,
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-image video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Card content */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-content {
    padding: 12px;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-content {
      padding: 24px;
    }
  }
  
  /* Card title - weight 600, textColor */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-title {
    font-family: 'DM Sans',  sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #143c2c;
    line-height: 160%;
    text-align: center;
    margin: 0 0 8px 0;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-title {
      font-size: 16px;
    }
  }
  
  /* Card description */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-desc {
    font-family: 'DM Sans',  sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #143c2c;
    line-height: 160%;
    text-align: center;
    margin: 0;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-card-desc {
      font-size: 14px;
    }
  }
  
  /* Button wrapper */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-button-wrapper {
    text-align: center;
    margin-top: 24px;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-button-wrapper {
      margin-top: 48px;
    }
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background-color: #05b67a;
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 8px;
    border: 0px solid #0d3d3d;
    text-decoration: none;
    font-family: 'DM Sans',  sans-serif;
    font-weight: 700;
    font-size: 14px;
    line-height: 160%;
    text-transform: capitalize;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-button {
      width: auto;
      font-size: 16px;
    }
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-button:hover {
    background-color: #1efda4;
    color: #ffffff;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-heading b,
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-subheading b {
    font-weight: 700;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-heading > p,
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-subheading > p {
    margin: 0;
    padding: 0;
  }
  
  /* Video controls */
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-video-controls {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 10;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-play-button {
    pointer-events: auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #05b67a;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    border: none;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  @media (min-width: 1024px) {
    #ecomwize-benefit08-rs-VnQGQDU .benefit08-play-button {
      width: 56px;
      height: 56px;
    }
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-play-button:hover {
    transform: scale(1.05);
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-play-button.playing {
    opacity: 0;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-video-wrapper:hover .benefit08-play-button.playing {
    opacity: 1;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-play-icon,
  #ecomwize-benefit08-rs-VnQGQDU .benefit08-pause-icon {
    fill: #ffffff;
  }
  
  #ecomwize-benefit08-rs-VnQGQDU .text-highlight {
    font-family: 'Instrument Serif', sans-serif;
    font-weight: 400;
    font-style: italic;
  }
{%- endstyle -%}

